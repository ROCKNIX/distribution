#!/usr/bin/env bash
for var in $(compgen -e); do
  [[ "$var" == PATH  ]] && continue
  # A host TMPDIR does not exist inside the container. macOS sets one by
  # default, so mktemp fails and init_package_cache dies before it can
  # build the package caches - which is why builds have needed to be run
  # as "env -u TMPDIR make docker-...". Drop it and let the container use
  # its own /tmp.
  [[ "$var" == TMPDIR ]] && continue
  # The build system keeps its derived state in the underscore namespace and
  # only recomputes it when unset: init_package_cache regenerates the package
  # caches when _CACHE_PACKAGE_* are empty, and set_debug_depends runs when
  # _DEBUG_DEPENDS_LIST is unset - tested with +x, so an empty-but-set value
  # also suppresses it. Carrying those in from the host pins them for the
  # whole run, and adding or removing a package then silently has no effect.
  [[ "$var" == _* ]] && continue
  echo "$var=${!var}"
done
