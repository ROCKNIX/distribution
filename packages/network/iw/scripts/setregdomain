#!/bin/sh

REGDOMAIN=
REGDOMAIN_CONF="/storage/.cache/regdomain.conf"
[ -r "$REGDOMAIN_CONF" ] && . "$REGDOMAIN_CONF"
[ -z "$REGDOMAIN" ] && exit 0

# cfg80211 is usually built into the kernel, so its single attempt at loading
# regulatory.db happens before any rootfs exists and fails with -ENOENT. That
# failure is cached, and every hint afterwards is answered from an empty
# database and silently dropped, leaving the domain at 00. Reload it first.
/usr/sbin/iw reg reload

exec /usr/sbin/iw reg set "$REGDOMAIN"
