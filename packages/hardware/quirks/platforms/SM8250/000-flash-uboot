[ -f "/proc/device-tree/rocknix,u-boot" ] && exit 0

if [ -b "/dev/sde" ]; then
  if dd if=/dev/sde bs=4K skip=502072 count=1 2>/dev/null | grep -q ANDROID; then
    #Android 10 LOADER_A=502072 LOADER_B=504632
    dd if=/usr/share/bootloader/u-boot.img of=/dev/sde bs=4K seek=502072 conv=fsync,notrunc &>/dev/null
    dd if=/usr/share/bootloader/u-boot.img of=/dev/sde bs=4K seek=504632 conv=fsync,notrunc &>/dev/null
  elif dd if=/dev/sde bs=4K skip=472888 count=1 2>/dev/null | grep -q ANDROID; then
    #Android 13 LOADER_A=472888 LOADER_B=475448
    dd if=/usr/share/bootloader/u-boot.img of=/dev/sde bs=4K seek=472888 conv=fsync,notrunc &>/dev/null
    dd if=/usr/share/bootloader/u-boot.img of=/dev/sde bs=4K seek=475448 conv=fsync,notrunc &>/dev/null
  fi
fi
sync
reboot
