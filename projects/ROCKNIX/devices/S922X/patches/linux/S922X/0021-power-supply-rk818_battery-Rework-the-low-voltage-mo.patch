From f6beb9d34c84b41032e60827858b4dc447307bda Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sat, 25 Jul 2026 11:59:50 +0200
Subject: [PATCH 21/34] power: supply: rk818_battery: Rework the low voltage
 monitor setup

The VBAT low voltage monitor was armed at 3.4V in interrupt mode with
the interrupt unmasked at all times. The monitor watches Vsys behind
the internal battery switch with only 2ms of debouncing, so it fired
on transient load dips long before the battery was empty, causing
spurious interrupts at runtime and spurious wakeups from suspend.

While the system runs, park the monitor at 3.0V with the interrupt
masked - empty battery reporting is done by the fuel gauge and the
fixed 2.7V UVLO remains as the hardware backstop. Re-arm the monitor
at 3.4V as an unmasked wakeup source only when entering suspend, so
the system wakes up and can shut down cleanly before the battery runs
out. The vendor BSP arms the 3.4V wakeup only for suspend, too.

On the wakeup, refresh the gauge state and notify userspace right
away instead of just logging. The handler now uses the monitor work,
so set the workqueue up before requesting the interrupt in probe.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/power/supply/rk818_battery.c | 61 +++++++++++++++++++---------
 1 file changed, 42 insertions(+), 19 deletions(-)

diff --git a/drivers/power/supply/rk818_battery.c b/drivers/power/supply/rk818_battery.c
index 35eb8f2098af..eee0ef08a3a3 100644
--- a/drivers/power/supply/rk818_battery.c
+++ b/drivers/power/supply/rk818_battery.c
@@ -88,6 +88,7 @@
 
 /* RK818_VB_MON_REG */
 #define PLUG_IN_STS			BIT(6)
+#define RK818_VBAT_LOW_3V0		0x02
 #define RK818_VBAT_LOW_3V4		0x06
 
 /* RK818_MISC_MARK_REG */
@@ -748,19 +749,26 @@ static void rk818_configure_relax_thresholds(struct rk818_battery *di)
 }
 
 /*
- * Set the VBAT low-voltage monitor to 3.4 V in IRQ (not hard-shutdown) mode
- * so the system receives a wakeup event when the battery is nearly empty.
- * Unmask the corresponding interrupt so it is actually delivered.
+ * Configure the VBAT low-voltage monitor.  The monitor watches Vsys (behind
+ * the internal battery switch) with only 2 ms of debouncing, so a 3.4 V
+ * threshold trips on transient load dips long before the battery is empty.
+ * While the system runs, park the monitor at 3.0 V in interrupt mode with
+ * the interrupt masked - empty battery reporting is done by the fuel gauge
+ * and the fixed 2.7 V UVLO remains as the hardware backstop.  For suspend,
+ * re-arm it at 3.4 V as an unmasked wakeup source so the system can wake
+ * up and shut down cleanly before the battery runs out.
  */
-static void rk818_set_low_voltage_irq(struct rk818_battery *di)
+static void rk818_set_low_voltage_irq(struct rk818_battery *di, bool wakeup)
 {
 	u8 val = rk818_read(di, RK818_VB_MON_REG);
 
-	val = (val & ~(VBAT_LOW_VOL_MASK | VBAT_LOW_ACT_MASK)) |
-	      RK818_VBAT_LOW_3V4 | EN_VBAT_LOW_IRQ;
+	val &= ~(VBAT_LOW_VOL_MASK | VBAT_LOW_ACT_MASK);
+	val |= EN_VBAT_LOW_IRQ;
+	val |= wakeup ? RK818_VBAT_LOW_3V4 : RK818_VBAT_LOW_3V0;
 	rk818_write(di, RK818_VB_MON_REG, val);
-	/* Clear the mask bit to enable the interrupt */
-	rk818_clrsetbits(di, RK818_INT_STS_MSK_REG1, VB_LOW_INT_EN, 0);
+
+	rk818_clrsetbits(di, RK818_INT_STS_MSK_REG1, VB_LOW_INT_EN,
+			 wakeup ? 0 : VB_LOW_INT_EN);
 }
 
 /*
@@ -1490,7 +1498,7 @@ static int rk818_battery_suspend(struct platform_device *pdev,
 
 	rk818_save_dsoc(di);
 	rk818_save_remain_cap(di);
-	rk818_set_low_voltage_irq(di);
+	rk818_set_low_voltage_irq(di, true);
 
 	dev_info(di->dev,
 		 "suspend: dsoc=%d rsoc=%d i=%d mA v=%d mV cap=%d mAh chrg=%d\n",
@@ -1531,7 +1539,7 @@ static int rk818_battery_resume(struct platform_device *pdev)
 	}
 
 	rk818_save_dsoc(di);
-	rk818_set_low_voltage_irq(di);
+	rk818_set_low_voltage_irq(di, false);
 
 	dev_info(di->dev,
 		 "resume: dsoc=%d rsoc=%d i=%d mA v=%d mV cap=%d mAh\n",
@@ -1553,6 +1561,15 @@ static irqreturn_t rk818_vb_low_irq(int irq, void *data)
 
 	dev_warn(di->dev, "low battery IRQ: v=%d mV dsoc=%d%%\n",
 		 di->voltage_avg_mv, di->dsoc);
+
+	/*
+	 * The interrupt is only unmasked as a suspend wakeup source.  Refresh
+	 * the gauge state and notify userspace right away, so that it can
+	 * react to the nearly empty battery after the wakeup.
+	 */
+	mod_delayed_work(di->wq, &di->work, 0);
+	power_supply_changed(di->charger_psy);
+
 	return IRQ_HANDLED;
 }
 
@@ -2570,7 +2587,7 @@ static int rk818_battery_probe(struct platform_device *pdev)
 	rk818_init_soc(di);
 	rk818_configure_charger(di);
 	rk818_init_ts1_detect(di);
-	rk818_set_low_voltage_irq(di);
+	rk818_set_low_voltage_irq(di, false);
 
 	/* disable voltage limit and enable input current limit */
 	ret = regmap_update_bits(di->regmap, RK818_SUP_STS_REG,
@@ -2595,27 +2612,33 @@ static int rk818_battery_probe(struct platform_device *pdev)
 
 	rk818_usb_power_external_power_changed(di->usb_psy);
 
+	/* The vb_lo IRQ handler uses the work, set it up first. */
+	di->wq = alloc_ordered_workqueue("rk818-bat",
+					 WQ_MEM_RECLAIM | WQ_FREEZABLE);
+	if (!di->wq)
+		return -ENOMEM;
+
+	INIT_DELAYED_WORK(&di->work, rk818_battery_work);
+
 	vb_lo_irq = regmap_irq_get_virq(rk818->irq_data, RK818_IRQ_VB_LO);
-	if (vb_lo_irq < 0)
+	if (vb_lo_irq < 0) {
+		destroy_workqueue(di->wq);
 		return dev_err_probe(di->dev, vb_lo_irq,
 				     "cannot get vb_lo virq\n");
+	}
 
 	ret = devm_request_threaded_irq(di->dev, vb_lo_irq, NULL,
 					rk818_vb_low_irq,
 					IRQF_TRIGGER_HIGH | IRQF_ONESHOT,
 					"rk818_vb_low", di);
-	if (ret)
+	if (ret) {
+		destroy_workqueue(di->wq);
 		return dev_err_probe(di->dev, ret,
 				     "failed to request vb_lo IRQ\n");
+	}
 
 	enable_irq_wake(vb_lo_irq);
 
-	di->wq = alloc_ordered_workqueue("rk818-bat",
-					 WQ_MEM_RECLAIM | WQ_FREEZABLE);
-	if (!di->wq)
-		return -ENOMEM;
-
-	INIT_DELAYED_WORK(&di->work, rk818_battery_work);
 	queue_delayed_work(di->wq, &di->work, msecs_to_jiffies(di->monitor_ms));
 
 	dev_info(di->dev, "ready: dsoc=%d%% fcc=%d mAh sense=%u mOhm\n",
-- 
