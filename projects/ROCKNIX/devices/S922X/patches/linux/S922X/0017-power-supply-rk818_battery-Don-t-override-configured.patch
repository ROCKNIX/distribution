From baad030384af127b0e882b35113d72ace89d2224 Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sat, 25 Jul 2026 11:57:17 +0200
Subject: [PATCH 17/34] power: supply: rk818_battery: Don't override configured
 charger limits in probe

Probe was overwriting CHRG_CTRL_REG1 with hardcoded 1.2A/4.3V limits
right after rk818_configure_charger() applied the limits from battery
info, so constant-charge-current-max-microamp from DT never took
effect. Just enable the charger without touching the limit fields.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/power/supply/rk818_battery.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/drivers/power/supply/rk818_battery.c b/drivers/power/supply/rk818_battery.c
index a4af2631d3bf..27da0b1d52e8 100644
--- a/drivers/power/supply/rk818_battery.c
+++ b/drivers/power/supply/rk818_battery.c
@@ -2538,11 +2538,10 @@ static int rk818_battery_probe(struct platform_device *pdev)
 	if (ret)
 		dev_warn(di->dev, "failed to enable analog control loop (%d)\n", ret);
 
-	/* enable charger and set some reasonable limits on each boot */
-	ret = regmap_write(di->regmap, RK818_CHRG_CTRL_REG1,
-			   RK818_CHRG_CTRL_REG1_CHRG_EN
-			   | (1) /* 1.2A */
-			   | (5 << 4) /* 4.3V */);
+	/* enable charger (limits are set up by rk818_configure_charger) */
+	ret = regmap_update_bits(di->regmap, RK818_CHRG_CTRL_REG1,
+				 RK818_CHRG_CTRL_REG1_CHRG_EN,
+				 RK818_CHRG_CTRL_REG1_CHRG_EN);
 	if (ret)
 		dev_warn(di->dev, "failed to enable charger (%d)\n", ret);
 
