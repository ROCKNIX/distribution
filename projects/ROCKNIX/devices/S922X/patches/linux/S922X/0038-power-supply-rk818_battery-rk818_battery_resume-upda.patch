From 8cf99e6659226ec31d3e52778b92130ed1df9e29 Mon Sep 17 00:00:00 2001
From: John Williams <porschemad911@gmail.com>
Date: Tue, 27 Oct 2026 23:31:57 +1100
Subject: [PATCH 38/38] power: supply: rk818_battery: rk818_battery_resume:
 update dsoc from rsoc if charging

---
 drivers/power/supply/rk818_battery.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/power/supply/rk818_battery.c b/drivers/power/supply/rk818_battery.c
index 9969741d140d..c7146fec3391 100644
--- a/drivers/power/supply/rk818_battery.c
+++ b/drivers/power/supply/rk818_battery.c
@@ -1534,10 +1534,22 @@ static int rk818_battery_resume(struct platform_device *pdev)
 		di->dsoc = max(di->dsoc - sleep_soc_drop, max(di->rsoc, 0));
 
 		dev_info(di->dev,
-			 "resume: slept %d s, est. drop %d%%, dsoc=%d rsoc=%d\n",
+			 "resume (discharging): slept %d s, est. drop %d%%, dsoc=%d rsoc=%d\n",
 			 sleep_sec, sleep_soc_drop, di->dsoc, di->rsoc);
 	}
 
+	/*
+	 * Update dsoc from rsoc if charging so it does not appear to
+	 * lag behind reality after a long sleep with a charger attached.
+	*/
+	if (di->sleep_chrg_online && sleep_sec > 0) {
+		dev_info(di->dev,
+			 "resume (charging): slept %d s, dsoc=%d rsoc=%d\n",
+			 sleep_sec, di->dsoc, di->rsoc);
+
+		di->dsoc = max(di->rsoc, 0);
+	}
+
 	rk818_save_dsoc(di);
 	rk818_set_low_voltage_irq(di, false);
 
