From 5b19a995cef35fdd11906605abab620335ccc1ba Mon Sep 17 00:00:00 2001
From: Ondrej Jirman <megi@xff.cz>
Date: Sat, 25 Jul 2026 11:45:56 +0200
Subject: [PATCH 19/34] power: supply: rk818_battery: Scale termination current
 by the sense resistor value

CHRG_TERM_SEL steps are nominal values for the reference 20 mOhm sense
resistor design, like the CC current steps. On the 10 mOhm Pinephone
Pro design the 150 mA setting from DT terminated charging at ~300 mA
of actual current, ending the CV phase early and leaving the battery
visibly below the CV setpoint. This matches the vendor BSP, which
forces the lowest termination step on 10 mOhm boards.

Encode the termination current scaled by the sense resistor and report
the actual value. Drop the 10 mOhm special case from the fallback -
the scaling now covers it with the same resulting register values.

Signed-off-by: Ondrej Jirman <megi@xff.cz>
---
 drivers/power/supply/rk818_battery.c | 16 +++++++++-------
 1 file changed, 9 insertions(+), 7 deletions(-)

diff --git a/drivers/power/supply/rk818_battery.c b/drivers/power/supply/rk818_battery.c
index bc6d92890405..d9b62d45f114 100644
--- a/drivers/power/supply/rk818_battery.c
+++ b/drivers/power/supply/rk818_battery.c
@@ -334,6 +334,7 @@ static void rk818_clrsetbits(struct rk818_battery *di, u8 reg, u8 mask, u8 val)
 /* Forward declarations for helpers used before their definition. */
 static int rk818_charger_set_current_max(struct rk818_battery *di, int val);
 static int rk818_charger_set_voltage_max(struct rk818_battery *di, int val);
+static int rk818_charger_current_to_nominal(struct rk818_battery *di, int val);
 
 /*
  * Read a big-endian 16-bit register pair and apply linear voltage calibration.
@@ -838,14 +839,13 @@ static void rk818_configure_charger(struct rk818_battery *di)
 
 	/*
 	 * Termination current: prefer charge_term_current_ua from the DT;
-	 * fall back to ~C/30 of FCC scaled by sense resistor, then encode
-	 * to the nearest supported FINISH_*MA step.
+	 * fall back to ~C/30 of FCC.  The FINISH_*MA steps are nominal
+	 * values for a 20 mOhm sense resistor, so encode the value scaled
+	 * by the actual sense resistor.
 	 */
 	term_ua = di->info->charge_term_current_ua;
 	if (term_ua <= 0) {
-		if (di->sense_resist_mohm == 10)
-			term_ua = 100000;
-		else if (di->fcc_mah >= 5000)
+		if (di->fcc_mah >= 5000)
 			term_ua = 250000;
 		else if (di->fcc_mah >= 4000)
 			term_ua = 200000;
@@ -854,7 +854,8 @@ static void rk818_configure_charger(struct rk818_battery *di)
 		else
 			term_ua = 100000;
 	}
-	finish_ma = rk818_encode_finish_current(term_ua);
+	finish_ma = rk818_encode_finish_current(
+			rk818_charger_current_to_nominal(di, term_ua));
 
 	usb_ctrl = rk818_read(di, RK818_USB_CTRL_REG);
 	chrg2    = rk818_read(di, RK818_CHRG_CTRL_REG2);
@@ -1947,7 +1948,8 @@ static int rk818_charger_get_property(struct power_supply *psy,
 		if (ret)
 			return ret;
 
-		val->intval = 100000 + ((reg >> 6) & 3) * 50000;
+		val->intval = rk818_charger_nominal_to_current(di,
+				100000 + ((reg >> 6) & 3) * 50000);
 		break;
 
 	case POWER_SUPPLY_PROP_HEALTH:
-- 
