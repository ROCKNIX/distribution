From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] regulator: qcom-rpmh: skip resources missing from cmd-db

---
 drivers/regulator/qcom-rpmh-regulator.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

--- a/drivers/regulator/qcom-rpmh-regulator.c
+++ b/drivers/regulator/qcom-rpmh-regulator.c
@@ -481,9 +481,9 @@

 	vreg->addr = cmd_db_read_addr(rpmh_resource_name);
 	if (!vreg->addr) {
-		dev_err(dev, "%pOFn: could not find RPMh address for resource %s\n",
-			node, rpmh_resource_name);
-		return -ENODEV;
+		dev_warn(dev, "%pOFn: no RPMh address for resource %s, skipping\n",
+			 node, rpmh_resource_name);
+		return 0;
 	}

 	vreg->rdesc.name = rpmh_data->name;
