From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] drm/panel: Add BOE CH13726A AMOLED panel driver

Panel Driver based on mainline AYN Thor driver with timings from
android devicetree.

---
--- a/drivers/gpu/drm/panel/Kconfig	2026-08-25 09:46:43.248514136 -0700
+++ b/drivers/gpu/drm/panel/Kconfig	2026-08-25 09:46:48.305508922 -0700
@@ -56,6 +56,18 @@
 	  uses 24 bit RGB per pixel. It provides a MIPI DSI interface to
 	  the host and backlight is controlled through DSI commands.
 
+config DRM_PANEL_BOE_CH13726A
+	tristate "Boe CH13726A panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the Boe CH13726A
+	  3.92" AMOLED module, as found in the Retroid Pocket Classic
+	  handheld. The panel has a 1080x1240 resolution and uses 24 bit
+	  RGB per pixel. It provides a MIPI DSI interface to the host and
+	  backlight is controlled through DSI commands.
+
 config DRM_PANEL_BOE_HIMAX8279D
 	tristate "Boe Himax8279d panel"
 	depends on OF
--- a/drivers/gpu/drm/panel/Makefile	2026-08-25 09:46:43.249567780 -0700
+++ b/drivers/gpu/drm/panel/Makefile	2026-08-25 09:46:50.617506538 -0700
@@ -4,6 +4,7 @@
 obj-$(CONFIG_DRM_PANEL_ASUS_Z00T_TM5P5_NT35596) += panel-asus-z00t-tm5p5-n35596.o
 obj-$(CONFIG_DRM_PANEL_AUO_A030JTN01) += panel-auo-a030jtn01.o
 obj-$(CONFIG_DRM_PANEL_BOE_BF060Y8M_AJ0) += panel-boe-bf060y8m-aj0.o
+obj-$(CONFIG_DRM_PANEL_BOE_CH13726A) += panel-boe-ch13726a.o
 obj-$(CONFIG_DRM_PANEL_BOE_HIMAX8279D) += panel-boe-himax8279d.o
 obj-$(CONFIG_DRM_PANEL_BOE_TD4320) += panel-boe-td4320.o
 obj-$(CONFIG_DRM_PANEL_BOE_TH101MB31UIG002_28A) += panel-boe-th101mb31ig002-28a.o
--- a/drivers/gpu/drm/panel/panel-boe-ch13726a.c	1969-12-31 16:00:00.000000000 -0800
+++ b/drivers/gpu/drm/panel/panel-boe-ch13726a.c	2026-08-25 00:00:00.000000000 -0700
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * BOE CH13726A AMOLED DSI panel driver (Retroid Pocket Classic)
+ *
+ * Copyright (c) 2026, ROCKNIX contributors.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include <video/mipi_display.h>
+
+#define CH13726A_CMD_F0		0xf0
+#define CH13726A_CMD_B9		0xb9
+
+static const struct regulator_bulk_data boe_ch13726a_supplies[] = {
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+};
+
+struct boe_ch13726a {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+	enum drm_panel_orientation orientation;
+};
+
+static inline struct boe_ch13726a *to_boe_ch13726a(struct drm_panel *panel)
+{
+	return container_of(panel, struct boe_ch13726a, panel);
+}
+
+static void boe_ch13726a_reset(struct boe_ch13726a *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int boe_ch13726a_on(struct boe_ch13726a *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, CH13726A_CMD_F0, 0x50);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, CH13726A_CMD_B9, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	return dsi_ctx.accum_err;
+}
+
+static int boe_ch13726a_disable(struct drm_panel *panel)
+{
+	struct boe_ch13726a *ctx = to_boe_ch13726a(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	return dsi_ctx.accum_err;
+}
+
+static int boe_ch13726a_prepare(struct drm_panel *panel)
+{
+	struct boe_ch13726a *ctx = to_boe_ch13726a(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(boe_ch13726a_supplies),
+				    ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	msleep(20);
+
+	boe_ch13726a_reset(ctx);
+
+	ret = boe_ch13726a_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(boe_ch13726a_supplies),
+				       ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int boe_ch13726a_unprepare(struct drm_panel *panel)
+{
+	struct boe_ch13726a *ctx = to_boe_ch13726a(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(boe_ch13726a_supplies),
+			       ctx->supplies);
+
+	return 0;
+}
+
+static const struct drm_display_mode boe_ch13726a_mode = {
+	.clock = (1080 + 12 + 4 + 12) * (1240 + 12 + 4 + 12) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 12,
+	.hsync_end = 1080 + 12 + 4,
+	.htotal = 1080 + 12 + 4 + 12,
+	.vdisplay = 1240,
+	.vsync_start = 1240 + 12,
+	.vsync_end = 1240 + 12 + 4,
+	.vtotal = 1240 + 12 + 4 + 12,
+	.width_mm = 65,
+	.height_mm = 75,
+	.type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED,
+};
+
+static int boe_ch13726a_get_modes(struct drm_panel *panel,
+				  struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &boe_ch13726a_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	connector->display_info.bpc = 8;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static enum drm_panel_orientation
+boe_ch13726a_get_orientation(struct drm_panel *panel)
+{
+	struct boe_ch13726a *ctx = to_boe_ch13726a(panel);
+
+	return ctx->orientation;
+}
+
+static const struct drm_panel_funcs boe_ch13726a_panel_funcs = {
+	.prepare = boe_ch13726a_prepare,
+	.unprepare = boe_ch13726a_unprepare,
+	.disable = boe_ch13726a_disable,
+	.get_modes = boe_ch13726a_get_modes,
+	.get_orientation = boe_ch13726a_get_orientation,
+};
+
+static int boe_ch13726a_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	u16 brightness = backlight_get_brightness(bl);
+	int ret;
+
+	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	ret = mipi_dsi_dcs_set_display_brightness(dsi, brightness);
+	if (ret < 0)
+		return ret;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	return 0;
+}
+
+static const struct backlight_ops boe_ch13726a_bl_ops = {
+	.update_status = boe_ch13726a_bl_update_status,
+};
+
+static struct backlight_device *
+boe_ch13726a_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 255,
+		.max_brightness = 255,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &boe_ch13726a_bl_ops, &props);
+}
+
+static int boe_ch13726a_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct boe_ch13726a *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, __typeof(*ctx), panel,
+				   &boe_ch13726a_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev,
+					    ARRAY_SIZE(boe_ch13726a_supplies),
+					    boe_ch13726a_supplies,
+					    &ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ret = of_drm_get_panel_orientation(dev->of_node, &ctx->orientation);
+	if (ret < 0) {
+		dev_err(dev, "%pOF: failed to get orientation %d\n",
+			dev->of_node, ret);
+		return ret;
+	}
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = boe_ch13726a_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void boe_ch13726a_remove(struct mipi_dsi_device *dsi)
+{
+	struct boe_ch13726a *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id boe_ch13726a_of_match[] = {
+	{ .compatible = "boe,ch13726a" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, boe_ch13726a_of_match);
+
+static struct mipi_dsi_driver boe_ch13726a_driver = {
+	.probe = boe_ch13726a_probe,
+	.remove = boe_ch13726a_remove,
+	.driver = {
+		.name = "panel-boe-ch13726a",
+		.of_match_table = boe_ch13726a_of_match,
+	},
+};
+module_mipi_dsi_driver(boe_ch13726a_driver);
+
+MODULE_DESCRIPTION("DRM driver for the BOE CH13726A AMOLED DSI panel");
+MODULE_LICENSE("GPL");
