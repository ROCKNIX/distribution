From 91bc419ce7f775c38ddd7876ca340a79da70513b Mon Sep 17 00:00:00 2001
From: Zhenyu Qi <qzydustin@hotmail.com>
Date: Sun, 4 Oct 2026 23:57:06 -0700
Subject: [PATCH] mali_kbase: request a minimum voltage on the GPU supply

vdd_logic is shared with the DDR controller. Request the OPP voltage as
a minimum, as the vendor kernel does, so the two do not block each other.
---
 .../drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c  | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/product/kernel/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c b/product/kernel/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c
index 69f1751..7ae71a5 100644
--- a/product/kernel/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c
+++ b/product/kernel/drivers/gpu/arm/midgard/backend/gpu/mali_kbase_devfreq.c
@@ -165,7 +165,7 @@ static int kbase_devfreq_target(struct device *dev, unsigned long *target_freq,
 	for (i = 0; i < kbdev->nr_clocks; i++) {
 		if (kbdev->regulators[i] && kbdev->current_voltages[i] != volts[i] &&
 		    kbdev->current_freqs[i] < freqs[i]) {
-			err = regulator_set_voltage(kbdev->regulators[i], volts[i], volts[i]);
+			err = regulator_set_voltage(kbdev->regulators[i], volts[i], INT_MAX);
 			if (!err) {
 				kbdev->current_voltages[i] = volts[i];
 			} else {
@@ -199,7 +199,7 @@ static int kbase_devfreq_target(struct device *dev, unsigned long *target_freq,
 	for (i = 0; i < kbdev->nr_clocks; i++) {
 		if (kbdev->regulators[i] && kbdev->current_voltages[i] != volts[i] &&
 		    original_freqs[i] > freqs[i]) {
-			err = regulator_set_voltage(kbdev->regulators[i], volts[i], volts[i]);
+			err = regulator_set_voltage(kbdev->regulators[i], volts[i], INT_MAX);
 			if (!err) {
 				kbdev->current_voltages[i] = volts[i];
 			} else {
-- 
2.55.0

