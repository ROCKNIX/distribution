From a88471d50cb7d55e1c803050f596184aab630a08 Mon Sep 17 00:00:00 2001
From: Zhenyu Qi <qzydustin@hotmail.com>
Date: Sun, 4 Oct 2026 17:22:50 -0700
Subject: [PATCH] devfreq: add a PX30/RK3326 DMC driver

The DDR rate of the PX30 is changed by Rockchip's BL31: the kernel puts
the request into a page shared with the firmware and issues
ROCKCHIP_SIP_DRAM_FREQ. ROUND_RATE lets the firmware prepare the switch
to that rate and SET_RATE performs it; SET_RATE without the preceding
ROUND_RATE hangs the SoC. SET_RATE may return with the switch still
pending; the firmware then finishes from FIQ and raises the "complete"
interrupt, which is lost if it is only enabled around the switch, so it
stays enabled.

The firmware can also wait for the display's vertical blanking before
switching; that is not requested, as switching while the panel scans
showed no glitches.

The load comes from the DFI, whose PX30 registers match the RK3568
ones. The second shared page would carry DDR timings from the DT; it is
left empty so the loader's settings stay in effect. vdd_logic is shared
with the GPU, so only a minimum voltage is requested.
---
 drivers/devfreq/Kconfig              |  12 +
 drivers/devfreq/Makefile             |   1 +
 drivers/devfreq/event/rockchip-dfi.c |   1 +
 drivers/devfreq/px30_dmc.c           | 336 +++++++++++++++++++++++++++
 4 files changed, 350 insertions(+)
 create mode 100644 drivers/devfreq/px30_dmc.c

diff --git a/drivers/devfreq/Kconfig b/drivers/devfreq/Kconfig
index c999c4a1e..fe9ccaac1 100644
--- a/drivers/devfreq/Kconfig
+++ b/drivers/devfreq/Kconfig
@@ -140,6 +140,18 @@ config ARM_MEDIATEK_CCI_DEVFREQ
 	  buck voltages and update a proper CCI frequency. Use the notification
 	  to get the regulator status.
 
+config ARM_PX30_DMC_DEVFREQ
+	tristate "ARM PX30 DMC DEVFREQ Driver"
+	depends on (ARCH_ROCKCHIP && HAVE_ARM_SMCCC) || \
+		(COMPILE_TEST && HAVE_ARM_SMCCC)
+	select DEVFREQ_EVENT_ROCKCHIP_DFI
+	select DEVFREQ_GOV_SIMPLE_ONDEMAND
+	select PM_DEVFREQ_EVENT
+	select PM_OPP
+	help
+	  This adds the DEVFREQ driver for the PX30/RK3326 DMC (Dynamic Memory
+	  Controller). The DDR rate is changed by Rockchip's BL31 firmware.
+
 config ARM_RK3399_DMC_DEVFREQ
 	tristate "ARM RK3399 DMC DEVFREQ Driver"
 	depends on (ARCH_ROCKCHIP && HAVE_ARM_SMCCC) || \
diff --git a/drivers/devfreq/Makefile b/drivers/devfreq/Makefile
index 404179d79..388bd14b4 100644
--- a/drivers/devfreq/Makefile
+++ b/drivers/devfreq/Makefile
@@ -13,6 +13,7 @@ obj-$(CONFIG_ARM_HISI_UNCORE_DEVFREQ)	+= hisi_uncore_freq.o
 obj-$(CONFIG_ARM_IMX_BUS_DEVFREQ)	+= imx-bus.o
 obj-$(CONFIG_ARM_IMX8M_DDRC_DEVFREQ)	+= imx8m-ddrc.o
 obj-$(CONFIG_ARM_MEDIATEK_CCI_DEVFREQ)	+= mtk-cci-devfreq.o
+obj-$(CONFIG_ARM_PX30_DMC_DEVFREQ)	+= px30_dmc.o
 obj-$(CONFIG_ARM_RK3399_DMC_DEVFREQ)	+= rk3399_dmc.o
 obj-$(CONFIG_ARM_SUN8I_A33_MBUS_DEVFREQ)	+= sun8i-a33-mbus.o
 obj-$(CONFIG_ARM_TEGRA_DEVFREQ)		+= tegra30-devfreq.o
diff --git a/drivers/devfreq/event/rockchip-dfi.c b/drivers/devfreq/event/rockchip-dfi.c
index 5e6e7e900..57bc13a79 100644
--- a/drivers/devfreq/event/rockchip-dfi.c
+++ b/drivers/devfreq/event/rockchip-dfi.c
@@ -808,6 +808,7 @@ static int rk3588_dfi_init(struct rockchip_dfi *dfi)
 };
 
 static const struct of_device_id rockchip_dfi_id_match[] = {
+	{ .compatible = "rockchip,px30-dfi", .data = rk3568_dfi_init },
 	{ .compatible = "rockchip,rk3399-dfi", .data = rk3399_dfi_init },
