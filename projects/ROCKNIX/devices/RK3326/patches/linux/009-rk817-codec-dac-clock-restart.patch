--- a/sound/soc/codecs/rk817_codec.c	2026-05-27 18:10:55.771876379 +1200
+++ b/sound/soc/codecs/rk817_codec.c	2026-05-27 18:18:33.864894486 +1200
@@ -50,6 +50,30 @@
 	return 0;
 }
 
+/*
+ * Restart DAC digital clocks to synchronize the DAC with the PLL/I2S clock
+ * domains. Required after codec reset per Rockchip BSP kernel.
+ * Without this sequence the DAC does not process incoming I2S data.
+ */
+static void rk817_restart_dac(struct snd_soc_component *component)
+{
+	/* Power down DAC bias */
+	snd_soc_component_update_bits(component, RK817_CODEC_ADAC_CFG1,
+				      BIT(3), BIT(3));
+	usleep_range(500, 600);
+	/* Disable DAC digital clocks */
+	snd_soc_component_update_bits(component, RK817_CODEC_DTOP_DIGEN_CLKE,
+				      0x0f, 0x00);
+	usleep_range(500, 600);
+	/* Re-enable DAC digital clocks */
+	snd_soc_component_update_bits(component, RK817_CODEC_DTOP_DIGEN_CLKE,
+				      0x0f, 0x0f);
+	usleep_range(500, 600);
+	/* Re-enable DAC bias */
+	snd_soc_component_update_bits(component, RK817_CODEC_ADAC_CFG1,
+				      BIT(3), 0);
+}
+
 static int rk817_set_component_pll(struct snd_soc_component *component,
 		int pll_id, int source, unsigned int freq_in,
 		unsigned int freq_out)
@@ -429,6 +453,8 @@
 
 	snd_soc_component_set_pll(component, 0, 0, 0, 0);
 
+	rk817_restart_dac(component);
+
 	return 0;
 }
 
