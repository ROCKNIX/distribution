From a3fee4fde64eb3c1e6e4e215875a61d4e902696b Mon Sep 17 00:00:00 2001
From: sydarn <sydarn@proton.me>
Date: Wed, 21 Oct 2026 19:28:39 +0200
Subject: [PATCH] rk356x: set higher cpu opps to 6.12 level

---
 arch/arm64/boot/dts/rockchip/rk3566.dtsi | 6 +++---
 arch/arm64/boot/dts/rockchip/rk3568.dtsi | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/rk3566.dtsi b/arch/arm64/boot/dts/rockchip/rk3566.dtsi
index 3fcca79279f7..1c996b23da75 100644
--- a/arch/arm64/boot/dts/rockchip/rk3566.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3566.dtsi
@@ -34,19 +34,19 @@ opp-1104000000 {
 
 		opp-1416000000 {
 			opp-hz = /bits/ 64 <1416000000>;
-			opp-microvolt = <1025000 1025000 1150000>;
+			opp-microvolt = <900000 900000 1150000>;
 			clock-latency-ns = <40000>;
 		};
 
 		opp-1608000000 {
 			opp-hz = /bits/ 64 <1608000000>;
-			opp-microvolt = <1100000 1100000 1150000>;
+			opp-microvolt = <975000 975000 1150000>;
 			clock-latency-ns = <40000>;
 		};
 
 		opp-1800000000 {
 			opp-hz = /bits/ 64 <1800000000>;
-			opp-microvolt = <1150000 1150000 1150000>;
+			opp-microvolt = <1050000 1050000 1150000>;
 			clock-latency-ns = <40000>;
 		};
 	};
diff --git a/arch/arm64/boot/dts/rockchip/rk3568.dtsi b/arch/arm64/boot/dts/rockchip/rk3568.dtsi
index 3bc653f027f1..ccce81cc4c3b 100644
--- a/arch/arm64/boot/dts/rockchip/rk3568.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3568.dtsi
@@ -39,19 +39,19 @@ opp-1104000000 {
 
 		opp-1416000000 {
 			opp-hz = /bits/ 64 <1416000000>;
-			opp-microvolt = <1025000 1025000 1150000>;
+			opp-microvolt = <900000 900000 1150000>;
 			clock-latency-ns = <40000>;
 		};
 
 		opp-1608000000 {
 			opp-hz = /bits/ 64 <1608000000>;
-			opp-microvolt = <1100000 1100000 1150000>;
+			opp-microvolt = <975000 975000 1150000>;
 			clock-latency-ns = <40000>;
 		};
 
 		opp-1800000000 {
 			opp-hz = /bits/ 64 <1800000000>;
-			opp-microvolt = <1150000 1150000 1150000>;
+			opp-microvolt = <1050000 1050000 1150000>;
 			clock-latency-ns = <40000>;
 		};
 
-- 
2.54.0

