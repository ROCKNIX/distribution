From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ROCKNIX <noreply@rocknix.org>
Date: Mon, 01 Jan 2024 00:00:00 +0000
Subject: [PATCH] Input: Add Samsung SEC touchscreen driver

Ported from Radxa ROCK 4D linux-rockchip 6.1 BSP for the
1080x2160 MIPI panel (sec,sec_ts on i2c0). Changes vs vendor:
drop the 600KB built-in firmware blob in favour of optional
request_firmware via the firmware-name property, fix 7.0 APIs
(class_create, i2c probe, GPIOF, pinctrl include, unaligned.h,
remove dead fb notifier and asm includes).

Signed-off-by: ROCKNIX <noreply@rocknix.org>
---
diff --git a/drivers/input/touchscreen/Kconfig b/drivers/input/touchscreen/Kconfig
index 7d5b72e..e0ae74e 100644
--- a/drivers/input/touchscreen/Kconfig
+++ b/drivers/input/touchscreen/Kconfig
@@ -1424,4 +1424,14 @@ config TOUCHSCREEN_HIMAX_HX83112B
 	  To compile this driver as a module, choose M here: the
 	  module will be called himax_hx83112b.
 
+config TOUCHSCREEN_SEC_TS
+	tristate "Samsung SEC touchscreen"
+	depends on I2C
+	help
+	  Say Y here if you have a Samsung SEC touchscreen controller
+	  (Radxa ROCK 4D MIPI panel).
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called sec_ts.
+
 endif
diff --git a/drivers/input/touchscreen/Makefile b/drivers/input/touchscreen/Makefile
index ab9abd1..fe47cdb 100644
--- a/drivers/input/touchscreen/Makefile
+++ b/drivers/input/touchscreen/Makefile
@@ -120,3 +120,5 @@ obj-$(CONFIG_TOUCHSCREEN_IQS5XX)	+= iqs5xx.o
 obj-$(CONFIG_TOUCHSCREEN_IQS7211)	+= iqs7211.o
 obj-$(CONFIG_TOUCHSCREEN_ZINITIX)	+= zinitix.o
 obj-$(CONFIG_TOUCHSCREEN_HIMAX_HX83112B)	+= himax_hx83112b.o
+obj-$(CONFIG_TOUCHSCREEN_SEC_TS)	+= sec_ts.o
+sec_ts-objs := sec_ts_main.o sec_ts_fw.o sec_ts_fn.o sec_ts_selftest.o
