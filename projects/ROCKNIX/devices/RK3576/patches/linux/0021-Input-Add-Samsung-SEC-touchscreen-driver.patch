+static int sec_ts_flashread(struct sec_ts_data *ts, u32 mem_addr, u8 *mem_data,
+														u32 mem_size) {
+	int ret;
+
+	if ((mem_size == 0) || (mem_size > 128000))
+		return 0;
+
+	ret = sec_ts_flashlimitread(ts, mem_addr, mem_size, mem_data);
+	if (ret < 0) {
