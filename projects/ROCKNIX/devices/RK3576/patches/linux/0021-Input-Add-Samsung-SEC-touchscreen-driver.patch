+static void set_default_result(struct sec_ts_data *data) {
+	char delim = ':';
+
+	memset(data->cmd_result, 0x00, CMD_RESULT_STR_LEN);
+	memcpy(data->cmd_result, data->cmd, strnlen(data->cmd, CMD_STR_LEN));
+	strncat(data->cmd_result, &delim, 1);
+}
