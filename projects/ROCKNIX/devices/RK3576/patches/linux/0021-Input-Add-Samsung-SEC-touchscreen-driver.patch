+// 替换原有的 file_operations 定义
+static const struct proc_ops sec_ts_selftest_proc_ops = {
+    .proc_open = sec_ts_selftest_open,
+    .proc_read = seq_read,
+    .proc_lseek = seq_lseek,
+    .proc_release = seq_release,
