Subject: [PATCH] arm64: dts: rockchip: rk3562: Add display nodes

--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -204,6 +204,11 @@
 		interrupt-affinity = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>;
 	};
 
+	display_subsystem: display-subsystem {
+		compatible = "rockchip,display-subsystem";
+		ports = <&vop_out>;
+	};
+
 	firmware {
 		scmi: scmi {
 			compatible = "arm,scmi-smc";
@@ -808,6 +813,40 @@
 			status = "disabled";
 		};
 
+		vop: vop@ff400000 {
+			compatible = "rockchip,rk3562-vop";
+			reg = <0x0 0xff400000 0x0 0x2000>, <0x0 0xff405000 0x0 0x1000>;
+			reg-names = "vop", "gamma-lut";
+			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>, <&cru DCLK_VOP>;
+			clock-names = "aclk", "hclk", "dclk_vp0";
+			iommus = <&vop_mmu>;
+			power-domains = <&power RK3562_PD_VO>;
+			status = "disabled";
+
+			vop_out: ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				vp0: port@0 {
+					reg = <0>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+				};
+			};
+		};
+
+		vop_mmu: iommu@ff407e00 {
+			compatible = "rockchip,rk3568-iommu";
+			reg = <0x0 0xff407e00 0x0 0x100>;
+			interrupts = <GIC_SPI 135 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru ACLK_VOP>, <&cru HCLK_VOP>;
+			clock-names = "aclk", "iface";
+			#iommu-cells = <0>;
+			power-domains = <&power RK3562_PD_VO>;
+			status = "disabled";
+		};
+
 		spi1: spi@ff640000 {
 			compatible = "rockchip,rk3066-spi";
 			reg = <0x0 0xff640000 0x0 0x1000>;
@@ -1318,6 +1357,46 @@
 			#io-channel-cells = <1>;
 			status = "disabled";
 		};
+
+		dsi: dsi@ffb10000 {
+			compatible = "rockchip,rk3562-mipi-dsi", "snps,dw-mipi-dsi";
+			reg = <0x0 0xffb10000 0x0 0x10000>;
+			interrupts = <GIC_SPI 132 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cru PCLK_DSITX>;
+			clock-names = "pclk";
+			phys = <&dsi_dphy>;
+			phy-names = "dphy";
+			power-domains = <&power RK3562_PD_VO>;
+			resets = <&cru SRST_P_DSITX>;
+			reset-names = "apb";
+			rockchip,grf = <&sys_grf>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				dsi_in: port@0 {
+					reg = <0>;
+				};
+
+				dsi_out: port@1 {
+					reg = <1>;
+				};
+			};
+		};
+
+		dsi_dphy: phy@ffb20000 {
+			compatible = "rockchip,rk3562-dsi-dphy", "rockchip,rk3568-dsi-dphy";
+			reg = <0x0 0xffb20000 0x0 0x10000>;
+			clocks = <&cru CLK_MIPIDSIPHY_REF>, <&cru PCLK_DSIPHY>;
+			clock-names = "ref", "pclk";
+			#phy-cells = <0>;
+			power-domains = <&power RK3562_PD_VO>;
+			resets = <&cru SRST_P_DSIPHY>;
+			reset-names = "apb";
+			status = "disabled";
+		};
 	};
 };
 
