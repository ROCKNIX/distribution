Subject: [PATCH] arm64: dts: rockchip: rk3562: Add power domain clocks

--- a/arch/arm64/boot/dts/rockchip/rk3562.dtsi
+++ b/arch/arm64/boot/dts/rockchip/rk3562.dtsi
@@ -717,24 +717,34 @@
 
 				power-domain@RK3562_PD_GPU {
 					reg = <RK3562_PD_GPU>;
+					clocks = <&cru CLK_GPU>,
+						 <&cru ACLK_GPU_PRE>;
 					pm_qos = <&qos_gpu>;
 					#power-domain-cells = <0>;
 				};
 
 				power-domain@RK3562_PD_NPU {
 					reg = <RK3562_PD_NPU>;
+					clocks = <&cru ACLK_RKNN>,
+						 <&cru HCLK_RKNN>;
 					pm_qos = <&qos_npu>;
 					#power-domain-cells = <0>;
 				};
 
 				power-domain@RK3562_PD_VDPU {
 					reg = <RK3562_PD_VDPU>;
+					clocks = <&cru ACLK_RKVDEC>,
+						 <&cru HCLK_RKVDEC>;
 					pm_qos = <&qos_rkvdec>;
 					#power-domain-cells = <0>;
 				};
 
 				power-domain@RK3562_PD_VI {
 					reg = <RK3562_PD_VI>;
+					clocks = <&cru ACLK_ISP>,
+						 <&cru HCLK_ISP>,
+						 <&cru ACLK_VICAP>,
+						 <&cru HCLK_VICAP>;
 					pm_qos = <&qos_isp>,
 						 <&qos_vicap>;
 					#power-domain-cells = <1>;
@@ -743,6 +753,8 @@
 
 					power-domain@RK3562_PD_VEPU {
 						reg = <RK3562_PD_VEPU>;
+						clocks = <&cru ACLK_RKVENC>,
+							 <&cru HCLK_RKVENC>;
 						pm_qos = <&qos_vepu>;
 						#power-domain-cells = <0>;
 					};
@@ -750,6 +762,8 @@
 
 				power-domain@RK3562_PD_VO {
 					reg = <RK3562_PD_VO>;
+					clocks = <&cru ACLK_VOP>,
+						 <&cru HCLK_VOP>;
 					pm_qos = <&qos_vop>;
 					#power-domain-cells = <1>;
 					#address-cells = <1>;
@@ -757,6 +771,10 @@
 
 					power-domain@RK3562_PD_RGA {
 						reg = <RK3562_PD_RGA>;
+						clocks = <&cru ACLK_RGA>,
+							 <&cru HCLK_RGA>,
+							 <&cru ACLK_JDEC>,
+							 <&cru HCLK_JDEC>;
 						pm_qos = <&qos_rga_rd>,
 							 <&qos_rga_wr>,
 							 <&qos_jpeg>;
