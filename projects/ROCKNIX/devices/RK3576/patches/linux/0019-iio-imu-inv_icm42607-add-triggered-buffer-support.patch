 #include <linux/regmap.h>
@@ -42,6 +44,7 @@
 	INV_ICM42607_GYRO_SCAN_Y,
 	INV_ICM42607_GYRO_SCAN_Z,
 	INV_ICM42607_GYRO_SCAN_TEMP,
+	INV_ICM42607_GYRO_SCAN_TIMESTAMP,
 };
 
 static const struct iio_chan_spec_ext_info inv_icm42607_gyro_ext_infos[] = {
@@ -57,6 +60,7 @@
 	INV_ICM42607_GYRO_CHAN(IIO_MOD_Z, INV_ICM42607_GYRO_SCAN_Z,
 			       inv_icm42607_gyro_ext_infos),
 	INV_ICM42607_TEMP_CHAN(INV_ICM42607_GYRO_SCAN_TEMP),
+	IIO_CHAN_SOFT_TIMESTAMP(INV_ICM42607_GYRO_SCAN_TIMESTAMP),
 };
 
 static const int inv_icm42607_gyro_scale_nano[][2] = {
@@ -305,6 +309,13 @@
 	indio_dev->num_channels = ARRAY_SIZE(inv_icm42607_gyro_channels);
 	iio_device_set_drvdata(indio_dev, st);
 
+	ret = devm_iio_triggered_buffer_setup(dev, indio_dev,
+					      iio_pollfunc_store_time,
+					      inv_icm42607_trigger_handler,
+					      &inv_icm42607_buffer_ops);
+	if (ret)
+		return ERR_PTR(ret);
+
 	ret = devm_iio_device_register(dev, indio_dev);
 	if (ret)
 		return ERR_PTR(ret);
--- a/drivers/iio/imu/inv_icm42607/inv_icm42607.h
+++ b/drivers/iio/imu/inv_icm42607/inv_icm42607.h
@@ -7,6 +7,7 @@
 #define INV_ICM42607_H_
 
 #include <linux/bits.h>
+#include <linux/interrupt.h>
 #include <linux/iio/iio.h>
 #include <linux/mutex.h>
 #include <linux/pm.h>
@@ -393,6 +394,7 @@
 extern const struct inv_icm42607_hw inv_icm42607_hw_data;
 extern const struct inv_icm42607_hw inv_icm42607p_hw_data;
 extern const struct dev_pm_ops inv_icm42607_pm_ops;
+extern const struct iio_buffer_setup_ops inv_icm42607_buffer_ops;
 
 const struct iio_mount_matrix *
 inv_icm42607_get_mount_matrix(struct iio_dev *indio_dev,
@@ -410,6 +412,8 @@
 			     struct iio_chan_spec const *chan,
 			     s16 *val);
 
+irqreturn_t inv_icm42607_trigger_handler(int irq, void *p);
+
 int inv_icm42607_core_probe(struct regmap *regmap,
 			    const struct inv_icm42607_hw *hw,
 			    inv_icm42607_bus_setup bus_setup);
--- a/drivers/iio/imu/inv_icm42607/Kconfig
+++ b/drivers/iio/imu/inv_icm42607/Kconfig
@@ -3,6 +3,7 @@
 config INV_ICM42607
 	tristate
 	select IIO_BUFFER
+	select IIO_TRIGGERED_BUFFER
 	select IIO_INV_SENSORS_TIMESTAMP
 
 config INV_ICM42607_I2C
