+static void rk3562_vop2_setup_overlay(struct vop2_video_port *vp)
+{
+	struct vop2 *vop2 = vp->vop2;
+	struct drm_plane *plane;
+	u32 val;
+
+	vp->win_mask = 0;
+
+	drm_atomic_crtc_for_each_plane(plane, &vp->crtc) {
+		struct vop2_win *win = to_vop2_win(plane);
+		u32 id = win->data->layer_sel_id[vp->id];
+
+		vp->win_mask |= BIT(win->data->phys_id);
+
+		val = vop2_readl(vop2, RK3562_OVL_SYS_PORT_SEL_IMD);
+		val &= ~RK3562_OVL_SYS_PORT_SEL_IMD__ESMART(id);
+		vop2_writel(vop2, RK3562_OVL_SYS_PORT_SEL_IMD, val);
+
+		val = vop2_readl(vop2, RK3562_OVL_SYS_ESMART_CTRL(id));
+		val &= ~RK3562_OVL_SYS_ESMART_CTRL__DLY_NUM;
+		vop2_writel(vop2, RK3562_OVL_SYS_ESMART_CTRL(id), val);
+	}
+
+	if (!vp->win_mask)
+		return;
+
+	/* Each of the four Esmart windows gets a 2K line buffer */
+	val = vop2_readl(vop2, RK3568_LUT_PORT_SEL);
+	val |= RK3562_LUT_PORT_SEL__ESMART_LB_MODE;
+	vop2_writel(vop2, RK3568_LUT_PORT_SEL, val);
+
+	rk3576_vop2_setup_layer_mixer(vp);
+	vop2_setup_alpha(vp);
+}
+
