
/ {
	vcc3v3_lcd_n: vcc3v3-lcd0-n {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_lcd0_n";
		regulator-boot-on;
		enable-active-high;
		gpio = <&gpio2 RK_PB1 GPIO_ACTIVE_HIGH>;
		vin-supply = <&vcc_3v3_s0>;
	};
};

&dsi {
	status = "okay";
	dsi_panel: panel@0 {
		status = "okay";
		compatible = "simple-panel-dsi";
		reg = <0>;
		backlight = <&sgm37604_bl>;
		power-supply = <&vcc3v3_lcd_n>;
		reset-gpios = <&gpio0 RK_PD1 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&lcd_rst>;
		prepare-delay-ms = <40>;
		reset-delay-ms = <60>;
		init-delay-ms = <80>;
		stbyb-delay-ms = <20>;
		enable-delay-ms = <60>;
		disable-delay-ms = <20>;
		unprepare-delay-ms = <20>;
		width-mm = <135>;
		height-mm = <216>;
		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET | MIPI_DSI_CLOCK_NON_CONTINUOUS)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes  = <4>;
		panel-init-sequence = [
			05 78 01 11
			05 0A 01 29
		];

		panel-exit-sequence = [
			05 10 01 28
			05 78 01 10
		];

		disp_timings0: display-timings {
			native-mode = <&dsi_timing0>;
			dsi_timing0: timing0 {
				clock-frequency = <157000000>;
				hactive = <1080>;
				hfront-porch = <115>;
				hback-porch = <13>;
				hsync-len = <3>;
				vactive = <2160>;
				vfront-porch = <10>;
				vback-porch = <10>;
				vsync-len = <2>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			dsi_out_panel: endpoint {
				remote-endpoint = <&panel_in_dsi>;
			};
		};
	};
};

&dsi_in_vp1 {
	status = "okay";
};

&route_dsi {
	status = "okay";
	connect = <&vp1_out_dsi>;
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0m1_xfer>;

	sec_ts: sec_ts@48 {
		compatible = "sec,sec_ts";
		reg = <0x48>;
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&ts_irq>;
		sec,irq_gpio = <&gpio2 RK_PD5 GPIO_ACTIVE_LOW>;
		sec,max_coords = <1080>, <2160>;
	};

	sgm37604_bl: backlight@36 {
		compatible = "sgmicro,sgm37604a";
		reg = <0x36>;
		sgmicro,led-channels = <0x07>;  // bit0 for dev_en and bit1~bit4 for led_channel1~led_channel4
		sgmicro,max-current = <0>;      // 00->25ma 01->30ma 10->35ma 11->40ma
		default-brightness = <80>;
		enable-gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	touch {
		ts_irq: ts-irq {
			rockchip,pins = <2 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	dsi {
		lcd_rst: lcd-rst {
			rockchip,pins = <0 RK_PD1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};