// SPDX-License-Identifier: (GPL-2.0+ OR MIT)

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include <dt-bindings/soc/rockchip,vop2.h>
#include "rk3562.dtsi"

/ {
	model = "AISLPC Pocket AIS";
	compatible = "aislpc,pocket-ais", "rockchip,rk3562";

	aliases {
		mmc0 = &sdhci;
		mmc1 = &sdmmc0;
		serial0 = &uart0;
		serial1 = &uart1;
	};

	chosen: chosen {
		stdout-path = "serial0:1500000n8";
	};

	adc-joystick {
		compatible = "adc-joystick";
		#address-cells = <1>;
		io-channels = <&saradc0 2>, <&saradc0 3>, <&saradc1 1>,
			      <&saradc0 5>, <&saradc0 6>, <&saradc1 4>;
		poll-interval = <16>;
		#size-cells = <0>;

		axis@0 {
			reg = <0>;
			abs-flat = <32>;
			abs-fuzz = <16>;
			abs-range = <15 1010>;
			linux,code = <ABS_X>;
		};

		axis@1 {
			reg = <1>;
			abs-flat = <32>;
			abs-fuzz = <16>;
			abs-range = <15 1010>;
			linux,code = <ABS_Y>;
		};

		axis@2 {
			reg = <2>;
			abs-fuzz = <8>;
			abs-range = <460 125>;
			linux,code = <ABS_Z>;
		};

		axis@3 {
			reg = <3>;
			abs-flat = <32>;
			abs-fuzz = <16>;
			abs-range = <1010 15>;
			linux,code = <ABS_RX>;
		};

		axis@4 {
			reg = <4>;
			abs-flat = <32>;
			abs-fuzz = <16>;
			abs-range = <1010 15>;
			linux,code = <ABS_RY>;
		};

		axis@5 {
			reg = <5>;
			abs-fuzz = <8>;
			abs-range = <440 15>;
			linux,code = <ABS_RZ>;
		};
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc0 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <100>;

		button-vol-up {
			label = "volume up";
			linux,code = <KEY_VOLUMEUP>;
			press-threshold-microvolt = <17000>;
		};

		button-vol-down {
			label = "volume down";
			linux,code = <KEY_VOLUMEDOWN>;
			press-threshold-microvolt = <1200000>;
		};
	};

	adc-keys-dpad-down {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc1 3>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <20>;

		button {
			label = "DPAD-DOWN";
			linux,code = <BTN_DPAD_DOWN>;
			press-threshold-microvolt = <20000>;
		};
	};

	adc-keys-dpad-left {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc1 0>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <20>;

		button {
			label = "DPAD-LEFT";
			linux,code = <BTN_DPAD_LEFT>;
			press-threshold-microvolt = <20000>;
		};
	};

	adc-keys-dpad-right {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc1 2>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <20>;

		button {
			label = "DPAD-RIGHT";
			linux,code = <BTN_DPAD_RIGHT>;
			press-threshold-microvolt = <20000>;
		};
	};

	adc-keys-north {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc1 6>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <20>;

		button {
			label = "NORTH";
			linux,code = <BTN_NORTH>;
			press-threshold-microvolt = <20000>;
		};
	};

	adc-keys-south {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc1 5>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <20>;

		button {
			label = "SOUTH";
			linux,code = <BTN_SOUTH>;
			press-threshold-microvolt = <20000>;
		};
	};

	adc-keys-west {
		compatible = "adc-keys";
		io-channel-names = "buttons";
		io-channels = <&saradc1 7>;
		keyup-threshold-microvolt = <1800000>;
		poll-interval = <20>;

		button {
			label = "WEST";
			linux,code = <BTN_WEST>;
			press-threshold-microvolt = <20000>;
		};
	};

	spk_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpio3 RK_PC3 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&spk_amp_en>;
		pinctrl-names = "default";
		rocknix,enable-delay-ms = <100>;
		sound-name-prefix = "Speaker Amp";
		VCC-supply = <&vcc_sys>;
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		brightness-levels = <0 255>;
		default-brightness-level = <200>;
		num-interpolated-steps = <255>;
		power-supply = <&vcc_sys>;
		pwms = <&pwm5 0 25000 0>;
	};

	battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <3675000>;
		charge-term-current-microamp = <150000>;
		constant-charge-current-max-microamp = <2000000>;
		constant-charge-voltage-max-microvolt = <4350000>;
		factory-internal-resistance-micro-ohms = <107000>;
		voltage-max-design-microvolt = <4182000>;
		voltage-min-design-microvolt = <3500000>;

		ocv-capacity-celsius = <20>;
		ocv-capacity-table-0 =  <4182000 100>, <4103000 95>, <4057000 90>, <4041000 85>,
					<4036000 80>, <4029000 75>, <4007000 70>, <3969000 65>,
					<3931000 60>, <3912000 55>, <3896000 50>, <3865000 45>,
					<3843000 40>, <3821000 35>, <3794000 30>, <3755000 25>,
					<3703000 20>, <3648000 15>, <3596000 10>, <3549000 5>,
					<3500000 0>;
	};

	fan: pwm-fan {
		compatible = "pwm-fan";
		#cooling-cells = <2>;
		cooling-levels = <0 50 100 150 200 255>;
		fan-supply = <&vcc_fan>;
		interrupt-parent = <&gpio2>;
		interrupts = <RK_PA1 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-0 = <&fan_tach>;
		pinctrl-names = "default";
		pwms = <&pwm4 0 50000 0>;
	};

	gpio-keys-control {
		compatible = "gpio-keys";
		pinctrl-0 = <&btn_pins>;
		pinctrl-names = "default";

		button-back {
			gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
			label = "BACK";
			linux,code = <BTN_Z>;
		};

		button-dpad-up {
			gpios = <&gpio1 RK_PD0 GPIO_ACTIVE_LOW>;
			label = "DPAD-UP";
			linux,code = <BTN_DPAD_UP>;
		};

		button-east {
			gpios = <&gpio1 RK_PD6 GPIO_ACTIVE_LOW>;
			label = "EAST";
			linux,code = <BTN_EAST>;
		};

		button-home {
			gpios = <&gpio1 RK_PD4 GPIO_ACTIVE_LOW>;
			label = "HOME";
			linux,code = <BTN_MODE>;
		};

		button-l1 {
			gpios = <&gpio1 RK_PC7 GPIO_ACTIVE_LOW>;
			label = "L1";
			linux,code = <BTN_TL>;
		};

		button-r1 {
			gpios = <&gpio1 RK_PD5 GPIO_ACTIVE_LOW>;
			label = "R1";
			linux,code = <BTN_TR>;
		};

		button-select {
			gpios = <&gpio1 RK_PD3 GPIO_ACTIVE_LOW>;
			label = "SELECT";
			linux,code = <BTN_SELECT>;
		};

		button-start {
			gpios = <&gpio1 RK_PD7 GPIO_ACTIVE_LOW>;
			label = "START";
			linux,code = <BTN_START>;
		};

		button-thumbl {
			gpios = <&gpio0 RK_PC5 GPIO_ACTIVE_LOW>;
			label = "THUMBL";
			linux,code = <BTN_THUMBL>;
		};

		button-thumbr {
			gpios = <&gpio0 RK_PC6 GPIO_ACTIVE_LOW>;
			label = "THUMBR";
			linux,code = <BTN_THUMBR>;
		};
	};

	gpio-vibrator {
		compatible = "gpio-vibrator";
		enable-gpios = <&gpio3 RK_PA7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&vibrator_en>;
		pinctrl-names = "default";
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&charge_led_pins>;
		pinctrl-names = "default";

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			default-state = "on";
			function = LED_FUNCTION_POWER;
			gpios = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
		};

		led-1 {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_CHARGING;
			gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
		};
	};

	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk817 1>;
		clock-names = "ext_clock";
		pinctrl-0 = <&wifi_reg_on>;
		pinctrl-names = "default";
		post-power-on-delay-ms = <200>;
		reset-gpios = <&gpio0 RK_PB3 GPIO_ACTIVE_LOW>;
	};

	sound {
		compatible = "simple-audio-card";
		pinctrl-0 = <&hp_det>;
		pinctrl-names = "default";
		simple-audio-card,name = "rk817_ext";
		simple-audio-card,aux-devs = <&spk_amp>;
		simple-audio-card,format = "i2s";
		simple-audio-card,hp-det-gpios = <&gpio0 RK_PA7 GPIO_ACTIVE_HIGH>;
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,pin-switches = "Internal Speakers";
		simple-audio-card,routing =
			"MICL", "Mic Jack",
			"Headphones", "HPOL",
			"Headphones", "HPOR",
			"Internal Speakers", "Speaker Amp OUTL",
			"Internal Speakers", "Speaker Amp OUTR",
			"Speaker Amp INL", "HPOL",
			"Speaker Amp INR", "HPOR";
		simple-audio-card,widgets =
			"Microphone", "Mic Jack",
			"Headphone", "Headphones",
			"Speaker", "Internal Speakers";

		simple-audio-card,codec {
			sound-dai = <&rk817>;
		};

		simple-audio-card,cpu {
			sound-dai = <&sai0>;
		};
	};

	vcc_fan: regulator-vcc-fan {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&fan_en>;
		pinctrl-names = "default";
		regulator-name = "vcc_fan";
		vin-supply = <&vcc_sys>;
	};

	vcc_led: regulator-vcc-led {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PC7 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&led_en>;
		pinctrl-names = "default";
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "vcc_led";
		vin-supply = <&vcc_sys>;
	};

	vcc_sd: regulator-vcc-sd {
		compatible = "regulator-fixed";
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&vcc_sd_en>;
		pinctrl-names = "default";
		regulator-boot-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "vcc_sd";
		vin-supply = <&vcc_3v3>;
	};

	vcc_sys: regulator-vcc-sys {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <3800000>;
		regulator-min-microvolt = <3800000>;
		regulator-name = "vcc_sys";
	};

	vdd_gpu: regulator-vdd-gpu {
		compatible = "pwm-regulator";
		pwms = <&pwm7 0 5000 1>;
		pwm-supply = <&vcc_sys>;
		regulator-always-on;
		regulator-boot-on;
		regulator-max-microvolt = <1100000>;
		regulator-min-microvolt = <800000>;
		regulator-name = "vdd_gpu";
		regulator-settling-time-up-us = <250>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x0 0x8000000>;
			alignment = <0x0 0x400000>;
			linux,cma-default;
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_cpu>;
};

&cpu1 {
	cpu-supply = <&vdd_cpu>;
};

&cpu2 {
	cpu-supply = <&vdd_cpu>;
};

&cpu3 {
	cpu-supply = <&vdd_cpu>;
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "rocknix,generic-dsi";
		reg = <0>;
		backlight = <&backlight>;
		enable-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&lcd_en>, <&lcd_rst>;
		pinctrl-names = "default";
		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;

		panel_description =
			"G size=87,65 delays=20,20,20,120,20 format=rgb888 lanes=4 flags=0xa03",

			"M clock=61000 horizontal=1024,90,80,80 vertical=768,16,8,8 default=1",

			"I seq=ee01", "I seq=ea07", "I seq=eb12", "I seq=0a5e", "I seq=1314", "I seq=1735",
			"I seq=1d33", "I seq=2101", "I seq=2828", "I seq=2918", "I seq=2a63", "I seq=2ff3",
			"I seq=ee02", "I seq=39a9", "I seq=0000", "I seq=010d", "I seq=0212", "I seq=0308",
			"I seq=040e", "I seq=0530", "I seq=060b", "I seq=070e", "I seq=080f", "I seq=090e",
			"I seq=0a11", "I seq=0b4e", "I seq=0c14", "I seq=0d1a", "I seq=0e2f", "I seq=0f36",
			"I seq=103f", "I seq=2000", "I seq=210d", "I seq=2212", "I seq=2308", "I seq=240e",
			"I seq=2530", "I seq=260b", "I seq=270e", "I seq=280f", "I seq=290e", "I seq=2a11",
			"I seq=2b4e", "I seq=2c14", "I seq=2d1a", "I seq=2e2f", "I seq=2f36", "I seq=303f",
			"I seq=ee04", "I seq=0005", "I seq=0101", "I seq=0280", "I seq=0304", "I seq=0400",
			"I seq=0606", "I seq=0705", "I seq=081a", "I seq=0920", "I seq=0a0e", "I seq=0b00",
			"I seq=2040", "I seq=2408",
			"I seq=ee05", "I seq=0001", "I seq=0109", "I seq=0205", "I seq=0305", "I seq=0705",
			"I seq=080d", "I seq=0900", "I seq=0a12", "I seq=0b14", "I seq=0c66", "I seq=1003",
			"I seq=1107", "I seq=1205", "I seq=1305", "I seq=1912", "I seq=1af6", "I seq=4055",
			"I seq=4100", "I seq=4303", "I seq=4401", "I seq=4581", "I seq=4606", "I seq=4700",
			"I seq=ee06", "I seq=0045", "I seq=0201", "I seq=0488", "I seq=06cd", "I seq=08ef",
			"I seq=09cd", "I seq=0aab", "I seq=0b89", "I seq=0c67", "I seq=0d45", "I seq=0e23",
			"I seq=0f01",
			"I seq=ee07", "I seq=003c", "I seq=013c", "I seq=023c", "I seq=033c", "I seq=040d",
			"I seq=053c", "I seq=063c", "I seq=073c", "I seq=0808", "I seq=0910", "I seq=0a12",
			"I seq=0b14", "I seq=0c16", "I seq=0d18", "I seq=0e1a", "I seq=0f1c", "I seq=101e",
			"I seq=1104", "I seq=1200", "I seq=133c", "I seq=140c", "I seq=153c", "I seq=203c",
			"I seq=213c", "I seq=223c", "I seq=233c", "I seq=240d", "I seq=253c", "I seq=263c",
			"I seq=273c", "I seq=2808", "I seq=2911", "I seq=2a13", "I seq=2b15", "I seq=2c17",
			"I seq=2d19", "I seq=2e1b", "I seq=2f1d", "I seq=301f", "I seq=3105", "I seq=3201",
			"I seq=333c", "I seq=340c", "I seq=353c",
			"I seq=ee08", "I seq=1000", "I seq=12dc", "I seq=131c", "I seq=1723", "I seq=1820",
			"I seq=2080",
			"I seq=ee0f", "I seq=0001", "I seq=0100",
			"I seq=ee00", "I seq=ea00", "I seq=eb00", "I seq=3600",
			"I seq=11 wait=200",
			"I seq=29 wait=20";

		port {
			panel_in_dsi: endpoint {
				remote-endpoint = <&dsi_out_panel>;
			};
		};
	};
};

&dsi_dphy {
	status = "okay";
};

&dsi_in {
	dsi_in_vp0: endpoint {
		remote-endpoint = <&vp0_out_dsi>;
	};
};

&dsi_out {
	dsi_out_panel: endpoint {
		remote-endpoint = <&panel_in_dsi>;
	};
};

&gpu {
	clocks = <&scmi_clk CLK_GPU>;
	clock-names = "gpu";
	mali-supply = <&vdd_gpu>;
	resets = <&cru SRST_GPU>;
	status = "okay";
};

&i2c0 {
	status = "okay";

	rk817: pmic@20 {
		compatible = "rockchip,rk817";
		reg = <0x20>;
		#clock-cells = <1>;
		#sound-dai-cells = <0>;
		clock-names = "mclk";
		clock-output-names = "rk808-clkout1", "rk808-clkout2";
		clocks = <&cru MCLK_SAI0_TO_IO>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-0 = <&i2s0m0_mclk>, <&pmic_int>;
		pinctrl-names = "default";
		system-power-controller;
		wakeup-source;

		vcc1-supply = <&vcc_sys>;
		vcc2-supply = <&vcc_sys>;
		vcc3-supply = <&vcc_sys>;
		vcc4-supply = <&vcc_sys>;
		vcc5-supply = <&vcc_sys>;
		vcc6-supply = <&vcc_sys>;
		vcc7-supply = <&vcc_sys>;
		vcc8-supply = <&vcc_sys>;
		vcc9-supply = <&dcdc_boost>;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-max-microvolt = <1350000>;
				regulator-min-microvolt = <500000>;
				regulator-name = "vdd_logic";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vdd_cpu: DCDC_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-max-microvolt = <1350000>;
				regulator-min-microvolt = <500000>;
				regulator-name = "vdd_cpu";
				regulator-ramp-delay = <6001>;

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-name = "vcc_ddr";

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v3: DCDC_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-max-microvolt = <3300000>;
				regulator-min-microvolt = <3300000>;
				regulator-name = "vcc_3v3";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcca1v8_pmu: LDO_REG1 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <1800000>;
				regulator-min-microvolt = <1800000>;
				regulator-name = "vcca1v8_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1800000>;
				};
			};

			vdda_0v9: LDO_REG2 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <900000>;
				regulator-min-microvolt = <900000>;
				regulator-name = "vdda_0v9";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <900000>;
				regulator-min-microvolt = <900000>;
				regulator-name = "vdda0v9_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <900000>;
				};
			};

			vccio_acodec: LDO_REG4 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <3000000>;
				regulator-min-microvolt = <3000000>;
				regulator-name = "vccio_acodec";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <3300000>;
				regulator-min-microvolt = <1800000>;
				regulator-name = "vccio_sd";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <3300000>;
				regulator-min-microvolt = <3300000>;
				regulator-name = "vcc3v3_pmu";

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3000000>;
				};
			};

			vcc_1v8: LDO_REG7 {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <1800000>;
				regulator-min-microvolt = <1800000>;
				regulator-name = "vcc_1v8";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-max-microvolt = <1800000>;
				regulator-min-microvolt = <1800000>;
				regulator-name = "vcc1v8_dvp";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			vcc2v8_dvp: LDO_REG9 {
				regulator-max-microvolt = <2800000>;
				regulator-min-microvolt = <2800000>;
				regulator-name = "vcc2v8_dvp";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			dcdc_boost: BOOST {
				regulator-always-on;
				regulator-boot-on;
				regulator-max-microvolt = <5400000>;
				regulator-min-microvolt = <4700000>;
				regulator-name = "boost";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};

			otg_switch: OTG_SWITCH {
				regulator-name = "otg_switch";

				regulator-state-mem {
					regulator-off-in-suspend;
				};
			};
		};

		rk817_charger: charger {
			monitored-battery = <&battery>;
			rockchip,resistor-sense-micro-ohms = <10000>;
			rockchip,sleep-enter-current-microamp = <300000>;
			rockchip,sleep-filter-current-microamp = <100000>;
		};
	};
};

&pinctrl {
	audio {
		hp_det: hp-det {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		spk_amp_en: spk-amp-en {
			rockchip,pins = <3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	buttons {
		btn_pins: btn-pins {
			rockchip,pins = <0 RK_PC5 RK_FUNC_GPIO &pcfg_pull_up>,
					<0 RK_PC6 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PD0 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PD5 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PD6 RK_FUNC_GPIO &pcfg_pull_up>,
					<1 RK_PD7 RK_FUNC_GPIO &pcfg_pull_up>,
					<2 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		vibrator_en: vibrator-en {
			rockchip,pins = <3 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	fan {
		fan_en: fan-en {
			rockchip,pins = <3 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		fan_tach: fan-tach {
			rockchip,pins = <2 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	lcd {
		lcd_en: lcd-en {
			rockchip,pins = <0 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		lcd_rst: lcd-rst {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	leds {
		charge_led_pins: charge-led-pins {
			rockchip,pins = <3 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>,
					<3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		led_en: led-en {
			rockchip,pins = <0 RK_PC7 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		led_mcu_tx: led-mcu-tx {
			rockchip,pins = <1 RK_PD2 1 &pcfg_pull_up>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	wifi {
		wifi_reg_on: wifi-reg-on {
			rockchip,pins = <0 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	vcc-sd {
		vcc_sd_en: vcc-sd-en {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};

&pwm4 {
	pinctrl-0 = <&pwm4m1_pins>;
	status = "okay";
};

&pwm5 {
	status = "okay";
};

&pwm7 {
	status = "okay";
};

&sai0 {
	status = "okay";
};

&saradc0 {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&saradc1 {
	vref-supply = <&vcc_1v8>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	full-pwr-cycle-in-suspend;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	no-sd;
	no-sdio;
	non-removable;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;
	no-mmc;
	no-sdio;
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	pinctrl-names = "default";
	sd-uhs-sdr104;
	vmmc-supply = <&vcc_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&sdmmc1 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	no-mmc;
	no-sd;
	non-removable;
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_clk &sdmmc1_cmd>;
	pinctrl-names = "default";
	sd-uhs-sdr104;
	status = "okay";
};

&soc_thermal {
	trips {
		fan_trip0: fan-trip-0 {
			temperature = <50000>;
			hysteresis = <2000>;
			type = "active";
		};

		fan_trip1: fan-trip-1 {
			temperature = <55000>;
			hysteresis = <2000>;
			type = "active";
		};

		fan_trip2: fan-trip-2 {
			temperature = <60000>;
			hysteresis = <2000>;
			type = "active";
		};

		fan_trip3: fan-trip-3 {
			temperature = <65000>;
			hysteresis = <2000>;
			type = "active";
		};

		fan_trip4: fan-trip-4 {
			temperature = <70000>;
			hysteresis = <2000>;
			type = "active";
		};
	};

	cooling-maps {
		map1 {
			trip = <&fan_trip0>;
			cooling-device = <&fan 1 1>;
		};

		map2 {
			trip = <&fan_trip1>;
			cooling-device = <&fan 2 2>;
		};

		map3 {
			trip = <&fan_trip2>;
			cooling-device = <&fan 3 3>;
		};

		map4 {
			trip = <&fan_trip3>;
			cooling-device = <&fan 4 4>;
		};

		map5 {
			trip = <&fan_trip4>;
			cooling-device = <&fan 5 5>;
		};
	};
};

&tsadc {
	status = "okay";
};

&u2phy {
	status = "okay";
};

&u2phy_otg {
	status = "okay";
};

&uart0 {
	pinctrl-0 = <&uart0m0_xfer>;
	pinctrl-names = "default";
	status = "okay";
};

&uart1 {
	pinctrl-0 = <&led_mcu_tx>;
	pinctrl-names = "default";
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	snps,dis_u2_susphy_quirk;
	snps,usb2-lpm-disable;
	status = "okay";
};

&vop {
	assigned-clocks = <&cru PLL_VPLL>, <&cru DCLK_VOP>;
	assigned-clock-parents = <0>, <&cru PLL_VPLL>;
	assigned-clock-rates = <1464000000>, <0>;
	status = "okay";
};

&vop_mmu {
	status = "okay";
};

&vp0 {
	vp0_out_dsi: endpoint@ROCKCHIP_VOP2_EP_MIPI0 {
		reg = <ROCKCHIP_VOP2_EP_MIPI0>;
		remote-endpoint = <&dsi_in_vp0>;
	};
};
