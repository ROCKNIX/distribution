From: Jacob Cook <jacobmcook1984@gmail.com>
Subject: [PATCH] arm64: dts: qcom: sdm845-ayn-odin: don't autorepeat Volume Up

Held, it repeats far too fast in the ROCKNIX menus.
---
diff --git a/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi
index cd67aeaab..06c787f03 100644
--- a/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi
@@ -35,7 +35,6 @@ chosen {
 
 	gpio-keys {
 		compatible = "gpio-keys";
-		autorepeat;
 
 		pinctrl-names = "default";
 		pinctrl-0 = <&volume_up_gpio>;
