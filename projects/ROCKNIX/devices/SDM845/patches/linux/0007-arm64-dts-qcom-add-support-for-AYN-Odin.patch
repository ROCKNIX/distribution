From f2434a25106df823e28f38e2d72ae5a972842c89 Mon Sep 17 00:00:00 2001
From: Anton Bambura <jenneron@protonmail.com>
Date: Thu, 16 Jun 2022 01:41:06 +0700
Subject: [PATCH] arm64: dts: qcom: add support for AYN Odin

Add device-trees for SDM845-based AYN Odin M0 and M2.

Based on initial implementation by Teguh Sobirin, extensively
reworked and extended since 2022.

TODO: Rename sdm845-ayn-odin to sdm845-ayn-odin-m0, sync with
pmaports changes

TODO: Ask Teguh Sobirin whether it is fine to arrange authorships
this way.

Co-developed-by: Teguh Sobirin <teguh@sobir.in>
Signed-off-by: Teguh Sobirin <teguh@sobir.in>
Signed-off-by: Anton Bambura <jenneron@protonmail.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |    2 +
 .../boot/dts/qcom/sdm845-ayn-odin-common.dtsi | 1485 +++++++++++++++++
 .../boot/dts/qcom/sdm845-ayn-odin-m0.dts      |   57 +
 .../boot/dts/qcom/sdm845-ayn-odin-m2.dts      |   57 +
 arch/arm64/boot/dts/qcom/sdm845.dtsi          |   26 +-
 5 files changed, 1614 insertions(+), 13 deletions(-)
 create mode 100644 arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi
 create mode 100644 arch/arm64/boot/dts/qcom/sdm845-ayn-odin-m0.dts
 create mode 100644 arch/arm64/boot/dts/qcom/sdm845-ayn-odin-m2.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index 557be6fd56d7..4561f1c3c806 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -303,6 +303,8 @@ dtb-$(CONFIG_ARCH_QCOM)	+= sdm632-motorola-ocean.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm636-sony-xperia-ganges-mermaid.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm660-xiaomi-lavender.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm670-google-sargo.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sdm845-ayn-odin-m0.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= sdm845-ayn-odin-m2.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= sdm845-db845c.dtb
 
 sdm845-db845c-navigation-mezzanine-dtbs	:= sdm845-db845c.dtb sdm845-db845c-navigation-mezzanine.dtbo
diff --git a/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi b/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi
new file mode 100644
index 000000000000..cd67aeaabae0
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sdm845-ayn-odin-common.dtsi
@@ -0,0 +1,1485 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2022, Teguh Sobirin.
+ * Copyright (c) 2024, Anton Bambura.
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
+#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
+#include <dt-bindings/sound/qcom,q6afe.h>
+#include <dt-bindings/sound/qcom,q6asm.h>
+
+#include "sdm845.dtsi"
+#include "sdm845-wcd9340.dtsi"
+#include "pm8998.dtsi"
+#include "pmi8998.dtsi"
+
+/ {
+	model = "AYN Odin";
+	compatible = "ayn,odin", "qcom,sdm845";
+	qcom,msm-id = <321 0x20001>;
+	qcom,board-id = <8 0>;
+	chassis-type = "tablet";
+
+	aliases {
+		serial0 = &uart9;
+		hsuart0 = &uart6;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+		autorepeat;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&volume_up_gpio>;
+
+		key-volume-up {
+			label = "Volume Up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&pm8998_gpios 6 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	led-controller {
+		compatible = "gpio-leds";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&side_leds_active>;
+
+		led-left {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_BACKLIGHT;
+			function-enumerator = <1>;
+			gpios = <&tlmm 129 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led-right {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_BACKLIGHT;
+			function-enumerator = <2>;
+			gpios = <&tlmm 87 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led-left-stick {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_BACKLIGHT;
+			function-enumerator = <3>;
+			gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led-right-stick {
+			color = <LED_COLOR_ID_BLUE>;
+			function = LED_FUNCTION_BACKLIGHT;
+			function-enumerator = <4>;
+			gpios = <&tlmm 7 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	adc-joystick {
+		compatible = "adc-joystick";
+		io-channels = <&pm8998_adc ADC5_GPIO3>,
+			      <&pm8998_adc ADC5_GPIO2>,
+			      <&pm8998_adc ADC5_GPIO1>,
+			      <&pm8998_adc ADC5_GPIO5>,
+			      <&pm8998_adc ADC5_GPIO6_DIV3>,
+			      <&pm8998_adc ADC5_GPIO4>;
+		poll-interval = <10>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		axis@0 {
+			reg = <0>;
+			linux,code = <ABS_X>;
+			/* Stick neutral is near 850 mV, not ADC mid-scale. */
+			abs-range = <250000 1450000>;
+			abs-fuzz = <3000>;
+			abs-flat = <20000>;
+		};
+
+		axis@1 {
+			reg = <1>;
+			linux,code = <ABS_Y>;
+			abs-range = <1450000 250000>;
+			abs-fuzz = <3000>;
+			abs-flat = <20000>;
+		};
+
+		axis@2 {
+			reg = <2>;
+			linux,code = <ABS_Z>;
+			abs-range = <1425000 825000>;
+			abs-fuzz = <3000>;
+			abs-flat = <90000>;
+		};
+
+		axis@3 {
+			reg = <3>;
+			linux,code = <ABS_RX>;
+			abs-range = <1450000 250000>;
+			abs-fuzz = <3000>;
+			abs-flat = <20000>;
+		};
+
+		axis@4 {
+			reg = <4>;
+			linux,code = <ABS_RY>;
+			abs-range = <1450000 250000>;
+			abs-fuzz = <3000>;
+			abs-flat = <20000>;
+		};
+
+		axis@5 {
+			reg = <5>;
+			linux,code = <ABS_RZ>;
+			abs-range = <1425000 825000>;
+			abs-fuzz = <3000>;
+			abs-flat = <90000>;
+		};
+	};
+
+	gpio-keys-gamepad {
+		compatible = "gpio-keys";
+		label = "AYN Odin Gamepad Buttons";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&btn_pins &btn_en_active>;
+
+		button-east {
+			gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
+			label = "East";
+			linux,code = <BTN_EAST>;
+		};
+
+		button-south {
+			gpios = <&tlmm 95 GPIO_ACTIVE_LOW>;
+			label = "South";
+			linux,code = <BTN_SOUTH>;
+		};
+
+		button-west {
+			gpios = <&tlmm 41 GPIO_ACTIVE_LOW>;
+			label = "West";
+			linux,code = <BTN_WEST>;
+		};
+
+		button-north {
+			gpios = <&tlmm 92 GPIO_ACTIVE_LOW>;
+			label = "North";
+			linux,code = <BTN_NORTH>;
+		};
+
+		button-left-shoulder {
+			gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
+			label = "Left Shoulder";
+			linux,code = <BTN_TL>;
+		};
+
+		button-right-shoulder {
+			gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;
+			label = "Right Shoulder";
+			linux,code = <BTN_TR>;
+		};
+
+		button-select {
+			gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;
+			label = "Select";
+			linux,code = <BTN_SELECT>;
+		};
+
+		button-start {
+			gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
+			label = "Start";
+			linux,code = <BTN_START>;
+		};
+
+		button-left-stick {
+			gpios = <&tlmm 40 GPIO_ACTIVE_LOW>;
+			label = "Left Stick";
+			linux,code = <BTN_THUMBL>;
+		};
+
+		button-right-stick {
+			gpios = <&tlmm 22 GPIO_ACTIVE_LOW>;
+			label = "Right Stick";
+			linux,code = <BTN_THUMBR>;
+		};
+
+		button-dpad-up {
+			gpios = <&tlmm 124 GPIO_ACTIVE_LOW>;
+			label = "D-pad Up";
+			linux,code = <BTN_DPAD_UP>;
+		};
+
+		button-dpad-down {
+			gpios = <&tlmm 128 GPIO_ACTIVE_LOW>;
+			label = "D-pad Down";
+			linux,code = <BTN_DPAD_DOWN>;
+		};
+
+		button-dpad-left {
+			gpios = <&tlmm 52 GPIO_ACTIVE_LOW>;
+			label = "D-pad Left";
+			linux,code = <BTN_DPAD_LEFT>;
+		};
+
+		button-dpad-right {
+			gpios = <&tlmm 122 GPIO_ACTIVE_LOW>;
+			label = "D-pad Right";
+			linux,code = <BTN_DPAD_RIGHT>;
+		};
+
+		button-mode {
+			gpios = <&tlmm 49 GPIO_ACTIVE_LOW>;
+			label = "Mode";
+			linux,code = <BTN_MODE>;
+		};
+
+		button-right-paddle {
+			gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+			label = "Right Paddle";
+			linux,code = <BTN_TRIGGER_HAPPY5>;
+		};
+
+		button-left-paddle {
+			gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+			label = "Left Paddle";
+			linux,code = <BTN_TRIGGER_HAPPY7>;
+		};
+	};
+
+	battery: battery {
+		compatible = "simple-battery";
+
+		charge-full-design-microamp-hours = <3850000>;
+		voltage-min-design-microvolt = <3600000>;
+		voltage-max-design-microvolt = <4400000>;
+	};
+
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		#cooling-cells = <2>;
+
+		pwms = <&pmi8998_lpg 1 200000>;
+		fan-supply = <&fan_pwr>;
+		interrupts-extended = <&tlmm 30 IRQ_TYPE_EDGE_RISING>;
+		pulses-per-revolution = <2>;
+
+		pwm-inverted;
+		initial-pwm = <0>;
+		fan-supply-off-on-zero;
+		cooling-levels = <0 80 96 128 160 200 255>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fan_tach_active &pwm_fan_active>;
+	};
+
+	connector {
+		compatible = "hdmi-connector";
+
+		label = "hdmi";
+		type = "d";
+
+		hdmi-pwr-supply = <&hdmi_en_reg>;
+		hpd-gpios = <&tlmm 121 GPIO_ACTIVE_HIGH>;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&hdmi_hpd>;
+
+		port {
+			hdmi_con: endpoint {
+				remote-endpoint = <&lt8912b_out>;
+			};
+		};
+	};
+
+	hdmi_en_reg: hdmi-en-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "hdmi_en";
+
+		gpio = <&tlmm 13 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+	};
+
+	fan_pwr: fan-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "fan_pwr";
+
+		gpio = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&fan_en_active>;
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+	};
+
+	vreg_s4a_1p8: pm8998-smps4 {
+		compatible = "regulator-fixed";
+		regulator-name = "vreg_s4a_1p8";
+
+		regulator-min-microvolt = <1800000>;
+		regulator-max-microvolt = <1800000>;
+
+		regulator-always-on;
+		regulator-boot-on;
+
+		vin-supply = <&vph_pwr>;
+	};
+};
+
+&cpu0_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu0_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu1_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu1_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu2_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu2_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu3_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu3_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu4_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu4_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu5_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu5_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu6_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu6_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu7_alert0 {
+	temperature = <78000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+&cpu7_alert1 {
+	temperature = <82000>;
+	hysteresis = <5000>;
+	type = "active";
+};
+
+/*
+ * Keep the fan off for idle and light loads, then use active cooling before
+ * performance throttling: Fan trips start quietly at 78 C and ramp harder at 82 C.
+ */
+&cpu0_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu0_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu0_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu1_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu1_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu1_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu2_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu2_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu2_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu3_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu3_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu3_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu4_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu4_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu4_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu5_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu5_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu5_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu6_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu6_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu6_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&cpu7_thermal {
+	cooling-maps {
+		map0 {
+			trip = <&cpu7_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		map1 {
+			trip = <&cpu7_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&gpu_top_thermal {
+	trips {
+		gpu_top_fan_alert0: fan-alert0 {
+			temperature = <78000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		gpu_top_fan_alert1: fan-alert1 {
+			temperature = <82000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+	};
+
+	cooling-maps {
+		fan-map0 {
+			trip = <&gpu_top_fan_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		fan-map1 {
+			trip = <&gpu_top_fan_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&gpu_bottom_thermal {
+	trips {
+		gpu_bottom_fan_alert0: fan-alert0 {
+			temperature = <78000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+
+		gpu_bottom_fan_alert1: fan-alert1 {
+			temperature = <82000>;
+			hysteresis = <5000>;
+			type = "active";
+		};
+	};
+
+	cooling-maps {
+		fan-map0 {
+			trip = <&gpu_bottom_fan_alert0>;
+			cooling-device = <&fan 0 1>;
+		};
+
+		fan-map1 {
+			trip = <&gpu_bottom_fan_alert1>;
+			cooling-device = <&fan 0 3>;
+		};
+	};
+};
+
+&adsp_pas {
+	status = "okay";
+	firmware-name = "qcom/sdm845/adsp.mbn";
+};
+
+&apps_rsc {
+	pm8998-rpmh-regulators {
+		compatible = "qcom,pm8998-rpmh-regulators";
+		qcom,pmic-id = "a";
+
+		vdd-s1-supply = <&vph_pwr>;
+		vdd-s2-supply = <&vph_pwr>;
+		vdd-s3-supply = <&vph_pwr>;
+		vdd-s4-supply = <&vph_pwr>;
+		vdd-s5-supply = <&vph_pwr>;
+		vdd-s6-supply = <&vph_pwr>;
+		vdd-s7-supply = <&vph_pwr>;
+		vdd-s8-supply = <&vph_pwr>;
+		vdd-s9-supply = <&vph_pwr>;
+		vdd-s10-supply = <&vph_pwr>;
+		vdd-s11-supply = <&vph_pwr>;
+		vdd-s12-supply = <&vph_pwr>;
+		vdd-s13-supply = <&vph_pwr>;
+		vdd-l1-l27-supply = <&vreg_s7a_1p025>;
+		vdd-l2-l8-l17-supply = <&vreg_s3a_1p35>;
+		vdd-l3-l11-supply = <&vreg_s7a_1p025>;
+		vdd-l4-l5-supply = <&vreg_s7a_1p025>;
+		vdd-l6-supply = <&vph_pwr>;
+		vdd-l7-l12-l14-l15-supply = <&vreg_s5a_2p04>;
+		vdd-l9-supply = <&vreg_bob>;
+		vdd-l10-l23-l25-supply = <&vreg_bob>;
+		vdd-l13-l19-l21-supply = <&vreg_bob>;
+		vdd-l16-l28-supply = <&vreg_bob>;
+		vdd-l18-l22-supply = <&vreg_bob>;
+		vdd-l20-l24-supply = <&vreg_bob>;
+		vdd-l26-supply = <&vreg_s3a_1p35>;
+		vin-lvs-1-2-supply = <&vreg_s4a_1p8>;
