From 1fc778a2583dab89aa03f7a0630df105a89a7135 Mon Sep 17 00:00:00 2001
From: Anton Bambura <jenneron@protonmail.com>
Date: Sat, 29 Aug 2026 16:38:45 +0300
Subject: [PATCH] input: adc-joystick: support IIO_CHAN_INFO_PROCESSED

This is required to use with qcom adc
---
 drivers/input/joystick/adc-joystick.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/input/joystick/adc-joystick.c b/drivers/input/joystick/adc-joystick.c
index ff44f9978b71..932a0df8def7 100644
--- a/drivers/input/joystick/adc-joystick.c
+++ b/drivers/input/joystick/adc-joystick.c
@@ -41,7 +41,13 @@ static void adc_joystick_poll(struct input_dev *input)
 	int i, val, ret;
 
 	for (i = 0; i < joy->num_chans; i++) {
-		ret = iio_read_channel_raw(&joy->chans[i], &val);
+		struct iio_channel *chan = &joy->chans[i];
+
+		if (iio_channel_has_info(chan->channel, IIO_CHAN_INFO_RAW))
+			ret = iio_read_channel_raw(chan, &val);
+		else
+			ret = iio_read_channel_processed(chan, &val);
+
 		if (ret < 0)
 			return;
 		if (joy->axes[i].inverted)
