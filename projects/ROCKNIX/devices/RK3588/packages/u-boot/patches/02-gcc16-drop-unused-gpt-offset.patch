gcc 16 promotes -Wunused-but-set-variable and u-boot builds -Werror:

  cmd/gpt.c:386:18: error: variable 'offset' set but not used

set_gpt_info() accumulates offset once per partition and never reads
it. Delete the accumulator rather than annotate it - nothing else in
the file refers to it.

--- a/cmd/gpt.c
+++ b/cmd/gpt.c
@@ -383,7 +383,6 @@
 	disk_partition_t *parts;
 	int errno = 0;
 	uint64_t size_ll, start_ll;
-	lbaint_t offset = 0;
 	int max_str_part = calc_parts_list_len(MAX_SEARCH_PARTITIONS);
 
 	debug("%s:  lba num: 0x%x %d\n", __func__,
@@ -530,8 +529,6 @@
 			free(val);
 		}
 
-		offset += parts[i].size + parts[i].start;
-
 		/* bootable */
 		if (found_key(tok, "bootable"))
 			parts[i].bootable = 1;
