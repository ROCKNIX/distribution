From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] interconnect: qcom: add SM6450 driver

---
diff -Nur a/drivers/interconnect/qcom/Kconfig b/drivers/interconnect/qcom/Kconfig
--- a/drivers/interconnect/qcom/Kconfig	2026-09-26 19:28:32
+++ b/drivers/interconnect/qcom/Kconfig	2026-09-26 19:28:32
@@ -358,6 +358,16 @@
 	  This is a driver for the Qualcomm Network-on-Chip on sm6350-based
 	  platforms.
 
+config INTERCONNECT_QCOM_SM6450
+	tristate "Qualcomm SM6450 interconnect driver"
+	depends on INTERCONNECT_QCOM_RPMH_POSSIBLE
+	depends on ARM64 || COMPILE_TEST
+	select INTERCONNECT_QCOM_RPMH
+	select INTERCONNECT_QCOM_BCM_VOTER
+	help
+	  This is a driver for the Qualcomm Network-on-Chip on SM6450-based
+	  platforms.
+
 config INTERCONNECT_QCOM_SM7150
 	tristate "Qualcomm SM7150 interconnect driver"
 	depends on INTERCONNECT_QCOM_RPMH_POSSIBLE
diff -Nur a/drivers/interconnect/qcom/Makefile b/drivers/interconnect/qcom/Makefile
--- a/drivers/interconnect/qcom/Makefile	2026-09-26 19:28:32
+++ b/drivers/interconnect/qcom/Makefile	2026-09-26 19:28:32
@@ -40,6 +40,7 @@
 qnoc-shikra-objs			:= shikra.o
 qnoc-sm6115-objs			:= sm6115.o
 qnoc-sm6350-objs			:= sm6350.o
+qnoc-sm6450-objs			:= sm6450.o
 qnoc-sm7150-objs			:= sm7150.o
 qnoc-sm8150-objs			:= sm8150.o
 qnoc-sm8250-objs			:= sm8250.o
@@ -88,6 +89,7 @@
 obj-$(CONFIG_INTERCONNECT_QCOM_SHIKRA) += qnoc-shikra.o
 obj-$(CONFIG_INTERCONNECT_QCOM_SM6115) += qnoc-sm6115.o
 obj-$(CONFIG_INTERCONNECT_QCOM_SM6350) += qnoc-sm6350.o
+obj-$(CONFIG_INTERCONNECT_QCOM_SM6450) += qnoc-sm6450.o
 obj-$(CONFIG_INTERCONNECT_QCOM_SM7150) += qnoc-sm7150.o
 obj-$(CONFIG_INTERCONNECT_QCOM_SM8150) += qnoc-sm8150.o
 obj-$(CONFIG_INTERCONNECT_QCOM_SM8250) += qnoc-sm8250.o
