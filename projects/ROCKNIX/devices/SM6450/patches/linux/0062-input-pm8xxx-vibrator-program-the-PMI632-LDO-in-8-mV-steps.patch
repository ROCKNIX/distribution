From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] input: pm8xxx-vibrator: program the PMI632 LDO in 8 mV steps

The PMI632-style vibrator LDO takes its level as a 12-bit count of 8 mV
steps split over VSET_LB and VSET_UB. Scale the level into steps and 
move the upper bits down into VSET_UB.

---
--- a/drivers/input/misc/pm8xxx-vibrator.c
+++ b/drivers/input/misc/pm8xxx-vibrator.c
@@ -61,7 +61,7 @@
 	.drv2_mask = GENMASK(3, 0),
 	.drv2_shift = 8,
 	.drv_en_manual_mask = 0,
-	.drv_in_step = false,
+	.drv_in_step = true,
 };
 
 /**
@@ -119,7 +119,7 @@
 	vib->reg_vib_drv = val;
 
 	if (regs->drv2_mask) {
-		val = vib->level << regs->drv2_shift;
+		val = vib->level >> regs->drv2_shift;
 		rc = regmap_write_bits(vib->regmap, vib->drv2_addr,
 				regs->drv2_mask, on ? val : 0);
 		if (rc < 0)
