From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] pinctrl: qcom: add SM6450 TLMM driver

acmeplus's "pinctrl: qcom: add the Parrot TLMM driver" did the first
conversion of the same table.

Co-developed-by: acmeplus <acmeplus@users.noreply.github.com>
---
diff -Nur a/drivers/pinctrl/qcom/Kconfig.msm b/drivers/pinctrl/qcom/Kconfig.msm
--- a/drivers/pinctrl/qcom/Kconfig.msm	2026-09-26 19:34:15
+++ b/drivers/pinctrl/qcom/Kconfig.msm	2026-09-26 19:34:15
@@ -452,6 +452,15 @@
 	 Qualcomm Technologies Inc TLMM block found on the Qualcomm
 	 Technologies Inc SM4450 platform.
 
+config PINCTRL_SM6450
+	tristate "Qualcomm SM6450 pin controller driver"
+	depends on ARM64 || COMPILE_TEST
+	default ARCH_QCOM
+	help
+	 This is the pinctrl, pinmux, pinconf and gpiolib driver for the
+	 Qualcomm Technologies Inc TLMM block found on the Qualcomm
+	 Technologies Inc SM6450 platform.
+
 config PINCTRL_SM6115
 	tristate "Qualcomm SM6115,SM4250 pin controller driver"
 	depends on ARM64 || COMPILE_TEST
diff -Nur a/drivers/pinctrl/qcom/Makefile b/drivers/pinctrl/qcom/Makefile
--- a/drivers/pinctrl/qcom/Makefile	2026-09-26 19:34:15
+++ b/drivers/pinctrl/qcom/Makefile	2026-09-26 19:34:15
@@ -62,6 +62,7 @@
 obj-$(CONFIG_PINCTRL_SHIKRA) += pinctrl-shikra.o
 obj-$(CONFIG_PINCTRL_SM4250_LPASS_LPI) += pinctrl-sm4250-lpass-lpi.o
 obj-$(CONFIG_PINCTRL_SM4450) += pinctrl-sm4450.o
+obj-$(CONFIG_PINCTRL_SM6450) += pinctrl-sm6450.o
 obj-$(CONFIG_PINCTRL_SM6115) += pinctrl-sm6115.o
 obj-$(CONFIG_PINCTRL_SM6115_LPASS_LPI) += pinctrl-sm6115-lpass-lpi.o
 obj-$(CONFIG_PINCTRL_SM6125) += pinctrl-sm6125.o
