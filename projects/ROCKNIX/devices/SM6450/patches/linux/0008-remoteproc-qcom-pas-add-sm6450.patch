From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] remoteproc: qcom: pas: add SM6450 ADSP, CDSP and WPSS

---
diff -Nur a/drivers/remoteproc/qcom_q6v5_pas.c b/drivers/remoteproc/qcom_q6v5_pas.c
--- a/drivers/remoteproc/qcom_q6v5_pas.c	2026-09-26 19:28:31
+++ b/drivers/remoteproc/qcom_q6v5_pas.c	2026-09-26 19:28:31
@@ -1437,6 +1437,57 @@
 	.region_assign_vmid = QCOM_SCM_VMID_MSS_MSA,
 };
 
+static const struct qcom_pas_data sm6450_adsp_resource = {
+	.crash_reason_smem = 423,
+	.firmware_name = "adsp.mbn",
+	.pas_id = 1,
+	.minidump_id = 5,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"lcx",
+		"lmx",
+		NULL
+	},
+	.load_state = "adsp",
+	.ssr_name = "lpass",
+	.sysmon_name = "adsp",
+	.ssctl_id = 0x14,
+};
+
+static const struct qcom_pas_data sm6450_cdsp_resource = {
+	.crash_reason_smem = 601,
+	.firmware_name = "cdsp.mbn",
+	.pas_id = 18,
+	.minidump_id = 7,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"cx",
+		"mx",
+		NULL
+	},
+	.load_state = "cdsp",
+	.ssr_name = "cdsp",
+	.sysmon_name = "cdsp",
+	.ssctl_id = 0x17,
+};
+
+static const struct qcom_pas_data sm6450_wpss_resource = {
+	.crash_reason_smem = 626,
+	.firmware_name = "wpss.mbn",
+	.pas_id = 6,
+	.minidump_id = 4,
+	.auto_boot = true,
+	.proxy_pd_names = (char*[]){
+		"cx",
+		"mx",
+		NULL
+	},
+	.load_state = "wpss",
+	.ssr_name = "wpss",
+	.sysmon_name = "wpss",
+	.ssctl_id = 0x19,
+};
+
 static const struct qcom_pas_data sc7280_wpss_resource = {
 	.crash_reason_smem = 626,
 	.firmware_name = "wpss.mdt",
@@ -1622,6 +1673,9 @@
 	{ .compatible = "qcom,sm6350-adsp-pas", .data = &sm6350_adsp_resource },
 	{ .compatible = "qcom,sm6350-cdsp-pas", .data = &sm6350_cdsp_resource },
 	{ .compatible = "qcom,sm6350-mpss-pas", .data = &mpss_resource_init },
+	{ .compatible = "qcom,sm6450-adsp-pas", .data = &sm6450_adsp_resource },
+	{ .compatible = "qcom,sm6450-cdsp-pas", .data = &sm6450_cdsp_resource },
+	{ .compatible = "qcom,sm6450-wpss-pas", .data = &sm6450_wpss_resource },
 	{ .compatible = "qcom,sm6375-adsp-pas", .data = &sm6350_adsp_resource },
 	{ .compatible = "qcom,sm6375-cdsp-pas", .data = &sm8150_cdsp_resource },
 	{ .compatible = "qcom,sm6375-mpss-pas", .data = &sm6375_mpss_resource },
