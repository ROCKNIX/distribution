From: sunshineinabox <aqemail@gmail.com>
Subject: [PATCH] usb: typec: ucsi_glink: enable UCSI_DELAY_DEVICE_PDOS quirk for SM6450

---
diff -Nur a/drivers/usb/typec/ucsi/ucsi_glink.c b/drivers/usb/typec/ucsi/ucsi_glink.c
--- a/drivers/usb/typec/ucsi/ucsi_glink.c	2026-09-26 19:56:03
+++ b/drivers/usb/typec/ucsi/ucsi_glink.c	2026-09-26 19:56:03
@@ -380,6 +380,7 @@
 	{ .compatible = "qcom,sc8180x-pmic-glink", .data = &quirk_sc8180x, },
 	{ .compatible = "qcom,sc8280xp-pmic-glink", .data = &quirk_sc8280xp, },
 	{ .compatible = "qcom,sm8350-pmic-glink", .data = &quirk_sc8180x, },
+	{ .compatible = "qcom,sm6450-pmic-glink", .data = &quirk_sm8450, },
 	{ .compatible = "qcom,sm8450-pmic-glink", .data = &quirk_sm8450, },
 	{ .compatible = "qcom,sm8550-pmic-glink", .data = &quirk_sm8450, },
 	{ .compatible = "qcom,x1e80100-pmic-glink", .data = &quirk_x1e80100, },
