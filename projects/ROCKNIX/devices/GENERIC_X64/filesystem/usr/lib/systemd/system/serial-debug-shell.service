#
# A root shell on the serial console, with no login: the developers' way into
# a QA guest (tools/vm-serial; SSH is off on a fresh image). GENERIC_X64 is a
# developer's tool and never a gameplay image (D-QA-053), and this unit is why
# it must not become one unchanged. ROCKNIX strips every getty unit, so this is
# systemd's debug-shell pattern -- a plain /bin/sh bound to the tty -- rather
# than a getty and a login.
#
# It starts only on a virtual machine: ConditionVirtualization=vm has no |, so
# it must hold as well as one of the console conditions (both always met here,
# since EXTRA_CMDLINE puts console=ttyS0,115200 on every boot). GENERIC_X64
# installed on hardware with a serial header does not open the shell.
[Unit]
Description=Serial debug root shell on ttyS0 (GENERIC_X64 VM testing)
After=rocknix-automount.service
ConditionVirtualization=vm
ConditionKernelCommandLine=|console=ttyS0
ConditionKernelCommandLine=|console=ttyS0,115200
# A [Unit] key: the shell outlives an isolate (it sat under [Service] until
# 2026-09, where systemd ignores it).
IgnoreOnIsolate=yes

[Service]
Environment=TERM=vt100
Environment=HOME=/storage
WorkingDirectory=/storage
ExecStart=/bin/sh
Restart=always
RestartSec=1
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes
KillMode=process

[Install]
WantedBy=rocknix.target
