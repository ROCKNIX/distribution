################################################################################
# setup device defaults
################################################################################

  # The TARGET_CPU variable controls which processor should be targeted for
  # generated code.
    case ${TARGET_ARCH} in
      x86_64)
        TARGET_KERNEL_ARCH="x86"
        TARGET_KERNEL_PATCH_ARCH="x86_64"
        # x86-64-v3 (Haswell/Excavator or newer: AVX2, BMI2, FMA). The VM
        # profile's CPU model is Haswell-v4 for this reason; an older CPU
        # stops with SIGILL at the first v3 instruction. GENERIC_X64 is a
        # developers' QA device, not a PC image (D-QA-053).
        TARGET_CPU="x86-64-v3"
        TARGET_FEATURES="64bit"
        ;;
    esac

    PARTITION_TABLE="gpt"
    HW_CPU="Generic x86_64"

  # Kernel target
    KERNEL_TARGET="bzImage"

  # Additional bootloader settings
    BOOTLOADER="syslinux"

  # Graphics drivers for x86_64.
  # VM QA target: virtio (virgl) is the guest's GL -- generic-x64-vm --headless
  # renders it on the host's GPU (D-QA-052) -- and vmware (svga) is kept for
  # other hypervisors. llvmpipe (LLVM_SUPPORT below) is the software GL path
  # (--gl none). iris (Intel HW GL/Vulkan) is intentionally omitted: it pulls in
  # the intel_clc/SPIR-V toolchain cascade (issue #16). None of these is a
  # Vulkan driver.
    GRAPHIC_DRIVERS="virtio vmware"

  # OpenGL support
    OPENGL_SUPPORT="yes"
    OPENGL="mesa"

  # Vulkan: the loader and headers only. GRAPHIC_DRIVERS builds no Vulkan
  # driver, so the image carries no ICD and a Vulkan renderer has no device on
  # a guest; RetroArch's GENERIC_X64 profile draws with gl.
    VULKAN_SUPPORT="yes"
    VULKAN="vulkan-loader vulkan-headers"

  # VAAPI support
    VAAPI_SUPPORT="yes"

  # Audio support
    PULSEAUDIO_SUPPORT="yes"

  # Network support
    NETWORK="yes"

  # Display server for x86_64 systems (wl = Wayland)
    DISPLAYSERVER="wl"

  # Window manager/compositor selection (weston / swaywm-env / none)
    WINDOWMANAGER="swaywm-env"

  # For x86_64 compatibility
    PREFER_GLES="no"

  # Disable 32-bit support for x86_64 builds
    ENABLE_32BIT="no"

  # Boot method
    DISK_LABEL="ROCKNIX"
    SYSTEM_SIZE="4096"
    SYSTEM_PART_START="8192"

  # Extra command line for x86_64
    EXTRA_CMDLINE="console=ttyS0,115200 console=tty0"

  # Disable joypad driver for x86_64
    ROCKNIX_JOYPAD="no"

  # LLVM for llvmpipe, the software GL path (config/graphic keeps this
  # device's explicit yes; D-QA-052)
    LLVM_SUPPORT="yes"

  # No swap: the QA guest has 8 GiB (vm/profile.json)
    SWAP_SUPPORT="no"

  # Enable installer support for GENERIC_X64 (allows installation to disk; a
  # developer's install -- the serial root shell stays off on hardware, see
  # serial-debug-shell.service)
    INSTALLER_SUPPORT="yes"
