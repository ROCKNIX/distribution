From: Noxwell <beebono@gmail.com>
Date: Mon, 23 Nov 2026 12:00:00 -0600
Subject: [PATCH] libavcodec: v4l2m2m: skip empty capture buffers flagged as
 errors

Drivers return frames that are not meant for display, such as VP9
alt-ref frames on venus, as error buffers without payload. Requeue them
instead of handing them to the caller as frames.
---
--- a/libavcodec/v4l2_context.c
+++ b/libavcodec/v4l2_context.c
@@ -641,6 +641,14 @@
         return AVERROR(EAGAIN);
     }
 
+    /* the driver returned a frame that is not meant to be displayed */
+    if ((avbuf->buf.flags & V4L2_BUF_FLAG_ERROR) &&
+        !(V4L2_TYPE_IS_MULTIPLANAR(avbuf->buf.type) ?
+          avbuf->buf.m.planes[0].bytesused : avbuf->buf.bytesused)) {
+        ff_v4l2_buffer_enqueue(avbuf);
+        return AVERROR(EAGAIN);
+    }
+
     return ff_v4l2_buffer_buf_to_avframe(frame, avbuf);
 }
 
