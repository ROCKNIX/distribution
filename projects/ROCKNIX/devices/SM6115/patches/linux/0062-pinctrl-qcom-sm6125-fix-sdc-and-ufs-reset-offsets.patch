From: Noxwell <beebono@gmail.com>
Date: Tue, 29 Sep 2026 12:00:00 -0500
Subject: [PATCH] pinctrl: qcom: sm6125: fix SDC and UFS reset register offsets

The SDC1, SDC2 and ufs_reset groups carry offsets taken from the
downstream driver, where they are relative to a single TLMM base at
0x400000. This driver adds them to the base of the tile named in the
group instead, so they point at the wrong registers, and the SDC2 pads
at 0x58b000 land 0x18b000 bytes past the end of the 4 MiB south tile
mapping. Configuring the sdc2 pins then writes into whichever mapping
follows the TLMM in vmalloc space; on the Retroid Pocket Duo Lite that
is a silent hard reset on most boots, depending on the KASLR placement.

Convert the offsets to be relative to their tile:

  0x400000 + 0x18d000 = 0x58d000 = west  + 0x8d000  (sdc1)
  0x400000 + 0x58b000 = 0x98b000 = south + 0x8b000  (sdc2)
  0x400000 + 0x190000 = 0x590000 = west  + 0x90000  (ufs_reset)

---
 drivers/pinctrl/qcom/pinctrl-sm6125.c | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/drivers/pinctrl/qcom/pinctrl-sm6125.c b/drivers/pinctrl/qcom/pinctrl-sm6125.c
--- a/drivers/pinctrl/qcom/pinctrl-sm6125.c
+++ b/drivers/pinctrl/qcom/pinctrl-sm6125.c
@@ -1210,14 +1210,14 @@ static const struct msm_pingroup sm6125_groups[] = {
 	[130] = PINGROUP(130, SOUTH, phase_flag, _, _, _, _, _, _, _, _),
 	[131] = PINGROUP(131, SOUTH, phase_flag, _, _, _, _, _, _, _, _),
 	[132] = PINGROUP(132, SOUTH, _, _, _, _, _, _, _, _, _),
-	[133] = UFS_RESET(ufs_reset, 0x190000),
-	[134] = SDC_QDSD_PINGROUP(sdc1_rclk, WEST, 0x18d000, 15, 0),
-	[135] = SDC_QDSD_PINGROUP(sdc1_clk, WEST, 0x18d000, 13, 6),
-	[136] = SDC_QDSD_PINGROUP(sdc1_cmd, WEST, 0x18d000, 11, 3),
-	[137] = SDC_QDSD_PINGROUP(sdc1_data, WEST, 0x18d000, 9, 0),
-	[138] = SDC_QDSD_PINGROUP(sdc2_clk, SOUTH, 0x58b000, 14, 6),
-	[139] = SDC_QDSD_PINGROUP(sdc2_cmd, SOUTH, 0x58b000, 11, 3),
-	[140] = SDC_QDSD_PINGROUP(sdc2_data, SOUTH, 0x58b000, 9, 0),
+	[133] = UFS_RESET(ufs_reset, 0x90000),
+	[134] = SDC_QDSD_PINGROUP(sdc1_rclk, WEST, 0x8d000, 15, 0),
+	[135] = SDC_QDSD_PINGROUP(sdc1_clk, WEST, 0x8d000, 13, 6),
+	[136] = SDC_QDSD_PINGROUP(sdc1_cmd, WEST, 0x8d000, 11, 3),
+	[137] = SDC_QDSD_PINGROUP(sdc1_data, WEST, 0x8d000, 9, 0),
+	[138] = SDC_QDSD_PINGROUP(sdc2_clk, SOUTH, 0x8b000, 14, 6),
+	[139] = SDC_QDSD_PINGROUP(sdc2_cmd, SOUTH, 0x8b000, 11, 3),
+	[140] = SDC_QDSD_PINGROUP(sdc2_data, SOUTH, 0x8b000, 9, 0),
 };
 
 static const struct msm_gpio_wakeirq_map sm6125_mpm_map[] = {
