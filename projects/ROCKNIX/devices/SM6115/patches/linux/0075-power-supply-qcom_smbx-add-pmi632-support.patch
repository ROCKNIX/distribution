+	if (!chip->var->typec_snk_status ||
+	    device_property_read_u32(chip->dev,
+				     "qcom,hvdcp-input-current-microamp",
+				     &chip->hvdcp_icl_ua))
+		return 0;
+
+	rc = regmap_update_bits(chip->regmap, chip->base + HVDCP_PULSE_COUNT_MAX,
+				HVDCP_PULSE_COUNT_MAX_QC2_MASK,
+				HVDCP_PULSE_COUNT_MAX_QC2_9V);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc,
+				     "Couldn't cap HVDCP at 9 V\n");
+
+	rc = regmap_update_bits(chip->regmap, chip->base + USBIN_OPTIONS_1_CFG,
+				en, en);
+	if (rc < 0)
+		return dev_err_probe(chip->dev, rc, "Couldn't enable HVDCP\n");
+
+	return 0;
