+static int smb5_init_hvdcp(struct smb_chip *chip)
+{
+	const unsigned int en = HVDCP_AUTH_ALG_EN_CFG_BIT |
+				HVDCP_AUTONOMOUS_MODE_EN_CFG_BIT | HVDCP_EN_BIT;
+	int rc;
