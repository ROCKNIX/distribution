+
+static unsigned int _dpu_plane_scaler_lut(u32 src_w, u32 src_h, u32 dst_w, u32 dst_h)
+{
+
+	u32 ratio = max(src_w * 100 / dst_w, src_h * 100 / dst_h);
+	unsigned int i, last = ARRAY_SIZE(dpu_lut_area_ratio) - 1;
+
+	if (ratio <= 112)
+		return DPU_LUT_CUBIC;
+	for (i = 0; i < last; i++)
+		if (ratio * 2 <= dpu_lut_area_ratio[i] + dpu_lut_area_ratio[i + 1])
+			break;
+	return DPU_LUT_AREA + i;
+}
+
 static void _dpu_plane_setup_scaler3(struct dpu_hw_sspp *pipe_hw,
 		uint32_t src_w, uint32_t src_h, uint32_t dst_w, uint32_t dst_h,
 		struct dpu_hw_scaler3_cfg *scale_cfg,
@@ -562,6 +657,19 @@ static void _dpu_plane_setup_scaler3(struct dpu_hw_sspp *pipe_hw,
 			scale_cfg->de.adjust_c[i] = clamp(dpu_de_adjust_c[i], -512, 511);
 		}
 	}
+
+	if (scaled && (dpu_nearest || dpu_filter_lut)) {
+		unsigned int lut = dpu_nearest ? DPU_LUT_NEAREST :
+				   _dpu_plane_scaler_lut(src_w, src_h, dst_w, dst_h);
+
+		scale_cfg->y_rgb_filter_cfg = DPU_SCALE_1D_SEP;
+		scale_cfg->uv_filter_cfg = DPU_SCALE_1D_SEP;
+		scale_cfg->sep_lut = (u32 *)dpu_qseed_luts;
+		scale_cfg->sep_len = sizeof(dpu_qseed_luts);
+		scale_cfg->y_rgb_sep_lut_idx = lut;
+		scale_cfg->uv_sep_lut_idx = lut;
+		scale_cfg->lut_flag = BIT(4) | BIT(5) | BIT(0);
+	}
