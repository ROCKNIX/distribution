From: Noxwell <beebono@gmail.com>
Date: Fri, 2 Oct 2026 12:00:00 -0500
Subject: [PATCH] clk: qcom: dispcc-sm6125: fix DP link clock frequency table

The F() macro takes Hz, but the DP link clock table lists 162, 270 and
540 MHz in kHz. No entry then matches the DP link rates, so setting the
link clock through the DP OPP table fails with -EINVAL.
---
--- a/drivers/clk/qcom/dispcc-sm6125.c
+++ b/drivers/clk/qcom/dispcc-sm6125.c
@@ -200,9 +200,9 @@
 };
 
 static const struct freq_tbl ftbl_disp_cc_mdss_dp_link_clk_src[] = {
-	F( 162000, P_DP_PHY_PLL_LINK_CLK,   1,   0,   0),
-	F( 270000, P_DP_PHY_PLL_LINK_CLK,   1,   0,   0),
-	F( 540000, P_DP_PHY_PLL_LINK_CLK,   1,   0,   0),
+	F(162000000, P_DP_PHY_PLL_LINK_CLK, 1, 0, 0),
+	F(270000000, P_DP_PHY_PLL_LINK_CLK, 1, 0, 0),
+	F(540000000, P_DP_PHY_PLL_LINK_CLK, 1, 0, 0),
 	{ }
 };
 
