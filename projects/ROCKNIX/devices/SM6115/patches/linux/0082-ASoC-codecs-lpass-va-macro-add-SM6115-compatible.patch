Subject: [PATCH] ASoC: codecs: lpass-va-macro: add SM6115 compatible

Add qcom,sm6115-lpass-va-macro compatible string using the
sm8450_va_data variant (has SoundWire master, has NPL clock).

Upstream commit 893e2fd509e9 ("ASoC: codecs: lpass-va-macro: add SM6115 compatible")
---
 sound/soc/codecs/lpass-va-macro.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/sound/soc/codecs/lpass-va-macro.c b/sound/soc/codecs/lpass-va-macro.c
--- a/sound/soc/codecs/lpass-va-macro.c
@@ -1722,6 +1722,7 @@
 };

 static const struct of_device_id va_macro_dt_match[] = {
 	{ .compatible = "qcom,sc7280-lpass-va-macro", .data = &sm8250_va_data },
+	{ .compatible = "qcom,sm6115-lpass-va-macro", .data = &sm8450_va_data },
 	{ .compatible = "qcom,sm8250-lpass-va-macro", .data = &sm8250_va_data },
 	{ .compatible = "qcom,sm8450-lpass-va-macro", .data = &sm8450_va_data },
 	{ .compatible = "qcom,sm8550-lpass-va-macro", .data = &sm8550_va_data },
