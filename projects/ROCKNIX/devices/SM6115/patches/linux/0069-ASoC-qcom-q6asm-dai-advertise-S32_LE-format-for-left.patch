From: Alexandre Ferrieux <alexandre.ferrieux@orange.com>
Subject: ASoC: qcom: q6asm-dai: advertise S32_LE format for left-justified 24-bit ADSP

The Q6 ADSP expects left-justified 24-bit audio in 32-bit containers.
Restrict the FEDAI playback to S32_LE only so PipeWire uses the correct
format. Add S32_LE to the hardware playback struct for direct aplay
flexibility, and map S32_LE to 24 bits_per_sample in hw_params.

Based on postmarketOS pmaports MR !7700 for Fairphone 5 speaker support.
Co-developed-by: Bharadwaj Raju <bharadwaj.raju@machinesoul.in>
Co-developed-by: Bhushan Shah <bshah@kde.org>
Co-developed-by: Luca Weiss <luca.weiss@fairphone.com>
---
--- a/sound/soc/qcom/qdsp6/q6asm-dai.c	2026-03-26 19:34:35
+++ b/sound/soc/qcom/qdsp6/q6asm-dai.c	2026-03-26 22:14:23
@@ -111,7 +111,8 @@
 				SNDRV_PCM_INFO_INTERLEAVED |
 				SNDRV_PCM_INFO_PAUSE | SNDRV_PCM_INFO_RESUME),
 	.formats =              (SNDRV_PCM_FMTBIT_S16_LE |
-				SNDRV_PCM_FMTBIT_S24_LE),
+				SNDRV_PCM_FMTBIT_S24_LE |
+				SNDRV_PCM_FMTBIT_S32_LE),
 	.rates =                SNDRV_PCM_RATE_8000_192000,
 	.rate_min =             8000,
 	.rate_max =             192000,
@@ -136,8 +137,7 @@
 				  SNDRV_PCM_RATE_96000 |		\
 				  SNDRV_PCM_RATE_176400 |		\
 				  SNDRV_PCM_RATE_192000),		\
-			.formats = (SNDRV_PCM_FMTBIT_S16_LE |		\
-					SNDRV_PCM_FMTBIT_S24_LE),	\
+			.formats = SNDRV_PCM_FMTBIT_S32_LE,		\
 			.channels_min = 1,				\
 			.channels_max = 8,				\
 			.rate_min =     8000,				\
@@ -481,6 +481,7 @@
 		prtd->bits_per_sample = 16;
 		break;
 	case SNDRV_PCM_FORMAT_S24_LE:
+	case SNDRV_PCM_FORMAT_S32_LE:
 		prtd->bits_per_sample = 24;
 		break;
 	}
