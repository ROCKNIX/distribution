ASoC: codecs: aw88261: add TLV metadata and invert volume direction

The AW88261 volume register is attenuation-based: hardware value 0 is
0 dB (loudest) and 720 is -90 dB (muted).  The existing driver exposes
this raw range via SOC_SINGLE_EXT without TLV and without inversion,
so PipeWire/PulseAudio see a backwards slider with no dB scale.

Fix by:
  1. Adding DECLARE_TLV_DB_MINMAX_MUTE so user-space knows the range
  2. Inverting in get/put so ALSA convention (higher = louder) holds
  3. Switching SOC_SINGLE_EXT to SOC_SINGLE_EXT_TLV

After this patch the control behaves as:
  user value   0 = mute  (-inf dB)
  user value 720 = 0 dB  (loudest)
---
 sound/soc/codecs/aw88261.c | 25 ++++++++++++++++++++-----
 1 file changed, 20 insertions(+), 5 deletions(-)

--- a/sound/soc/codecs/aw88261.c	
+++ b/sound/soc/codecs/aw88261.c	
@@ -12,6 +12,7 @@
 #include <linux/firmware.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
+#include <sound/tlv.h>
 #include <sound/soc.h>
 #include "aw88261.h"
 #include "aw88395/aw88395_data_type.h"
@@ -887,6 +888,13 @@
 	return 1;
 }
 
+/*
+ * The AW88261 volume register is attenuation-based: hardware value 0 is
+ * 0 dB (loudest) and 720 is -90 dB (muted).  Invert in get/put so that
+ * ALSA user-space sees 0 = mute, 720 = 0 dB, matching convention.
+ */
+static const DECLARE_TLV_DB_MINMAX_MUTE(aw88261_vol_tlv, -9000, 0);
+
 static int aw88261_volume_get(struct snd_kcontrol *kcontrol,
 				struct snd_ctl_elem_value *ucontrol)
 {
@@ -894,7 +902,7 @@
 	struct aw88261 *aw88261 = snd_soc_component_get_drvdata(codec);
 	struct aw_volume_desc *vol_desc = &aw88261->aw_pa->volume_desc;
 
-	ucontrol->value.integer.value[0] = vol_desc->ctl_volume;
+	ucontrol->value.integer.value[0] = AW88261_MUTE_VOL - vol_desc->ctl_volume;
 
 	return 0;
 }
@@ -907,16 +915,18 @@
 	struct aw_volume_desc *vol_desc = &aw88261->aw_pa->volume_desc;
 	struct soc_mixer_control *mc =
 		(struct soc_mixer_control *)kcontrol->private_value;
-	int value;
+	int value, hw_vol;
 
 	value = ucontrol->value.integer.value[0];
 
 	if (value < mc->min || value > mc->max)
 		return -EINVAL;
 
-	if (vol_desc->ctl_volume != value) {
-		vol_desc->ctl_volume = value;
-		aw88261_dev_set_volume(aw88261->aw_pa, vol_desc->ctl_volume);
+	hw_vol = AW88261_MUTE_VOL - value;
+
+	if (vol_desc->ctl_volume != hw_vol) {
+		vol_desc->ctl_volume = hw_vol;
+		aw88261_dev_set_volume(aw88261->aw_pa, hw_vol);
 
 		return 1;
 	}
@@ -957,9 +967,9 @@
 }
 
 static const struct snd_kcontrol_new aw88261_controls[] = {
-	SOC_SINGLE_EXT("PCM Playback Volume", AW88261_SYSCTRL2_REG,
+	SOC_SINGLE_EXT_TLV("PCM Playback Volume", AW88261_SYSCTRL2_REG,
 		6, AW88261_MUTE_VOL, 0, aw88261_volume_get,
-		aw88261_volume_set),
+		aw88261_volume_set, aw88261_vol_tlv),
 	SOC_SINGLE_EXT("Fade Step", 0, 0, AW88261_MUTE_VOL, 0,
 		aw88261_get_fade_step, aw88261_set_fade_step),
 	SOC_SINGLE_EXT("Volume Ramp Up Step", 0, 0, FADE_TIME_MAX, FADE_TIME_MIN,
