+/* --- Combined Speaker volume for paired AW88261 amplifiers --------------- */
+
+/*
+ * The AW88261 "PCM Playback Volume" is an attenuation register:
+ *   hardware value 0   = 0 dB   (loudest)
+ *   hardware value 720 = -90 dB (muted)
+ *
+ * ALSA convention is higher value = louder, so we invert in get/put and
+ * attach a standard TLV so PipeWire sees:
+ *   user value 0   = mute
+ *   user value 720 = 0 dB (loudest)
+ */
+#define SPK_AMP_VOL_MAX	720
+
+static const DECLARE_TLV_DB_MINMAX_MUTE(sm8250_spk_tlv, -9000, 0);
+
+static int sm8250_spk_vol_info(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = SPK_AMP_VOL_MAX;
+	return 0;
+}
+
+static int sm8250_spk_vol_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = kcontrol->private_data;
+	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_ctl_elem_value val = {};
+	int ret;
+
+	ret = data->spk_l_vol->get(data->spk_l_vol, &val);
+	if (ret < 0)
+		return ret;
+
+	ucontrol->value.integer.value[0] =
+		SPK_AMP_VOL_MAX - val.value.integer.value[0];
+	return 0;
+}
+
+static int sm8250_spk_vol_put(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_card *card = kcontrol->private_data;
+	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_ctl_elem_value val = {};
+	int user_vol = ucontrol->value.integer.value[0];
+	int hw_vol;
+
+	if (user_vol < 0 || user_vol > SPK_AMP_VOL_MAX)
+		return -EINVAL;
+
+	hw_vol = SPK_AMP_VOL_MAX - user_vol;
+	val.value.integer.value[0] = hw_vol;
+	data->spk_l_vol->put(data->spk_l_vol, &val);
+
+	val.value.integer.value[0] = hw_vol;
+	data->spk_r_vol->put(data->spk_r_vol, &val);
+
+	return 1;
+}
+
+static const struct snd_kcontrol_new sm8250_spk_vol_ctl = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.name = "Speaker Playback Volume",
+	.access = SNDRV_CTL_ELEM_ACCESS_READWRITE |
+		  SNDRV_CTL_ELEM_ACCESS_TLV_READ,
+	.tlv.p = sm8250_spk_tlv,
+	.info = sm8250_spk_vol_info,
+	.get = sm8250_spk_vol_get,
+	.put = sm8250_spk_vol_put,
+};
+
+static int sm8250_snd_late_probe(struct snd_soc_card *card)
+{
+	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(card);
+	struct snd_ctl_elem_id id = {};
+	struct snd_kcontrol *ctl;
+
+	id.iface = SNDRV_CTL_ELEM_IFACE_MIXER;
+
+	strscpy(id.name, "SPK_L PCM Playback Volume", sizeof(id.name));
+	data->spk_l_vol = snd_ctl_find_id(card->snd_card, &id);
+
+	strscpy(id.name, "SPK_R PCM Playback Volume", sizeof(id.name));
+	data->spk_r_vol = snd_ctl_find_id(card->snd_card, &id);
+
+	if (data->spk_l_vol && data->spk_r_vol) {
+		ctl = snd_ctl_new1(&sm8250_spk_vol_ctl, card);
+		if (ctl)
+			snd_ctl_add(card->snd_card, ctl);
+	}
+
+	return 0;
+}
+
 static int sm8250_snd_init(struct snd_soc_pcm_runtime *rtd)
 {
 	struct sm8250_snd_data *data = snd_soc_card_get_drvdata(rtd->card);
@@ -204,6 +306,7 @@
 
 	card->driver_name = of_device_get_match_data(dev);
 	sm8250_add_be_ops(card);
+	card->late_probe = sm8250_snd_late_probe;
 	return devm_snd_soc_register_card(dev, card);
 }
 
