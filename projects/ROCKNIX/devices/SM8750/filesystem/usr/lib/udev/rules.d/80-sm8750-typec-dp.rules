# Auto-enable DisplayPort AltMode when USB Billboard Device is detected (e.g. powered TV docks)
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{TYPE}=="17/*", RUN+="/bin/sh -c 'echo 1 > /sys/devices/platform/pmic-glink/pmic_glink.altmode.0/force_dp 2>/dev/null || true'"

# When Billboard device or Type-C partner is removed, tear down forced DisplayPort AltMode
ACTION=="remove", SUBSYSTEM=="typec", ENV{DEVTYPE}=="typec_partner", RUN+="/bin/sh -c 'echo 0 > /sys/devices/platform/pmic-glink/pmic_glink.altmode.0/force_dp 2>/dev/null || true'"
ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{TYPE}=="17/*", RUN+="/bin/sh -c 'echo 0 > /sys/devices/platform/pmic-glink/pmic_glink.altmode.0/force_dp 2>/dev/null || true'"
