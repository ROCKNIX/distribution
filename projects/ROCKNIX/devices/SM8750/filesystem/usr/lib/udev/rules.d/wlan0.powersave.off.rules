# KONKR Pocket FIT Elite (SM8750, ath12k/PCIe): keep the radio out of 802.11
# power save while the system is awake. Dynamic PS parks the radio between
# DTIM beacons and drops/delays inbound packets, which stalls SSH and large
# downloads. Awake-only: suspend still powers the radio down over PCIe/MHI.
# RUN+= re-applies on every interface add, so PS cannot creep back on.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="wlan*", RUN+="/sbin/iw dev %k set power_save off"
