From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Thu, 5 Nov 2026 19:27:49 +0000
Subject: [PATCH] dt-bindings: perf: add the Qualcomm SM8750 LLCC PMU

The SM8750 LLCC counts the read misses of each CPU in a counter of its
own. Describe it, with the CPU each counter belongs to.
---
 .../bindings/perf/qcom,sm8750-llcc-pmu.yaml   | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/perf/qcom,sm8750-llcc-pmu.yaml

diff --git a/Documentation/devicetree/bindings/perf/qcom,sm8750-llcc-pmu.yaml b/Documentation/devicetree/bindings/perf/qcom,sm8750-llcc-pmu.yaml
new file mode 100644
index 000000000..7264b2057
--- /dev/null
+++ b/Documentation/devicetree/bindings/perf/qcom,sm8750-llcc-pmu.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/perf/qcom,sm8750-llcc-pmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm LLCC per-CPU read-miss monitor
+
+maintainers:
+  - André Braga <code@andrebraga.com>
+
+description: |
+  The Last Level Cache Controller counts the read misses of each CPU in a
+  counter of its own. The counters have no overflow interrupt.
+
+properties:
+  compatible:
+    const: qcom,sm8750-llcc-pmu
+
+  reg:
+    maxItems: 1
+
+  cpus:
+    description:
+      The CPU each counter belongs to, in counter order.
+    minItems: 1
+    maxItems: 16
+
+required:
+  - compatible
+  - reg
+  - cpus
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        pmu@24095000 {
+            compatible = "qcom,sm8750-llcc-pmu";
+            reg = <0x0 0x24095000 0x0 0x300>;
+            cpus = <&cpu6>, <&cpu7>, <&cpu0>, <&cpu1>,
+                   <&cpu2>, <&cpu3>, <&cpu4>, <&cpu5>;
+        };
+    };
-- 
