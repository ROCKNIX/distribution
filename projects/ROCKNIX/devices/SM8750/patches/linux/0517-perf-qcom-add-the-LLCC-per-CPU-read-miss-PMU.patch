+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __QCOM_LLCC_PMU_H__
+#define __QCOM_LLCC_PMU_H__
+
+#include <linux/errno.h>
+
+struct device_node;
+
+#if IS_ENABLED(CONFIG_QCOM_LLCC_PMU)
+int qcom_llcc_pmu_type(struct device_node *np);
+#else
+static inline int qcom_llcc_pmu_type(struct device_node *np)
+{
+	return -ENODEV;
+}
+#endif
+
+#endif
