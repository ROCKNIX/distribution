From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Thu, 5 Nov 2026 19:27:50 +0000
Subject: [PATCH] dt-bindings: soc: qcom: add memlat

Describe the CPU memory latency bandwidth voter: the buses it votes on,
what counts a CPU's misses to each, and the monitors that map a CPU's
effective frequency to a bus frequency while the CPU stalls on memory.
---
 .../bindings/soc/qcom/qcom,memlat.yaml        | 143 ++++++++++++++++++
 1 file changed, 143 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/qcom/qcom,memlat.yaml

diff --git a/Documentation/devicetree/bindings/soc/qcom/qcom,memlat.yaml b/Documentation/devicetree/bindings/soc/qcom/qcom,memlat.yaml
new file mode 100644
index 000000000..1c2269521
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/qcom/qcom,memlat.yaml
@@ -0,0 +1,143 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/qcom/qcom,memlat.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm CPU memory latency bandwidth voter
+
+maintainers:
+  - André Braga <code@andrebraga.com>
+
+description: |
+  Votes for memory bus bandwidth while CPUs stall on memory. Each child
+  describes a bus, named as the interconnect path it votes on, and the
+  event that counts a CPU's misses to it. Each grandchild is a monitor,
+  a group of CPUs that, while missing at least once per qcom,ipm-ceil
+  instructions, vote for the bus frequency their table maps their
+  effective frequency to.
+
+properties:
+  compatible:
+    items:
+      - const: qcom,sm8750-memlat
+      - const: qcom,memlat
+
+  interconnects:
+    minItems: 1
+    maxItems: 4
+
+  interconnect-names:
+    minItems: 1
+    maxItems: 4
+
+required:
+  - compatible
+  - interconnects
+  - interconnect-names
+
+additionalProperties: false
+
+patternProperties:
+  "^(ddr|llcc|l3)$":
+    type: object
+    description: A bus, named as its entry in interconnect-names.
+    additionalProperties: false
+
+    properties:
+      qcom,bus-width:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        description: Bytes per cycle, to turn a frequency into bandwidth.
+
+      qcom,miss-event:
+        $ref: /schemas/types.yaml#/definitions/uint32
+        description:
+          Event that counts a CPU's misses to this bus, raw for the CPU
+          PMU unless qcom,miss-pmu names another.
+
+      qcom,miss-pmu:
+        $ref: /schemas/types.yaml#/definitions/phandle
+        description: PMU of qcom,miss-event, counting per CPU.
+
+    required:
+      - qcom,bus-width
+      - qcom,miss-event
+
+    patternProperties:
+      "^[a-z-]+$":
+        type: object
+        description: A monitor.
+        additionalProperties: false
+
+        properties:
+          cpus:
+            minItems: 1
+            maxItems: 32
+
+          qcom,freq-map:
+            $ref: /schemas/types.yaml#/definitions/uint32-matrix
+            description:
+              Pairs of CPU frequency and bus frequency, in kHz, in rising
+              order; a CPU frequency uses the first row at or above it.
+            items:
+              items:
+                - description: CPU frequency in kHz
+                - description: Bus frequency in kHz
+
+          qcom,ipm-ceil:
+            $ref: /schemas/types.yaml#/definitions/uint32
+            description:
+              Instructions per miss at or below which a CPU votes.
+            default: 400
+
+          qcom,freq-scale:
+            $ref: /schemas/types.yaml#/definitions/uint32-array
+            description:
+              Raise the effective frequency of CPUs between the floor and
+              the ceiling by up to the percentage, in proportion to how far
+              they are below qcom,ipm-ceil.
+            items:
+              - description: Percentage
+              - description: Floor in MHz
+              - description: Ceiling in MHz
+
+          qcom,compute:
+            type: boolean
+            description: Vote by frequency alone, whatever the miss rate.
+
+        required:
+          - cpus
+          - qcom,freq-map
+
+examples:
+  - |
+    #include <dt-bindings/interconnect/qcom,icc.h>
+    #include <dt-bindings/interconnect/qcom,sm8750-rpmh.h>
+
+    memlat {
+        compatible = "qcom,sm8750-memlat", "qcom,memlat";
+        interconnects = <&mc_virt MASTER_LLCC QCOM_ICC_TAG_ACTIVE_ONLY
+                         &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>;
+        interconnect-names = "ddr";
+
+        ddr {
+            qcom,bus-width = <4>;
+            qcom,miss-event = <0x1000>;
+            qcom,miss-pmu = <&llcc_pmu>;
+
+            prime {
+                cpus = <&cpu6>, <&cpu7>;
+                qcom,freq-map = <1017600 1353000>,
+                                <2246400 3187000>,
+                                <4185600 4761000>;
+                qcom,freq-scale = <25 1500 2800>;
+            };
+
+            compute {
+                cpus = <&cpu0>, <&cpu6>;
+                qcom,freq-map = <2227200 547000>,
+                                <4185600 2092000>;
+                qcom,compute;
+            };
+        };
+    };
-- 
