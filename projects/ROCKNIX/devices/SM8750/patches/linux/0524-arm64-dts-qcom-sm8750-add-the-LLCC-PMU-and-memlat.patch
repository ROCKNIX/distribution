From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Thu, 5 Nov 2026 19:27:50 +0000
Subject: [PATCH] arm64: dts: qcom: sm8750: add the LLCC PMU and memlat

Take the memlat monitors, tables, events and bus widths from the SM8750
vendor DT of the AYN Odin 3, and the tunables its post_boot script
sets; the LLCC PMU's address and counter order come from the same DT.
The vendor's DDR QoS group has no interconnect equivalent and is left
out.
---
 arch/arm64/boot/dts/qcom/sm8750.dtsi | 92 ++++++++++++++++++++++++++++
 1 file changed, 92 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8750.dtsi b/arch/arm64/boot/dts/qcom/sm8750.dtsi
index b09d5f131..2f44347a5 100644
--- a/arch/arm64/boot/dts/qcom/sm8750.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8750.dtsi
@@ -265,6 +265,91 @@ domain_ss3: domain-sleep-0 {
 		};
 	};
 
+	memlat {
+		compatible = "qcom,sm8750-memlat", "qcom,memlat";
+		interconnects = <&mc_virt MASTER_LLCC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ACTIVE_ONLY>,
+				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+				 &gem_noc SLAVE_LLCC QCOM_ICC_TAG_ACTIVE_ONLY>;
+		interconnect-names = "ddr", "llcc";
+
+		ddr {
+			qcom,bus-width = <4>;
+			qcom,miss-event = <0x1000>;
+			qcom,miss-pmu = <&llcc_pmu>;
+
+			gold {
+				cpus = <&cpu0>, <&cpu1>, <&cpu2>,
+				       <&cpu3>, <&cpu4>, <&cpu5>;
+				qcom,freq-map = <748800 547000>,
+						<960000 1353000>,
+						<1363200 1555000>,
+						<1785600 2092000>,
+						<2572800 3187000>,
+						<3072000 3686000>;
+			};
+
+			prime {
+				cpus = <&cpu6>, <&cpu7>;
+				qcom,freq-map = <614400 547000>,
+						<1017600 1353000>,
+						<1689600 2092000>,
+						<2246400 3187000>,
+						<2841600 3686000>,
+						<3513600 4224000>,
+						<4185600 4761000>;
+				qcom,freq-scale = <25 1500 2800>;
+			};
+
+			gold-compute {
+				cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>,
+				       <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
+				qcom,freq-map = <2227200 547000>,
+						<4185600 2092000>;
+				qcom,compute;
+			};
+
+			prime-latfloor {
+				cpus = <&cpu6>, <&cpu7>;
+				qcom,freq-map = <2841600 547000>,
+						<4185600 4224000>;
+				qcom,ipm-ceil = <25000>;
+			};
+		};
+
+		llcc {
+			qcom,bus-width = <16>;
+			qcom,miss-event = <0x17>;
+
+			gold {
+				cpus = <&cpu0>, <&cpu1>, <&cpu2>,
+				       <&cpu3>, <&cpu4>, <&cpu5>;
+				qcom,freq-map = <960000 350000>,
+						<1785600 533000>,
+						<2572800 806000>,
+						<3072000 933000>;
+			};
+
+			prime {
+				cpus = <&cpu6>, <&cpu7>;
+				qcom,freq-map = <1017600 350000>,
+						<1689600 533000>,
+						<2246400 806000>,
+						<2841600 933000>,
+						<3513600 1066000>,
+						<4185600 1211000>;
+			};
+
+			gold-compute {
+				cpus = <&cpu0>, <&cpu1>, <&cpu2>, <&cpu3>,
+				       <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
+				qcom,freq-map = <2227200 350000>,
+						<4185600 533000>;
+				qcom,compute;
+			};
+		};
+	};
+
 	firmware {
 		scm: scm {
 			compatible = "qcom,scm-sm8750", "qcom,scm";
@@ -6476,6 +6561,13 @@ gpu_speed_bin: gpu-speed-bin@138 {
 			};
 		};
 
+		llcc_pmu: pmu@24095000 {
+			compatible = "qcom,sm8750-llcc-pmu";
+			reg = <0x0 0x24095000 0x0 0x300>;
+			cpus = <&cpu6>, <&cpu7>, <&cpu0>, <&cpu1>,
+			       <&cpu2>, <&cpu3>, <&cpu4>, <&cpu5>;
+		};
+
 		/* cluster0 */
 		pmu@240b3400 {
 			compatible = "qcom,sm8750-cpu-bwmon", "qcom,sdm845-bwmon";
-- 
2.56.0

