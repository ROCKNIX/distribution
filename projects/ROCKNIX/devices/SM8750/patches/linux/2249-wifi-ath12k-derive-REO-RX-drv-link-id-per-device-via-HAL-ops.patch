 		if (!rcu_dereference(partner_ab->pdevs_active[pdev_idx])) {
@@ -686,7 +701,7 @@ int ath12k_wifi7_dp_rx_process(struct ath12k_dp *dp, int ring_id,
 	struct sk_buff_head msdu_list;
