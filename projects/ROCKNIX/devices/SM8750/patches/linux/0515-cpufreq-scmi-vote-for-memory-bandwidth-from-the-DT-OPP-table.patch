From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Thu, 5 Nov 2026 20:00:00 +0000
Subject: [PATCH] cpufreq: scmi: vote for memory bandwidth from the DT OPP table

scmi-cpufreq builds the CPUs' OPP tables from the firmware and never
sets an OPP, so opp-peak-kBps in a CPU's DT OPP table casts no
interconnect vote.

When a CPU node has interconnects, add its DT OPP table and let the
firmware add only the frequencies it leaves out, then set the OPP on
frequency changes, as tegra186-cpufreq and qcom-cpufreq-hw do. Fast
switches run in scheduler context, where a vote can't sleep, so they
hand the vote to a worker through irq_work, as schedutil does for its
own slow path, and keep switching fast.

A policy's bandwidth_votes file turns the votes off and on, so they can
be weighed against other voters, such as a memory latency governor.
---
 Documentation/ABI/testing/sysfs-devices-system-cpu |   10 ++
 drivers/cpufreq/scmi-cpufreq.c                     |  130 +++++++++++++++++++-
 drivers/firmware/arm_scmi/perf.c                   |    8 +
 3 files changed, 143 insertions(+), 5 deletions(-)

diff --git a/Documentation/ABI/testing/sysfs-devices-system-cpu b/Documentation/ABI/testing/sysfs-devices-system-cpu
index 82d10d556..2d9375963 100644
--- a/Documentation/ABI/testing/sysfs-devices-system-cpu
+++ b/Documentation/ABI/testing/sysfs-devices-system-cpu
@@ -539,6 +539,16 @@ Description:	POWERNV CPUFreq driver's frequency throttle stats directory and
 		powercap, overtemp, supply_fault, overcurrent and occ_reset map to
 		the reasons provided by OCC firmware for throttling the frequency.
 
+What:		/sys/devices/system/cpu/cpufreq/policyX/bandwidth_votes
+Date:		November 2026
+Contact:	linux-pm@vger.kernel.org
+Description:	Memory bandwidth votes of the SCMI cpufreq driver
+
+		(RW) 1 while the policy votes for the memory bandwidth its
+		DT OPP table gives each frequency, 0 when it does not; writing
+		0 removes the votes. Only policies whose CPUs have an OPP table
+		with interconnect paths can vote.
+
 What:		/sys/devices/system/cpu/cpufreq/policyX/throttle_stats
 		/sys/devices/system/cpu/cpufreq/policyX/throttle_stats/turbo_stat
 		/sys/devices/system/cpu/cpufreq/policyX/throttle_stats/sub_turbo_stat
diff --git a/drivers/cpufreq/scmi-cpufreq.c b/drivers/cpufreq/scmi-cpufreq.c
index 4edb4f7a8..a5bcb6bcf 100644
--- a/drivers/cpufreq/scmi-cpufreq.c
+++ b/drivers/cpufreq/scmi-cpufreq.c
@@ -14,6 +14,7 @@
 #include <linux/cpumask.h>
 #include <linux/energy_model.h>
 #include <linux/export.h>
+#include <linux/irq_work.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/pm_opp.h>
@@ -22,10 +23,18 @@
 #include <linux/scmi_protocol.h>
 #include <linux/types.h>
 #include <linux/units.h>
+#include <linux/workqueue.h>
 
 struct scmi_data {
 	int domain_id;
 	int nr_opp;
+	bool bw_votes;
+	bool bw_enabled;
+	unsigned long bw_freq;
+	/* Serialises bandwidth votes with their sysfs switch */
+	struct mutex bw_lock;
+	struct irq_work bw_irq_work;
+	struct work_struct bw_work;
 	struct device *cpu_dev;
 	cpumask_var_t opp_shared_cpus;
 	struct notifier_block limit_notify_nb;
@@ -55,6 +64,33 @@ static unsigned int scmi_cpufreq_get_rate(unsigned int cpu)
 	return rate / 1000;
 }
 
+/* Must hold bw_lock */
+static void scmi_cpufreq_set_bw(struct scmi_data *priv, unsigned long freq)
+{
+	struct dev_pm_opp *opp __free(put_opp) =
+		dev_pm_opp_find_freq_ceil(priv->cpu_dev, &freq);
+
+	if (!IS_ERR(opp))
+		dev_pm_opp_set_opp(priv->cpu_dev, opp);
+}
+
+static void scmi_cpufreq_bw_work(struct work_struct *work)
+{
+	struct scmi_data *priv = container_of(work, struct scmi_data, bw_work);
+
+	guard(mutex)(&priv->bw_lock);
+	if (priv->bw_enabled)
+		scmi_cpufreq_set_bw(priv, READ_ONCE(priv->bw_freq));
+}
+
+/* Fast switches run in scheduler context, where votes can't sleep */
+static void scmi_cpufreq_bw_irq_work(struct irq_work *iw)
+{
+	struct scmi_data *priv = container_of(iw, struct scmi_data, bw_irq_work);
+
+	queue_work(system_highpri_wq, &priv->bw_work);
+}
+
 /*
  * perf_ops->freq_set is not a synchronous, the actual OPP change will
  * happen asynchronously and can get notified if the events are
@@ -66,6 +102,13 @@ scmi_cpufreq_set_target(struct cpufreq_policy *policy, unsigned int index)
 	struct scmi_data *priv = policy->driver_data;
 	u64 freq = policy->freq_table[index].frequency;
 
+	if (READ_ONCE(priv->bw_enabled)) {
+		guard(mutex)(&priv->bw_lock);
+		WRITE_ONCE(priv->bw_freq, freq * 1000);
+		if (priv->bw_enabled)
+			scmi_cpufreq_set_bw(priv, freq * 1000);
+	}
+
 	return perf_ops->freq_set(ph, priv->domain_id, freq * 1000, false);
 }
 
@@ -75,12 +118,52 @@ static unsigned int scmi_cpufreq_fast_switch(struct cpufreq_policy *policy,
 	struct scmi_data *priv = policy->driver_data;
 	unsigned long freq = target_freq;
 
-	if (!perf_ops->freq_set(ph, priv->domain_id, freq * 1000, true))
-		return target_freq;
+	if (perf_ops->freq_set(ph, priv->domain_id, freq * 1000, true))
+		return 0;
+
+	if (READ_ONCE(priv->bw_enabled)) {
+		WRITE_ONCE(priv->bw_freq, freq * 1000);
+		irq_work_queue(&priv->bw_irq_work);
+	}
 
-	return 0;
+	return target_freq;
 }
 
+static ssize_t show_bandwidth_votes(struct cpufreq_policy *policy, char *buf)
+{
+	struct scmi_data *priv = policy->driver_data;
+
+	return sysfs_emit(buf, "%d\n", READ_ONCE(priv->bw_enabled));
+}
+
+static ssize_t store_bandwidth_votes(struct cpufreq_policy *policy, const char *buf,
+				     size_t count)
+{
+	struct scmi_data *priv = policy->driver_data;
+	bool enable;
+
+	if (!priv->bw_votes)
+		return -EOPNOTSUPP;
+	if (kstrtobool(buf, &enable))
+		return -EINVAL;
+
+	guard(mutex)(&priv->bw_lock);
+	WRITE_ONCE(priv->bw_enabled, enable);
+	if (enable)
+		scmi_cpufreq_set_bw(priv, policy->cur * 1000UL);
+	else
+		dev_pm_opp_set_opp(priv->cpu_dev, NULL);
+
+	return count;
+}
+
+cpufreq_freq_attr_rw(bandwidth_votes);
+
+static struct freq_attr *scmi_cpufreq_attr[] = {
+	&bandwidth_votes,
+	NULL
+};
+
 static int scmi_cpu_domain_id(struct device *cpu_dev)
 {
 	struct device_node *np = cpu_dev->of_node;
@@ -218,6 +301,10 @@ static int scmi_cpufreq_init(struct cpufreq_policy *policy)
 	if (!priv)
 		return -ENOMEM;
 
+	mutex_init(&priv->bw_lock);
+	init_irq_work(&priv->bw_irq_work, scmi_cpufreq_bw_irq_work);
+	INIT_WORK(&priv->bw_work, scmi_cpufreq_bw_work);
+
 	if (!zalloc_cpumask_var(&priv->opp_shared_cpus, GFP_KERNEL)) {
 		ret = -ENOMEM;
 		goto out_free_priv;
@@ -252,10 +339,23 @@ static int scmi_cpufreq_init(struct cpufreq_policy *policy)
 	  */
 	nr_opp = dev_pm_opp_get_opp_count(cpu_dev);
 	if (nr_opp <= 0) {
+		/*
+		 * An OPP table in DT can carry the memory bandwidth to vote
+		 * for at each frequency; the firmware adds the frequencies
+		 * it leaves out.
+		 */
+		if (of_property_present(cpu_dev->of_node, "interconnects")) {
+			ret = dev_pm_opp_of_add_table(cpu_dev);
+			if (ret)
+				goto out_free_cpumask;
+			priv->bw_votes = true;
+			priv->bw_enabled = true;
+		}
+
 		ret = perf_ops->device_opps_add(ph, cpu_dev, domain);
 		if (ret) {
 			dev_warn(cpu_dev, "failed to add opps to the device\n");
-			goto out_free_cpumask;
+			goto out_remove_table;
 		}
 
 		nr_opp = dev_pm_opp_get_opp_count(cpu_dev);
@@ -328,6 +428,9 @@ static int scmi_cpufreq_init(struct cpufreq_policy *policy)
 	dev_pm_opp_free_cpufreq_table(cpu_dev, &freq_table);
 out_free_opp:
 	dev_pm_opp_remove_all_dynamic(cpu_dev);
+out_remove_table:
+	if (priv->bw_votes)
+		dev_pm_opp_of_remove_table(cpu_dev);
 
 out_free_cpumask:
 	free_cpumask_var(priv->opp_shared_cpus);
@@ -348,8 +451,12 @@ static void scmi_cpufreq_exit(struct cpufreq_policy *policy)
 							    &priv->domain_id,
 							    &priv->limit_notify_nb);
 	freq_qos_remove_request(&priv->limits_freq_req);
+	irq_work_sync(&priv->bw_irq_work);
+	cancel_work_sync(&priv->bw_work);
 	dev_pm_opp_free_cpufreq_table(priv->cpu_dev, &policy->freq_table);
 	dev_pm_opp_remove_all_dynamic(priv->cpu_dev);
+	if (priv->bw_votes)
+		dev_pm_opp_of_remove_table(priv->cpu_dev);
 	free_cpumask_var(priv->opp_shared_cpus);
 	kfree(priv);
 }
@@ -393,6 +500,7 @@ static struct cpufreq_driver scmi_cpufreq_driver = {
 	.exit	= scmi_cpufreq_exit,
 	.register_em	= scmi_cpufreq_register_em,
 	.set_boost	= cpufreq_boost_set_sw,
+	.attr	= scmi_cpufreq_attr,
 };
 
 static bool scmi_dev_used_by_cpus(struct device *scmi_dev)
@@ -440,8 +548,9 @@ static bool scmi_dev_used_by_cpus(struct device *scmi_dev)
 
 static int scmi_cpufreq_probe(struct scmi_device *sdev)
 {
-	int ret;
+	int cpu, ret;
 	struct device *dev = &sdev->dev;
+	struct device *cpu_dev;
 	const struct scmi_handle *handle;
 
 	handle = sdev->handle;
@@ -449,6 +558,17 @@ static int scmi_cpufreq_probe(struct scmi_device *sdev)
 	if (!handle || !scmi_dev_used_by_cpus(dev))
 		return -ENODEV;
 
+	/* The OPP tables of the CPUs need their interconnect paths */
+	for_each_possible_cpu(cpu) {
+		cpu_dev = get_cpu_device(cpu);
+		if (!cpu_dev || !of_property_present(cpu_dev->of_node, "interconnects"))
+			continue;
+
+		ret = dev_pm_opp_of_find_icc_paths(cpu_dev, NULL);
+		if (ret)
+			return dev_err_probe(dev, ret, "failed to find icc paths\n");
+	}
+
 	scmi_cpufreq_driver.driver_data = sdev;
 
 	perf_ops = handle->devm_protocol_get(sdev, SCMI_PROTOCOL_PERF, &ph);
diff --git a/drivers/firmware/arm_scmi/perf.c b/drivers/firmware/arm_scmi/perf.c
index 4583d02be..37b0bdd1b 100644
--- a/drivers/firmware/arm_scmi/perf.c
+++ b/drivers/firmware/arm_scmi/perf.c
@@ -867,6 +867,7 @@ static int scmi_dvfs_device_opps_add(const struct scmi_protocol_handle *ph,
 	int idx, ret;
 	unsigned long freq;
 	struct dev_pm_opp_data data = {};
+	struct dev_pm_opp *opp;
 	struct perf_dom_info *dom;
 
 	dom = scmi_perf_domain_lookup(ph, domain);
@@ -879,6 +880,13 @@ static int scmi_dvfs_device_opps_add(const struct scmi_protocol_handle *ph,
 		else
 			freq = dom->opp[idx].indicative_freq * dom->mult_factor;
 
+		/* An OPP table in DT may hold this frequency already */
+		opp = dev_pm_opp_find_freq_exact(dev, freq, true);
+		if (!IS_ERR(opp)) {
+			dev_pm_opp_put(opp);
+			continue;
+		}
+
 		/* All OPPs above the sustained frequency are treated as turbo */
 		data.turbo = freq > dom->sustained_freq_khz * 1000UL;
 
-- 
2.56.0

