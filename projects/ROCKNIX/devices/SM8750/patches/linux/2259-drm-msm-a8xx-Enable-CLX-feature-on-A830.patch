From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Andr=C3=A9=20Braga?= <code@andrebraga.com>
Date: Sat, 7 Nov 2026 08:35:35 +0000
Subject: [PATCH] drm/msm/a8xx: Enable CLX feature on A830

Add the A830 CLX domain table to the catalog, so the GMU limits the
peak current on the GX and MXG rails as it does on A840. The values
are the ones the downstream kgsl driver sends for gen8_0_0: a current
rating of 55 on both domains, 4 GX phases and 1 MXG phase, budgets of
100 and 50. Downstream sends no IFF/PCLX limits table for this GPU.
---
 drivers/gpu/drm/msm/adreno/a6xx_catalog.c | 25 +++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
index 685ba1296..b357d7258 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -1981,6 +1981,30 @@ static const struct adreno_reglist_pipe a830_dyn_pwrup_reglist_regs[] = {
 };
 DECLARE_ADRENO_REGLIST_PIPE_LIST(a830_dyn_pwrup_reglist);
 
+static const struct a6xx_hfi_clx_table_v2_cmd a830_clx_tbl = {
+	.version = (2 << 16) | 1,
+	.domain = {
+		/* GX DOMAIN */
+		{
+			.data = CLX_DATA(55, 4, 1, 1),
+			.clxt = 0,
+			.clxh = 0,
+			.urg_mode = 1,
+			.lkg_en = 0,
+			.curr_budget = 100,
+		},
+		/* MXG DOMAIN */
+		{
+			.data = CLX_DATA(55, 1, 1, 1),
+			.clxt = 0,
+			.clxh = 0,
+			.urg_mode = 1,
+			.lkg_en = 0,
+			.curr_budget = 50,
+		},
+	},
+};
+
 static const struct adreno_reglist_pipe x285_nonctxt_regs[] = {
 	{ REG_A8XX_CP_SMMU_STREAM_ID_LPAC, 0x00000101, BIT(PIPE_NONE) },
 	{ REG_A8XX_GRAS_DBG_ECO_CNTL, 0x00000800, BIT(PIPE_BV) | BIT(PIPE_BR) },
@@ -2721,6 +2745,7 @@ static const struct adreno_info a8xx_gpus[] = {
 				},
 				{ /* sentinel */ },
 			},
+			.clx_tbl = &a830_clx_tbl,
 		},
 		.preempt_record_size = 13536 * SZ_1K,
 		.speedbins = ADRENO_SPEEDBINS(
