# AMD BC-250: only its Cyan Skillfish APU has GPU 1002:13fe, whatever the BIOS puts in DMI

# The NCT6686D sensor chip is supported in-tree but has nothing to autoload it
ACTION=="add", SUBSYSTEM=="pci", ATTR{vendor}=="0x1002", ATTR{device}=="0x13fe", RUN{builtin}+="kmod load nct6683"

# Scale the GPU clock with load once amdgpu has registered the card
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", ENV{DEVTYPE}=="drm_minor", ATTRS{vendor}=="0x1002", ATTRS{device}=="0x13fe", \
  TAG+="systemd", ENV{SYSTEMD_WANTS}+="oberon-governor.service"
