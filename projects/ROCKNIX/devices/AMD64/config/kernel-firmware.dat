# MICROCODE_AMD (Van Gogh/Phoenix/Hawk Point APUs - Deck, Ally, Legion Go, Ayaneo)
amd-ucode/*

# DRM_AMDGPU (AMD APU graphics - most handhelds)
amdgpu/*

# AMD_PMF (AMD platform power policy, loaded through AMDTEE)
amdtee/*

# DRM_I915 (Intel graphics - GPD Win, OneXPlayer Intel models, older Aya Neo Air)
i915/*

# DRM_XE (Intel Meteor Lake/Lunar Lake handhelds - newer GPD/OneXPlayer)
xe/*

# IWLWIFI (Intel WiFi)
iwlwifi-*

# ATH10K (Qualcomm Atheros 802.11ac)
ath10k/*

# ATH11K (Qualcomm Atheros WiFi 6)
ath11k/*

# ATH12K (Qualcomm Atheros WiFi 7)
ath12k/*

# MEDIATEK_MT76 WiFi (MT7921 chip uses MT7961-codenamed firmware; MT7922 uses its own; MT7925 and MT7927 have subdirs; MT7902 is budget Wi-Fi 6E)
mediatek/WIFI_RAM_CODE_MT7961*.bin
mediatek/WIFI_MT7961_patch_mcu*.bin
mediatek/BT_RAM_CODE_MT7961*.bin
mediatek/WIFI_RAM_CODE_MT7922*.bin
mediatek/WIFI_MT7922_patch_mcu*.bin
mediatek/BT_RAM_CODE_MT7922*.bin
mediatek/mt7925/*
mediatek/WIFI_RAM_CODE_MT7902*.bin
mediatek/WIFI_MT7902_patch_mcu*.bin
mediatek/BT_RAM_CODE_MT7902*.bin
mediatek/mt7927/*

# USB Wi-Fi dongles: MediaTek/Ralink (MT7601U, MT7610U, MT7612U, RT2x00) and Atheros (AR9271, AR9170)
mt7601u.bin
mediatek/mt7610e.bin
mediatek/mt7610u.bin
mediatek/mt7650e.bin
mt7662.bin
mt7662_rom_patch.bin
rt2561*.bin
rt2661.bin
rt2860.bin
rt2870.bin
rt73.bin
ath9k_htc/*
carl9170-1.fw

# RTW89 (Realtek WiFi 6/6E - some Ayaneo/OneXPlayer variants)
rtw89/*

# Realtek onboard NIC/misc
realtek/*

# Bluetooth - Realtek (pairs with rtw89 combo cards)
rtl_bt/*

# Bluetooth - Qualcomm Atheros (pairs with some Intel/QCA combo cards)
qca/*

# Bluetooth - Intel (pairs with iwlwifi combo cards)
intel/ibt-*

# SND_SOC_SOF_INTEL (Intel audio DSP - GPD/OneXPlayer Intel models)
intel/avs/*

# Cirrus Logic / TI smart-amp speaker firmware (onboard speaker amps - many handhelds use these)
cs42l43.bin
cirrus/*
TAS2XXX*.bin
TIAS2781RCA*.bin
TXNW*.bin

# SND_HDA_CODEC_CA0132 (Creative Sound Blaster Z/ZxR/AE-5 cards, Sound Core3D onboard audio)
ctefx.bin

# TIGON3 (Broadcom BCM57766 Ethernet - Mac mini, iMac)
tigon/*

# BMI270_I2C (BMI260 IMU - GPD, OneXPlayer, AYANEO)
bmi260-init-data.fw

# INTEL_ISH_HID (Intel sensor hub - Lunar Lake and newer, e.g. MSI Claw 8 AI+)
intel/ish/*

# Realtek WiFi/Bluetooth - all variants (RTL8188/8192/8723/8821/8822/8852 etc.)
rtlwifi/*
rtw88/*
rtw89/*
rtl_bt/*

# USB_RTL8152 (USB-C dock ethernet - common accessory for handhelds/SFF)
rtl_nic/*
