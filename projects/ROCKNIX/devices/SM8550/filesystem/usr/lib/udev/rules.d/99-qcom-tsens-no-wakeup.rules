# Disable the qcom-tsens wakeup so the thermal sensors cannot end suspend.
#
# The sensors are registered as wakeup sources and their interrupt fires while
# the SoC is suspended. This woke the Thor a few minutes after the lid was
# closed, with no lid or power-key event (/sys/power/pm_wakeup_irq reported the
# c271000.thermal-sensor IRQ). Temperature readings are unaffected.
SUBSYSTEM=="platform", DRIVER=="qcom-tsens", ATTR{power/wakeup}="disabled"
