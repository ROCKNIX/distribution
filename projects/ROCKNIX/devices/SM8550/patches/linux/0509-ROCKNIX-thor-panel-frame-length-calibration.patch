 static int icna35xx_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -815,6 +921,16 @@ static int icna35xx_probe(struct mipi_dsi_device *dsi)
 
 	pinfo->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
