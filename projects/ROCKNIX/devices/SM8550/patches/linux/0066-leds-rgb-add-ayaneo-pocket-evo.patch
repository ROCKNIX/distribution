+static ssize_t calibration_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	u8 green_percent;
+	u8 blue_percent;
+
+	mutex_lock(&rgb->lock);
+	green_percent = rgb->calibration.green_percent;
+	blue_percent = rgb->calibration.blue_percent;
+	mutex_unlock(&rgb->lock);
+
+	return sysfs_emit(buf, "%u %u\n", green_percent, blue_percent);
+}
+
+static ssize_t calibration_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	struct evo_calibration old_calibration;
+	u8 values[EVO_CALIBRATION_VALUE_COUNT];
+	u16 old_effect_step;
+	bool restart_work = false;
+	int ret;
+
+	ret = evo_parse_values(buf, values, ARRAY_SIZE(values));
+	if (ret)
+		return ret;
+	if (values[0] > EVO_CALIBRATION_PERCENT_MAX ||
+	    values[1] > EVO_CALIBRATION_PERCENT_MAX)
+		return -ERANGE;
+
+	cancel_delayed_work_sync(&rgb->effect_work);
+	evo_lock_led_caches(rgb);
+	mutex_lock(&rgb->lock);
+	if (rgb->tx_inhibited) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (rgb->calibration.green_percent == values[0] &&
+	    rgb->calibration.blue_percent == values[1]) {
+		restart_work = evo_restore_is_pending(rgb) ||
+			(rgb->enabled &&
+			 evo_effect_is_host_rendered(rgb->effect));
+		goto out;
+	}
+
+	old_calibration = rgb->calibration;
+	old_effect_step = rgb->effect_step;
+	rgb->calibration.green_percent = values[0];
+	rgb->calibration.blue_percent = values[1];
+	rgb->static_coherent = false;
+
+	if (!rgb->enabled || !rgb->state_valid) {
+		rgb->rgb_restore_pending = false;
+		restart_work = rgb->xbox360_restore_pending;
+		goto out;
+	}
+	if (!evo_effect_uses_calibration(rgb->effect)) {
+		restart_work = evo_restore_is_pending(rgb) ||
+			evo_effect_is_host_rendered(rgb->effect);
+		goto out;
+	}
+
+	ret = evo_restore_xbox360_locked(rgb);
+	if (ret)
+		goto rollback;
+	ret = evo_restore_rgb_locked(rgb);
+	if (ret)
+		goto rollback;
+
+	rgb->rgb_restore_pending = false;
+	restart_work = rgb->xbox360_restore_pending ||
+		evo_effect_is_host_rendered(rgb->effect);
+	goto out;
+
+rollback:
+	rgb->calibration = old_calibration;
+	rgb->effect_step = old_effect_step;
+	rgb->static_coherent = false;
+	evo_mark_rgb_restore_pending(rgb);
+	restart_work = evo_restore_is_pending(rgb) ||
+		evo_effect_is_host_rendered(rgb->effect);
+out:
+	if (restart_work)
+		mod_delayed_work(system_freezable_wq, &rgb->effect_work,
+				 msecs_to_jiffies(EVO_EFFECT_TICK_MS));
+	mutex_unlock(&rgb->lock);
+	evo_unlock_led_caches(rgb);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(calibration);
+
+static ssize_t zone_index_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf,
+		"left-zone-270 left-zone-0 left-zone-90 left-zone-180 "
+		"right-zone-270 right-zone-0 right-zone-90 right-zone-180\n");
+}
+static DEVICE_ATTR_RO(zone_index);
+
+static ssize_t zone_layout_show(struct device *dev,
+				struct device_attribute *attr, char *buf)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	int len = 0;
+	int i;
+	int channel;
+
+	mutex_lock(&rgb->lock);
+	for (i = 0; i < EVO_ZONE_COUNT; i++)
+		for (channel = 0; channel < 4; channel++)
+			len += sysfs_emit_at(buf, len, "%s%u",
+					     i || channel ? " " : "",
+					     rgb->layout[i][channel]);
+	len += sysfs_emit_at(buf, len, "\n");
+	mutex_unlock(&rgb->lock);
+
+	return len;
+}
+
+static ssize_t zone_layout_store(struct device *dev,
+				 struct device_attribute *attr,
+				 const char *buf, size_t count)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	u8 next_layout[EVO_ZONE_COUNT][4];
+	bool restart_work = false;
+	int i;
+	int channel;
+	int ret;
+
+	ret = evo_parse_values(buf, &next_layout[0][0],
+			       EVO_LAYOUT_VALUE_COUNT);
+	if (ret)
+		return ret;
+
+	cancel_delayed_work_sync(&rgb->effect_work);
+	evo_lock_led_caches(rgb);
+	mutex_lock(&rgb->lock);
+	if (rgb->tx_inhibited) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (rgb->enabled) {
+		ret = evo_restore_xbox360_locked(rgb);
+		if (ret)
+			goto out;
+		ret = evo_apply_layout_locked(rgb, next_layout);
+		if (ret) {
+			rgb->static_coherent = false;
+			goto out;
+		}
+	}
+
+	memcpy(rgb->layout, next_layout, sizeof(rgb->layout));
+	for (i = 0; i < EVO_ZONE_COUNT; i++) {
+		for (channel = 0; channel < 3; channel++)
+			rgb->zones[i].subled[channel].intensity =
+				rgb->layout[i][channel];
+		rgb->zones[i].mc.led_cdev.brightness = rgb->layout[i][3];
+	}
+	rgb->effect = EVO_EFFECT_STATIC;
+	rgb->state_valid = true;
+	rgb->static_coherent = rgb->enabled;
+	rgb->rgb_restore_pending = false;
+	restart_work = rgb->xbox360_restore_pending;
+out:
+	if (ret) {
+		evo_mark_rgb_restore_pending(rgb);
+		restart_work = !rgb->tx_inhibited &&
+			(evo_restore_is_pending(rgb) ||
+			 (rgb->enabled &&
+			  evo_effect_is_host_rendered(rgb->effect)));
+	}
+	if (restart_work)
+		mod_delayed_work(system_freezable_wq, &rgb->effect_work,
+				 msecs_to_jiffies(EVO_EFFECT_TICK_MS));
+	mutex_unlock(&rgb->lock);
+	evo_unlock_led_caches(rgb);
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(zone_layout);
+
+static ssize_t available_effects_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "static breath rgb-breath rainbow reactive\n");
+}
+static DEVICE_ATTR_RO(available_effects);
+
+static int evo_effect_by_name(const char *name, enum evo_effect *effect)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(evo_effect_names); i++) {
+		if (!strcmp(name, evo_effect_names[i])) {
+			*effect = i;
+			return 0;
+		}
+	}
+
+	return -EINVAL;
+}
+
+static unsigned int evo_effect_arg_count(enum evo_effect effect)
+{
+	switch (effect) {
+	case EVO_EFFECT_BREATH:
+		return 4;
+	case EVO_EFFECT_RGB_BREATH:
+		return 1;
+	case EVO_EFFECT_REACTIVE:
+		return 7;
+	default:
+		return 0;
+	}
+}
+
+static int evo_parse_effect(const char *buf, enum evo_effect *effect, u8 *args)
+{
+	char *cursor;
+	char *copy;
+	char *token;
+	unsigned int nargs;
+	unsigned int i;
+	int ret;
+
+	copy = kstrdup(buf, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	cursor = copy;
+	token = evo_next_token(&cursor);
+	if (!token) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	ret = evo_effect_by_name(token, effect);
+	if (ret)
+		goto out;
+	nargs = evo_effect_arg_count(*effect);
+	for (i = 0; i < nargs; i++) {
+		token = evo_next_token(&cursor);
+		if (!token || kstrtou8(token, 10, &args[i])) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	if (evo_next_token(&cursor))
+		ret = -EINVAL;
+out:
+	kfree(copy);
+	return ret;
+}
+
+static ssize_t effect_show(struct device *dev, struct device_attribute *attr,
+			   char *buf)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	unsigned int nargs;
+	int len;
+	unsigned int i;
+
+	mutex_lock(&rgb->lock);
+	len = sysfs_emit(buf, "%s", evo_effect_names[rgb->effect]);
+	nargs = evo_effect_arg_count(rgb->effect);
+	for (i = 0; i < nargs; i++)
+		len += sysfs_emit_at(buf, len, " %u", rgb->effect_args[i]);
+	len += sysfs_emit_at(buf, len, "\n");
+	mutex_unlock(&rgb->lock);
+
+	return len;
+}
+
+static ssize_t effect_store(struct device *dev, struct device_attribute *attr,
+			    const char *buf, size_t count)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	enum evo_effect effect;
+	u8 args[7] = {};
+	u8 frame[EVO_COMMAND_FRAME_SIZE] = {};
+	u16 next_step = 0;
+	bool restart_work = false;
+	bool start_work = false;
+	int ret;
+
+	ret = evo_parse_effect(buf, &effect, args);
+	if (ret)
+		return ret;
+
+	cancel_delayed_work_sync(&rgb->effect_work);
+	evo_lock_led_caches(rgb);
+	mutex_lock(&rgb->lock);
+	if (rgb->tx_inhibited) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	if (rgb->enabled) {
+		ret = evo_restore_xbox360_locked(rgb);
+		if (ret)
+			goto out;
+
+		switch (effect) {
+		case EVO_EFFECT_STATIC:
+			ret = evo_apply_layout_locked(rgb, rgb->layout);
+			break;
+		case EVO_EFFECT_BREATH:
+		case EVO_EFFECT_RGB_BREATH:
+			ret = evo_render_breath_locked(rgb, effect, args,
+						       &next_step);
+			break;
+		case EVO_EFFECT_RAINBOW:
+			ret = evo_write_repeated_locked(rgb, evo_rainbow_frame,
+							sizeof(evo_rainbow_frame),
+							EVO_COMMAND_GAP_MS);
+			break;
+		case EVO_EFFECT_REACTIVE:
+			evo_build_reactive_frame(frame, args,
+						 &rgb->calibration);
+			ret = evo_write_repeated_locked(rgb, frame,
+							sizeof(frame),
+							EVO_COMMAND_GAP_MS);
+			break;
+		}
+	}
+	if (ret) {
+		rgb->static_coherent = false;
+		goto out;
+	}
+
+	rgb->rgb_restore_pending = false;
+	rgb->effect = effect;
+	memcpy(rgb->effect_args, args, sizeof(args));
+	rgb->effect_step = next_step;
+	rgb->state_valid = true;
+	rgb->static_coherent = rgb->enabled && effect == EVO_EFFECT_STATIC;
+	start_work = rgb->xbox360_restore_pending ||
+		(rgb->enabled && evo_effect_is_host_rendered(effect));
+out:
+	if (ret) {
+		evo_mark_rgb_restore_pending(rgb);
+		restart_work = !rgb->tx_inhibited &&
+			(evo_restore_is_pending(rgb) ||
+			 (rgb->enabled &&
+			  evo_effect_is_host_rendered(rgb->effect)));
+	}
+	if (start_work || restart_work)
+		mod_delayed_work(system_freezable_wq, &rgb->effect_work,
+				 msecs_to_jiffies(EVO_EFFECT_TICK_MS));
+	mutex_unlock(&rgb->lock);
+	evo_unlock_led_caches(rgb);
+
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(effect);
+
+static ssize_t enabled_show(struct device *dev,
+			    struct device_attribute *attr, char *buf)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	bool enabled;
+
+	mutex_lock(&rgb->lock);
+	enabled = rgb->enabled;
+	mutex_unlock(&rgb->lock);
+
+	return sysfs_emit(buf, "%u\n", enabled);
+}
+
+static ssize_t enabled_store(struct device *dev,
+			     struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct evo_rgb *rgb = dev_get_drvdata(dev);
+	bool start_work = false;
+	bool enable;
+	int blank_ret;
+	int ret;
+
+	ret = kstrtobool(buf, &enable);
+	if (ret)
+		return ret;
+
+	cancel_delayed_work_sync(&rgb->effect_work);
+	evo_lock_led_caches(rgb);
+	mutex_lock(&rgb->lock);
+	if (rgb->tx_inhibited) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	if (enable == rgb->enabled) {
+		start_work = evo_restore_is_pending(rgb) ||
+			(enable && evo_effect_is_host_rendered(rgb->effect));
+		ret = 0;
+		goto out;
+	}
+	ret = evo_restore_xbox360_locked(rgb);
+	if (ret)
+		goto out;
+
+	if (!enable) {
+		ret = evo_write_repeated_locked(rgb, evo_off_frame,
+						sizeof(evo_off_frame),
+						EVO_COMMAND_GAP_MS);
+		if (ret) {
+			start_work =
+				evo_effect_is_host_rendered(rgb->effect);
+			goto out;
+		}
+
+		rgb->enabled = false;
+		rgb->static_coherent = false;
+		rgb->rgb_restore_pending = false;
+		goto out;
+	}
+
+	/* Restore without resending the independent Xbox 360 mode bootstrap. */
+	rgb->enabled = true;
+	ret = evo_restore_rgb_locked(rgb);
+	if (ret) {
+		blank_ret = evo_write_repeated_locked(rgb, evo_off_frame,
+						      sizeof(evo_off_frame),
+						      EVO_COMMAND_GAP_MS);
+		if (blank_ret)
+			dev_warn(&rgb->serdev->dev,
+				 "could not reblank RGB after restore failure: %d\n",
+				 blank_ret);
+		rgb->enabled = false;
+		rgb->static_coherent = false;
+		rgb->rgb_restore_pending = false;
+		goto out;
+	}
+
+	rgb->rgb_restore_pending = false;
+	start_work = evo_effect_is_host_rendered(rgb->effect);
+out:
+	if (ret) {
+		evo_mark_rgb_restore_pending(rgb);
+		if (!rgb->tx_inhibited)
+			start_work = evo_restore_is_pending(rgb) ||
+				(rgb->enabled &&
+				 evo_effect_is_host_rendered(rgb->effect));
+	}
+	if (start_work)
+		mod_delayed_work(system_freezable_wq, &rgb->effect_work,
+				 msecs_to_jiffies(EVO_EFFECT_TICK_MS));
+	mutex_unlock(&rgb->lock);
+	evo_unlock_led_caches(rgb);
+
+	if (ret)
+		return ret;
+
+	return count;
+}
+static DEVICE_ATTR_RW(enabled);
+
+static struct attribute *evo_rgb_attrs[] = {
+	&dev_attr_abi_version.attr,
+	&dev_attr_calibration.attr,
+	&dev_attr_zone_index.attr,
+	&dev_attr_zone_layout.attr,
+	&dev_attr_available_effects.attr,
+	&dev_attr_effect.attr,
+	&dev_attr_enabled.attr,
+	NULL,
+};
+
+static const struct attribute_group evo_rgb_group = {
+	.name = "rgb",
+	.attrs = evo_rgb_attrs,
+};
+
+static int evo_pm_notify(struct notifier_block *nb, unsigned long action,
+			 void *data)
+{
+	struct evo_rgb *rgb = container_of(nb, struct evo_rgb, pm_nb);
+	int ret;
+
+	switch (action) {
+	case PM_SUSPEND_PREPARE:
+	case PM_HIBERNATION_PREPARE:
+	case PM_RESTORE_PREPARE:
+		cancel_delayed_work_sync(&rgb->effect_work);
+		mutex_lock(&rgb->lock);
+		if (!rgb->tx_inhibited && rgb->enabled) {
+			ret = evo_write_repeated_locked(rgb, evo_off_frame,
+							sizeof(evo_off_frame),
+							EVO_COMMAND_GAP_MS);
+			if (ret)
+				dev_warn(&rgb->serdev->dev,
+					 "could not blank RGB before suspend: %d\n",
+					 ret);
+		}
+		rgb->tx_inhibited = true;
+		rgb->static_coherent = false;
+		mutex_unlock(&rgb->lock);
+		break;
+	case PM_POST_SUSPEND:
+	case PM_POST_HIBERNATION:
+	case PM_POST_RESTORE:
+		mutex_lock(&rgb->lock);
+		rgb->tx_inhibited = false;
+		rgb->static_coherent = false;
+		rgb->xbox360_restore_pending = rgb->xbox360_mode;
+		rgb->rgb_restore_pending = rgb->enabled && rgb->state_valid;
+		mutex_unlock(&rgb->lock);
+		mod_delayed_work(system_freezable_wq, &rgb->effect_work, 0);
+		break;
+	default:
+		break;
+	}
+
+	return NOTIFY_DONE;
+}
+
+static void evo_unregister_pm_notifier(void *data)
+{
+	struct evo_rgb *rgb = data;
+
+	unregister_pm_notifier(&rgb->pm_nb);
+}
+
+static void evo_init_zone(struct evo_rgb *rgb, unsigned int index)
+{
+	struct evo_zone *zone = &rgb->zones[index];
+	struct led_classdev *cdev = &zone->mc.led_cdev;
+
+	zone->rgb = rgb;
+	zone->index = index;
+	zone->subled[0].color_index = LED_COLOR_ID_RED;
+	zone->subled[1].color_index = LED_COLOR_ID_GREEN;
+	zone->subled[2].color_index = LED_COLOR_ID_BLUE;
+	zone->subled[0].intensity = 255;
+	zone->subled[1].intensity = 255;
+	zone->subled[2].intensity = 255;
+	zone->subled[0].max_intensity = 255;
+	zone->subled[1].max_intensity = 255;
+	zone->subled[2].max_intensity = 255;
+	rgb->layout[index][0] = 255;
+	rgb->layout[index][1] = 255;
+	rgb->layout[index][2] = 255;
+	zone->mc.num_colors = ARRAY_SIZE(zone->subled);
+	zone->mc.subled_info = zone->subled;
+	cdev->name = evo_zone_names[index];
+	cdev->color = LED_COLOR_ID_RGB;
+	cdev->max_brightness = 255;
+	cdev->flags |= LED_RETAIN_AT_SHUTDOWN;
+	cdev->brightness_set_blocking = evo_zone_set;
+}
+
+static int evo_register_zone(struct evo_rgb *rgb, unsigned int index)
+{
+	struct evo_zone *zone = &rgb->zones[index];
+
+	return devm_led_classdev_multicolor_register(&rgb->serdev->dev,
+						      &zone->mc);
+}
+
+static int evo_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct evo_rgb *rgb;
+	unsigned int baud;
+	unsigned int i;
+	int ret;
+
+	rgb = devm_kzalloc(dev, sizeof(*rgb), GFP_KERNEL);
+	if (!rgb)
+		return -ENOMEM;
+
+	rgb->serdev = serdev;
+	rgb->effect = EVO_EFFECT_STATIC;
+	rgb->enabled = true;
+	rgb->xbox360_mode =
+		device_property_read_bool(dev, "ayaneo,xbox360-mode");
+	rgb->calibration.green_percent =
+		EVO_CALIBRATION_GREEN_DEFAULT_PERCENT;
+	rgb->calibration.blue_percent =
+		EVO_CALIBRATION_BLUE_DEFAULT_PERCENT;
+	mutex_init(&rgb->lock);
+	INIT_DELAYED_WORK(&rgb->effect_work, evo_effect_work);
+	serdev_device_set_drvdata(serdev, rgb);
+	serdev_device_set_client_ops(serdev, &evo_serdev_ops);
+
+	ret = devm_serdev_device_open(dev, serdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not open RGB UART\n");
+
+	baud = serdev_device_set_baudrate(serdev, EVO_BAUD_RATE);
+	if (baud != EVO_BAUD_RATE)
+		return dev_err_probe(dev, -EINVAL,
+				     "could not set 115200 baud (got %u)\n", baud);
+	serdev_device_set_flow_control(serdev, false);
+	ret = serdev_device_set_parity(serdev, SERDEV_PARITY_NONE);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not set 8N1 framing\n");
+
+	if (rgb->xbox360_mode) {
+		mutex_lock(&rgb->lock);
+		ret = evo_send_xbox360_locked(rgb);
+		mutex_unlock(&rgb->lock);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "could not initialize Xbox 360 mode\n");
+	}
+
+	for (i = 0; i < EVO_ZONE_COUNT; i++)
+		evo_init_zone(rgb, i);
+
+	for (i = 0; i < EVO_ZONE_COUNT; i++) {
+		ret = evo_register_zone(rgb, i);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "could not register RGB zone %u\n", i);
+	}
+
+	ret = devm_device_add_group(dev, &evo_rgb_group);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not create RGB ABI\n");
+
+	rgb->pm_nb.notifier_call = evo_pm_notify;
+	ret = register_pm_notifier(&rgb->pm_nb);
+	if (ret)
+		return dev_err_probe(dev, ret, "could not register PM notifier\n");
+
+	ret = devm_add_action_or_reset(dev, evo_unregister_pm_notifier, rgb);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "AYANEO serial MCU registered (Pocket EVO eight-zone RGB%s)\n",
+		 rgb->xbox360_mode ? ", Xbox 360 mode" : "");
+	return 0;
+}
+
+static void evo_remove(struct serdev_device *serdev)
+{
+	struct evo_rgb *rgb = serdev_device_get_drvdata(serdev);
+
+	devm_release_action(&serdev->dev, evo_unregister_pm_notifier, rgb);
+	mutex_lock(&rgb->lock);
+	rgb->tx_inhibited = true;
+	mutex_unlock(&rgb->lock);
+	cancel_delayed_work_sync(&rgb->effect_work);
+}
+
+static void evo_shutdown(struct serdev_device *serdev)
+{
+	struct evo_rgb *rgb = serdev_device_get_drvdata(serdev);
+
+	cancel_delayed_work_sync(&rgb->effect_work);
+	mutex_lock(&rgb->lock);
+	if (!rgb->tx_inhibited && rgb->enabled)
+		evo_write_repeated_locked(rgb, evo_off_frame,
+					  sizeof(evo_off_frame),
+					  EVO_COMMAND_GAP_MS);
+	rgb->tx_inhibited = true;
+	mutex_unlock(&rgb->lock);
+}
+
+static const struct of_device_id evo_of_match[] = {
+	{ .compatible = "ayaneo,serial-mcu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, evo_of_match);
+
+static struct serdev_device_driver evo_driver = {
+	.probe = evo_probe,
+	.remove = evo_remove,
+	.shutdown = evo_shutdown,
+	.driver = {
+		.name = "ayaneo-serial-mcu",
+		.of_match_table = evo_of_match,
+	},
+};
+module_serdev_device_driver(evo_driver);
