diff --git a/Documentation/ABI/testing/sysfs-driver-ayaneo-pocket-evo-rgb b/Documentation/ABI/testing/sysfs-driver-ayaneo-pocket-evo-rgb
new file mode 100644
index 0000000000000000000000000000000000000000..00caae96e584b8b08593833b00d3b505e91000e2
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-driver-ayaneo-pocket-evo-rgb
@@ -0,0 +1,128 @@
+What:		/sys/bus/serial/devices/.../rgb/abi_version
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Read-only ABI revision. The current interface returns "3".
+
+What:		/sys/bus/serial/devices/.../rgb/calibration
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Device-wide Pocket EVO colour calibration. A write must contain
+		exactly two decimal percentages in the range 0 through 100:
+
+		green-percent blue-percent
+
+		The default is "15 20". "100 100" selects raw, uncalibrated RGB.
+		When red and a calibrated channel are both nonzero, the channel is
+		scaled by its percentage. Zero percent suppresses that mixed channel;
+		at positive percentages an originally nonzero channel is clamped to at
+		least one. Red, brightness, pure green, pure blue, and cyan are
+		unchanged.
+
+		A write updates both percentages atomically. With output enabled, the
+		current Static, single-colour Breath, or Reactive state is synchronously
+		reapplied. With output disabled, the new calibration is used on the next
+		restore. The fixed captured RGB Breath palette and MCU Rainbow are
+		unaffected and are not restarted. Requested RGB caches and their
+		readback remain uncalibrated. Values reset to the defaults when the
+		driver is reprobed. A write returns EBUSY while real system suspend
+		inhibits controller transport.
+
+What:		/sys/bus/serial/devices/.../rgb/zone_index
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Read-only physical order used by zone_layout. It returns:
+
+		left-zone-270 left-zone-0 left-zone-90 left-zone-180
+		right-zone-270 right-zone-0 right-zone-90 right-zone-180
+
+		The angles describe the segment's physical position around its
+		analog stick.
+
+What:		/sys/bus/serial/devices/.../rgb/zone_layout
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Atomic eight-zone static layout. A write must contain exactly 32
+		decimal values in the range 0 through 255. Values are grouped as
+		"red green blue brightness" for each zone in zone_index order.
+		No partial layout is accepted. Reading returns the cached layout in
+		the same format.
+
+		A write selects the static effect and is serialized as one complete
+		transaction. An all-zero layout uses the controller's validated
+		shutdown command rather than eight black zone updates. A layout in
+		which no zone can emit light uses the same shutdown command while its
+		requested channel values remain cached for later writes. Layouts that
+		are uniform within each ring are coalesced into the validated per-ring
+		frames, or one broadcast frame when both rings match. Mixed-quadrant
+		layouts use the direct-zone sequence.
+
+		RGB values are semantic requested values. The active calibration is
+		applied only at UART serialization; reads return the uncalibrated
+		requested values.
+
+What:		/sys/bus/serial/devices/.../rgb/available_effects
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Read-only, space-separated effect names accepted by effect.
+
+What:		/sys/bus/serial/devices/.../rgb/effect
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Read or select the device-wide analog-stick RGB effect. Accepted
+		writes, with every numeric argument a decimal byte, are:
+
+		static
+		breath <brightness> <red> <green> <blue>
+		rgb-breath <brightness>
+		rainbow
+		reactive <brightness> <idle-red> <idle-green> <idle-blue>
+		         <active-red> <active-green> <active-blue>
+
+		Static restores the cached zone_layout. Breath and rgb-breath are
+		host-rendered by the driver. Rainbow and reactive use bounded MCU
+		initializers. Per-zone LED class writes also select static.
+		User-selected Breath and Reactive colours receive the same Pocket EVO
+		calibration as Static. The captured fixed RGB Breath palette and the
+		MCU-generated Rainbow remain byte-for-byte unchanged.
+
+What:		/sys/bus/serial/devices/.../rgb/enabled
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Read or set the device-wide RGB output gate as a boolean. Writing
+		"0" sends the validated shutdown command and pauses host-rendered
+		animation without changing effect, effect arguments, animation
+		position, zone_layout, or LED-class caches. While output is disabled,
+		RGB writes update that desired cached state without transmitting.
+		Writing "1" restores the latest cached RGB state; repeated writes are
+		idempotent. Device-wide RGB writes return EBUSY only while transport
+		is inhibited by real system suspend.
+
+		This gate is independent from the optional controller-mode bootstrap
+		and from the driver's internal transport inhibition during system
+		suspend. It is intended for userspace fake-suspend implementations
+		that do not enter kernel power management.
+
+What:		/sys/class/leds/rgb:joystick-backlight-{left,right}-zone-{270,0,90,180}/
+Date:		August 2026
+KernelVersion:	7.2
+Contact:	linux-leds@vger.kernel.org
+Description:
+		Eight standard multicolor LED class devices, one for each retained
+		Pocket EVO ring segment. multi_intensity is red, green, blue and
+		brightness is the segment brightness, each in the range 0 through
+		255. A write to a zone selects static mode. Use zone_layout when all
+		eight zones must change without another client interleaving frames.
diff --git a/Documentation/devicetree/bindings/leds/ayaneo,serial-mcu.yaml b/Documentation/devicetree/bindings/leds/ayaneo,serial-mcu.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..83ceec85e58e9bad3cdc82aa32abe1cc2c11a451
--- /dev/null
+++ b/Documentation/devicetree/bindings/leds/ayaneo,serial-mcu.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/leds/ayaneo,serial-mcu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: AYANEO serial microcontroller
+
+maintainers:
+  - Linux LED Subsystem <linux-leds@vger.kernel.org>
+
+description: |
+  AYANEO handhelds use a serial-connected microcontroller for features such
+  as controller mode and analog-stick RGB lighting. On the Pocket EVO, the
+  MCU drives four independently retained RGB zones around each analog stick
+  over a dedicated 115200 baud UART.
+
+allOf:
+  - $ref: /schemas/serial/serial-peripheral-props.yaml#
+
+properties:
+  compatible:
+    const: ayaneo,serial-mcu
+
+  ayaneo,xbox360-mode:
+    type: boolean
+    description:
+      Send the AYANEO Xbox 360 controller-mode initialization sequence at
+      probe and restore it after system resume.
+
+  current-speed:
+    const: 115200
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    serial {
+        mcu {
+            compatible = "ayaneo,serial-mcu";
+            current-speed = <115200>;
+            ayaneo,xbox360-mode;
+        };
+    };
+...
