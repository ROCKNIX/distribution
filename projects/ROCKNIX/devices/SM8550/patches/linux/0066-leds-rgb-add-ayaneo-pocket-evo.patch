diff --git a/drivers/leds/rgb/leds-ayaneo-pocket-evo.c b/drivers/leds/rgb/leds-ayaneo-pocket-evo.c
new file mode 100644
index 0000000000000000000000000000000000000000..3fbce2a6941a1c5e01f83d79fd7f6bc3f52cbb3a
--- /dev/null
+++ b/drivers/leds/rgb/leds-ayaneo-pocket-evo.c
@@ -0,0 +1,1639 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * AYANEO Pocket EVO analog-stick RGB controller
+ *
+ * The AR07 controller is attached to a dedicated 115200 8N1 UART.  Binding
+ * through serdev deliberately makes this driver the sole owner of that UART.
+ */
+
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/kernel.h>
+#include <linux/led-class-multicolor.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/property.h>
+#include <linux/serdev.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/suspend.h>
+#include <linux/workqueue.h>
+
+#define EVO_BAUD_RATE			115200
+#define EVO_ZONE_COUNT			8
+#define EVO_RING_ZONE_COUNT		4
+#define EVO_LAYOUT_VALUE_COUNT		(EVO_ZONE_COUNT * 4)
+#define EVO_TARGET_BROADCAST		0x1c
+#define EVO_TARGET_RIGHT		0x20
+#define EVO_TARGET_LEFT			0x21
+#define EVO_REGISTER_FRAME_SIZE		27
+#define EVO_COMMAND_FRAME_SIZE		11
+#define EVO_COMMAND_REPEATS		3
+#define EVO_COMMAND_GAP_MS		40
+#define EVO_ZONE_GAP_MS			350
+#define EVO_MIXED_INIT_COPY_GAP_DEFAULT_MS	40
+#define EVO_MIXED_POST_INIT_DEFAULT_MS		350
+#define EVO_MIXED_ZONE_COPY_GAP_DEFAULT_MS	40
+#define EVO_MIXED_INTER_ZONE_GAP_DEFAULT_MS	350
+#define EVO_MIXED_FINAL_GUARD_DEFAULT_MS	350
+#define EVO_MIXED_COPY_GAP_MIN_MS		40
+#define EVO_MIXED_INIT_COPY_GAP_MAX_MS		1000
+#define EVO_MIXED_POST_INIT_MAX_MS		2500
+#define EVO_MIXED_ZONE_COPY_GAP_MAX_MS		350
+#define EVO_CALIBRATION_GREEN_DEFAULT_PERCENT	15
+#define EVO_CALIBRATION_BLUE_DEFAULT_PERCENT	20
+#define EVO_CALIBRATION_PERCENT_MAX		100
+#define EVO_CALIBRATION_VALUE_COUNT		2
+#define EVO_TX_TIMEOUT_MS		500
+#define EVO_DRAIN_TIMEOUT_MS		500
+#define EVO_EFFECT_TICK_MS		26
+#define EVO_WORK_RETRY_MS		1000
+#define EVO_BREATH_LOW_HOLD_TICKS	20
+#define EVO_BREATH_RISE_TICKS		80
+#define EVO_BREATH_HIGH_HOLD_TICKS	27
+#define EVO_BREATH_FALL_TICKS		80
+#define EVO_BREATH_TICKS		(EVO_BREATH_LOW_HOLD_TICKS + \
+					 EVO_BREATH_RISE_TICKS + \
+					 EVO_BREATH_HIGH_HOLD_TICKS + \
+					 EVO_BREATH_FALL_TICKS)
+
+enum evo_effect {
+	EVO_EFFECT_STATIC,
+	EVO_EFFECT_BREATH,
+	EVO_EFFECT_RGB_BREATH,
+	EVO_EFFECT_RAINBOW,
+	EVO_EFFECT_REACTIVE,
+};
+
+struct evo_rgb;
+
+struct evo_zone {
+	struct led_classdev_mc mc;
+	struct mc_subled subled[3];
+	struct evo_rgb *rgb;
+	u8 index;
+};
+
+struct evo_timing_param {
+	unsigned int value;
+	unsigned int minimum;
+	unsigned int maximum;
+};
+
+struct evo_mixed_timing {
+	unsigned int init_copy_gap_ms;
+	unsigned int post_init_ms;
+	unsigned int zone_copy_gap_ms;
+	unsigned int inter_zone_gap_ms;
+	unsigned int final_guard_ms;
+};
+
+struct evo_calibration {
+	u8 green_percent;
+	u8 blue_percent;
+};
+
+struct evo_rgb {
+	struct serdev_device *serdev;
+	struct evo_zone zones[EVO_ZONE_COUNT];
+	struct mutex lock; /* Serializes every state change and all UART TX. */
+	struct delayed_work effect_work;
+	struct notifier_block pm_nb;
+	struct evo_calibration calibration;
+	u8 layout[EVO_ZONE_COUNT][4];
+	u8 effect_args[7];
+	u16 effect_step;
+	enum evo_effect effect;
+	bool state_valid;
+	bool static_coherent;
+	bool enabled;
+	bool xbox360_mode;
+	bool xbox360_restore_pending;
+	bool rgb_restore_pending;
+	bool tx_inhibited;
+};
+
+static const struct evo_calibration evo_raw_calibration = {
+	.green_percent = EVO_CALIBRATION_PERCENT_MAX,
+	.blue_percent = EVO_CALIBRATION_PERCENT_MAX,
+};
+
+static int evo_timing_param_set(const char *val,
+				const struct kernel_param *kp)
+{
+	struct evo_timing_param *param = kp->arg;
+	unsigned int value;
+	int ret;
+
+	ret = kstrtouint(val, 10, &value);
+	if (ret)
+		return ret;
+	if (value < param->minimum || value > param->maximum)
+		return -ERANGE;
+
+	WRITE_ONCE(param->value, value);
+	return 0;
+}
+
+static int evo_timing_param_get(char *buf, const struct kernel_param *kp)
+{
+	const struct evo_timing_param *param = kp->arg;
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(param->value));
+}
+
+static const struct kernel_param_ops evo_timing_param_ops = {
+	.set = evo_timing_param_set,
+	.get = evo_timing_param_get,
+};
+
+static struct evo_timing_param evo_mixed_init_copy_gap = {
+	.value = EVO_MIXED_INIT_COPY_GAP_DEFAULT_MS,
+	.minimum = EVO_MIXED_COPY_GAP_MIN_MS,
+	.maximum = EVO_MIXED_INIT_COPY_GAP_MAX_MS,
+};
+module_param_cb(mixed_init_copy_gap_ms, &evo_timing_param_ops,
+		&evo_mixed_init_copy_gap, 0644);
+MODULE_PARM_DESC(mixed_init_copy_gap_ms,
+		 "Mixed layout initializer inter-copy gap in milliseconds");
+
+static struct evo_timing_param evo_mixed_post_init = {
+	.value = EVO_MIXED_POST_INIT_DEFAULT_MS,
+	.minimum = 0,
+	.maximum = EVO_MIXED_POST_INIT_MAX_MS,
+};
+module_param_cb(mixed_post_init_ms, &evo_timing_param_ops,
+		&evo_mixed_post_init, 0644);
+MODULE_PARM_DESC(mixed_post_init_ms,
+		 "Mixed layout delay after the final initializer copy");
+
+static struct evo_timing_param evo_mixed_zone_copy_gap = {
+	.value = EVO_MIXED_ZONE_COPY_GAP_DEFAULT_MS,
+	.minimum = EVO_MIXED_COPY_GAP_MIN_MS,
+	.maximum = EVO_MIXED_ZONE_COPY_GAP_MAX_MS,
+};
+module_param_cb(mixed_zone_copy_gap_ms, &evo_timing_param_ops,
+		&evo_mixed_zone_copy_gap, 0644);
+MODULE_PARM_DESC(mixed_zone_copy_gap_ms,
+		 "Mixed layout zone inter-copy gap in milliseconds");
+
+static struct evo_timing_param evo_mixed_inter_zone_gap = {
+	.value = EVO_MIXED_INTER_ZONE_GAP_DEFAULT_MS,
+	.minimum = EVO_MIXED_COPY_GAP_MIN_MS,
+	.maximum = EVO_MIXED_INTER_ZONE_GAP_DEFAULT_MS,
+};
+module_param_cb(mixed_inter_zone_gap_ms, &evo_timing_param_ops,
+		&evo_mixed_inter_zone_gap, 0644);
+MODULE_PARM_DESC(mixed_inter_zone_gap_ms,
+		 "Mixed layout gap between adjacent zones in milliseconds");
+
+static struct evo_timing_param evo_mixed_final_guard = {
+	.value = EVO_MIXED_FINAL_GUARD_DEFAULT_MS,
+	.minimum = 0,
+	.maximum = EVO_MIXED_FINAL_GUARD_DEFAULT_MS,
+};
+module_param_cb(mixed_final_guard_ms, &evo_timing_param_ops,
+		&evo_mixed_final_guard, 0644);
+MODULE_PARM_DESC(mixed_final_guard_ms,
+		 "Mixed layout guard after the final zone in milliseconds");
+
+static void evo_snapshot_mixed_timing(struct evo_mixed_timing *timing)
+{
+	timing->init_copy_gap_ms =
+		READ_ONCE(evo_mixed_init_copy_gap.value);
+	timing->post_init_ms = READ_ONCE(evo_mixed_post_init.value);
+	timing->zone_copy_gap_ms =
+		READ_ONCE(evo_mixed_zone_copy_gap.value);
+	timing->inter_zone_gap_ms =
+		READ_ONCE(evo_mixed_inter_zone_gap.value);
+	timing->final_guard_ms =
+		READ_ONCE(evo_mixed_final_guard.value);
+}
+
+static const char * const evo_zone_names[EVO_ZONE_COUNT] = {
+	"rgb:joystick-backlight-left-zone-270",
+	"rgb:joystick-backlight-left-zone-0",
+	"rgb:joystick-backlight-left-zone-90",
+	"rgb:joystick-backlight-left-zone-180",
+	"rgb:joystick-backlight-right-zone-270",
+	"rgb:joystick-backlight-right-zone-0",
+	"rgb:joystick-backlight-right-zone-90",
+	"rgb:joystick-backlight-right-zone-180",
+};
+
+static const char * const evo_effect_names[] = {
+	[EVO_EFFECT_STATIC] = "static",
+	[EVO_EFFECT_BREATH] = "breath",
+	[EVO_EFFECT_RGB_BREATH] = "rgb-breath",
+	[EVO_EFFECT_RAINBOW] = "rainbow",
+	[EVO_EFFECT_REACTIVE] = "reactive",
+};
+
+static const u8 evo_rgb_breath_palette[][3] = {
+	{ 0xff, 0x00, 0xff },
+	{ 0x00, 0xff, 0x00 },
+	{ 0x00, 0x00, 0xff },
+	{ 0xff, 0x00, 0x00 },
+	{ 0x00, 0xff, 0x00 },
+	{ 0x00, 0x00, 0xff },
+	{ 0xff, 0xff, 0x00 },
+};
+
+static const u8 evo_off_frame[EVO_REGISTER_FRAME_SIZE] = {
+	0xf7, 0x00, 0x1c, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x3c, 0xed,
+};
+
+static const u8 evo_rainbow_frame[EVO_COMMAND_FRAME_SIZE] = {
+	0xf7, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0xed,
+};
+
+static const u8 evo_xbox360_frame[EVO_COMMAND_FRAME_SIZE] = {
+	0xe7, 0x55, 0x05, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x5b, 0xed,
+};
+
+static const u8 evo_xbox360_ascii[] = "5505010000000000";
+
+static size_t evo_receive_buf(struct serdev_device *serdev, const u8 *data,
+			      size_t count)
+{
+	return count;
+}
+
+static const struct serdev_device_ops evo_serdev_ops = {
+	.receive_buf = evo_receive_buf,
+	.write_wakeup = serdev_device_write_wakeup,
+};
+
+/* Caller holds rgb->lock. */
+static int evo_write_full_locked(struct evo_rgb *rgb, const u8 *data,
+				 size_t len)
+{
+	ssize_t ret;
+
+	if (rgb->tx_inhibited)
+		return -EBUSY;
+
+	ret = serdev_device_write(rgb->serdev, data, len,
+				  msecs_to_jiffies(EVO_TX_TIMEOUT_MS));
+	if (ret < 0)
+		return ret;
+	if (ret != len)
+		return -ETIMEDOUT;
+
+	serdev_device_wait_until_sent(rgb->serdev,
+				      msecs_to_jiffies(EVO_DRAIN_TIMEOUT_MS));
+	return 0;
+}
+
+/* Caller holds rgb->lock. */
+static int evo_write_repeated_locked(struct evo_rgb *rgb, const u8 *data,
+				     size_t len, unsigned int gap_ms)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < EVO_COMMAND_REPEATS; i++) {
+		ret = evo_write_full_locked(rgb, data, len);
+		if (ret)
+			return ret;
+		if (i + 1 < EVO_COMMAND_REPEATS)
+			msleep(gap_ms);
+	}
+
+	return 0;
+}
+
+static u8 evo_checksum(const u8 *frame, size_t first, size_t last)
+{
+	unsigned int sum = 0;
+	size_t i;
+
+	for (i = first; i <= last; i++)
+		sum += frame[i];
+
+	return sum;
+}
+
+static u8 evo_calibrate_mixed_channel(u8 red, u8 channel,
+				      unsigned int percent)
+{
+	unsigned int calibrated;
+
+	if (!red || !channel)
+		return channel;
+	if (!percent)
+		return 0;
+
+	calibrated = channel * percent / 100;
+	return max(calibrated, 1U);
+}
+
+static void evo_build_static_frame(u8 *frame, u8 target, u8 red, u8 green,
+				   u8 blue, u8 brightness,
+				   const struct evo_calibration *calibration)
+{
+	static const u8 registers[] = {
+		0x20, 0x80, 0x81, 0x8b, 0x88, 0x89, 0x8a, 0x86,
+		0x87, 0x58, 0x45,
+	};
+	const u8 values[] = {
+		0x01, 0x00, 0x00, 0x0f, red,
+		evo_calibrate_mixed_channel(red, green,
+					    calibration->green_percent),
+		evo_calibrate_mixed_channel(red, blue,
+					    calibration->blue_percent),
+		brightness,
+		brightness, 0x02, 0x00,
+	};
+	unsigned int i;
+
+	memset(frame, 0, EVO_REGISTER_FRAME_SIZE);
+	frame[0] = 0xf7;
+	frame[2] = target;
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		frame[3 + i * 2] = registers[i];
+		frame[4 + i * 2] = values[i];
+	}
+	frame[25] = evo_checksum(frame, 1, 24);
+	frame[26] = 0xed;
+}
+
+static void evo_build_zone_frame(u8 *frame, unsigned int zone,
+				 u8 red, u8 green, u8 blue, u8 brightness,
+				 const struct evo_calibration *calibration)
+{
+	unsigned int local_zone = zone % EVO_RING_ZONE_COUNT;
+	u8 rgb_base = 0x46 + local_zone * 3;
+	u8 target = zone < EVO_RING_ZONE_COUNT ?
+		EVO_TARGET_LEFT : EVO_TARGET_RIGHT;
+	const u8 registers[] = {
+		0x20, 0x58, 0x8b, rgb_base, rgb_base + 1, rgb_base + 2,
+		0x21 + local_zone, 0x45,
+	};
+	const u8 values[] = {
+		0x01, 0x02, 0x40, red,
+		evo_calibrate_mixed_channel(red, green,
+					    calibration->green_percent),
+		evo_calibrate_mixed_channel(red, blue,
+					    calibration->blue_percent),
+		brightness, 0x00,
+	};
+	unsigned int i;
+
+	memset(frame, 0, EVO_REGISTER_FRAME_SIZE);
+	frame[0] = 0xf7;
+	frame[2] = target;
+	for (i = 0; i < ARRAY_SIZE(registers); i++) {
+		frame[3 + i * 2] = registers[i];
+		frame[4 + i * 2] = values[i];
+	}
+	frame[25] = evo_checksum(frame, 1, 24);
+	frame[26] = 0xed;
+}
+
+static void evo_build_reactive_frame(u8 *frame, const u8 *args,
+				     const struct evo_calibration *calibration)
+{
+	frame[0] = 0xf7;
+	frame[1] = 0x55;
+	memcpy(frame + 2, args, 7);
+	frame[4] = evo_calibrate_mixed_channel(frame[3], frame[4],
+					       calibration->green_percent);
+	frame[5] = evo_calibrate_mixed_channel(frame[3], frame[5],
+					       calibration->blue_percent);
+	frame[7] = evo_calibrate_mixed_channel(frame[6], frame[7],
+					       calibration->green_percent);
+	frame[8] = evo_calibrate_mixed_channel(frame[6], frame[8],
+					       calibration->blue_percent);
+	frame[9] = evo_checksum(frame, 1, 8);
+	frame[10] = 0xed;
+}
+
+static bool evo_layout_is_zero(const u8 layout[EVO_ZONE_COUNT][4])
+{
+	int i;
+	int channel;
+
+	for (i = 0; i < EVO_ZONE_COUNT; i++)
+		for (channel = 0; channel < 4; channel++)
+			if (layout[i][channel])
+				return false;
+
+	return true;
+}
+
+static bool evo_zone_is_visible(const u8 zone[4])
+{
+	return zone[3] && (zone[0] || zone[1] || zone[2]);
+}
+
+static bool evo_ring_is_uniform(const u8 layout[EVO_ZONE_COUNT][4],
+				unsigned int first)
+{
+	unsigned int i;
+
+	for (i = first + 1; i < first + EVO_RING_ZONE_COUNT; i++)
+		if (memcmp(layout[first], layout[i], sizeof(layout[first])))
+			return false;
+
+	return true;
+}
+
+static bool evo_layout_has_uniform_rings(const u8 layout[EVO_ZONE_COUNT][4])
+{
+	return evo_ring_is_uniform(layout, 0) &&
+		evo_ring_is_uniform(layout, EVO_RING_ZONE_COUNT);
+}
+
+static int evo_first_visible_zone(const u8 layout[EVO_ZONE_COUNT][4])
+{
+	int i;
+
+	for (i = 0; i < EVO_ZONE_COUNT; i++)
+		if (evo_zone_is_visible(layout[i]))
+			return i;
+
+	return -1;
+}
+
+/* Caller holds rgb->lock. */
+static int evo_send_static_locked(struct evo_rgb *rgb, u8 target,
+				  const u8 values[4], unsigned int gap_ms,
+				  bool trailing_gap)
+{
+	u8 frame[EVO_REGISTER_FRAME_SIZE];
+	int ret;
+
+	evo_build_static_frame(frame, target, values[0], values[1], values[2],
+			       values[3], &rgb->calibration);
+	ret = evo_write_repeated_locked(rgb, frame, sizeof(frame), gap_ms);
+	if (!ret && trailing_gap)
+		msleep(gap_ms);
+
+	return ret;
+}
+
+/* Caller holds rgb->lock; both rings are uniform and visibly enabled. */
+static int evo_apply_uniform_rings_locked(struct evo_rgb *rgb,
+					  const u8 layout[EVO_ZONE_COUNT][4])
+{
+	const u8 *left = layout[0];
+	const u8 *right = layout[EVO_RING_ZONE_COUNT];
+	int ret;
+
+	if (!memcmp(left, right, sizeof(layout[0])))
+		return evo_send_static_locked(rgb, EVO_TARGET_BROADCAST, left,
+					      EVO_COMMAND_GAP_MS, false);
+
+	/* The physically validated per-stick sequence first exits segmented mode
+	 * with the left colour broadcast, then retains independent target state.
+	 */
+	ret = evo_send_static_locked(rgb, EVO_TARGET_BROADCAST, left,
+				     EVO_ZONE_GAP_MS, true);
+	if (ret)
+		return ret;
+	ret = evo_send_static_locked(rgb, EVO_TARGET_LEFT, left,
+				     EVO_ZONE_GAP_MS, true);
+	if (ret)
+		return ret;
+
+	return evo_send_static_locked(rgb, EVO_TARGET_RIGHT, right,
+				      EVO_ZONE_GAP_MS, true);
+}
+
+/* Caller holds rgb->lock. */
+static int evo_send_zone_locked(struct evo_rgb *rgb,
+				const u8 layout[EVO_ZONE_COUNT][4],
+				unsigned int zone,
+				unsigned int copy_gap_ms,
+				unsigned int trailing_gap_ms)
+{
+	u8 frame[EVO_REGISTER_FRAME_SIZE];
+	const u8 *values = layout[zone];
+	int ret;
+
+	evo_build_zone_frame(frame, zone, values[0], values[1], values[2],
+			     values[3], &rgb->calibration);
+	ret = evo_write_repeated_locked(rgb, frame, sizeof(frame),
+					copy_gap_ms);
+	if (!ret && trailing_gap_ms)
+		msleep(trailing_gap_ms);
+
+	return ret;
+}
+
+/* Caller holds rgb->lock. */
+static int evo_apply_layout_locked(struct evo_rgb *rgb,
+				   const u8 layout[EVO_ZONE_COUNT][4])
+{
+	struct evo_mixed_timing timing;
+	u8 initializer_args[7];
+	u8 initializer[EVO_COMMAND_FRAME_SIZE] = {};
+	int initializer_zone;
+	int i;
+	int ret;
+
+	initializer_zone = evo_first_visible_zone(layout);
+	if (evo_layout_is_zero(layout) || initializer_zone < 0)
+		return evo_write_repeated_locked(rgb, evo_off_frame,
+						 sizeof(evo_off_frame),
+						 EVO_COMMAND_GAP_MS);
+
+	if (evo_layout_has_uniform_rings(layout) &&
+	    evo_zone_is_visible(layout[0]) &&
+	    evo_zone_is_visible(layout[EVO_RING_ZONE_COUNT]))
+		return evo_apply_uniform_rings_locked(rgb, layout);
+
+	evo_snapshot_mixed_timing(&timing);
+
+	initializer_args[0] = layout[initializer_zone][3];
+	initializer_args[1] = layout[initializer_zone][0];
+	initializer_args[2] = layout[initializer_zone][1];
+	initializer_args[3] = layout[initializer_zone][2];
+	memcpy(initializer_args + 4, initializer_args + 1, 3);
+	evo_build_reactive_frame(initializer, initializer_args,
+				 &rgb->calibration);
+	ret = evo_write_repeated_locked(rgb, initializer, sizeof(initializer),
+					timing.init_copy_gap_ms);
+	if (ret)
+		return ret;
+
+	/* The validated Android sequence waited 2.5 seconds after its final
+	 * initializer copy before the first zone transaction.
+	 */
+	if (timing.post_init_ms)
+		msleep(timing.post_init_ms);
+
+	for (i = 0; i < EVO_ZONE_COUNT; i++) {
+		unsigned int trailing_gap_ms = i + 1 < EVO_ZONE_COUNT ?
+			timing.inter_zone_gap_ms : timing.final_guard_ms;
+
+		ret = evo_send_zone_locked(rgb, layout, i,
+					   timing.zone_copy_gap_ms,
+					   trailing_gap_ms);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static u8 evo_breath_level(u8 maximum, unsigned int step, bool rgb_breath)
+{
+	unsigned int ramp_step;
+	u32 minimum;
+	u32 x;
+	u32 eased;
+
+	if (!maximum)
+		return 0;
+
+	minimum = rgb_breath ? min_t(u32, maximum, 2) :
+		min_t(u32, maximum, DIV_ROUND_UP(maximum, 40));
+
+	if (step < EVO_BREATH_LOW_HOLD_TICKS)
+		return minimum;
+	step -= EVO_BREATH_LOW_HOLD_TICKS;
+
+	if (step < EVO_BREATH_RISE_TICKS) {
+		ramp_step = step + 1;
+	} else {
+		step -= EVO_BREATH_RISE_TICKS;
+		if (step < EVO_BREATH_HIGH_HOLD_TICKS)
+			return maximum;
+		step -= EVO_BREATH_HIGH_HOLD_TICKS;
+		ramp_step = EVO_BREATH_FALL_TICKS - step - 1;
+	}
+
+	x = DIV_ROUND_CLOSEST(ramp_step * 255, EVO_BREATH_RISE_TICKS);
+	eased = x * x * (3 * 255 - 2 * x) / (255 * 255);
+	return minimum + DIV_ROUND_CLOSEST((maximum - minimum) * eased, 255);
+}
+
+/* Caller holds rgb->lock. The animation stream deliberately uses one frame
+ * per tick, matching the captured host-rendered transport rather than turning
+ * each 26 ms sample into a three-copy command burst.
+ */
+static int evo_render_breath_locked(struct evo_rgb *rgb,
+				    enum evo_effect effect, const u8 *args,
+				    u16 *effect_step)
+{
+	unsigned int palette_index = 0;
+	unsigned int phase = *effect_step;
+	const u8 *colour = &args[1];
+	u8 frame[EVO_REGISTER_FRAME_SIZE];
+	u8 level;
+	int ret;
+
+	if (effect == EVO_EFFECT_RGB_BREATH) {
+		palette_index = phase / EVO_BREATH_TICKS;
+		phase %= EVO_BREATH_TICKS;
+		colour = evo_rgb_breath_palette[palette_index];
+	}
+
+	level = evo_breath_level(args[0], phase,
+				 effect == EVO_EFFECT_RGB_BREATH);
+	/* RGB Breath uses literal captured UART palette values. */
+	evo_build_static_frame(frame, EVO_TARGET_BROADCAST, colour[0],
+			       colour[1], colour[2], level,
+			       effect == EVO_EFFECT_BREATH ?
+			       &rgb->calibration : &evo_raw_calibration);
+	ret = evo_write_full_locked(rgb, frame, sizeof(frame));
+	if (ret)
+		return ret;
+
+	(*effect_step)++;
+	if (effect == EVO_EFFECT_RGB_BREATH)
+		*effect_step %= EVO_BREATH_TICKS *
+			ARRAY_SIZE(evo_rgb_breath_palette);
+	else
+		*effect_step %= EVO_BREATH_TICKS;
+
+	return 0;
+}
+
+/* Caller holds rgb->lock. */
+static int evo_send_xbox360_locked(struct evo_rgb *rgb)
+{
+	int ret;
+
+	ret = evo_write_full_locked(rgb, evo_xbox360_frame,
+				    sizeof(evo_xbox360_frame));
+	if (ret)
+		return ret;
+	msleep(100);
+	ret = evo_write_full_locked(rgb, evo_xbox360_ascii,
+				    sizeof(evo_xbox360_ascii) - 1);
+	if (ret)
+		return ret;
+	msleep(100);
+
+	return 0;
+}
+
+static int evo_restore_rgb_locked(struct evo_rgb *rgb)
+{
+	u8 frame[EVO_COMMAND_FRAME_SIZE] = {};
+	int ret;
+
+	if (!rgb->state_valid)
+		return 0;
+
+	switch (rgb->effect) {
+	case EVO_EFFECT_STATIC:
+		ret = evo_apply_layout_locked(rgb, rgb->layout);
+		rgb->static_coherent = !ret;
+		return ret;
+	case EVO_EFFECT_BREATH:
+	case EVO_EFFECT_RGB_BREATH:
+		rgb->static_coherent = false;
+		return evo_render_breath_locked(rgb, rgb->effect,
+						rgb->effect_args,
+						&rgb->effect_step);
+	case EVO_EFFECT_RAINBOW:
+		rgb->static_coherent = false;
+		return evo_write_repeated_locked(rgb, evo_rainbow_frame,
+						 sizeof(evo_rainbow_frame),
+						 EVO_COMMAND_GAP_MS);
+	case EVO_EFFECT_REACTIVE:
+		rgb->static_coherent = false;
+		evo_build_reactive_frame(frame, rgb->effect_args,
+					 &rgb->calibration);
+		return evo_write_repeated_locked(rgb, frame, sizeof(frame),
+						 EVO_COMMAND_GAP_MS);
+	}
+
+	return -EINVAL;
+}
+
+static bool evo_restore_is_pending(const struct evo_rgb *rgb)
+{
+	return rgb->xbox360_restore_pending || rgb->rgb_restore_pending;
+}
+
+static void evo_mark_rgb_restore_pending(struct evo_rgb *rgb)
+{
+	if (!rgb->tx_inhibited && rgb->enabled && rgb->state_valid)
+		rgb->rgb_restore_pending = true;
+}
+
+static int evo_restore_xbox360_locked(struct evo_rgb *rgb)
+{
+	int ret;
+
+	if (!rgb->xbox360_mode || !rgb->xbox360_restore_pending)
+		return 0;
+
+	ret = evo_send_xbox360_locked(rgb);
+	if (!ret)
+		rgb->xbox360_restore_pending = false;
+
+	return ret;
+}
+
+static int evo_restore_pending_locked(struct evo_rgb *rgb)
+{
+	int ret;
+
+	ret = evo_restore_xbox360_locked(rgb);
+	if (ret || !rgb->rgb_restore_pending)
+		return ret;
+
+	if (!rgb->enabled) {
+		rgb->rgb_restore_pending = false;
+		return 0;
+	}
+
+	ret = evo_restore_rgb_locked(rgb);
+	if (!ret)
+		rgb->rgb_restore_pending = false;
+
+	return ret;
+}
+
+static bool evo_effect_is_host_rendered(enum evo_effect effect)
+{
+	return effect == EVO_EFFECT_BREATH ||
+	       effect == EVO_EFFECT_RGB_BREATH;
+}
+
+static bool evo_effect_uses_calibration(enum evo_effect effect)
+{
+	return effect == EVO_EFFECT_STATIC || effect == EVO_EFFECT_BREATH ||
+	       effect == EVO_EFFECT_REACTIVE;
+}
+
+static void evo_effect_work(struct work_struct *work)
+{
+	struct evo_rgb *rgb = container_of(to_delayed_work(work),
+					  struct evo_rgb, effect_work);
+	bool requeue = false;
+	unsigned int delay_ms;
+	int ret = 0;
+
+	mutex_lock(&rgb->lock);
+	if (rgb->tx_inhibited)
+		goto out;
+
+	if (evo_restore_is_pending(rgb)) {
+		ret = evo_restore_pending_locked(rgb);
+	} else if (rgb->enabled &&
+		   evo_effect_is_host_rendered(rgb->effect)) {
+		ret = evo_render_breath_locked(rgb, rgb->effect,
+					       rgb->effect_args,
+					       &rgb->effect_step);
+	}
+
+	requeue = evo_restore_is_pending(rgb) ||
+		(rgb->enabled && evo_effect_is_host_rendered(rgb->effect));
+	delay_ms = ret ? EVO_WORK_RETRY_MS : EVO_EFFECT_TICK_MS;
+	if (requeue)
+		queue_delayed_work(system_freezable_wq, &rgb->effect_work,
+				   msecs_to_jiffies(delay_ms));
+out:
+	mutex_unlock(&rgb->lock);
+
+	if (ret)
+		dev_err_ratelimited(&rgb->serdev->dev,
+				    "controller restore/effect write failed: %d\n",
+				    ret);
+}
+
+static int evo_zone_set(struct led_classdev *cdev,
+			enum led_brightness brightness)
+{
+	struct led_classdev_mc *mc = lcdev_to_mccdev(cdev);
+	struct evo_zone *zone = container_of(mc, struct evo_zone, mc);
+	struct evo_rgb *rgb = zone->rgb;
+	u8 next_layout[EVO_ZONE_COUNT][4];
+	bool restart_work = false;
+	int ret;
+
+	cancel_delayed_work_sync(&rgb->effect_work);
+	mutex_lock(&rgb->lock);
+	memcpy(next_layout, rgb->layout, sizeof(next_layout));
+	next_layout[zone->index][0] = zone->subled[0].intensity;
+	next_layout[zone->index][1] = zone->subled[1].intensity;
+	next_layout[zone->index][2] = zone->subled[2].intensity;
+	next_layout[zone->index][3] = brightness;
+
+	if (rgb->tx_inhibited) {
+		ret = -EBUSY;
+		goto rollback;
+	}
+	if (!rgb->enabled) {
+		memcpy(rgb->layout, next_layout, sizeof(rgb->layout));
+		rgb->effect = EVO_EFFECT_STATIC;
+		rgb->state_valid = true;
+		rgb->static_coherent = false;
+		rgb->rgb_restore_pending = false;
+		restart_work = rgb->xbox360_restore_pending;
+		ret = 0;
+		goto out;
+	}
+	ret = evo_restore_xbox360_locked(rgb);
+	if (ret)
+		goto rollback;
+
+	if (rgb->state_valid && rgb->static_coherent &&
+	    rgb->effect == EVO_EFFECT_STATIC &&
+	    evo_first_visible_zone(rgb->layout) >= 0 &&
+	    !evo_layout_has_uniform_rings(rgb->layout) &&
+	    evo_first_visible_zone(next_layout) >= 0)
+		ret = evo_send_zone_locked(rgb, next_layout, zone->index,
+					   EVO_ZONE_GAP_MS, EVO_ZONE_GAP_MS);
+	else
+		ret = evo_apply_layout_locked(rgb, next_layout);
+	if (ret)
+		goto rollback;
+
+	memcpy(rgb->layout, next_layout, sizeof(rgb->layout));
+	rgb->effect = EVO_EFFECT_STATIC;
+	rgb->state_valid = true;
+	rgb->static_coherent = true;
+	rgb->rgb_restore_pending = false;
+	goto out;
+
+rollback:
+	rgb->static_coherent = false;
+	evo_mark_rgb_restore_pending(rgb);
+	zone->subled[0].intensity = rgb->layout[zone->index][0];
+	zone->subled[1].intensity = rgb->layout[zone->index][1];
+	zone->subled[2].intensity = rgb->layout[zone->index][2];
+	cdev->brightness = rgb->layout[zone->index][3];
+	restart_work = !rgb->tx_inhibited &&
+		(evo_restore_is_pending(rgb) ||
+		 (rgb->enabled && evo_effect_is_host_rendered(rgb->effect)));
+out:
+	if (restart_work)
+		mod_delayed_work(system_freezable_wq, &rgb->effect_work,
+				 msecs_to_jiffies(EVO_EFFECT_TICK_MS));
+	mutex_unlock(&rgb->lock);
+
+	return ret;
+}
+
+static void evo_lock_led_caches(struct evo_rgb *rgb)
+{
+	int i;
+
+	for (i = 0; i < EVO_ZONE_COUNT; i++) {
+		if (!i)
+			mutex_lock(&rgb->zones[i].mc.led_cdev.led_access);
+		else
+			mutex_lock_nested(
+				&rgb->zones[i].mc.led_cdev.led_access, i);
+	}
+	for (i = 0; i < EVO_ZONE_COUNT; i++)
+		flush_work(&rgb->zones[i].mc.led_cdev.set_brightness_work);
+}
+
+static void evo_unlock_led_caches(struct evo_rgb *rgb)
+{
+	int i;
+
+	for (i = EVO_ZONE_COUNT - 1; i >= 0; i--)
+		mutex_unlock(&rgb->zones[i].mc.led_cdev.led_access);
+}
+
+static char *evo_next_token(char **input)
+{
+	char *token;
+
+	while ((token = strsep(input, " \t\n")))
+		if (*token)
+			return token;
+
+	return NULL;
+}
+
+static int evo_parse_values(const char *buf, u8 *values, unsigned int count)
+{
+	char *cursor;
+	char *copy;
+	char *token;
+	unsigned int i;
+	int ret = 0;
+
+	copy = kstrdup(buf, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	cursor = copy;
+
+	for (i = 0; i < count; i++) {
+		token = evo_next_token(&cursor);
+		if (!token || kstrtou8(token, 10, &values[i])) {
+			ret = -EINVAL;
+			goto out;
+		}
+	}
+	if (evo_next_token(&cursor))
+		ret = -EINVAL;
+out:
+	kfree(copy);
+	return ret;
+}
