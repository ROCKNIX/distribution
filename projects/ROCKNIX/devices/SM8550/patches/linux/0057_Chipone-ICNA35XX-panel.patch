From 4c5e76e974db7cca853619ca138eecd8f004622f Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Mon, 27 Oct 2025 16:51:01 +0800
Subject: [PATCH] drm/panel: Add panel driver for Chipone ICNA35XX based panels

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Folded in on top of the original driver, by virtudude <virtudude@protonmail.com>:
a luminance-linear sysfs backlight scale. Both DDICs drive their panels at
luminance ~ (DBV/4096)^2.2, measured on the AYN Odin 3 (ICNA3520) and Odin 2
Portal (ICNA3512) modules, so raw DBV in sysfs compresses the useful range
into the top of the scale and collapses the low end under nits-based
brightness control. Writes are translated through the brightness levels
helper (0480-drm-panel-add-brightness-levels-helper.patch) and the backlight
declares BACKLIGHT_SCALE_LINEAR.

The shared icna35xx table ends at 3413, the DBV ceiling the vendor Android
trees set for those modules, rather than 4096, which is one past the 12-bit
register. The DDIC does not enforce the ceiling: on the Odin 3, white-screen
panel power at DBV 4095 is 73% above DBV 3413. The sysfs range stays 0..4096,
so userspace is unaffected. The levels are the analytic response
round(round(4096 * (i/128)^(1/2.2)) * ceiling / 4096) -- the 2.2 exponent is a
property of the DDIC family (one table already serves both ICNA3512 and
ICNA3520) and the ceiling is the only per-module input.

Also folded in: the MANGMI Pocket Max (SM8250), which drives a 1080x1920 DSC
panel on the same DDIC with its own init sequence, a 60/90/120/144 Hz mode
list and a 3515 DBV ceiling. Its timings, DSC parameters and ceiling are
transcribed from the stock Android panel node
qcom,mdss_dsi_ican3512_1080p_7inch_cmd ("7inch" is vendor copy-paste; the
panel is 1080x1920). That node also sets qcom,mdss-dsi-bl-inverted-dbv, which
makes the vendor write DBV MSB-first -- the same byte order as
mipi_dsi_dcs_set_display_brightness_large(). Its levels are the family curve
at 3515: the exponent is inherited, not measured on a Pocket Max, and the
stock firmware records no DBV-to-nits mapping to check it against. Replace the
table if the module is ever measured, or override per-board with
brightness-levels in the panel node.

A desc naming no levels table would fail drm_panel_bl_levels_init() and leave
that panel dark, so every desc must carry one.

Also folded in, from gennro (Kettle Linux): no backlight DSI traffic while
the panel is off. A failed init sequence in prepare cut the supplies with
the panel out of reset; it now asserts reset first, as unprepare does.
update_status cleared MIPI_DSI_MODE_LPM and set it back only on success; it
now restores it either way. Brightness writes went over DSI while the panel
was unprepared (no supplies, the DSI host possibly off); they are skipped
then, since drm_panel_enable() calls backlight_enable(), which sends the
brightness once the panel is up. And .get_brightness is gone: it read the
DBV back over DSI at every read of actual_brightness, also while the panel
was off, and reported it unmapped, a different scale from the
luminance-linear sysfs value (the helper has no inverse). The backlight
core now reports the set value.

retroforge, 7.3.1 bump: v7.3 ships its own panel-chipone-icna35xx.c (Teguh
Sobirin's mainline version, f747473a838e) with per-board compatibles that none
of our DTs use. Ours is renamed to sit beside it, as 0535 was for the CH13726A:
panel-ddic-icna35xx.c, DRM_PANEL_DDIC_ICNA35XX, driver name panel-ddic-icna35xx.
The compatibles (chipone,icna3512 / chipone,icna3520 / mangmi,pocket-max-panel)
and the code are unchanged; 0531-0533 follow the new file name.
---
 drivers/gpu/drm/panel/Kconfig               |  11 +
 drivers/gpu/drm/panel/Makefile              |   1 +
 drivers/gpu/drm/panel/panel-ddic-icna35xx.c | 816 ++++++++++++++++++++
 3 files changed, 828 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-ddic-icna35xx.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 0228fb1a1..9c2edece2 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -177,6 +177,17 @@ config DRM_PANEL_BOE_XM91080G
 	  Say Y if you want to enable support for panels based on the
 	  Xm-Plus XM91080G controller.
 
+config DRM_PANEL_DDIC_ICNA35XX
+	tristate "Chipone ICNA35XX panel driver (RetroForge boards)"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y here if you want to enable support for the panels built
+	  around the Chipone ICNA3512 and ICNA3520 display controllers,
+	  such as some Tianma panels used in AYN Odin2 Portal and Thor.
+
 config DRM_PANEL_EBBG_FT8719
 	tristate "EBBG FT8719 panel driver"
 	depends on GPIOLIB
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 9d156338a..16edcb4fe 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -15,6 +15,7 @@ obj-$(CONFIG_DRM_PANEL_BOE_TV101WUM_LL2) += panel-boe-tv101wum-ll2.o
 obj-$(CONFIG_DRM_PANEL_BOE_TV101WUM_NL6) += panel-boe-tv101wum-nl6.o
 obj-$(CONFIG_DRM_PANEL_CHIPONE_ICNA35XX) += panel-chipone-icna35xx.o
 obj-$(CONFIG_DRM_PANEL_BOE_XM91080G) += panel-boe-xm91080g.o
+obj-$(CONFIG_DRM_PANEL_DDIC_ICNA35XX) += panel-ddic-icna35xx.o
 obj-$(CONFIG_DRM_PANEL_CHIPWEALTH_CH13726A) += panel-chipwealth-ch13726a.o
 obj-$(CONFIG_DRM_PANEL_DSI_CM) += panel-dsi-cm.o
 obj-$(CONFIG_DRM_PANEL_LVDS) += panel-lvds.o
diff --git a/drivers/gpu/drm/panel/panel-ddic-icna35xx.c b/drivers/gpu/drm/panel/panel-ddic-icna35xx.c
new file mode 100644
index 000000000..abe1d2478
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-ddic-icna35xx.c
@@ -0,0 +1,816 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Chipone ICNA35XX Driver IC panels driver
+ *
+ * Copyright (c) 2025 Teguh Sobirin <teguh@sobir.in>
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_of.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_crtc.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct panel_info {
+	struct drm_panel panel;
+	struct drm_connector *connector;
+	struct mipi_dsi_device *dsi;
+	struct panel_desc *desc;
+	enum drm_panel_orientation orientation;
+
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data *supplies;
+	struct drm_panel_bl_levels bl_levels;
+};
+
+struct panel_desc {
+	unsigned int width_mm;
+	unsigned int height_mm;
+
+	unsigned int bpc;
+	unsigned int lanes;
+	unsigned long mode_flags;
+	enum mipi_dsi_pixel_format format;
+
+	const struct drm_display_mode *modes;
+	unsigned int num_modes;
+	int (*init_sequence)(struct panel_info *pinfo);
+
+	const u16 *bl_levels;
+	unsigned int num_bl_levels;
+	unsigned int bl_num_interp;
+
+	struct drm_dsc_config dsc;
+};
+
+static const struct regulator_bulk_data panel_supplies[] = {
+	{ .supply = "vdd" },
+	{ .supply = "vddio" },
+	{ .supply = "vci" },
+	{ .supply = "disp" },
+	{ .supply = "blvdd" },
+};
+
+static inline struct panel_info *to_panel_info(struct drm_panel *panel)
+{
+	return container_of(panel, struct panel_info, panel);
+}
+
+static int icna35xx_get_current_mode(struct panel_info *pinfo)
+{
+	struct drm_connector *connector = pinfo->connector;
+	struct drm_crtc_state *crtc_state;
+	int i;
+
+	/* Return the default (first) mode if no info available yet */
+	if (!connector->state || !connector->state->crtc)
+		return 0;
+
+	crtc_state = connector->state->crtc->state;
+
+	for (i = 0; i < pinfo->desc->num_modes; i++) {
+		if (drm_mode_match(&crtc_state->mode,
+				   &pinfo->desc->modes[i],
+				   DRM_MODE_MATCH_TIMINGS | DRM_MODE_MATCH_CLOCK))
+			return i;
+	}
+
+	return 0;
+}
+
+static int icna3512_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	int cur_mode = icna35xx_get_current_mode(pinfo);
+	int cur_vrefresh = drm_mode_vrefresh(&pinfo->desc->modes[cur_mode]);
+
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9C, 0xA5, 0xA5);
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xFD, 0x5A, 0x5A);
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x53, 0xE0);
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x35, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x0F);
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xCE, 0x22);
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x01);
+	if (cur_vrefresh == 120) {
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
+                0x00, 0xE0, 0xA0, 0x10, 0xC8, 0x00, 0x02, 0x83, 
+                0x00, 0x10, 0x14, 0x00, 0x00, 0xC3, 0x00, 0x10, 
+                0x14, 0x00, 0x00, 0xE0, 0x10, 0x10, 0x9C, 0x00, 
+                0x00, 0xE0, 0xA0, 0x10, 0xC8, 0x22, 0x18, 0x18, 
+                0x18, 0x18, 0x18);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x07);
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB5,
+                0x04, 0x0C, 0x08, 0x0C, 0x04, 0x00, 0xC4);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xD9,
+                0x88, 0x40, 0x40, 0x88, 0x40, 0x40, 0x00, 0xEB,
+                0x11, 0xFF);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xCE,
+                0x01, 0x01, 0x01, 0x01, 0x04, 0x09, 0x2C);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x30);
+	}
+	else {
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
+                0x00, 0xE0, 0xA0, 0x10, 0xC8, 0x00);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x07);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB2,
+                0x04, 0x18, 0x08, 0x0C, 0x02, 0x00, 0xC4);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xD3,
+                0x88, 0x4A, 0x4A, 0x88, 0x4A, 0x4A, 0x00, 0xEB, 
+                0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xCB,
+                0x01, 0x01, 0x01, 0x01, 0x04, 0x2C);
+        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+	}
+
+	drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int icna3520_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	int cur_mode = icna35xx_get_current_mode(pinfo);
+	int cur_vrefresh = drm_mode_vrefresh(&pinfo->desc->modes[cur_mode]);
+
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9C, 0xA5, 0xA5);
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xFD, 0x5A, 0x5A);
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x53, 0xE0);
+    mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x35, 0x00);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+
+	mipi_dsi_msleep(&dsi_ctx, 120);
+
+	if (cur_vrefresh == 120) {
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
+                0x00, 0xD8, 0x00, 0x1C, 0x00, 0x4C);
+	}
+	else {
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x10);
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
+		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
+                0x00, 0xDB, 0x00, 0x1C, 0x00, 0x1C, 0x00, 0x00,
+				0xDB, 0x00, 0x1C, 0x07, 0xD6, 0x00);
+	}
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB2, 0x00);
+
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x0D);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB2, 0x27);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB6, 0x03);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xBB, 0x01);
+	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB2, 0x24);
+
+	drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	
+	mipi_dsi_msleep(&dsi_ctx, 20);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int mangmi_pocket_max_init_sequence(struct panel_info *pinfo)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = pinfo->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	int cur_mode = icna35xx_get_current_mode(pinfo);
+	int vrefresh = drm_mode_vrefresh(&pinfo->desc->modes[cur_mode]);
+
+	pinfo->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9c, 0xa5, 0xa5);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xfd, 0x5a, 0x5a);
+	if (vrefresh >= 90)
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x48, 0x30);
+	else
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x0f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xce, 0x22);
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 255);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x01);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xdf, 0xc5, 0x86);
+
+	switch (vrefresh) {
+	case 144:
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x00, 0xe0, 0xa0,
+					     0x10, 0xc8, 0x00, 0x02, 0x83, 0x00,
+					     0x10, 0x14, 0x00, 0x00, 0xc3, 0x00,
+					     0x10, 0x14, 0x00, 0x00, 0xe0, 0x00,
+					     0x10, 0x14, 0x00, 0x00, 0xe0, 0xa0,
+					     0x10, 0xc8, 0x22, 0x18, 0x18, 0x18,
+					     0x18, 0x18);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x07);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x04, 0x0a, 0x08,
+					     0x0a, 0x04, 0x00, 0xc4);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd9, 0x66, 0xe4, 0xe4,
+					     0x66, 0xe4, 0xe4, 0x00, 0xc4, 0x00,
+					     0x00, 0x00, 0x00, 0x00, 0x00,
+					     0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xce, 0x01, 0x01, 0x01,
+					     0x01, 0x04, 0x07, 0xa4);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x48, 0x30);
+		break;
+	case 120:
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x00, 0xe0, 0xa0,
+					     0x10, 0xc8, 0x00, 0x02, 0x83, 0x00,
+					     0x10, 0x14, 0x00, 0x00, 0xc3, 0x00,
+					     0x10, 0x14, 0x00, 0x00, 0xe0, 0x10,
+					     0x10, 0x9c, 0x00, 0x00, 0xe0, 0xa0,
+					     0x10, 0xc8, 0x22, 0x18, 0x18, 0x18,
+					     0x18, 0x18);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x07);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb5, 0x04, 0x0c, 0x08,
+					     0x0c, 0x04, 0x00, 0xc4);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd9, 0x88, 0x40, 0x40,
+					     0x88, 0x40, 0x40, 0x00, 0xeb, 0x00,
+					     0x00, 0x00, 0x00, 0x00, 0x00,
+					     0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xce, 0x01, 0x01, 0x01,
+					     0x01, 0x04, 0x09, 0x2c);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x48, 0x30);
+		break;
+	case 90:
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x00, 0xe0, 0x40,
+					     0x10, 0xa8, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x07);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x04, 0x10, 0x08,
+					     0x0c, 0x04, 0x00, 0xc4);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x55, 0x80, 0x80,
+					     0x55, 0x80, 0x80, 0x00, 0x9c, 0x00,
+					     0x00, 0x00, 0x00, 0x00, 0x00,
+					     0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcb, 0x01, 0x01, 0x01,
+					     0x01, 0x04, 0x06, 0x1c);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+		break;
+	default: /* 60 Hz */
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb3, 0x00, 0xe0, 0xa0,
+					     0x10, 0xc8, 0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x07);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb2, 0x04, 0x18, 0x08,
+					     0x0c, 0x04, 0x00, 0xc4);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xd3, 0x88, 0x4a, 0x4a,
+					     0x88, 0x4a, 0x4a, 0x00, 0xeb, 0x00,
+					     0x00, 0x00, 0x00, 0x00, 0x00,
+					     0x00);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcb, 0x01, 0x01, 0x01,
+					     0x01, 0x04, 0x09, 0x2c);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+		break;
+	}
+
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x9f, 0x02);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xbe, 0x04, 0x00, 0x10, 0x10,
+				     0x00, 0x03, 0x02, 0x07, 0xa4, 0x01, 0x00,
+				     0x00, 0x40, 0x20, 0x00, 0x00);
+	mipi_dsi_dcs_set_display_brightness_multi(&dsi_ctx, 0x0000);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0xe0);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+
+	drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 50);
+
+	return dsi_ctx.accum_err;
+}
