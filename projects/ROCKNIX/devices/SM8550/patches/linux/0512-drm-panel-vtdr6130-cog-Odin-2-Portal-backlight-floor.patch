From: TheWeaklessOne <41053514+TheWeaklessOne@users.noreply.github.com>
Subject: [PATCH] drm/panel: vtdr6130-cog: give the Portal panel a backlight floor

Below about DBV 100 the Odin 2 Portal panel goes dark (at 60 nothing is
visible). gamescope maps Steam's brightness slider linearly onto the
backlight range with a ~1 % floor, so the slider minimum (DBV 34) gave a
black screen. Spread backlight levels 1..max over bl_min..max instead;
0 still turns the backlight off.
---
diff --git a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
--- a/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
+++ b/drivers/gpu/drm/panel/panel-visionox-vtdr6130-cog.c
@@ -52,6 +52,11 @@
 	unsigned int num_modes;
 	int (*init_sequence)(struct panel_info *pinfo);
 	unsigned int bl_max;
+	/*
+	 * Lowest DBV that still lights the panel visibly. Backlight levels
+	 * 1..bl_max are spread over bl_min..bl_max; 0 stays 0.
+	 */
+	unsigned int bl_min;
 	/* Built-in EDID for panels whose users (gamescope) need one. */
 	const u8 *edid;
 	size_t edid_size;
@@ -426,6 +431,13 @@
 	.init_sequence = vtdr6130_portal_init_sequence,
 	/* Android: qcom,mdss-dsi-bl-max-level = <0xd55> */
 	.bl_max = 3413,
+	/*
+	 * Below about DBV 100 this panel goes dark: at 60 nothing is visible,
+	 * at 100 it is dim but usable (checked on a unit). gamescope maps
+	 * Steam's slider linearly with a ~1 % floor, so its minimum (34) read
+	 * as a black screen.
+	 */
+	.bl_min = 100,
 	.edid = vtdr6130_portal_edid,
 	.edid_size = sizeof(vtdr6130_portal_edid),
 	.dsc = {
@@ -582,9 +594,14 @@
 static int vtdr6130_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = backlight_get_brightness(bl);
+	unsigned int min = pinfo->desc->bl_min, max = bl->props.max_brightness;
 	int ret;
 
+	if (brightness && min && min < max)
+		brightness = min + DIV_ROUND_CLOSEST((brightness - 1) * (max - min), max - 1);
+
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
 	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
