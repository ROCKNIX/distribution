[Unit]
Description=Rocknix Memory Manager
After=local-fs.target
DefaultDependencies=no
Conflicts=swap.service shutdown.target
Before=shutdown.target
[Service]
Environment=HOME=/storage
Type=oneshot
ExecStart=/usr/bin/rocknix-memory-manager --setup
RemainAfterExit=yes
[Install]
WantedBy=basic.target
