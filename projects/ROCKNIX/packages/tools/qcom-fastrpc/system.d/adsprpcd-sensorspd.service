[Unit]
Description=Server for FastRPC remote procedure calls from Qualcomm Secure ADSP
After=dev-fastrpc-adsp-secure.device
ConditionPathExists=|/dev/fastrpc-adsp
ConditionPathExists=|/dev/fastrpc-adsp-secure

[Service]
ExecStart=/usr/bin/run-adsprpcd.sh
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target inputplumber.service