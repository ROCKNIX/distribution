 /*
+ * Rotation the kernel applied to the console, used when the device tree has none
+ * (x86 handhelds with portrait panels, rotated via drm_panel_orientation_quirks).
+ * fbcon rotate 1/2/3 is 90/180/270 degrees clockwise, as rotate_svg_path() expects.
+ */
+static int get_fbcon_rotation(void) {
+    int rotate = 0;
+    FILE *fp = fopen("/sys/class/graphics/fbcon/rotate", "r");
+    if (fp) {
+        if (fscanf(fp, "%d", &rotate) != 1)
+            rotate = 0;
+        fclose(fp);
+    }
+    return (rotate >= 1 && rotate <= 3) ? rotate * 90 : 0;
+}
