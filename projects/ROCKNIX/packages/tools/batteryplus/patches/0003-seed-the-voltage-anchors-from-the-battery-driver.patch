+// ========================= Anchor seeding =========================
+// The defaults describe a 4.2 V cell, so a 4.35 V pack reads 100% across the
+// top of its range until the first full charge teaches the map otherwise.
+// Start from the limits the battery driver reports instead: rk817 names them
+// *_design and constant_charge_voltage_max, axp20x voltage_max and voltage_min.
+static int read_limit_mv(const fs::path& dir, const char* a, const char* b) {
+    int mv = read_voltage_mv(dir / a);
+    return mv > 0 ? mv : read_voltage_mv(dir / b);
+}
+
+// Returns true when the map was seeded and needs saving.
+static bool seed_anchors(const BatteryPaths& bp, MapVals& map) {
+    if (!g_cfg.v_empty_set) {
+        int empty = read_limit_mv(bp.base_dir, "voltage_min_design", "voltage_min");
+        if (empty >= 3000 && empty <= 3400) {
+            g_cfg.V_EMPTY_DIS = empty;
+            g_cfg.V_EMPTY_CHG = std::max(empty + 100, 3300);
+        }
+    }
+
+    // Only an unlearned map; learning owns it from the first full charge on.
+    if (map.V_FULL_CHG != DEFAULT_V_FULL_CHG || map.V_FULL_DIS != DEFAULT_V_FULL_DIS)
+        return false;
+
+    int dis = read_limit_mv(bp.base_dir, "voltage_max_design", "voltage_max");
+    int chg = read_limit_mv(bp.base_dir, "constant_charge_voltage_max", "voltage_max");
+    if (dis < 3600 || dis > 4600)
+        return false;
+
+    map.V_FULL_DIS = dis;
+    map.V_FULL_CHG = std::clamp(chg, dis, 4600);
+    return true;
+}
+
 static int update_smoothed_voltage(int voltage_raw_mv, const MapVals& map, SmoothedV& sv) {
     if (sv.prev1 < 0)
         sv.prev1 = (voltage_raw_mv > 0 ? voltage_raw_mv : map.V_FULL_DIS);
@@ -1574,7 +1613,7 @@
     // Voltage map
     MapVals map = load_map(g_paths.map_file);
 
-    if (!fs::exists(g_paths.map_file)) {
+    if (seed_anchors(bp, map) || !fs::exists(g_paths.map_file)) {
         save_map_atomic(g_paths.map_file, map);
     }
 
