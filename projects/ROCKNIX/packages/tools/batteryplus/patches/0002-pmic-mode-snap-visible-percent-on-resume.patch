batteryplus: snap the visible percent on resume in PMIC mode

The kernel gauge has already reconciled across the sleep, so show its
value on resume instead of stepping one point at a time.

---
--- a/BatteryPlus/batteryplus.cpp
+++ b/BatteryPlus/batteryplus.cpp
@@ -2824,6 +2824,9 @@
                 resume_restore_saved.visible_percent = visible_percent;
 
                 resume_restore_pending = true;
+            } else {
+                // PMIC mode: the kernel gauge already reconciled across the sleep.
+                loop.visible_policy = VisiblePolicy::Snap;
             }
         }
 
