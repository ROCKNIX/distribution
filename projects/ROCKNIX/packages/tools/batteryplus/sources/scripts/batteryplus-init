. /etc/profile.d/001-functions

CONFIG_DIR="/storage/.config/batteryplus"
CONFIG_FILE="${CONFIG_DIR}/batteryplus.conf"
ENABLE_SETTING_KEY="system.batteryplus.enabled"
DEBUG_SETTING_KEY="system.batteryplus.debug"

### Enable logging
case $(get_setting system.loglevel) in
  verbose)
    DEBUG=true
  ;;
  *)
    DEBUG=false
  ;;
esac

write_config() {  
  ${DEBUG} && log $0 "batteryplus-mode: write_config, mode=$1, debug=$2"

  # Ensure config dir exists
  mkdir -p "${CONFIG_DIR}"
  
  # Write mode to batteryplus config override file
  cat <<EOF >${CONFIG_FILE}
mode=$1
debug=$2
EOF
}

init_config() {
  BATTERYPLUS_ENABLED=$(get_setting ${ENABLE_SETTING_KEY})
  BATTERYPLUS_DEBUG_ENABLED=$(get_setting ${DEBUG_SETTING_KEY})
  ${DEBUG} && log $0 "batteryplus-mode: init_config, enabled=${BATTERYPLUS_ENABLED}, debug=${BATTERYPLUS_DEBUG_ENABLED}"

  if [[ -z "${BATTERYPLUS_ENABLED}" ]]; then
    # Default to 'enabled'
    BATTERYPLUS_ENABLED="1"
    set_setting "${ENABLE_SETTING_KEY}" "${BATTERYPLUS_ENABLED}"
  fi

  if [[ -z "${BATTERYPLUS_DEBUG_ENABLED}" ]]; then
    # Default to 'disabled'
    BATTERYPLUS_DEBUG_ENABLED="0"
    set_setting "${DEBUG_SETTING_KEY}" "${BATTERYPLUS_DEBUG_ENABLED}"
  fi

  # Derive batteryplus mode (enabled = voltage, disabled = pmic)
  BATTERYPLUS_MODE="voltage"
  [[ "${BATTERYPLUS_ENABLED}" == "0" ]] && BATTERYPLUS_MODE="pmic"

  # Derive batteryplus debug flag
  BATTERYPLUS_DEBUG="false"
  [[ "${BATTERYPLUS_DEBUG_ENABLED}" == "1" ]] && BATTERYPLUS_DEBUG="true"

  write_config "${BATTERYPLUS_MODE}" "${BATTERYPLUS_DEBUG}"
}

# Main logic
init_config
