. /etc/profile.d/001-functions

CONFIG_DIR="/storage/.config/batteryplus"
CONFIG_FILE="${CONFIG_DIR}/batteryplus.conf"
SETTING_KEY="system.batteryplus.enabled"

### Enable logging
case $(get_setting system.loglevel) in
  verbose)
    DEBUG=true
  ;;
  *)
    DEBUG=false
  ;;
esac

write_config() {  
  ${DEBUG} && log $0 "batteryplus-mode: write_config, mode=$1"

  # Ensure config dir exists
  mkdir -p "${CONFIG_DIR}"
  
  # Write mode to batteryplus config override file
  cat <<EOF >${CONFIG_FILE}
mode=$1
EOF
}

init_config() {
  BATTERYPLUS_ENABLED=$(get_setting ${SETTING_KEY})
  ${DEBUG} && log $0 "batteryplus-mode: init_config, enabled=${BATTERYPLUS_ENABLED}"

  if [[ -z "${BATTERYPLUS_ENABLED}" ]]; then
    # Default to 'enabled'
    BATTERYPLUS_ENABLED="1"
    set_setting "${SETTING_KEY}" "${BATTERYPLUS_ENABLED}"
  fi

  # Derive batteryplus mode (enabled = voltage, disabled = pmic)
  BATTERYPLUS_MODE="voltage"
  [[ "${BATTERYPLUS_ENABLED}" == "0" ]] && BATTERYPLUS_MODE="pmic"

  write_config "${BATTERYPLUS_MODE}"
}

# Main logic
init_config
