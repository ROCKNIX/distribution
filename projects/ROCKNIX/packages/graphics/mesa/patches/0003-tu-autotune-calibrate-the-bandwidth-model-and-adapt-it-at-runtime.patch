+   float t_skip_light_us;
+   float t_skip_heavy_us;
+   float t_skip_pad_us;
+   float t_render_light_us;
+   float t_render_heavy_us;
+   float pixel_bytes_per_draw;
+   float prim_bytes_per_vis;
+   uint32_t stream_light;
+   uint32_t stream_heavy;
+   uint32_t stream_pad;
+   uint32_t state_light;
+   uint32_t state_heavy;
+   float depth_layer_sys_us;
+   float depth_layer_gmem_us;
+   float depth_hidden_gmem_us;
+   float reject_layer_sys_us;
