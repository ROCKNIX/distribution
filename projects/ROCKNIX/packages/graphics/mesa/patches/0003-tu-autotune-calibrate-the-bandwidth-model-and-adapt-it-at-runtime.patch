+bool create_image(probe &p, probe_image &img, uint32_t width, uint32_t height, image_kind kind);
+
+/* Set 0, binding 0 of the texture shader. */
+bool
+create_texture_resources(probe &p)
+{
+   if (!create_image(p, p.tex, TEX_SIZE, TEX_SIZE, IMG_TEXTURE))
+      return false;
+   const VkSamplerCreateInfo sampler_info = {
+      .sType = VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO,
+      .magFilter = VK_FILTER_NEAREST,
+      .minFilter = VK_FILTER_NEAREST,
+      .mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST,
+      .addressModeU = VK_SAMPLER_ADDRESS_MODE_REPEAT,
+      .addressModeV = VK_SAMPLER_ADDRESS_MODE_REPEAT,
+      .addressModeW = VK_SAMPLER_ADDRESS_MODE_REPEAT,
+   };
+   if (p.disp->CreateSampler(p.dev, &sampler_info, NULL, &p.sampler) != VK_SUCCESS)
+      return fail(p, "sampler");
+   const VkDescriptorSetLayoutBinding binding = {
+      .binding = 0,
+      .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+      .descriptorCount = 1,
+      .stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT,
+   };
+   const VkDescriptorSetLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+      .bindingCount = 1,
+      .pBindings = &binding,
+   };
+   if (p.disp->CreateDescriptorSetLayout(p.dev, &layout_info, NULL, &p.set_layout) != VK_SUCCESS)
+      return fail(p, "descriptor set layout");
+   const VkDescriptorPoolSize pool_size = { VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1 };
+   const VkDescriptorPoolCreateInfo pool_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+      .maxSets = 1,
+      .poolSizeCount = 1,
+      .pPoolSizes = &pool_size,
+   };
+   if (p.disp->CreateDescriptorPool(p.dev, &pool_info, NULL, &p.desc_pool) != VK_SUCCESS)
+      return fail(p, "descriptor pool");
+   const VkDescriptorSetAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+      .descriptorPool = p.desc_pool,
+      .descriptorSetCount = 1,
+      .pSetLayouts = &p.set_layout,
+   };
+   if (p.disp->AllocateDescriptorSets(p.dev, &alloc_info, &p.tex_set) != VK_SUCCESS)
+      return fail(p, "descriptor set");
+   const VkDescriptorImageInfo image_info = {
+      .sampler = p.sampler,
+      .imageView = p.tex.view,
+      .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+   };
+   const VkWriteDescriptorSet write = {
+      .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+      .dstSet = p.tex_set,
+      .dstBinding = 0,
+      .descriptorCount = 1,
+      .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER,
+      .pImageInfo = &image_info,
+   };
+   p.disp->UpdateDescriptorSets(p.dev, 1, &write, 0, NULL);
+   return true;
+}
+
+bool
+create_pipeline(probe &p, probe_pipeline which)
+{
+   const VkPushConstantRange push_range = {
+      .stageFlags = VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT,
+      .offset = 0,
+      .size = sizeof(push_data),
+   };
+   const VkPipelineLayoutCreateInfo layout_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+      .setLayoutCount = which == PIPE_TEX ? 1u : 0u,
+      .pSetLayouts = &p.set_layout,
+      .pushConstantRangeCount = 1,
+      .pPushConstantRanges = &push_range,
+   };
+   if (p.disp->CreatePipelineLayout(p.dev, &layout_info, NULL, &p.layouts[which]) != VK_SUCCESS)
+      return fail(p, "pipeline layout");
+
+   nir_shader *vs = build_vs(p.device);
+   nir_shader *fs = build_fs(p.device, which != PIPE_FLAT, which == PIPE_ALU ? ALU_CHAIN : 0,
+                             which == PIPE_TEX ? TEX_FETCHES : 0, which == PIPE_DEPTH_ALWAYS);
+
+   const VkPipelineShaderStageNirCreateInfoMESA vs_nir = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+      .nir = vs,
+   };
+   const VkPipelineShaderStageNirCreateInfoMESA fs_nir = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_NIR_CREATE_INFO_MESA,
+      .nir = fs,
+   };
+   const VkPipelineShaderStageCreateInfo stages[2] = {
+      {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .pNext = &vs_nir,
+         .stage = VK_SHADER_STAGE_VERTEX_BIT,
+         .pName = "main",
+      },
+      {
+         .sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+         .pNext = &fs_nir,
+         .stage = VK_SHADER_STAGE_FRAGMENT_BIT,
+         .pName = "main",
+      },
+   };
+   const VkPipelineVertexInputStateCreateInfo vi_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO,
+   };
+   const VkPipelineInputAssemblyStateCreateInfo ia_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO,
+      .topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST,
+   };
+   const VkPipelineViewportStateCreateInfo vp_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO,
+      .viewportCount = 1,
+      .scissorCount = 1,
+   };
+   const VkPipelineRasterizationStateCreateInfo rs_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO,
+      .polygonMode = VK_POLYGON_MODE_FILL,
+      .cullMode = VK_CULL_MODE_NONE,
+      .frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE,
+      .lineWidth = 1.0f,
+   };
+   const VkPipelineMultisampleStateCreateInfo ms_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO,
+      .rasterizationSamples = VK_SAMPLE_COUNT_1_BIT,
+   };
+   const VkPipelineDepthStencilStateCreateInfo ds_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO,
+      .depthTestEnable = which == PIPE_DEPTH || which == PIPE_DEPTH_ALWAYS,
+      .depthWriteEnable = which == PIPE_DEPTH || which == PIPE_DEPTH_ALWAYS,
+      .depthCompareOp = which == PIPE_DEPTH_ALWAYS ? VK_COMPARE_OP_ALWAYS
+                        : depth_greater()          ? VK_COMPARE_OP_GREATER
+                                                   : VK_COMPARE_OP_LESS,
+   };
+   const VkPipelineColorBlendAttachmentState cb_att = {
+      .blendEnable = which == PIPE_STRIPES_BLEND,
+      .srcColorBlendFactor = VK_BLEND_FACTOR_ONE,
+      .dstColorBlendFactor = VK_BLEND_FACTOR_ONE,
+      .colorBlendOp = VK_BLEND_OP_ADD,
+      .srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE,
+      .dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE,
+      .alphaBlendOp = VK_BLEND_OP_ADD,
+      .colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT |
+                        VK_COLOR_COMPONENT_A_BIT,
+   };
+   const VkPipelineColorBlendStateCreateInfo cb_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO,
+      .attachmentCount = 1,
+      .pAttachments = &cb_att,
+   };
+   const VkDynamicState dyn_states[2] = { VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR };
+   const VkPipelineDynamicStateCreateInfo dyn_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO,
+      .dynamicStateCount = 2,
+      .pDynamicStates = dyn_states,
+   };
+   const VkPipelineRenderingCreateInfo rendering_info = {
+      .sType = VK_STRUCTURE_TYPE_PIPELINE_RENDERING_CREATE_INFO,
+      .colorAttachmentCount = 1,
+      .pColorAttachmentFormats = &PROBE_FORMAT,
+      .depthAttachmentFormat =
+         which == PIPE_DEPTH || which == PIPE_DEPTH_ALWAYS ? PROBE_DEPTH_FORMAT : VK_FORMAT_UNDEFINED,
+   };
+   const VkGraphicsPipelineCreateInfo pipeline_info = {
+      .sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO,
+      .pNext = &rendering_info,
+      .stageCount = 2,
+      .pStages = stages,
+      .pVertexInputState = &vi_info,
+      .pInputAssemblyState = &ia_info,
+      .pViewportState = &vp_info,
+      .pRasterizationState = &rs_info,
+      .pMultisampleState = &ms_info,
+      .pDepthStencilState = &ds_info,
+      .pColorBlendState = &cb_info,
+      .pDynamicState = &dyn_info,
+      .layout = p.layouts[which],
+   };
+
+   VkResult result =
+      p.disp->CreateGraphicsPipelines(p.dev, VK_NULL_HANDLE, 1, &pipeline_info, NULL, &p.pipelines[which]);
+   ralloc_free(vs);
+   ralloc_free(fs);
+   if (result != VK_SUCCESS)
+      return fail(p, "graphics pipeline");
+
+   const struct tu_pipeline *pipeline = tu_pipeline_from_handle(p.pipelines[which]);
+   const struct tu_shader *fs_shader = pipeline->shaders[MESA_SHADER_FRAGMENT];
+   p.fs_instrs[which] = fs_shader && fs_shader->variant ? fs_shader->variant->info.instrs_count : 0;
+   p.fs_tex[which] = fs_shader ? fs_shader->nir_tex_count : 0;
+   return true;
+}
+
+void
+destroy_image(probe &p, probe_image &img)
+{
+   if (img.view)
+      p.disp->DestroyImageView(p.dev, img.view, NULL);
+   if (img.image)
+      p.disp->DestroyImage(p.dev, img.image, NULL);
+   if (img.memory)
+      p.disp->FreeMemory(p.dev, img.memory, NULL);
+   img = probe_image();
+}
+
+bool
+create_image(probe &p, probe_image &img, uint32_t width, uint32_t height, image_kind kind = IMG_COLOR)
+{
+   img.width = width;
+   img.height = height;
+   const bool depth = kind == IMG_DEPTH;
+   const VkFormat format = depth ? PROBE_DEPTH_FORMAT : PROBE_FORMAT;
+   const VkImageAspectFlags aspect = depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+   const VkImageUsageFlags usage = depth                 ? VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT
+                                   : kind == IMG_TEXTURE ? VK_IMAGE_USAGE_SAMPLED_BIT
+                                                         : VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+
+   const VkImageCreateInfo image_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+      .imageType = VK_IMAGE_TYPE_2D,
+      .format = format,
+      .extent = { width, height, 1 },
+      .mipLevels = 1,
+      .arrayLayers = 1,
+      .samples = VK_SAMPLE_COUNT_1_BIT,
+      .tiling = VK_IMAGE_TILING_OPTIMAL,
+      .usage = usage,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+      .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+   };
+   if (p.disp->CreateImage(p.dev, &image_info, NULL, &img.image) != VK_SUCCESS)
+      return fail(p, "image");
+
+   VkMemoryRequirements reqs;
+   p.disp->GetImageMemoryRequirements(p.dev, img.image, &reqs);
+
+   VkPhysicalDeviceMemoryProperties mem_props;
+   struct tu_physical_device *pdev = p.device->physical_device;
+   pdev->vk.dispatch_table.GetPhysicalDeviceMemoryProperties(tu_physical_device_to_handle(pdev), &mem_props);
+
+   uint32_t type_index = UINT32_MAX;
+   for (uint32_t i = 0; i < mem_props.memoryTypeCount; i++) {
+      if (!(reqs.memoryTypeBits & (1u << i)))
+         continue;
+      if (mem_props.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) {
+         type_index = i;
+         break;
+      }
+      if (type_index == UINT32_MAX)
+         type_index = i;
+   }
+   if (type_index == UINT32_MAX)
+      return fail(p, "memory type");
+
+   const VkMemoryAllocateInfo alloc_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = reqs.size,
+      .memoryTypeIndex = type_index,
+   };
+   if (p.disp->AllocateMemory(p.dev, &alloc_info, NULL, &img.memory) != VK_SUCCESS)
+      return fail(p, "image memory");
+   if (p.disp->BindImageMemory(p.dev, img.image, img.memory, 0) != VK_SUCCESS)
+      return fail(p, "bind image memory");
+
+   const VkImageViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+      .image = img.image,
+      .viewType = VK_IMAGE_VIEW_TYPE_2D,
+      .format = format,
+      .subresourceRange = { aspect, 0, 1, 0, 1 },
+   };
+   if (p.disp->CreateImageView(p.dev, &view_info, NULL, &img.view) != VK_SUCCESS)
+      return fail(p, "image view");
+   return true;
+}
+
+/* Also returns the tiling, which the driver already picks at vkCmdBeginRendering. */
+void
+begin_rendering_ex(probe &p, const probe_image &img, bool sysmem, bool load, bool store, tiling_info *ti,
+                   bool depth = false, bool depth_load = false, bool depth_store = false, bool depth_clear = true)
+{
+   struct tu_cmd_buffer *cmd = tu_cmd_buffer_from_handle(p.cb);
+   cmd->calib_force = sysmem ? TU_CALIB_FORCE_SYSMEM : TU_CALIB_FORCE_GMEM;
+
+   const VkRenderingAttachmentInfo att = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = img.view,
+      .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .loadOp = load ? VK_ATTACHMENT_LOAD_OP_LOAD : VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+      .storeOp = store ? VK_ATTACHMENT_STORE_OP_STORE : VK_ATTACHMENT_STORE_OP_DONT_CARE,
+   };
+   const VkRenderingAttachmentInfo depth_att = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO,
+      .imageView = p.depth.view,
+      .imageLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .loadOp = depth_load    ? VK_ATTACHMENT_LOAD_OP_LOAD
+                : depth_clear ? VK_ATTACHMENT_LOAD_OP_CLEAR
+                              : VK_ATTACHMENT_LOAD_OP_DONT_CARE,
+      .storeOp = depth_store ? VK_ATTACHMENT_STORE_OP_STORE : VK_ATTACHMENT_STORE_OP_DONT_CARE,
+      .clearValue = { .depthStencil = { depth_greater() ? 0.0f : 1.0f, 0 } },
+   };
+   const VkRenderingInfo rendering = {
+      .sType = VK_STRUCTURE_TYPE_RENDERING_INFO,
+      .renderArea = { { 0, 0 }, { img.width, img.height } },
+      .layerCount = 1,
+      .colorAttachmentCount = 1,
+      .pColorAttachments = &att,
+      .pDepthAttachment = depth ? &depth_att : NULL,
+   };
+   p.disp->CmdBeginRendering(p.cb, &rendering);
+
+   const struct tu_tiling_config *tiling = cmd->state.tiling;
+   *ti = {};
+   if (tiling && tiling->possible) {
+      ti->bins = tiling->vsc.tile_count.width * tiling->vsc.tile_count.height;
+      ti->tiles_x = tiling->vsc.tile_count.width;
+      ti->pipes = tiling->vsc.pipe_count.width * tiling->vsc.pipe_count.height;
+      ti->tile_w = 2.0f * tiling->tile0.width / img.width;
+      ti->tile_h = 2.0f * tiling->tile0.height / img.height;
+      ti->binning_ok = tiling->vsc.binning_possible && tiling->vsc.binning_useful;
+   }
+}
+
+void
+begin_rendering(probe &p, const probe_image &img, bool sysmem, bool load, bool store, uint32_t *bins,
+                bool *binning_ok)
+{
+   tiling_info ti;
+   begin_rendering_ex(p, img, sysmem, load, store, &ti);
+   *bins = ti.bins;
+   *binning_ok = ti.binning_ok;
+}
+
+void
+end_rendering(probe &p, bool *used_sysmem)
+{
+   struct tu_cmd_buffer *cmd = tu_cmd_buffer_from_handle(p.cb);
+   p.disp->CmdEndRendering(p.cb);
+   *used_sysmem = cmd->calib_last_sysmem;
+   cmd->calib_force = TU_CALIB_FORCE_NONE;
+}
+
+bool
+begin_cmd_buffer(probe &p)
+{
+   const VkCommandBufferBeginInfo begin_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   if (p.disp->ResetCommandBuffer(p.cb, 0) != VK_SUCCESS)
+      return fail(p, "reset command buffer");
+   if (p.disp->BeginCommandBuffer(p.cb, &begin_info) != VK_SUCCESS)
+      return fail(p, "begin command buffer");
+   return true;
+}
+
+/* Smallest square image with enough bins, plus one twice as wide for the per-bin cost. */
+bool
+choose_sizes(probe &p)
+{
+   /* a7xx and later need bigger images to get enough bins */
+   const uint32_t candidates[] = { 512, 1024, 2048, 2896, 4096 };
+   for (uint32_t size : candidates) {
+      if (!create_image(p, p.s1, size, size))
+         return false;
+      if (!begin_cmd_buffer(p))
+         return false;
+
+      tiling_info ti;
+      bool used_sysmem;
+      begin_rendering_ex(p, p.s1, true, false, false, &ti);
+      end_rendering(p, &used_sysmem);
+      p.disp->EndCommandBuffer(p.cb);
+      if (p.dump)
+         mesa_logi("autotune calib: %ux%u image: %u bins (%u x %.3f NDC wide, %.3f tall), %u pipes, binning %s", size,
+                   size, ti.bins, ti.tiles_x, ti.tile_w, ti.tile_h, ti.pipes, ti.binning_ok ? "ok" : "no");
+
+      if (ti.bins >= MIN_BINS && ti.binning_ok) {
+         if (!create_image(p, p.s2, size * 2, size))
+            return false;
+         return true;
+      }
+      destroy_image(p, p.s1);
+   }
+   return fail(p, "no image size with enough bins");
+}
+
+void
+record_barrier(probe &p)
+{
+   const VkMemoryBarrier2 barrier = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER_2,
+      .srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+      .srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT,
+      .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+      .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+   };
+   const VkDependencyInfo dep = {
+      .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+      .memoryBarrierCount = 1,
+      .pMemoryBarriers = &barrier,
+   };
+   p.disp->CmdPipelineBarrier2(p.cb, &dep);
+}
+
+void
+record_layout_transition(probe &p, const probe_image &img, bool depth = false)
+{
+   const VkImageMemoryBarrier2 barrier = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2,
+      .srcStageMask = VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT,
+      .dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT,
+      .dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+      .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = img.image,
+      .subresourceRange = { depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 },
+   };
+   const VkDependencyInfo dep = {
+      .sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO,
+      .imageMemoryBarrierCount = 1,
+      .pImageMemoryBarriers = &barrier,
+   };
+   p.disp->CmdPipelineBarrier2(p.cb, &dep);
+}
+
+/* Returns false if the driver didn't use the requested mode. */
+bool
+record_pass(probe &p, uint32_t pass, bool keep)
+{
+   const pass_desc &d = pass_descs[pass];
+   const probe_image &img = d.s2 ? p.s2 : p.s1;
+   struct tu_cmd_buffer *cmd = tu_cmd_buffer_from_handle(p.cb);
+
+   probe_sample sample = {};
+   sample.query = p.query_count;
+   sample.pass = pass;
+   p.query_count += 2;
+
+   p.disp->CmdWriteTimestamp2(p.cb, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, p.queries, sample.query);
+
+   tiling_info ti;
+   begin_rendering_ex(p, img, d.sysmem, d.load, d.store, &ti, d.depth, d.depth_load, d.depth_store,
+                      d.pipeline != PIPE_DEPTH_ALWAYS);
+   sample.bins = ti.bins;
+   sample.pipes = ti.pipes;
+   bool binning_ok = ti.binning_ok;
+
+   /* kept GMEM passes get a slot for their VSC sizes */
+   cmd->calib_pad_dwords = d.variant == VAR_PAD ? PAD_DWORDS : 0;
+   sample.vsc_slot = (keep && !d.sysmem) ? (uint32_t) p.samples.size() + 1 : 0;
+   cmd->calib_vsc_iova = sample.vsc_slot ? p.vsc_bo->iova + (uint64_t) sample.vsc_slot * VSC_SLOT_DWORDS * 4 : 0;
+
+   const VkViewport viewport = { 0.0f, 0.0f, (float) img.width, (float) img.height, 0.0f, 1.0f };
+   const VkRect2D scissor = { { 0, 0 }, { img.width, img.height } };
+   p.disp->CmdSetViewport(p.cb, 0, 1, &viewport);
+   p.disp->CmdSetScissor(p.cb, 0, 1, &scissor);
+
+   push_data data = {};
+   push_data *pd = &data;
+
+   for (uint32_t i = 0; i < d.draws; i++) {
+      /* switching pipelines makes every draw re-emit its draw states */
+      const bool heavy = d.variant == VAR_HEAVY;
+      probe_pipeline pipe = (heavy && (i & 1)) ? PIPE_STRIPES_ALT : d.pipeline;
+      if (i == 0 || heavy) {
+         p.disp->CmdBindPipeline(p.cb, VK_PIPELINE_BIND_POINT_GRAPHICS, p.pipelines[pipe]);
+         if (pipe == PIPE_TEX)
+            p.disp->CmdBindDescriptorSets(p.cb, VK_PIPELINE_BIND_POINT_GRAPHICS, p.layouts[pipe], 0, 1, &p.tex_set,
+                                          0, NULL);
+      }
+
+      if (d.omni) {
+         /* one pixel in from the corner of each bin */
+         pd->x0 = 2.0f / img.width;
+         pd->y0 = 2.0f / img.height;
+         pd->x1 = 2.0f * pd->x0;
+         pd->y1 = 2.0f * pd->y0;
+         pd->tile_w = ti.tile_w;
+         pd->tile_h = ti.tile_h;
+         pd->tiles_x = ti.tiles_x;
+         pd->omni = 1;
+      } else if (d.pixel) {
+         /* spread the pixels out so the draws land in different bins */
+         uint32_t px = (i * 7919u) % img.width;
+         uint32_t py = (i * 104729u) % img.height;
+         pd->x0 = -1.0f + 2.0f * px / img.width;
+         pd->y0 = -1.0f + 2.0f * py / img.height;
+         pd->x1 = pd->x0 + 2.0f / img.width;
+         pd->y1 = pd->y0 + 2.0f / img.height;
+      } else {
+         pd->x0 = pd->y0 = -1.0f;
+         pd->x1 = pd->y1 = 1.0f;
+      }
+      pd->color[0] = (i & 1) ? 0.9f : 0.1f;
+      pd->color[1] = (i & 2) ? 0.8f : 0.2f;
+      pd->color[2] = (i & 4) ? 0.7f : 0.3f;
+      pd->color[3] = 1.0f;
+      pd->z = d.depth ? (d.ftb ? 0.3f + 0.2f * i : 0.9f - 0.2f * i) : 0.0f;
+      if (d.depth && depth_greater())
+         pd->z = 1.0f - pd->z;
+      p.disp->CmdPushConstants(p.cb, p.layouts[pipe], VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0,
+                               sizeof(data), &data);
+      p.disp->CmdDraw(p.cb, d.omni ? 6 * MAX2(ti.bins, 1u) : 6, 1, 0, 0);
+   }
+
+   sample.stream_dwords = tu_cs_total_dwords(&cmd->draw_cs);
+   sample.state_dwords = cmd->draw_cs.draw_state_dwords;
+   if (p.device->autotune->calib_payload)
+      sample.state_dwords += cmd->draw_cs.load_payload_dwords + cmd->draw_cs.draw_state_payload_dwords;
+   end_rendering(p, &sample.sysmem);
+   cmd->calib_pad_dwords = 0;
+   cmd->calib_vsc_iova = 0;
+
+   p.disp->CmdWriteTimestamp2(p.cb, VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT, p.queries, sample.query + 1);
+   record_barrier(p);
+
+   if (sample.sysmem != d.sysmem)
+      return fail(p, "render mode could not be forced");
+   if (!d.sysmem && !binning_ok)
+      return fail(p, "HW binning unavailable for the probe image");
+
+   if (keep)
+      p.samples.push_back(sample);
+   return true;
+}
+
+bool
+submit_and_wait(probe &p)
+{
+   if (p.disp->ResetFences(p.dev, 1, &p.fence) != VK_SUCCESS)
+      return fail(p, "reset fence");
+
+   const VkCommandBufferSubmitInfo cb_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO,
+      .commandBuffer = p.cb,
+   };
+   const VkSubmitInfo2 submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2,
+      .commandBufferInfoCount = 1,
+      .pCommandBufferInfos = &cb_info,
+   };
+   if (p.disp->QueueSubmit2(p.queue, 1, &submit, p.fence) != VK_SUCCESS)
+      return fail(p, "submit");
+   if (p.disp->WaitForFences(p.dev, 1, &p.fence, VK_TRUE, PROBE_TIMEOUT_NS) != VK_SUCCESS)
+      return fail(p, "wait");
+   return true;
+}
+
+/* Keeps the GPU busy until two batches in a row take the same time, so the clocks have settled. */
+bool
+run_warmup(probe &p)
+{
+   int64_t previous_ns = 0;
+   for (uint32_t batch = 0; batch < WARMUP_MAX_BATCHES; batch++) {
+      if (!begin_cmd_buffer(p))
+         return false;
+      p.query_count = 0;
+      p.disp->CmdResetQueryPool(p.cb, p.queries, 0, MAX_QUERIES);
+      if (batch == 0) {
+         record_layout_transition(p, p.s1);
+         record_layout_transition(p, p.s2);
+         record_layout_transition(p, p.depth, true);
+         record_layout_transition(p, p.tex);
+      }
+      for (uint32_t i = 0; i < WARMUP_PASSES; i++) {
+         if (!record_pass(p, PASS_SYSMEM_OVERDRAW_N, false))
+            return false;
+      }
+      if (p.disp->EndCommandBuffer(p.cb) != VK_SUCCESS)
+         return fail(p, "end command buffer");
+
+      int64_t start_ns = os_time_get_nano();
+      if (!submit_and_wait(p))
+         return false;
+      int64_t batch_ns = os_time_get_nano() - start_ns;
+
+      if (previous_ns && llabs(batch_ns - previous_ns) * 20 < previous_ns)
+         return true; /* within 5% of the previous batch */
+      previous_ns = batch_ns;
+   }
+   return true;
+}
+
+bool
+create_query_pool(probe &p)
+{
+   const VkQueryPoolCreateInfo query_info = {
+      .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+      .queryType = VK_QUERY_TYPE_TIMESTAMP,
+      .queryCount = MAX_QUERIES,
+   };
+   if (p.disp->CreateQueryPool(p.dev, &query_info, NULL, &p.queries) != VK_SUCCESS)
+      return fail(p, "query pool");
+   return true;
+}
+
+bool
+run_probe_passes(probe &p)
+{
+   if (!begin_cmd_buffer(p))
+      return false;
+   p.query_count = 0;
+   p.disp->CmdResetQueryPool(p.cb, p.queries, 0, MAX_QUERIES);
+
+   /* interleaved so clock drift hits every pass the same */
+   for (uint32_t round = 0; round < PROBE_ROUNDS; round++) {
+      for (uint32_t pass = 0; pass < PASS_COUNT; pass++) {
+         if (!record_pass(p, pass, round > 0))
+            return false;
+      }
+   }
+
+   if (p.disp->EndCommandBuffer(p.cb) != VK_SUCCESS)
+      return fail(p, "end command buffer");
+   if (!submit_and_wait(p))
+      return false;
+
+   uint64_t shown = 0;
+   for (probe_sample &s : p.samples) {
+      if (!s.vsc_slot)
+         continue;
+      const uint32_t *slot = p.vsc_map + s.vsc_slot * VSC_SLOT_DWORDS;
+      const uint32_t pipes = MIN2(s.pipes, (uint32_t) MAX_VSC_PIPES);
+      s.vsc_draw_bytes = s.vsc_prim_bytes = 0;
+      for (uint32_t i = 0; i < pipes; i++) {
+         s.vsc_draw_bytes += slot[i];
+         s.vsc_prim_bytes += slot[MAX_VSC_PIPES + i];
+      }
+      if (p.dump && !(shown & (1ull << s.pass))) {
+         shown |= 1ull << s.pass;
+         char line[400];
+         int n = 0;
+         for (uint32_t i = 0; i < pipes && n < (int) sizeof(line) - 16; i++)
+            n += snprintf(line + n, sizeof(line) - n, " %u/%u", slot[i], slot[MAX_VSC_PIPES + i]);
+         mesa_logi("autotune calib vsc per pipe (draw/prim bytes) %-26s%s", pass_descs[s.pass].name, line);
+      }
+   }
+   return true;
+}
+
+bool
+create_vsc_buffer(probe &p)
+{
+   const uint64_t size = (uint64_t) (PROBE_ROUNDS * PASS_COUNT + 1) * VSC_SLOT_DWORDS * sizeof(uint32_t);
+   if (tu_bo_init_new(p.device, NULL, &p.vsc_bo, size, TU_BO_ALLOC_NO_FLAGS, "autotune calib vsc") != VK_SUCCESS)
+      return fail(p, "vsc buffer");
+   if (tu_bo_map(p.device, p.vsc_bo, NULL) != VK_SUCCESS)
+      return fail(p, "vsc buffer map");
+   p.vsc_map = (uint32_t *) p.vsc_bo->map;
+   memset(p.vsc_map, 0, size);
+   return true;
+}
+
+double
+median(std::vector<double> &v)
+{
+   std::sort(v.begin(), v.end());
+   size_t n = v.size();
+   return n % 2 ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
+}
+
+struct pass_stats {
+   double median, min, max;
+   uint32_t bins, stream, state;
+   uint64_t vsc_draw, vsc_prim;
+};
+
+/* GMEM passes switch between two speeds from repeat to repeat, even at a fixed clock, so the fastest repeat is
+ * not the typical one. The median is, and it also ignores repeats slowed by other GPU users.
+ */
+
+bool
+analyse_probe(probe &p, struct tu_autotune_calib *calib, pass_stats *stats)
+{
+   std::vector<uint64_t> ticks(p.query_count);
+   if (p.disp->GetQueryPoolResults(p.dev, p.queries, 0, p.query_count, ticks.size() * sizeof(uint64_t),
+                                   ticks.data(), sizeof(uint64_t),
+                                   VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT) != VK_SUCCESS)
+      return fail(p, "query results");
+
+   std::vector<double> durations[PASS_COUNT];
+   double total_us = 0;
+   for (const probe_sample &s : p.samples) {
+      uint64_t begin = tu_device_ticks_to_ns(p.device, ticks[s.query]);
+      uint64_t end = tu_device_ticks_to_ns(p.device, ticks[s.query + 1]);
+      if (end < begin)
+         return fail(p, "timestamps out of order");
+      double us = (end - begin) / 1000.0;
+      durations[s.pass].push_back(us);
+      stats[s.pass].bins = s.bins;
+      stats[s.pass].stream = s.stream_dwords;
+      stats[s.pass].state = s.state_dwords;
+      stats[s.pass].vsc_draw = s.vsc_draw_bytes;
+      stats[s.pass].vsc_prim = s.vsc_prim_bytes;
+      total_us += us;
+   }
+   for (uint32_t i = 0; i < PASS_COUNT; i++) {
+      if (durations[i].empty())
+         return fail(p, "missing pass");
+      stats[i].min = *std::min_element(durations[i].begin(), durations[i].end());
+      stats[i].max = *std::max_element(durations[i].begin(), durations[i].end());
+      stats[i].median = median(durations[i]);
+   }
+   auto us = [&](probe_pass pass) { return stats[pass].median; };
+
+   const double bytes = (double) p.s1.width * p.s1.height * PROBE_CPP;
+   const double layers = OVERDRAW_LAYERS - 1;
+   const double bins1 = stats[PASS_GMEM_PIXEL_LIGHT_FEW_S1].bins;
+   const double bins2 = stats[PASS_GMEM_PIXEL_LIGHT_FEW_S2].bins;
+   const double dbins = bins2 - bins1;
+   if (dbins <= 0)
+      return fail(p, "second image did not add bins");
+
+   /* Games mostly blend or depth test, so the model uses the blended rate at two bytes per sample. */
+   const double sysmem_overdraw_us = us(PASS_SYSMEM_OVERDRAW_N) - us(PASS_SYSMEM_OVERDRAW_1);
+   const double sysmem_flat_us = us(PASS_SYSMEM_FLAT_N) - us(PASS_SYSMEM_FLAT_1);
+   const double sysmem_blend_us = us(PASS_SYSMEM_BLEND_N) - us(PASS_SYSMEM_BLEND_1);
+   if (sysmem_overdraw_us <= 0 || sysmem_flat_us <= 0 || sysmem_blend_us <= 0)
+      return fail(p, "sysmem overdraw not measurable");
+   const double bw_write = layers * bytes / sysmem_overdraw_us;
+   const double bw_flat = layers * bytes / sysmem_flat_us;
+   const double bw = 2.0 * layers * bytes / sysmem_blend_us;
+
+   /* Skipped draw-bins, split into stream dwords, draw state dwords and the rest. */
+   auto draw_bin_cost = [&](probe_pass few_s1, probe_pass many_s1, probe_pass few_s2, probe_pass many_s2) {
+      double few_dbins_us = us(few_s2) - us(few_s1);
+      double many_dbins_us = us(many_s2) - us(many_s1);
+      return (many_dbins_us - few_dbins_us) / (dbins * (DRAWS_MANY - DRAWS_FEW));
+   };
+   auto per_draw = [&](uint32_t pass_stats::*field, probe_pass few, probe_pass many) {
+      return (double) (stats[many].*field - stats[few].*field) / (DRAWS_MANY - DRAWS_FEW);
+   };
+   const double t_light = draw_bin_cost(PASS_GMEM_PIXEL_LIGHT_FEW_S1, PASS_GMEM_PIXEL_LIGHT_MANY_S1,
+                                        PASS_GMEM_PIXEL_LIGHT_FEW_S2, PASS_GMEM_PIXEL_LIGHT_MANY_S2);
+   const double t_heavy = draw_bin_cost(PASS_GMEM_PIXEL_HEAVY_FEW_S1, PASS_GMEM_PIXEL_HEAVY_MANY_S1,
+                                        PASS_GMEM_PIXEL_HEAVY_FEW_S2, PASS_GMEM_PIXEL_HEAVY_MANY_S2);
+   const double t_pad = draw_bin_cost(PASS_GMEM_PIXEL_PAD_FEW_S1, PASS_GMEM_PIXEL_PAD_MANY_S1,
+                                      PASS_GMEM_PIXEL_PAD_FEW_S2, PASS_GMEM_PIXEL_PAD_MANY_S2);
+   const double ib1_light = per_draw(&pass_stats::stream, PASS_GMEM_PIXEL_LIGHT_FEW_S1, PASS_GMEM_PIXEL_LIGHT_MANY_S1);
+   const double ib1_heavy = per_draw(&pass_stats::stream, PASS_GMEM_PIXEL_HEAVY_FEW_S1, PASS_GMEM_PIXEL_HEAVY_MANY_S1);
+   const double ib1_pad = per_draw(&pass_stats::stream, PASS_GMEM_PIXEL_PAD_FEW_S1, PASS_GMEM_PIXEL_PAD_MANY_S1);
+   const double st_light = per_draw(&pass_stats::state, PASS_GMEM_PIXEL_LIGHT_FEW_S1, PASS_GMEM_PIXEL_LIGHT_MANY_S1);
+   const double st_heavy = per_draw(&pass_stats::state, PASS_GMEM_PIXEL_HEAVY_FEW_S1, PASS_GMEM_PIXEL_HEAVY_MANY_S1);
+   if (ib1_pad <= ib1_light)
+      return fail(p, "padded draws are not larger than light draws");
+   if (st_heavy <= st_light)
+      return fail(p, "heavy draws carry no more draw state than light draws");
+   const double t_dword = (t_pad - t_light) / (ib1_pad - ib1_light);
+   const double t_state_skip = MAX2((t_heavy - t_light - (ib1_heavy - ib1_light) * t_dword) / (st_heavy - st_light), 0.0);
+   const double t_draw = MAX2(t_light - ib1_light * t_dword - st_light * t_state_skip, 0.0);
+
+   /* Rendered draw-bins. */
+   const double v_light = draw_bin_cost(PASS_GMEM_OMNI_LIGHT_FEW_S1, PASS_GMEM_OMNI_LIGHT_MANY_S1,
+                                        PASS_GMEM_OMNI_LIGHT_FEW_S2, PASS_GMEM_OMNI_LIGHT_MANY_S2);
+   const double v_heavy = draw_bin_cost(PASS_GMEM_OMNI_HEAVY_FEW_S1, PASS_GMEM_OMNI_HEAVY_MANY_S1,
+                                        PASS_GMEM_OMNI_HEAVY_FEW_S2, PASS_GMEM_OMNI_HEAVY_MANY_S2);
+   const double ib1_olight = per_draw(&pass_stats::stream, PASS_GMEM_OMNI_LIGHT_FEW_S1, PASS_GMEM_OMNI_LIGHT_MANY_S1);
+   const double ib1_oheavy = per_draw(&pass_stats::stream, PASS_GMEM_OMNI_HEAVY_FEW_S1, PASS_GMEM_OMNI_HEAVY_MANY_S1);
+   const double st_olight = per_draw(&pass_stats::state, PASS_GMEM_OMNI_LIGHT_FEW_S1, PASS_GMEM_OMNI_LIGHT_MANY_S1);
+   const double st_oheavy = per_draw(&pass_stats::state, PASS_GMEM_OMNI_HEAVY_FEW_S1, PASS_GMEM_OMNI_HEAVY_MANY_S1);
+   if (st_oheavy <= st_olight)
+      return fail(p, "heavy omni draws carry no more draw state than light ones");
+   const double t_state = MAX2((v_heavy - v_light - (ib1_oheavy - ib1_olight) * t_dword) / (st_oheavy - st_olight), 0.0);
+   const double t_vis = MAX2(v_light - ib1_olight * t_dword - st_olight * t_state, 0.0);
+
+   /* What's left of a one-pixel draw after its skipped and rendered bins is the binning pass. */
+   const double light_draw_us = (us(PASS_GMEM_PIXEL_LIGHT_MANY_S1) - us(PASS_GMEM_PIXEL_LIGHT_FEW_S1)) /
+                                (DRAWS_MANY - DRAWS_FEW);
+   const double t_draw_binning =
+      MAX2(light_draw_us - (bins1 - 1) * t_light - (ib1_light * t_dword + st_light * t_state + t_vis), 0.0);
+
+   const double few_light_dbins_us = us(PASS_GMEM_PIXEL_LIGHT_FEW_S2) - us(PASS_GMEM_PIXEL_LIGHT_FEW_S1);
+   const double t_bin = few_light_dbins_us / dbins - DRAWS_FEW * t_light;
+
+   const double omni_bytes_per_draw =
+      ((double) stats[PASS_GMEM_OMNI_LIGHT_MANY_S1].vsc_draw - (double) stats[PASS_GMEM_OMNI_LIGHT_FEW_S1].vsc_draw) /
+      (DRAWS_MANY - DRAWS_FEW);
+   const double pixel_bytes_per_draw =
+      ((double) stats[PASS_GMEM_PIXEL_LIGHT_MANY_S1].vsc_draw - (double) stats[PASS_GMEM_PIXEL_LIGHT_FEW_S1].vsc_draw) /
+      (DRAWS_MANY - DRAWS_FEW);
+   /* VSC bytes = bytes_per_draw * draws + bytes_per_vis * rendered draw-bins */
+   const double bytes_per_vis = (omni_bytes_per_draw - pixel_bytes_per_draw) / (bins1 - 1.0);
+   const double bytes_per_draw = pixel_bytes_per_draw - bytes_per_vis;
+   const double omni_draw_bins = (double) (DRAWS_MANY - DRAWS_FEW) * bins1;
+   const double prim_bytes_per_vis =
+      ((double) stats[PASS_GMEM_OMNI_LIGHT_MANY_S1].vsc_prim - (double) stats[PASS_GMEM_OMNI_LIGHT_FEW_S1].vsc_prim) /
+      (omni_draw_bins * 2.0);
+
+   /* Every bin renders a full screen draw, so take that cost out first. */
+   const double gmem_blend_us = us(PASS_GMEM_BLEND_N) - us(PASS_GMEM_BLEND_1);
+   const double w_draw = (gmem_blend_us - layers * bins1 * v_light) / sysmem_blend_us;
+   const double gmem_overdraw_us = us(PASS_GMEM_OVERDRAW_N) - us(PASS_GMEM_OVERDRAW_1);
+   const double w_draw_write = (gmem_overdraw_us - layers * bins1 * v_light) / sysmem_overdraw_us;
+
+   /* Loads and stores overlap, so doing both costs less than the two apart. */
+   const double att_load_us = MAX2(us(PASS_GMEM_LOAD) - us(PASS_GMEM_OVERDRAW_1), 0.0);
+   const double att_store_us = MAX2(us(PASS_GMEM_STORE) - us(PASS_GMEM_OVERDRAW_1), 0.0);
+   const double att_load_store_us = MAX2(us(PASS_GMEM_LOAD_STORE) - us(PASS_GMEM_OVERDRAW_1), 0.0);
+   const double w_att_load = att_load_us / (bytes / bw);
+   const double w_att_store = att_store_us / (bytes / bw);
+   const double w_att_load_store = att_load_store_us / (2.0 * bytes / bw);
+
+   /* Depth test and write on top of a colour layer, relative to the depth bytes the model charges for. */
+   const double depth_bytes = (double) p.s1.width * p.s1.height * PROBE_DEPTH_CPP;
+   const double model_depth_us = 2.0 * depth_bytes / bw;
+   const double bins_d = stats[PASS_GMEM_DEPTH_N].bins;
+   const double sys_depth_layer = (us(PASS_SYSMEM_DEPTH_N) - us(PASS_SYSMEM_DEPTH_1)) / layers;
+   const double sys_color_layer = sysmem_overdraw_us / layers;
+   /* Binning LRZ drops hidden layers in GMEM, so the weight comes from the one layer passes. */
+   const double gmem_hidden_layer = (us(PASS_GMEM_DEPTH_N) - us(PASS_GMEM_DEPTH_1)) / layers - bins_d * v_light;
+   const double gmem_depth_layer =
+      us(PASS_GMEM_DEPTH_1) - us(PASS_GMEM_OVERDRAW_1) - (bins_d - bins1) * (t_bin + v_light);
+   const double w_depth_sys = (sys_depth_layer - sys_color_layer) / model_depth_us;
+   const double w_depth_gmem = gmem_depth_layer / model_depth_us;
+   const double sys_reject_layer = (us(PASS_SYSMEM_DEPTH_FTB_N) - us(PASS_SYSMEM_DEPTH_1)) / layers;
+   const double gmem_reject_layer = (us(PASS_GMEM_DEPTH_FTB_N) - us(PASS_GMEM_DEPTH_1)) / layers - bins_d * v_light;
+   /* Like colour, against passes that don't clear: the GMEM depth clear costs more than the load. */
+   const double depth_load_us = MAX2(us(PASS_GMEM_DEPTH_LOAD) - us(PASS_GMEM_DEPTH_NONE), 0.0);
+   const double depth_store_us = MAX2(us(PASS_GMEM_DEPTH_STORE) - us(PASS_GMEM_DEPTH_NONE), 0.0);
+   const double depth_load_store_us = MAX2(us(PASS_GMEM_DEPTH_LOAD_STORE) - us(PASS_GMEM_DEPTH_NONE), 0.0);
+   auto depth_weight = [](double w) { return (w > 0.0 && w <= 10.0) ? w : 0.0; };
+
+   /* Per ALU instruction, and per fetch on top of its instructions. */
+   const double px = (double) p.s1.width * p.s1.height;
+   const double base_layer = sysmem_overdraw_us / layers;
+   const double alu_layer = (us(PASS_SYSMEM_ALU_N) - us(PASS_SYSMEM_ALU_1)) / layers;
+   const double tex_layer = (us(PASS_SYSMEM_TEX_N) - us(PASS_SYSMEM_TEX_1)) / layers;
+   const double d_instrs_alu = (double) p.fs_instrs[PIPE_ALU] - p.fs_instrs[PIPE_STRIPES];
+   const double d_instrs_tex = (double) p.fs_instrs[PIPE_TEX] - p.fs_instrs[PIPE_STRIPES];
+   const double tex_fetches = p.fs_tex[PIPE_TEX];
+   const double t_instr = d_instrs_alu > 0.0 ? MAX2(alu_layer - base_layer, 0.0) / (px * d_instrs_alu) : 0.0;
+   const double t_tex =
+      tex_fetches > 0.0
+         ? MAX2(tex_layer - base_layer - px * MAX2(d_instrs_tex, 0.0) * t_instr, 0.0) / (px * tex_fetches)
+         : 0.0;
+
+   memset(calib, 0, sizeof(*calib));
+   calib->version = TU_AUTOTUNE_CALIB_VERSION;
+   calib->bw_bytes_per_us = bw;
+   calib->t_dword_us = MAX2(t_dword, 0.0);
+   calib->t_draw_us = t_draw;
+   calib->t_state_skip_us = t_state_skip;
+   calib->t_vis_us = t_vis;
+   calib->t_state_us = t_state;
+   calib->t_draw_binning_us = t_draw_binning;
+   calib->bytes_per_vis = (bytes_per_vis > 0.0 && bytes_per_vis <= 4096.0) ? bytes_per_vis : 0.0;
+   calib->bytes_per_draw = MAX2(bytes_per_draw, 0.0);
+   calib->t_bin_us = MAX2(t_bin, 0.0);
+   calib->w_draw = w_draw;
+   calib->w_att_load = w_att_load;
+   calib->w_att_store = w_att_store;
+   calib->w_att_load_store = w_att_load_store;
+   /* 0 makes the model price depth like colour */
+   calib->w_depth_sys = (w_depth_sys >= -0.5 && w_depth_sys <= 20.0) ? MAX2(w_depth_sys, 0.01) : 0.0;
+   calib->w_depth_gmem = (w_depth_gmem >= -0.5 && w_depth_gmem <= 20.0) ? MAX2(w_depth_gmem, 0.01) : 0.0;
+   calib->w_att_depth_load = depth_weight(depth_load_us / (depth_bytes / bw));
+   calib->w_att_depth_store = depth_weight(depth_store_us / (depth_bytes / bw));
+   calib->w_att_depth_load_store = depth_weight(depth_load_store_us / (2.0 * depth_bytes / bw));
+   calib->depth_layer_sys_us = sys_depth_layer;
+   calib->depth_layer_gmem_us = gmem_depth_layer;
+   calib->depth_hidden_gmem_us = gmem_hidden_layer;
+   calib->reject_layer_sys_us = sys_reject_layer;
+   calib->reject_layer_gmem_us = gmem_reject_layer;
+   calib->att_load_us = att_load_us;
+   calib->att_store_us = att_store_us;
+   calib->att_load_store_us = att_load_store_us;
+   calib->depth_load_us = depth_load_us;
+   calib->depth_store_us = depth_store_us;
+   calib->depth_load_store_us = depth_load_store_us;
+   calib->t_instr_us = t_instr <= 0.05 ? t_instr : 0.0;
+   calib->t_tex_us = t_tex <= 0.5 ? t_tex : 0.0;
+   calib->fs_instrs_base = p.fs_instrs[PIPE_STRIPES];
+   calib->alu_layer_us = alu_layer;
+   calib->tex_layer_us = tex_layer;
+   calib->instrs_alu = p.fs_instrs[PIPE_ALU];
+   calib->instrs_tex = p.fs_instrs[PIPE_TEX];
+   calib->tex_fetches = p.fs_tex[PIPE_TEX];
+   calib->bw_flat_bytes_per_us = bw_flat;
+   calib->bw_write_bytes_per_us = bw_write;
+   calib->w_draw_write = w_draw_write;
+   calib->t_skip_light_us = t_light;
+   calib->t_skip_heavy_us = t_heavy;
+   calib->t_skip_pad_us = t_pad;
+   calib->t_render_light_us = v_light;
+   calib->t_render_heavy_us = v_heavy;
+   calib->pixel_bytes_per_draw = pixel_bytes_per_draw;
+   calib->prim_bytes_per_vis = prim_bytes_per_vis;
+   calib->stream_light = ib1_light;
+   calib->stream_heavy = ib1_heavy;
+   calib->stream_pad = ib1_pad;
+   calib->state_light = st_light;
+   calib->state_heavy = st_heavy;
+   calib->size_s1 = p.s1.width;
+   calib->bins_s1 = bins1;
+   calib->bins_s2 = bins2;
+   calib->probe_us = total_us;
+
+   /* Anything outside these ranges is a broken probe, not a strange GPU. */
+   if (!(bw >= 1000.0 && bw <= 200000.0)) {
+      snprintf(p.error_buf, sizeof(p.error_buf), "bandwidth out of range: %.0f B/us from %.0f bytes x %.0f layers in %.1f us",
+               bw, bytes, layers, sysmem_blend_us);
+      return fail(p, p.error_buf);
+   }
+   if (!(t_light >= 0.001 && t_light <= 5.0 && t_heavy <= 10.0 && t_pad <= 10.0))
+      return fail(p, "draw skip cost out of range");
+   if (!(v_light >= 0.005 && v_light <= 50.0 && v_heavy <= 100.0))
+      return fail(p, "draw render cost out of range");
+   if (!(t_dword >= 0.0 && t_dword <= 0.1 && t_state_skip <= 0.1 && t_state <= 0.1))
+      return fail(p, "dword cost out of range");
+   if (!(t_bin >= -5.0 && t_bin <= 200.0))
+      return fail(p, "bin cost out of range");
+   if (!(w_draw >= 0.1 && w_draw <= 4.0 && w_draw_write >= 0.1 && w_draw_write <= 4.0))
+      return fail(p, "GMEM draw weight out of range");
+   if (!(w_att_load >= 0.1 && w_att_load <= 4.0 && w_att_store >= 0.1 && w_att_store <= 4.0 &&
+         w_att_load_store >= 0.1 && w_att_load_store <= 4.0))
+      return fail(p, "GMEM attachment weight out of range");
+
+   calib->valid = 1;
+   return true;
+}
+
+void
+destroy_probe(probe &p)
+{
+   if (p.fence)
+      p.disp->DestroyFence(p.dev, p.fence, NULL);
+   if (p.queries)
+      p.disp->DestroyQueryPool(p.dev, p.queries, NULL);
+   if (p.cb)
+      p.disp->FreeCommandBuffers(p.dev, p.pool, 1, &p.cb);
+   if (p.pool)
+      p.disp->DestroyCommandPool(p.dev, p.pool, NULL);
+   destroy_image(p, p.s1);
+   destroy_image(p, p.s2);
+   destroy_image(p, p.depth);
+   if (p.desc_pool)
+      p.disp->DestroyDescriptorPool(p.dev, p.desc_pool, NULL);
+   if (p.set_layout)
+      p.disp->DestroyDescriptorSetLayout(p.dev, p.set_layout, NULL);
+   if (p.sampler)
+      p.disp->DestroySampler(p.dev, p.sampler, NULL);
+   destroy_image(p, p.tex);
+   if (p.vsc_bo)
+      tu_bo_finish(p.device, p.vsc_bo);
+   for (uint32_t i = 0; i < PIPE_COUNT; i++) {
+      if (p.pipelines[i])
+         p.disp->DestroyPipeline(p.dev, p.pipelines[i], NULL);
+      if (p.layouts[i])
+         p.disp->DestroyPipelineLayout(p.dev, p.layouts[i], NULL);
+   }
+}
+
+/* On failure calib only keeps the version and calib->error. */
+bool
+run_probe(struct tu_device *device, struct tu_autotune_calib *calib, bool dump)
+{
+   probe p;
+   p.device = device;
+   p.disp = &device->vk.dispatch_table;
+   p.dev = tu_device_to_handle(device);
+   p.dump = dump;
+
+   for (unsigned qfi = 0; qfi < device->physical_device->num_queue_families && !p.queue; qfi++) {
+      const struct tu_queue_family *family = &device->physical_device->queue_families[qfi];
+      if (device->queue_count[qfi] > 0 && (family->properties->queueFlags & VK_QUEUE_GRAPHICS_BIT)) {
+         p.queue = tu_queue_to_handle(&device->queues[qfi][0]);
+         p.queue_family = qfi;
+      }
+   }
+   if (!p.queue) {
+      memset(calib, 0, sizeof(*calib));
+      calib->version = TU_AUTOTUNE_CALIB_VERSION;
+      snprintf(calib->error, sizeof(calib->error), "no graphics queue");
+      return false;
+   }
+
+   pass_stats stats[PASS_COUNT] = {};
+   bool ok = false;
+   do {
+      const VkCommandPoolCreateInfo pool_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+         .queueFamilyIndex = p.queue_family,
+      };
+      if (p.disp->CreateCommandPool(p.dev, &pool_info, NULL, &p.pool) != VK_SUCCESS) {
+         fail(p, "command pool");
+         break;
+      }
+      const VkCommandBufferAllocateInfo cb_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = p.pool,
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      };
+      if (p.disp->AllocateCommandBuffers(p.dev, &cb_info, &p.cb) != VK_SUCCESS) {
+         fail(p, "command buffer");
+         break;
+      }
+      const VkFenceCreateInfo fence_info = { .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+      if (p.disp->CreateFence(p.dev, &fence_info, NULL, &p.fence) != VK_SUCCESS) {
+         fail(p, "fence");
+         break;
+      }
+
+      bool pipelines_ok = create_texture_resources(p);
+      for (uint32_t i = 0; i < PIPE_COUNT && pipelines_ok; i++)
+         pipelines_ok = create_pipeline(p, (probe_pipeline) i);
+      if (!pipelines_ok || !choose_sizes(p) || !create_image(p, p.depth, p.s1.width, p.s1.height, IMG_DEPTH) ||
+          !create_query_pool(p))
+         break;
+      if (!create_vsc_buffer(p) || !run_warmup(p) || !run_probe_passes(p))
+         break;
+
+      ok = analyse_probe(p, calib, stats);
+   } while (0);
+
+   if (dump || TU_DEBUG(STARTUP)) {
+      for (uint32_t i = 0; i < PASS_COUNT; i++)
+         mesa_logi("autotune calib pass %-26s min %9.1f us  median %9.1f  max %9.1f  bins %3u  stream %6u  "
+                   "state %6u  vsc %6" PRIu64 "/%6" PRIu64,
+                   pass_descs[i].name, stats[i].min, stats[i].median, stats[i].max, stats[i].bins, stats[i].stream,
+                   stats[i].state, stats[i].vsc_draw, stats[i].vsc_prim);
+   }
+
+   destroy_probe(p);
+   if (!ok) {
+      /* p.error can point into p */
+      memset(calib, 0, sizeof(*calib));
+      calib->version = TU_AUTOTUNE_CALIB_VERSION;
+      snprintf(calib->error, sizeof(calib->error), "%s", p.error ? p.error : "unknown");
+   }
+   return ok;
+}
+
+/* TU_DEBUG flags that don't affect the probe. Anything else skips it unless forced and isn't cached. */
+constexpr uint64_t NEUTRAL_DEBUG_FLAGS =
+   TU_DEBUG_STARTUP | TU_DEBUG_NIR | TU_DEBUG_SYSMEM | TU_DEBUG_GMEM | TU_DEBUG_LAYOUT | TU_DEBUG_PERF |
+   TU_DEBUG_LOG_SKIP_GMEM_OPS | TU_DEBUG_BOS | TU_DEBUG_HIPRIO | TU_DEBUG_DUMPAS | TU_DEBUG_CHECK_CMD_BUFFER_STATUS |
+   TU_DEBUG_COMM | TU_DEBUG_COMPUTE_ROUND_ROBIN | TU_DEBUG_NOCONFORM;
+
+/* Matches whole items only, so a path can't turn on an option by containing its name. */
+bool
+env_has(const char *env, const char *opt)
+{
+   const size_t len = strlen(opt);
+   for (const char *item = env; item;) {
+      const char *end = strchr(item, ',');
+      const size_t n = end ? (size_t) (end - item) : strlen(item);
+      if (n == len && !strncmp(item, opt, len))
+         return true;
+      item = end ? end + 1 : NULL;
+   }
+   return false;
+}
+
+uint32_t
+probe_conditions(const struct tu_device *device)
+{
+   uint32_t conditions = 0;
+   if (device->autotune->calib_payload)
+      conditions |= TU_AUTOTUNE_CALIB_COND_PAYLOAD;
+   if (depth_greater())
+      conditions |= TU_AUTOTUNE_CALIB_COND_DEPTH_GREATER;
+   return conditions;
+}
+
+/* The disk cache already keys on the driver build and GPU. */
+void
+compute_cache_key(struct disk_cache *cache, uint32_t conditions, cache_key key)
+{
+   char id[64];
+   snprintf(id, sizeof(id), "tu_autotune_calib_v%u_c%x", TU_AUTOTUNE_CALIB_VERSION, conditions);
+   disk_cache_compute_key(cache, id, strlen(id), key);
+}
+
+enum cache_result {
+   CACHE_MISS,
+   CACHE_HIT,
+   CACHE_HIT_FAILED, /* cached failure */
+};
+
+cache_result
+cache_load(struct tu_device *device, uint32_t conditions, struct tu_autotune_calib *calib)
+{
+   struct disk_cache *cache = device->physical_device->vk.disk_cache;
+   if (!cache)
+      return CACHE_MISS;
+
+   cache_key key;
+   compute_cache_key(cache, conditions, key);
+
+   size_t size = 0;
+   void *data = disk_cache_get(cache, key, &size);
+   if (!data)
+      return CACHE_MISS;
+
+   cache_result result = CACHE_MISS;
+   if (size == sizeof(*calib)) {
+      const struct tu_autotune_calib *stored = (const struct tu_autotune_calib *) data;
+      if (stored->version == TU_AUTOTUNE_CALIB_VERSION && stored->conditions == conditions) {
+         memcpy(calib, stored, sizeof(*calib));
+         calib->error[sizeof(calib->error) - 1] = '\0';
+         result = calib->valid ? CACHE_HIT : CACHE_HIT_FAILED;
+      }
+   }
+   free(data);
+   return result;
+}
+
+void
+cache_store(struct tu_device *device, const struct tu_autotune_calib *calib)
+{
+   struct disk_cache *cache = device->physical_device->vk.disk_cache;
+   if (!cache)
+      return;
+
+   cache_key key;
+   compute_cache_key(cache, calib->conditions, key);
+   /* disk_cache_put() never replaces an existing entry, so a forced re-probe would be dropped. */
+   disk_cache_remove(cache, key);
+   disk_cache_put(cache, key, calib, sizeof(*calib), NULL);
+   /* disk_cache_put() only queues the write, and the app may get killed before it lands. */
+   disk_cache_wait_for_idle(cache);
+}
+
+} /* namespace */
+
+/* Returns "cache", "probe" or why the static model is used. */
+static const char *
+calibrate(struct tu_device *device)
+{
+   struct tu_autotune_calib *calib = &device->autotune->calib;
+   memset(calib, 0, sizeof(*calib));
+
+   bool force = false, dump = false;
+   const char *env = os_get_option("TU_AUTOTUNE_CALIB");
+   if (env) {
+      tu_autotune_log_bandwidth = env_has(env, "log");
+      device->autotune->calib_payload = env_has(env, "payload");
+      device->autotune->calib_exact_replay = env_has(env, "replay");
+      if (env_has(env, "off")) {
+         if (TU_DEBUG(STARTUP))
+            mesa_logi("autotune calib: disabled by TU_AUTOTUNE_CALIB");
+         return "disabled by TU_AUTOTUNE_CALIB=off";
+      }
+      force = env_has(env, "force");
+      dump = env_has(env, "dump");
+   }
+   const bool verbose = dump || TU_DEBUG(STARTUP);
+
+   const char *margin_env = os_get_option("TU_AUTOTUNE_CALIB_MARGIN_PCT");
+   if (margin_env)
+      device->autotune->calib_margin = CLAMP(atoi(margin_env), 0, 90) / 100.0f;
+
+   /* only tested up to a8xx */
+   if (device->physical_device->info->chip > 8 && !force)
+      return "static model: untested GPU generation";
+
+   if (TU_DEBUG(NOBIN) || TU_DEBUG(FORCEBIN)) {
+      if (TU_DEBUG(STARTUP))
+         mesa_logi("autotune calib: skipped, binning is overridden by TU_DEBUG");
+      return "static model: TU_DEBUG overrides binning";
+   }
+
+   const uint32_t conditions = probe_conditions(device);
+   const char *source = "cache";
+   const cache_result cached = force ? CACHE_MISS : cache_load(device, conditions, calib);
+   if (cached == CACHE_HIT_FAILED) {
+      if (verbose)
+         mesa_logw("autotune calib: the probe failed for this driver build (%s), using the static model; "
+                   "TU_AUTOTUNE_CALIB=force retries it",
+                   calib->error);
+      return "static model: the probe failed earlier";
+   }
+
+   if (cached == CACHE_MISS) {
+      const uint64_t debug = tu_env.debug.load(std::memory_order_acquire) & ~NEUTRAL_DEBUG_FLAGS;
+      if (debug && !force) {
+         if (verbose)
+            mesa_logi("autotune calib: not probing under TU_DEBUG=%s, using the static model",
+                      tu_env_debug_as_string());
+         return "static model: not probing under TU_DEBUG";
+      }
+      if (!device->physical_device->vk.disk_cache && !force) {
+         if (verbose)
+            mesa_logi("autotune calib: no disk cache to keep the result in, not probing, using the static model "
+                      "(TU_AUTOTUNE_CALIB=force probes anyway)");
+         return "static model: no disk cache";
+      }
+
+      int64_t start = os_time_get_nano();
+      bool ok = run_probe(device, calib, dump);
+      int64_t wall_us = (os_time_get_nano() - start) / 1000;
+      calib->conditions = conditions;
+
+      /* Failures are cached too so the probe doesn't rerun every launch, but a forced run never caches one. */
+      if (!debug && (ok || !force))
+         cache_store(device, calib);
+
+      if (!ok) {
+         if (verbose)
+            mesa_logw("autotune calib: probe failed (%s), using the static model", calib->error);
+         return "static model: probe failed";
+      }
+      source = "probe";
+      if (verbose)
+         mesa_logi("autotune calib: probe took %" PRId64 " us wall, %u us GPU", wall_us, calib->probe_us);
+   }
+
+   if (verbose) {
+      mesa_logi("autotune calib (%s): bw=%.0f B/us (write-only %.0f, flat %.0f) | skip: t_dword=%.4f t_state=%.4f "
+                "t_draw=%.3f us | render: t_vis=%.3f t_state=%.4f us | binning t_draw=%.3f us | t_bin=%.2f us "
+                "w_draw=%.2f (write-only %.2f) w_att load %.2f store %.2f both %.2f | vsc %.2f B/draw-bin + %.2f B/draw (pixel %.2f B/draw, prim %.2f "
+                "B/prim-bin) | skip light %.3f heavy %.3f pad %.3f us, render light %.3f heavy %.3f us, stream "
+                "%u/%u/%u dw, state %u/%u dw, bins %u/%u at %ux%u, margin %.0f%% | depth: w_sys=%.2f w_gmem=%.2f "
+                "w_att load %.2f store %.2f both %.2f (layer sys %.0f gmem %.0f us, hidden gmem %.0f us, reject sys "
+                "%.0f gmem %.0f us) | shade: t_instr=%.3f ns t_tex=%.2f ns (alu layer %.0f us/%u instrs, tex layer "
+                "%.0f us/%u instrs/%u fetches, base %.0f instrs)",
+                source, calib->bw_bytes_per_us, calib->bw_write_bytes_per_us, calib->bw_flat_bytes_per_us,
+                calib->t_dword_us, calib->t_state_skip_us, calib->t_draw_us, calib->t_vis_us, calib->t_state_us,
+                calib->t_draw_binning_us, calib->t_bin_us, calib->w_draw, calib->w_draw_write, calib->w_att_load,
+                calib->w_att_store, calib->w_att_load_store,
+                calib->bytes_per_vis, calib->bytes_per_draw, calib->pixel_bytes_per_draw, calib->prim_bytes_per_vis,
+                calib->t_skip_light_us, calib->t_skip_heavy_us, calib->t_skip_pad_us, calib->t_render_light_us,
+                calib->t_render_heavy_us, calib->stream_light, calib->stream_heavy, calib->stream_pad,
+                calib->state_light, calib->state_heavy, calib->bins_s1, calib->bins_s2, calib->size_s1,
+                calib->size_s1, device->autotune->calib_margin * 100.0f, calib->w_depth_sys, calib->w_depth_gmem,
+                calib->w_att_depth_load, calib->w_att_depth_store, calib->w_att_depth_load_store,
+                calib->depth_layer_sys_us, calib->depth_layer_gmem_us, calib->depth_hidden_gmem_us,
+                calib->reject_layer_sys_us, calib->reject_layer_gmem_us, calib->t_instr_us * 1000.0f,
+                calib->t_tex_us * 1000.0f,
+                calib->alu_layer_us, calib->instrs_alu, calib->tex_layer_us, calib->instrs_tex, calib->tex_fetches,
+                calib->fs_instrs_base);
+   }
+   return source;
+}
+
+/* Value of a "name=value" item, or an empty string. */
+static std::string
+env_value(const char *env, const char *name)
+{
+   const size_t len = strlen(name);
+   for (const char *item = env; item;) {
+      const char *end = strchr(item, ',');
+      const size_t n = end ? (size_t) (end - item) : strlen(item);
+      if (n > len && !strncmp(item, name, len) && item[len] == '=')
+         return std::string(item + len + 1, n - len - 1);
+      item = end ? end + 1 : NULL;
+   }
+   return std::string();
+}
+
+static const struct {
+   uint32_t bit;
+   const char *name;
+} condition_names[] = {
+   { TU_AUTOTUNE_CALIB_COND_PAYLOAD, "payload" },
+   { TU_AUTOTUNE_CALIB_COND_DEPTH_GREATER, "depth_greater" },
+};
+
+/* Reads a sysfs or device tree value. For a device tree string list this is the last string. */
+static std::string
+read_text(const char *path)
+{
+   size_t size = 0;
+   char *data = os_read_file(path, &size);
+   if (!data)
+      return std::string();
+   while (size && (!data[size - 1] || isspace((unsigned char) data[size - 1])))
+      size--;
+   size_t start = size;
+   while (start && data[start - 1])
+      start--;
+   const std::string text(data + start, size - start);
+   free(data);
+   return text;
+}
+
+/* Qualcomm's bootloader puts the DDR type in the memory node, numbered like DDR_TYPE in its DDRDetails.h. */
+static std::string
+ddr_type()
+{
+   static const char *const names[] = {
+      "none", "LPDDR1", "LPDDR2", "PCDDR2", "PCDDR3", "LPDDR3", "LPDDR4", "LPDDR4X", "LPDDR5", "LPDDR5X",
+   };
+   const char *base = "/sys/firmware/devicetree/base";
+   DIR *dir = opendir(base);
+   if (!dir)
+      return std::string();
+
+   std::string type;
+   while (const struct dirent *e = readdir(dir)) {
+      if (strncmp(e->d_name, "memory", 6))
+         continue;
+      const std::string path = std::string(base) + "/" + e->d_name + "/ddr_device_type";
+      size_t size = 0;
+      uint8_t *v = (uint8_t *) os_read_file(path.c_str(), &size);
+      if (v && size == 4) {
+         const uint32_t id = (uint32_t) v[0] << 24 | v[1] << 16 | v[2] << 8 | v[3];
+         type = id < ARRAY_SIZE(names) ? names[id] : "type " + std::to_string(id);
+      }
+      free(v);
+      if (!type.empty())
+         break;
+   }
+   closedir(dir);
+   return type;
+}
+
+/* TU_AUTOTUNE_CALIB=export=<path>, written to <path>.tmp first so readers never see a partial file. */
+static void
+export_calib(struct tu_device *device, const char *path, const char *status)
+{
+   const struct tu_autotune_calib *calib = &device->autotune->calib;
+   const struct tu_physical_device *pdev = device->physical_device;
+
+   const std::string tmp = std::string(path) + ".tmp";
+   FILE *f = fopen(tmp.c_str(), "w");
+   if (!f) {
+      mesa_logw("autotune calib: cannot write %s: %s", tmp.c_str(), strerror(errno));
+      return;
+   }
+
+   char uuid[VK_UUID_SIZE * 2 + 1];
+   mesa_bytes_to_hex(uuid, pdev->cache_uuid, VK_UUID_SIZE);
+   std::string conditions;
+   for (const auto &c : condition_names) {
+      if (calib->conditions & c.bit)
+         conditions += (conditions.empty() ? "" : ",") + std::string(c.name);
+   }
+
+   const std::string model = read_text("/sys/firmware/devicetree/base/model");
+   const std::string soc = read_text("/sys/firmware/devicetree/base/compatible");
+   const std::string soc_id = read_text("/sys/devices/soc0/soc_id");
+   const std::string ddr = ddr_type();
+   uint64_t ram = 0;
+   os_get_total_physical_memory(&ram);
+   const auto known = [](const std::string &s) { return s.empty() ? "unknown" : s.c_str(); };
+
+   fprintf(f, "# Turnip autotune calibration, written by TU_AUTOTUNE_CALIB=export\n");
+   fprintf(f, "mesa = %s\n", PACKAGE_VERSION MESA_GIT_SHA1);
+   fprintf(f, "gpu = %s\n", pdev->name);
+   fprintf(f, "chip_id = 0x%" PRIx64 "\n", (uint64_t) pdev->dev_id.chip_id);
+   fprintf(f, "device = %s\n", known(model));
+   fprintf(f, "soc = %s\n", known(soc));
+   fprintf(f, "soc_id = %s\n", known(soc_id));
+   fprintf(f, "ddr = %s\n", known(ddr));
+   fprintf(f, "ram_mb = %" PRIu64 "\n", ram >> 20);
+   fprintf(f, "cache_uuid = %s\n", uuid);
+   fprintf(f, "status = %s\n", status);
+   fprintf(f, "version = %u\n", calib->version);
+   fprintf(f, "valid = %u\n", calib->valid);
+   fprintf(f, "conditions = %s\n", conditions.empty() ? "none" : conditions.c_str());
+   fprintf(f, "error = %s\n", calib->error);
+   fprintf(f, "margin_pct = %.0f\n", device->autotune->calib_margin * 100.0f);
+
+#define FLT(name) fprintf(f, "%s = %.9g\n", #name, (double) calib->name)
+#define U32(name) fprintf(f, "%s = %u\n", #name, calib->name)
+   fprintf(f, "\n# Coefficients the model uses\n");
+   FLT(bw_bytes_per_us);
+   FLT(t_dword_us);
+   FLT(t_draw_us);
+   FLT(t_state_skip_us);
+   FLT(t_vis_us);
+   FLT(t_state_us);
+   FLT(t_draw_binning_us);
+   FLT(bytes_per_vis);
+   FLT(bytes_per_draw);
+   FLT(t_bin_us);
+   FLT(w_draw);
+   FLT(w_att_load);
+   FLT(w_att_store);
+   FLT(w_att_load_store);
+   FLT(w_depth_sys);
+   FLT(w_depth_gmem);
+   FLT(w_att_depth_load);
+   FLT(w_att_depth_store);
+   FLT(w_att_depth_load_store);
+   FLT(t_instr_us);
+   FLT(t_tex_us);
+   FLT(fs_instrs_base);
+
+   fprintf(f, "\n# Probe measurements and geometry, informational\n");
+   FLT(bw_flat_bytes_per_us);
+   FLT(bw_write_bytes_per_us);
+   FLT(w_draw_write);
+   FLT(t_skip_light_us);
+   FLT(t_skip_heavy_us);
+   FLT(t_skip_pad_us);
+   FLT(t_render_light_us);
+   FLT(t_render_heavy_us);
+   FLT(pixel_bytes_per_draw);
+   FLT(prim_bytes_per_vis);
+   U32(stream_light);
+   U32(stream_heavy);
+   U32(stream_pad);
+   U32(state_light);
+   U32(state_heavy);
+   FLT(depth_layer_sys_us);
+   FLT(depth_layer_gmem_us);
+   FLT(depth_hidden_gmem_us);
+   FLT(reject_layer_sys_us);
+   FLT(reject_layer_gmem_us);
+   FLT(att_load_us);
+   FLT(att_store_us);
+   FLT(att_load_store_us);
+   FLT(depth_load_us);
+   FLT(depth_store_us);
+   FLT(depth_load_store_us);
+   FLT(alu_layer_us);
+   FLT(tex_layer_us);
+   U32(instrs_alu);
+   U32(instrs_tex);
+   U32(tex_fetches);
+   U32(size_s1);
+   U32(bins_s1);
+   U32(bins_s2);
+   U32(probe_us);
+#undef FLT
+#undef U32
+
+   const bool ok = !ferror(f);
+   if (fclose(f) != 0 || !ok || rename(tmp.c_str(), path) != 0) {
+      mesa_logw("autotune calib: cannot write %s: %s", path, strerror(errno));
+      remove(tmp.c_str());
+      return;
+   }
+   mesa_logi("autotune calib: exported to %s (%s)", path, status);
+}
+
+void
+tu_autotune_calib_init(struct tu_device *device)
+{
+   const char *status = calibrate(device);
+
+   const char *env = os_get_option("TU_AUTOTUNE_CALIB");
+   const std::string path = env ? env_value(env, "export") : std::string();
+   if (!path.empty())
+      export_calib(device, path.c_str(), status);
+}
