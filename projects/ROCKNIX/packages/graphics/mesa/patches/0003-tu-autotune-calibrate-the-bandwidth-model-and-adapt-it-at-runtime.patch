+      MODF_STR(ADAPT);
       str += ")";
 
       str += ", Metric Flags: 0x" + std::to_string(metric_flags) + " (";
@@ -267,6 +280,38 @@ tu_autotune::atomic_config_t::compare_and_store(config_t expected, config_t upda
                                               std::memory_order_acquire, std::memory_order_relaxed);
 }
 
+/* Adaptive layers: "scale" and "hash" learn measured / predicted per process and per RP. "probe" occasionally runs
+ * the other mode for passes close to parity.
+ */
+static tu_autotune::adapt_config
+parse_adapt_env()
+{
+   tu_autotune::adapt_config cfg;
+   const char *env = os_get_option("TU_AUTOTUNE_ADAPT");
+   if (!env)
+      return cfg;
+
+   bool all = strstr(env, "all") != NULL;
+   cfg.scale = all || strstr(env, "scale") != NULL;
+   cfg.hash = all || strstr(env, "hash") != NULL;
+   cfg.probe = all || strstr(env, "probe") != NULL;
+   cfg.log = strstr(env, "log") != NULL;
+
+   const char *band = os_get_option("TU_AUTOTUNE_ADAPT_BAND");
+   int lo, hi;
+   if (band && sscanf(band, "%d,%d", &lo, &hi) == 2 && lo > 0 && hi > lo) {
+      cfg.band_lo = lo / 100.0f;
+      cfg.band_hi = hi / 100.0f;
+   }
+   const char *probe_ms = os_get_option("TU_AUTOTUNE_ADAPT_PROBE_MS");
+   if (probe_ms && atoi(probe_ms) > 0)
+      cfg.probe_interval_ns = (uint64_t) atoi(probe_ms) * 1'000'000;
+   const char *reprobe_ms = os_get_option("TU_AUTOTUNE_ADAPT_REPROBE_MS");
+   if (reprobe_ms && atoi(reprobe_ms) > 0)
+      cfg.reprobe_ns = (uint64_t) atoi(reprobe_ms) * 1'000'000;
+   return cfg;
+}
+
 tu_autotune::config_t
 tu_autotune::get_env_config()
 {
@@ -322,6 +367,9 @@ tu_autotune::get_env_config()
          }
       }
 
+      if (parse_adapt_env().enabled())
+         mod_flags |= (uint32_t) mod_flag::ADAPT;
+
       assert((uint8_t) mod_flags == mod_flags);
       at_config = config_t(algo, (uint8_t) mod_flags);
    });
@@ -335,7 +383,8 @@ tu_autotune::get_env_config()
 uint32_t
 tu_autotune::get_supported_mod_flags(tu_device *device) const
 {
-   uint32_t supported_mod_flags = (uint32_t) mod_flag::BIG_GMEM | (uint32_t) mod_flag::TUNE_SMALL;
+   uint32_t supported_mod_flags =
+      (uint32_t) mod_flag::BIG_GMEM | (uint32_t) mod_flag::TUNE_SMALL | (uint32_t) mod_flag::ADAPT;
    if (device->physical_device->info->props.max_draw_states > TU_DRAW_STATE_AT_WRITE_RP_HASH &&
        device->physical_device->is_perf_cntr_selectable) {
       supported_mod_flags |= (uint32_t) mod_flag::PREEMPT_OPTIMIZE;
@@ -432,6 +481,9 @@ struct PACKED tu_autotune::rp_gpu_data {
     * BV and BR overlap, but that is acceptable for the autotuner's purposes. */
    uint64_t ts_binning_start;
    uint64_t ts_binning_end;
+   /* VSC stream sizes per pipe in bytes, only written for GMEM with HW binning. */
+   uint32_t vsc_draw_size[MAX_VSC_PIPES];
+   uint32_t vsc_prim_size[MAX_VSC_PIPES];
 };
 
 /* Per-tile values for GMEM rendering, this structure is appended to the end of rp_gpu_data for each tile. */
@@ -528,6 +580,14 @@ struct tu_autotune::rp_entry {
    uint32_t tile_count;
    uint32_t draw_count;
 
+   /* Prediction per mode (0 sysmem, 1 gmem), in us when calibrated, model bytes otherwise. */
+   float pred_us[2] = { 0.0f, 0.0f };
+   bool probe = false;
+
+   /* The binning pass ran, so the first pipe_count VSC sizes are valid. */
+   bool binning = false;
+   uint32_t pipe_count = 0;
+
    rp_entry(struct tu_device *device, rp_history_handle &&history, config_t config, uint32_t draw_count)
        : device(device), map(nullptr), history(std::move(history)), config(config), draw_count(draw_count)
    {
@@ -578,6 +638,28 @@ struct tu_autotune::rp_entry {
       return *(tile_gpu_data *) (map + offset);
    }
 
+   /** VSC Visibility Metric **/
+
+   uint64_t get_vsc_draw_bytes()
+   {
+      assert(config.test(metric_flag::VSC) && binning);
+      rp_gpu_data &gpu = get_gpu_data();
+      uint64_t sum = 0;
+      for (uint32_t i = 0; i < pipe_count; i++)
+         sum += gpu.vsc_draw_size[i];
+      return sum;
+   }
+
+   uint64_t get_vsc_prim_bytes()
+   {
+      assert(config.test(metric_flag::VSC) && binning);
+      rp_gpu_data &gpu = get_gpu_data();
+      uint64_t sum = 0;
+      for (uint32_t i = 0; i < pipe_count; i++)
+         sum += gpu.vsc_prim_size[i];
+      return sum;
+   }
+
    /** Samples-Passed Metric **/
 
    uint64_t get_samples_passed()
@@ -685,6 +767,8 @@ struct tu_autotune::rp_entry {
       assert(map && bo.iova);
       if (config.test(metric_flag::TS))
          emit_metric_timestamp(cs, bo.iova + offsetof(rp_gpu_data, ts_binning_end));
+      if (config.test(metric_flag::VSC) && pipe_count)
+         tu_emit_vsc_sizes(cs, bo.iova + offsetof(rp_gpu_data, vsc_draw_size), pipe_count);
    }
 
    void emit_rp_start(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
@@ -1010,22 +1094,110 @@ struct tu_autotune::rp_history {
    {
    }
 
+   /** Adaptive layers, per RP and mode (0 sysmem, 1 gmem) **/
+   struct adapt_history {
+      std::atomic<float> measured_us[2]; /* EMA of the measured time */
+      std::atomic<float> ratio[2];       /* EMA of measured / predicted, for the mode that hasn't run */
+      std::atomic<uint32_t> count[2];
+      std::atomic<uint64_t> last_ns[2]; /* last measurement */
+      std::atomic<uint32_t> decisions;
+      adapt_history()
+      {
+         for (int m = 0; m < 2; m++) {
+            measured_us[m] = 0.0f;
+            ratio[m] = 1.0f;
+            count[m] = 0;
+            last_ns[m] = 0;
+         }
+         decisions = 0;
+      }
+   } adapt;
+
+   void adapt_update(rp_entry &entry, tu_autotune &at)
+   {
+      constexpr double SCALE_ALPHA = 0.05; /* process-wide, slow */
+      constexpr double HASH_ALPHA = 0.3;   /* per pass, fast */
+      constexpr double MIN_MEASURED_US = 50.0;
+
+      const int m = entry.sysmem ? 0 : 1;
+      const double pred = entry.pred_us[m];
+      if (pred <= 0.0)
+         return;
+      const double measured = (double) ticks_to_us(entry.get_rp_duration());
+      if (measured < MIN_MEASURED_US)
+         return;
+
+      double raw = measured / pred;
+      if (at.calib.valid)
+         raw = CLAMP(raw, 0.1, 20.0); /* anything outside this isn't a model error */
+      double scale = 1.0;
+      if (at.adapt_cfg.scale) {
+         uint32_t n = at.adapt.count[m].load(std::memory_order_relaxed);
+         double s = at.adapt.scale[m].load(std::memory_order_relaxed);
+         s = n == 0 ? raw : s + SCALE_ALPHA * (raw - s);
+         at.adapt.scale[m].store(s, std::memory_order_relaxed);
+         at.adapt.count[m].store(n + 1, std::memory_order_relaxed);
+         scale = s;
+      }
+
+      /* Against the raw prediction like the scale, so the two don't stack. */
+      float ratio = adapt.ratio[m].load(std::memory_order_relaxed);
+      if (at.adapt_cfg.hash) {
+         double rr = raw;
+         uint32_t n = adapt.count[m].load(std::memory_order_relaxed);
+         ratio = n == 0 ? (float) rr : ratio + (float) (HASH_ALPHA * (rr - ratio));
+         float mu = adapt.measured_us[m].load(std::memory_order_relaxed);
+         mu = n == 0 ? (float) measured : mu + (float) (HASH_ALPHA * (measured - mu));
+         adapt.measured_us[m].store(mu, std::memory_order_relaxed);
+         adapt.ratio[m].store(ratio, std::memory_order_relaxed);
+         adapt.count[m].store(n + 1, std::memory_order_relaxed);
+         adapt.last_ns[m].store(os_time_get_nano(), std::memory_order_relaxed);
+      }
+
+      if (at.adapt_cfg.log) {
+         mesa_logi("autotune-adapt %016" PRIx64 ": measured %s%s %.1f us, predicted %.1f, raw %.4f, scale %.4f, "
+                   "ratio %.3f (n=%u)",
+                   hash, render_mode_str(entry.sysmem ? render_mode::SYSMEM : render_mode::GMEM),
+                   entry.probe ? " probe" : "", measured, pred, raw, scale, ratio,
+                   adapt.count[m].load(std::memory_order_relaxed));
+      }
+   }
+
    /** Bandwidth Estimation Algorithm **/
    struct bandwidth_algo {
     private:
       exponential_average<uint32_t> mean_samples_passed;
+      /* Per mode, GMEM's is lower since the binning pass LRZ drops hidden fragments. */
+      exponential_average<uint32_t> mean_samples_passed_mode[2];
+      exponential_average<uint32_t> mean_vsc_draw_bytes;
+      exponential_average<uint32_t> mean_vsc_prim_bytes;
 
     public:
-      void update(uint32_t samples)
+      void update(uint32_t samples, bool sysmem)
       {
          mean_samples_passed.add(samples);
+         mean_samples_passed_mode[sysmem ? 0 : 1].add(samples);
+      }
+
+      void update_vsc(uint32_t draw_bytes, uint32_t prim_bytes)
+      {
+         mean_vsc_draw_bytes.add(draw_bytes);
+         mean_vsc_prim_bytes.add(prim_bytes);
       }
 
       render_mode get_optimal_mode(rp_history &history,
                                    const struct tu_cmd_state *cmd_state,
                                    const struct tu_render_pass *pass,
                                    const struct tu_framebuffer *framebuffer,
-                                   const struct tu_render_pass_state *rp_state)
+                                   const struct tu_render_pass_state *rp_state,
+                                   uint32_t stream_dwords,
+                                   uint32_t state_dwords,
+                                   uint32_t payload_dwords,
+                                   bool count_payload,
+                                   bool exact_replay,
+                                   const struct tu_autotune_calib *calib,
+                                   float margin,
+                                   double pred[2])
       {
          uint32_t pass_pixel_count = 0;
          if (cmd_state->per_layer_render_area) {
@@ -1041,9 +1213,20 @@ struct tu_autotune::rp_history {
 
          uint64_t sysmem_bandwidth = (uint64_t) pass->sysmem_bandwidth_per_pixel * pass_pixel_count;
          uint64_t gmem_bandwidth = (uint64_t) pass->gmem_bandwidth_per_pixel * pass_pixel_count;
+         const uint32_t *depth_att = pass->gmem_att_bytes_per_pixel[1];
+         const uint64_t gmem_depth_bandwidth =
+            (uint64_t) (depth_att[TU_ATT_LOAD] + depth_att[TU_ATT_STORE] + depth_att[TU_ATT_LOAD_STORE]) *
+            pass_pixel_count;
 
          uint64_t total_draw_call_bandwidth = 0;
+         uint64_t depth_draw_call_bandwidth = 0;
          uint64_t mean_samples = mean_samples_passed.get();
+         /* A mode borrows the other's count until it has run. */
+         const uint64_t samples_mode_sys = mean_samples_passed_mode[0].get();
+         const uint64_t samples_mode_gmem = mean_samples_passed_mode[1].get();
+         const uint64_t samples_sys = samples_mode_sys ? samples_mode_sys : samples_mode_gmem;
+         const uint64_t samples_gmem = samples_mode_gmem ? samples_mode_gmem : samples_mode_sys;
+         double d_total[2] = { 0.0, 0.0 }, d_depth[2] = { 0.0, 0.0 };
          if (rp_state->drawcall_count && mean_samples > 0.0) {
             /* The total draw call bandwidth is estimated as the average samples (collected via tracking samples passed
              * within the CS) multiplied by the drawcall bandwidth per sample, divided by the amount of draw calls.
@@ -1053,29 +1236,119 @@ struct tu_autotune::rp_history {
              */
             total_draw_call_bandwidth =
                (mean_samples * rp_state->drawcall_bandwidth_per_sample_sum) / rp_state->drawcall_count;
+            depth_draw_call_bandwidth =
+               (mean_samples * rp_state->drawcall_depth_bandwidth_per_sample_sum) / rp_state->drawcall_count;
+            const uint64_t samples_of[2] = { samples_sys, samples_gmem };
+            for (unsigned m = 0; m < 2; m++) {
+               d_total[m] = (double) samples_of[m] * rp_state->drawcall_bandwidth_per_sample_sum /
+                            rp_state->drawcall_count;
+               d_depth[m] = (double) samples_of[m] * rp_state->drawcall_depth_bandwidth_per_sample_sum /
+                            rp_state->drawcall_count;
+            }
          }
 
-         /* Drawcalls access the memory in SYSMEM rendering (ignoring CCU). */
-         sysmem_bandwidth += total_draw_call_bandwidth;
+         uint32_t bin_count = 1;
+         bool hw_binning = false;
+         if (cmd_state->tiling) {
+            const struct tu_vsc_config &vsc = cmd_state->tiling->vsc;
+            bin_count = MAX2(vsc.tile_count.width * vsc.tile_count.height, 1u);
+            hw_binning = vsc.binning_possible && vsc.binning_useful;
+         }
+         /* Without HW binning the first tile stands in for sysmem's single pass. */
+         const uint32_t replays = (exact_replay && !hw_binning) ? bin_count - 1 : bin_count;
+
+         bool select_sysmem;
+         double sysmem_us = 0.0, gmem_us = 0.0, vis_bins = 0.0;
+         bool vis_known = false;
+         if (calib->valid) {
+            /* Same model in us. Bins touched per draw come from earlier GMEM runs' VSC streams, else all of them. */
+            const double draws = rp_state->drawcall_count;
+            const double ib1 = stream_dwords;
+            const double ib2 = state_dwords + (count_payload ? payload_dwords : 0);
+            const double ib2_per_draw = draws > 0.0 ? ib2 / draws : 0.0;
+            const double all_bins = (double) bin_count * draws;
+            if (hw_binning && calib->bytes_per_vis > 0.0f && !mean_vsc_draw_bytes.empty()) {
+               vis_bins = ((double) mean_vsc_draw_bytes.get() - draws * calib->bytes_per_draw) / calib->bytes_per_vis;
+               vis_bins = CLAMP(vis_bins, MIN2(draws, all_bins), all_bins);
+               vis_known = true;
+            } else {
+               vis_bins = all_bins;
+            }
+            const double skip_bins = MAX2(all_bins - vis_bins, 0.0);
+            const double render_draw_us = calib->t_vis_us + ib2_per_draw * calib->t_state_us;
+
+            /* Depth falls back to the colour weights when it wasn't measured. */
+            const double d_depth_sys = d_depth[0], d_color_sys = d_total[0] - d_depth[0];
+            const double d_depth_gmem = d_depth[1], d_color_gmem = d_total[1] - d_depth[1];
+            const double w_depth_sys = calib->w_depth_sys > 0.0f ? calib->w_depth_sys : 1.0;
+            const double w_depth_gmem = calib->w_depth_gmem > 0.0f ? calib->w_depth_gmem : calib->w_draw;
+            const double w_att[2][TU_ATT_IO_COUNT] = {
+               { calib->w_att_load, calib->w_att_store, calib->w_att_load_store },
+               { calib->w_att_depth_load > 0.0f ? calib->w_att_depth_load : calib->w_att_load,
+                 calib->w_att_depth_store > 0.0f ? calib->w_att_depth_store : calib->w_att_store,
+                 calib->w_att_depth_load_store > 0.0f ? calib->w_att_depth_load_store : calib->w_att_load_store },
+            };
+            double g_att = 0.0;
+            for (unsigned ds = 0; ds < 2; ds++) {
+               for (unsigned io = 0; io < TU_ATT_IO_COUNT; io++)
+                  g_att += (double) pass->gmem_att_bytes_per_pixel[ds][io] * pass_pixel_count * w_att[ds][io];
+            }
+            /* Shading beyond the probe's own shader, per sample. */
+            const double fs_instrs = draws > 0.0 ? (double) rp_state->drawcall_fs_instrs_sum / draws : 0.0;
+            const double fs_tex = draws > 0.0 ? (double) rp_state->drawcall_fs_tex_sum / draws : 0.0;
+            const double shade_per_sample =
+               MAX2(fs_instrs - calib->fs_instrs_base, 0.0) * calib->t_instr_us + fs_tex * calib->t_tex_us;
+            const double shade_sys = (double) samples_sys * shade_per_sample;
+            const double shade_gmem = (double) samples_gmem * shade_per_sample;
+
+            sysmem_us = ((double) sysmem_bandwidth + d_color_sys + d_depth_sys * w_depth_sys) /
+                           calib->bw_bytes_per_us +
+                        draws * render_draw_us + shade_sys;
+            gmem_us = (g_att + d_color_gmem * calib->w_draw + d_depth_gmem * w_depth_gmem) /
+                         calib->bw_bytes_per_us +
+                      (hw_binning ? draws * calib->t_draw_binning_us : 0.0) +
+                      (double) replays * ib1 * calib->t_dword_us +
+                      skip_bins * (calib->t_draw_us + ib2_per_draw * calib->t_state_skip_us) +
+                      vis_bins * render_draw_us + (double) bin_count * calib->t_bin_us + shade_gmem;
+            select_sysmem = gmem_us >= sysmem_us * (1.0 - margin);
+            pred[0] = sysmem_us;
+            pred[1] = gmem_us;
