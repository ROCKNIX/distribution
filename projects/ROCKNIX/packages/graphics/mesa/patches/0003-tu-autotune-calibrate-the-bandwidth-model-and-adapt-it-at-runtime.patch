+      const bool have_hash_o = adapt_cfg.hash && history.adapt.count[o].load(std::memory_order_relaxed) > 0;
+      const bool have_scale_m = adapt_cfg.scale && adapt.count[m].load(std::memory_order_relaxed) > 0;
+      const bool have_scale_o = adapt_cfg.scale && adapt.count[o].load(std::memory_order_relaxed) > 0;
+      const double scale_m = have_scale_m ? adapt.scale[m].load(std::memory_order_relaxed) : 1.0;
+      const double scale_o = have_scale_o ? adapt.scale[o].load(std::memory_order_relaxed) : 1.0;
+
+      if (have_hash_m) {
+         adj[m] = history.adapt.measured_us[m].load(std::memory_order_relaxed);
+         continue;
+      }
+      double factor = 1.0;
+      if (have_hash_o)
