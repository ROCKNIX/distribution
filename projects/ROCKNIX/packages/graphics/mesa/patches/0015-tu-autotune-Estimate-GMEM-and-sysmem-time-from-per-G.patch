--- /dev/null
+++ b/src/freedreno/vulkan/tu_autotune_calib.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright © 2026 ROCKNIX
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef TU_AUTOTUNE_CALIB_H
+#define TU_AUTOTUNE_CALIB_H
+
+#include <stdint.h>
+
+struct tu_device;
+
+/* Costs for the GMEM/sysmem estimate, in us. A draw-bin is one draw in one bin. */
+struct tu_autotune_calib {
+   uint32_t valid;
+   uint32_t chip_id; /* table entry used */
+
+   float bw_bytes_per_us;   /* sysmem throughput for blended content */
+   float t_dword_us;        /* per draw stream dword per bin */
+   float t_draw_us;         /* per skipped draw-bin */
+   float t_state_skip_us;   /* per draw state dword per skipped draw-bin */
+   float t_vis_us;          /* per rendered draw-bin */
+   float t_state_us;        /* per draw state dword per rendered draw-bin */
+   float t_draw_binning_us; /* per draw in the binning pass */
+   float bytes_per_vis;     /* VSC draw stream bytes per rendered draw-bin, 0 if unusable */
+   float bytes_per_draw;    /* VSC draw stream bytes per draw */
+   float t_bin_us;          /* per bin */
+   float w_draw;            /* GMEM fragment traffic relative to sysmem */
+   /* GMEM loads and stores relative to sysmem. They overlap, so doing both has its own weight. */
+   float w_att_load;
+   float w_att_store;
+   float w_att_load_store;
+   /* Depth weights, 0 when not known. */
+   float w_depth_sys;
+   float w_depth_gmem;
+   float w_att_depth_load;
+   float w_att_depth_store;
+   float w_att_depth_load_store;
+   /* Shading per sample above fs_instrs_base instructions, 0 when not known. */
+   float t_instr_us;
+   float t_tex_us;
+   float fs_instrs_base;
+};
+
+void tu_autotune_calib_init(struct tu_device *device);
+
+#endif /* TU_AUTOTUNE_CALIB_H */
