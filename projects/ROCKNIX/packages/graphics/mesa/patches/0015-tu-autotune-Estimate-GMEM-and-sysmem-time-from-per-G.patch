+namespace {
+
+/* Measured on retail devices, taking the cheaper end of the results. Times are in GPU cycles at mhz. */
+struct calib_table_entry {
+   uint32_t chip_id;
+   uint32_t mhz;
+   /* t_dword, t_state_skip, t_draw, t_state, t_vis, t_draw_binning, t_bin */
+   float cycles[7];
+   /* bytes_per_vis, bytes_per_draw, bw_bytes_per_us, w_draw, w_att_load, w_att_store, w_att_load_store,
+    * w_att_depth_load, w_att_depth_store, w_att_depth_load_store, w_depth_gmem, w_depth_sys
+    */
+   float full_clock[12];
+};
+
+const calib_table_entry calib_table[] = {
+   /* A610: MANGMI Air X */
+   { 0x06010000, 1050,
+     { 1.29f, 0.026f, 21.9f, 2.75f, 603.0f, 636.0f, 8390.0f },
+     { 0.498f, 0.952f, 13680.0f, 0.818f, 0.951f, 1.1f, 0.839f, 1.52f, 1.66f, 0.92f, 0.165f, 0.14f } },
+   /* A613: Retroid Pocket Classic, Anbernic RG 55G1 */
+   { 0x06010300, 1010,
+     { 1.27f, 0.0f, 18.5f, 2.86f, 514.0f, 586.0f, 8329.0f },
+     { 0.498f, 0.952f, 14410.0f, 0.886f, 0.758f, 0.827f, 0.617f, 1.43f, 1.45f, 0.74f, 0.137f, 0.01f } },
+   /* A650: Retroid Pocket Flip 2, Mini V2 */
+   { 0x06050002, 925,
+     { 0.294f, 0.03f, 14.2f, 1.86f, 529.0f, 558.0f, 2577.0f },
+     { 0.548f, 1.1f, 52407.0f, 0.576f, 0.922f, 0.856f, 1.02f, 0.95f, 0.78f, 0.547f, 0.0505f, 0.369f } },
+   /* A740: AYN Thor, Odin 2 Mini/Portal, Retroid Pocket 6, Nova, AYANEO Pocket EVO */
+   { 0x43050a01, 680,
+     { 0.24f, 0.0534f, 37.4f, 1.3f, 362.0f, 370.0f, 1771.0f },
+     { 0.506f, 1.33f, 56516.0f, 0.239f, 0.449f, 0.513f, 0.712f, 0.24f, 0.237f, 0.319f, 0.0685f, 0.208f } },
+   /* A750: KONKR Pocket FIT, Lenovo Legion Y700 (2025) */
+   { 0x43051401, 1050,
+     { 0.453f, 0.00666f, 36.3f, 1.57f, 358.0f, 346.0f, 1643.0f },
+     { 0.529f, 0.705f, 55164.0f, 0.151f, 0.523f, 1.02f, 0.891f, 0.388f, 0.778f, 0.561f, 0.0452f, 0.211f } },
+   /* A830: AYN Odin 3, KONKR Pocket FIT Elite */
+   { 0x44050000, 1100,
+     { 0.316f, 0.224f, 68.7f, 1.57f, 211.0f, 156.0f, 2005.0f },
+     { 0.526f, 1.27f, 78458.0f, 0.208f, 1.08f, 1.16f, 0.991f, 0.563f, 0.659f, 0.479f, 0.0248f, 0.268f } },
+};
+
+/* Exact match, else the closest-sized GPU of the same generation, preferring a bigger one. */
+const calib_table_entry *
+find_row(const struct tu_physical_device *pdev)
+{
+   const uint32_t chip_id = (uint32_t) pdev->dev_id.chip_id;
+   const calib_table_entry *best = NULL;
+   int best_score = INT_MAX;
+   uint32_t best_dist = UINT32_MAX;
+
+   for (const calib_table_entry &e : calib_table) {
+      if (e.chip_id == chip_id)
+         return &e;
+
+      const struct fd_dev_id id = { .gpu_id = 0, .chip_id = e.chip_id };
+      const struct fd_dev_info *info = fd_dev_info_raw(&id);
+      if (!info || info->chip != pdev->info->chip)
+         continue;
+
+      const int ccu = (int) info->num_ccu - (int) pdev->info->num_ccu;
+      const int score = ccu >= 0 ? ccu : 1000 - ccu;
+      const uint32_t dist = e.chip_id > chip_id ? e.chip_id - chip_id : chip_id - e.chip_id;
+      if (score < best_score || (score == best_score && dist < best_dist)) {
+         best = &e;
+         best_score = score;
+         best_dist = dist;
+      }
+   }
+   return best;
+}
+
+void
+calib_from_row(const struct tu_physical_device *pdev, const calib_table_entry &e, struct tu_autotune_calib *calib)
+{
+   const double mhz = pdev->max_freq ? pdev->max_freq / 1e6 : e.mhz;
+   const double clock = e.mhz / mhz; /* the GMEM-side weights follow the GPU clock */
+
+   memset(calib, 0, sizeof(*calib));
+   calib->valid = 1;
+   calib->chip_id = e.chip_id;
+   calib->t_dword_us = e.cycles[0] / mhz;
+   calib->t_state_skip_us = e.cycles[1] / mhz;
+   calib->t_draw_us = e.cycles[2] / mhz;
+   calib->t_state_us = e.cycles[3] / mhz;
+   calib->t_vis_us = e.cycles[4] / mhz;
+   calib->t_draw_binning_us = e.cycles[5] / mhz;
+   calib->t_bin_us = e.cycles[6] / mhz;
+   calib->bytes_per_vis = e.full_clock[0];
+   calib->bytes_per_draw = e.full_clock[1];
+   calib->bw_bytes_per_us = e.full_clock[2];
+   calib->w_draw = e.full_clock[3] * clock;
+   calib->w_att_load = e.full_clock[4];
+   calib->w_att_store = e.full_clock[5];
+   calib->w_att_load_store = e.full_clock[6];
+   calib->w_att_depth_load = e.full_clock[7];
+   calib->w_att_depth_store = e.full_clock[8];
+   calib->w_att_depth_load_store = e.full_clock[9];
+   calib->w_depth_gmem = e.full_clock[10] * clock;
+   calib->w_depth_sys = e.full_clock[11];
+}
+
+} /* namespace */
+
+void
+tu_autotune_calib_init(struct tu_device *device)
+{
+   const struct tu_physical_device *pdev = device->physical_device;
+   struct tu_autotune_calib *calib = &device->autotune->calib;
+   memset(calib, 0, sizeof(*calib));
+
+   const char *env = os_get_option("TU_AUTOTUNE_CALIB");
+   if (env && !strcmp(env, "off"))
+      return;
+   if (pdev->info->chip < 6 || pdev->info->chip > 8 || TU_DEBUG(NOBIN) || TU_DEBUG(FORCEBIN))
+      return;
+
+   const calib_table_entry *row = find_row(pdev);
+   if (!row)
+      return;
+
+   calib_from_row(pdev, *row, calib);
+   if (TU_DEBUG(STARTUP)) {
+      mesa_logi("autotune calib: %s row 0x%08x at %.0f MHz",
+                row->chip_id == (uint32_t) pdev->dev_id.chip_id ? "own" : "borrowed", row->chip_id,
+                pdev->max_freq ? pdev->max_freq / 1e6 : row->mhz);
+   }
+}
