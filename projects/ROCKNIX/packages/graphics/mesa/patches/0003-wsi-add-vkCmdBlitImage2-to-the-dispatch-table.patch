From a75f2f15e1280ae9c0cc3c6350d5eebf959598cb Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Tue, 22 Sep 2026 10:03:41 -0700
Subject: [PATCH] wsi: add vkCmdBlitImage2 to the dispatch table

Used by rotated presents.
---
 src/vulkan/wsi/wsi_common.c | 1 +
 src/vulkan/wsi/wsi_common.h | 1 +
 2 files changed, 2 insertions(+)

diff --git a/src/vulkan/wsi/wsi_common.c b/src/vulkan/wsi/wsi_common.c
index 411ee3ea4bc..15a1c30d5a2 100644
--- a/src/vulkan/wsi/wsi_common.c
+++ b/src/vulkan/wsi/wsi_common.c
@@ -194,6 +194,7 @@ wsi_device_init(struct wsi_device *wsi,
    WSI_GET_CB(BeginCommandBuffer);
    WSI_GET_CB(CmdPipelineBarrier);
    WSI_GET_CB(CmdCopyImage);
+   WSI_GET_CB(CmdBlitImage2);
    WSI_GET_CB(CmdCopyImageToBuffer);
    WSI_GET_CB(CmdResetQueryPool);
    WSI_GET_CB(ResetQueryPoolEXT);
diff --git a/src/vulkan/wsi/wsi_common.h b/src/vulkan/wsi/wsi_common.h
index 803d140696a..7542cfbfddd 100644
--- a/src/vulkan/wsi/wsi_common.h
+++ b/src/vulkan/wsi/wsi_common.h
@@ -207,6 +207,7 @@ struct wsi_device {
    WSI_CB(BeginCommandBuffer);
    WSI_CB(CmdPipelineBarrier);
    WSI_CB(CmdCopyImage);
+   WSI_CB(CmdBlitImage2);
    WSI_CB(CmdCopyImageToBuffer);
    WSI_CB(CmdResetQueryPool);
    WSI_CB(ResetQueryPoolEXT);
