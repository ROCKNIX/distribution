From f8d52326cc165e40a5fd70853636008f3018f895 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Fri, 23 Oct 2026 14:40:00 -0700
Subject: [PATCH] freedreno: A610 registers from the stock blob

Give the A610 its own entry with the init registers the stock Android 14
driver writes on SM6115, its primitive allocation threshold, and the
highest bank bit every A610 SoC reports. A605 keeps the shared table.
---
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -288,7 +288,6 @@
 
 add_gpus([
         GPUId(605), # TODO: Test it, based only on libwrapfake dumps
-        GPUId(610),
     ], A6xxGPUInfo(
         CHIP.A6XX,
         [a6xx_base, a6xx_gen1_low],
@@ -308,7 +307,69 @@
         raw_magic_regs = a6xx_gen1_low_raw_magic_regs,
     ))
 
+# Adreno 610: values the stock Android 14 blob writes in its context init on
+# SM6115. UCHE_CLIENT_PF is left to the kernel, which sets it for its fault
+# handler.
+a610_raw_magic_regs = [
+        [A6XXRegs.REG_A6XX_PC_MODE_CNTL, 0xf],
+        [A6XXRegs.REG_A6XX_PC_POWER_CNTL, 0],
+        [A6XXRegs.REG_A6XX_VFD_POWER_CNTL, 0],
+        [A6XXRegs.REG_A6XX_TPL1_DBG_ECO_CNTL, 0x00008000],
+        [A6XXRegs.REG_A6XX_GRAS_DBG_ECO_CNTL, 0],
+        [A6XXRegs.REG_A6XX_SP_CHICKEN_BITS, 0x00000400],
+        [A6XXRegs.REG_A6XX_SP_DBG_ECO_CNTL, 0],
+        [A6XXRegs.REG_A6XX_HLSQ_DBG_ECO_CNTL, 0],
+        [A6XXRegs.REG_A6XX_VPC_DBG_ECO_CNTL, 0],
+        [A6XXRegs.REG_A6XX_UCHE_UNKNOWN_0E12, 0x10000001],
+        [A6XXRegs.REG_A7XX_UCHE_UNKNOWN_0E11, 0],
+        [A6XXRegs.REG_A7XX_VFD_DBG_ECO_CNTL, 0],
+        [A6XXRegs.REG_A7XX_RB_UNKNOWN_8E09, 0x00000004],
+
+        [A6XXRegs.REG_A7XX_SP_UNKNOWN_0CE2,   0],
+        [A6XXRegs.REG_A7XX_SP_UNKNOWN_0CE2+1, 0],
+        [A6XXRegs.REG_A7XX_SP_UNKNOWN_0CE4,   0],
+        [A6XXRegs.REG_A7XX_SP_UNKNOWN_0CE4+1, 0],
+        [A6XXRegs.REG_A7XX_SP_UNKNOWN_0CE6,   0],
+        [A6XXRegs.REG_A7XX_SP_UNKNOWN_0CE6+1, 0],
+
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A00,   0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A00+1, 0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A00+2, 0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A00+3, 0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A00+4, 0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A00+5, 0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A10,   0xfc00fc00],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A10+1, 0xfc00fc00],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A10+2, 0xfc00fc00],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A10+3, 0xfc00fc00],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A10+4, 0xfc00fc00],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A10+5, 0xfc00fc00],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A20,   0],
+        [A6XXRegs.REG_A6XX_RB_UNKNOWN_8A30,   0],
+    ]
+
 add_gpus([
+        GPUId(610),
+    ], A6xxGPUInfo(
+        CHIP.A6XX,
+        [a6xx_base, a6xx_gen1_low, GPUProps(prim_alloc_threshold = 0x3)],
+        num_ccu = 1,
+        tile_align_w = 32,
+        tile_align_h = 16,
+        tile_max_w = 1024,
+        tile_max_h = 1024,
+        num_vsc_pipes = 16,
+        cs_shared_mem_size = 16 * 1024,
+        wave_granularity = 1,
+        fibers_per_sp = 128 * 16,
+        highest_bank_bit = 14,
+        ubwc_swizzle = 0x7,
+        macrotile_mode = 0,
+        magic_regs = a6xx_gen1_low_magic_regs,
+        raw_magic_regs = a610_raw_magic_regs,
+    ))
+
+add_gpus([
         GPUId(608),
         GPUId(612),
         GPUId(613),
