From ce24a7f1f2db2bf3af63973ad2311b7a7fc000a9 Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Wed, 23 Sep 2026 16:02:51 -0700
Subject: [PATCH] dri: pass rotation through dri2_blit_image

---
 src/egl/drivers/dri2/platform_wayland.c        | 2 +-
 src/gallium/frontends/dri/dri2.c               | 3 ++-
 src/gallium/frontends/dri/dri_util.h           | 2 +-
 src/gallium/frontends/dri/loader_dri3_helper.c | 2 +-
 4 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/src/egl/drivers/dri2/platform_wayland.c b/src/egl/drivers/dri2/platform_wayland.c
index cdc790bf5a5..c5558acb9ff 100644
--- a/src/egl/drivers/dri2/platform_wayland.c
+++ b/src/egl/drivers/dri2/platform_wayland.c
@@ -1923,7 +1923,7 @@ dri2_wl_swap_buffers_with_damage(_EGLDisplay *disp, _EGLSurface *draw,
          dri2_ctx->dri_context, dri2_surf->current->linear_copy,
          dri2_surf->current->dri_image, 0, 0, dri2_surf->base.Width,
          dri2_surf->base.Height, 0, 0, dri2_surf->base.Width,
-         dri2_surf->base.Height, 0);
+         dri2_surf->base.Height, 0, 0);
       dri_flush_drawable(dri_drawable);
    }
 
diff --git a/src/gallium/frontends/dri/dri2.c b/src/gallium/frontends/dri/dri2.c
index e7380757895..d6f22341977 100644
--- a/src/gallium/frontends/dri/dri2.c
+++ b/src/gallium/frontends/dri/dri2.c
@@ -1496,7 +1496,7 @@ void
 dri2_blit_image(struct dri_context *ctx, struct dri_image *dst, struct dri_image *src,
                 int dstx0, int dsty0, int dstwidth, int dstheight,
                 int srcx0, int srcy0, int srcwidth, int srcheight,
-                int flush_flag)
+                unsigned rotation, int flush_flag)
 {
    struct pipe_context *pipe = ctx->st->pipe;
    struct pipe_screen *screen;
@@ -1530,6 +1530,7 @@ dri2_blit_image(struct dri_context *ctx, struct dri_image *dst, struct dri_image
    blit.src.format = src->texture->format;
    blit.mask = PIPE_MASK_RGBA;
    blit.filter = PIPE_TEX_FILTER_NEAREST;
+   blit.rotation = rotation;
 
    pipe->blit(pipe, &blit);
 
diff --git a/src/gallium/frontends/dri/dri_util.h b/src/gallium/frontends/dri/dri_util.h
index 96713679a23..30af123e06f 100644
--- a/src/gallium/frontends/dri/dri_util.h
+++ b/src/gallium/frontends/dri/dri_util.h
@@ -269,7 +269,7 @@ PUBLIC void
 dri2_blit_image(struct dri_context *ctx, struct dri_image *dst, struct dri_image *src,
                 int dstx0, int dsty0, int dstwidth, int dstheight,
                 int srcx0, int srcy0, int srcwidth, int srcheight,
-                int flush_flag);
+                unsigned rotation, int flush_flag);
 PUBLIC void *
 dri2_map_image(struct dri_context *ctx, struct dri_image *image,
                int x0, int y0, int width, int height,
diff --git a/src/gallium/frontends/dri/loader_dri3_helper.c b/src/gallium/frontends/dri/loader_dri3_helper.c
index 6b80ead53de..2a23e0ef4e7 100644
--- a/src/gallium/frontends/dri/loader_dri3_helper.c
+++ b/src/gallium/frontends/dri/loader_dri3_helper.c
@@ -236,7 +236,7 @@ loader_dri3_blit_image(struct loader_dri3_drawable *draw,
    if (dri_context)
       dri2_blit_image(dri_context, dst, src, dstx0, dsty0,
                      width, height, srcx0, srcy0,
-                     width, height, flush_flag);
+                     width, height, 0, flush_flag);
 
    if (use_blit_context)
       loader_dri3_blit_context_put();
