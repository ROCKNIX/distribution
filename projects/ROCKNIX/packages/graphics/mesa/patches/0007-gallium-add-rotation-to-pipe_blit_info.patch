From a63b02b04d291d6fc74f02729bdf26a022862bfb Mon Sep 17 00:00:00 2001
From: sunshineinabox <aqemail@gmail.com>
Date: Wed, 23 Sep 2026 09:41:08 -0700
Subject: [PATCH] gallium: add rotation to pipe_blit_info

Clockwise, in degrees. For 90 and 270 the destination box is the source box
transposed. Drivers that honour it set pipe_caps.blit_rotation, so
frontends check that before rotating.
---
 docs/gallium/screen.rst                | 2 ++
 src/gallium/auxiliary/util/u_surface.c | 5 +++--
 src/gallium/include/pipe/p_defines.h   | 1 +
 src/gallium/include/pipe/p_state.h     | 1 +
 4 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/docs/gallium/screen.rst b/docs/gallium/screen.rst
index 303502ee488..78e0e4180b0 100644
--- a/docs/gallium/screen.rst
+++ b/docs/gallium/screen.rst
@@ -678,6 +678,8 @@ Capability about the features and limits of the driver/GPU.
 * ``pipe_caps.prefer_persp``: Whether the driver prefers perspective correct
   or linear interpolation. This is a performance hint.
 * ``pipe_caps.blit_3d``: Whether pipe_context::blit can have depth > 1.
+* ``pipe_caps.blit_rotation``: Whether pipe_context::blit supports a non-zero
+  ``pipe_blit_info::rotation`` for formats that can be rendered to.
 
 
 .. _pipe_shader_caps:
diff --git a/src/gallium/auxiliary/util/u_surface.c b/src/gallium/auxiliary/util/u_surface.c
index 300dc3a9c2f..6296d0f657e 100644
--- a/src/gallium/auxiliary/util/u_surface.c
+++ b/src/gallium/auxiliary/util/u_surface.c
@@ -898,8 +898,9 @@ util_can_blit_via_copy_region(const struct pipe_blit_info *blit,
    assert(blit->dst.box.height >= 1);
    assert(blit->dst.box.depth >= 1);
 
-   /* No scaling or flipping */
-   if (blit->src.box.width != blit->dst.box.width ||
+   /* No scaling, flipping or rotation */
+   if (blit->rotation ||
+       blit->src.box.width != blit->dst.box.width ||
        blit->src.box.height != blit->dst.box.height ||
        blit->src.box.depth != blit->dst.box.depth) {
       return false;
diff --git a/src/gallium/include/pipe/p_defines.h b/src/gallium/include/pipe/p_defines.h
index c9929b5979f..93ddd061a7a 100644
--- a/src/gallium/include/pipe/p_defines.h
+++ b/src/gallium/include/pipe/p_defines.h
@@ -1063,6 +1063,7 @@ struct pipe_caps {
    bool representative_fragment_test;
    bool prefer_persp;
    bool blit_3d;
+   bool blit_rotation;
    bool glsl_bindless_handles_are_32bit;
 
    int accelerated;
diff --git a/src/gallium/include/pipe/p_state.h b/src/gallium/include/pipe/p_state.h
index 3f7734bc68d..9096a4fc5c3 100644
--- a/src/gallium/include/pipe/p_state.h
+++ b/src/gallium/include/pipe/p_state.h
@@ -929,6 +929,7 @@ struct pipe_blit_info
    bool render_condition_enable; /**< whether the blit should honor the
                                  current render condition */
    bool alpha_blend; /* dst.rgb = src.rgb * src.a + dst.rgb * (1 - src.a) */
+   uint16_t rotation; /* clockwise degrees: 0, 90, 180 or 270 */
 };
 
 /**
