-void
-tu_autotune_calib_init(struct tu_device *device)
+bool
+tu_autotune_calib_from_table(struct tu_device *device)
 {
    const struct tu_physical_device *pdev = device->physical_device;
    struct tu_autotune_calib *calib = &device->autotune->calib;
    memset(calib, 0, sizeof(*calib));
 
-   const char *env = os_get_option("TU_AUTOTUNE_CALIB");
-   if (env && !strcmp(env, "off"))
-      return;
    if (pdev->info->chip < 6 || pdev->info->chip > 8 || TU_DEBUG(NOBIN) || TU_DEBUG(FORCEBIN))
-      return;
+      return false;
 
    const calib_table_entry *row = find_row(pdev);
    if (!row)
-      return;
+      return false;
 
    calib_from_row(pdev, *row, calib);
    if (TU_DEBUG(STARTUP)) {
@@ -142,4 +140,18 @@ tu_autotune_calib_init(struct tu_device *device)
                 row->chip_id == (uint32_t) pdev->dev_id.chip_id ? "own" : "borrowed", row->chip_id,
                 pdev->max_freq ? pdev->max_freq / 1e6 : row->mhz);
    }
+   return true;
+}
+
+void
+tu_autotune_calib_init(struct tu_device *device)
+{
+   memset(&device->autotune->calib, 0, sizeof(device->autotune->calib));
+
+   const char *env = os_get_option("TU_AUTOTUNE_CALIB");
+   if (env && !strcmp(env, "off"))
+      return;
+   if (env && *env && tu_autotune_probe_init(device, env))
+      return;
+   tu_autotune_calib_from_table(device);
 }
