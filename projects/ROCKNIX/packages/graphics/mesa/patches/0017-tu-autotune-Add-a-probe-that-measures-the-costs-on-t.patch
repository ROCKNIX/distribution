diff --git a/src/freedreno/vulkan/tu_autotune_probe.cc b/src/freedreno/vulkan/tu_autotune_probe.cc
new file mode 100644
index 00000000000..e159ab6a65d
--- /dev/null
+++ b/src/freedreno/vulkan/tu_autotune_probe.cc
@@ -0,0 +1,1746 @@
+/*
+ * Copyright © 2026 ROCKNIX
+ * SPDX-License-Identifier: MIT
+ */
+
+/* TU_AUTOTUNE_CALIB=force measures the costs on this GPU instead of using the table, which is how table entries are
+ * made. It draws through the normal entry points, so it gets the same binning as an app.
+ */
+
+#include "tu_autotune_calib.h"
+
+#include <algorithm>
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <string>
+#include <vector>
+
+#include "nir/nir_builder.h"
+#include "ir3/ir3_compiler.h"
+#include "util/hex.h"
+#include "util/log.h"
+#include "util/os_file.h"
+#include "util/os_misc.h"
+#include "util/os_time.h"
+#include "vk_pipeline.h"
+
+#include "git_sha1.h"
+
+#include "tu_autotune.h"
+#include "tu_cmd_buffer.h"
+#include "tu_device.h"
+#include "tu_knl.h"
+#include "tu_pipeline.h"
+#include "tu_queue.h"
+#include "tu_shader.h"
+#include "tu_util.h"
+
+namespace {
+
+constexpr VkFormat PROBE_FORMAT = VK_FORMAT_R8G8B8A8_UNORM;
+constexpr uint32_t PROBE_CPP = 4;
+/* no stencil, so storing depth never has to preserve other bits */
+constexpr VkFormat PROBE_DEPTH_FORMAT = VK_FORMAT_D32_SFLOAT;
+constexpr uint32_t PROBE_DEPTH_CPP = 4;
+constexpr uint32_t ALU_CHAIN = 16;   /* multiply-add steps in the ALU shader */
+constexpr uint32_t TEX_FETCHES = 8;  /* fetches in the texture shader */
+constexpr uint32_t TEX_SIZE = 64;    /* small enough to stay in cache */
+
+/* Debug: depth test GREATER with increasing z instead of LESS. */
+bool
+depth_greater()
+{
+   static const bool greater = os_get_option("TU_AUTOTUNE_CALIB_DEPTH_GREATER") != nullptr;
+   return greater;
+}
+constexpr uint32_t PROBE_ROUNDS = 11; /* the first round is discarded */
+constexpr uint32_t WARMUP_PASSES = 64; /* most passes in one warm-up batch */
+constexpr int64_t WARMUP_BATCH_NS = 35'000'000; /* GPU work per warm-up batch, 64 passes on A610 */
+constexpr uint32_t WARMUP_MAX_BATCHES = 8;
+constexpr uint32_t OVERDRAW_LAYERS = 4;
+constexpr uint32_t DRAWS_FEW = 16;
+constexpr uint32_t DRAWS_MANY = 256;
+constexpr uint32_t MIN_BINS = 8;
+constexpr uint32_t PAD_DWORDS = 64;                    /* CP_NOP dwords per padded draw */
+constexpr uint32_t VSC_SLOT_DWORDS = 2 * MAX_VSC_PIPES; /* draw sizes, then prim sizes */
+constexpr uint64_t PROBE_TIMEOUT_NS = 5ull * 1000 * 1000 * 1000;
+
+struct push_data {
+   float x0, y0, x1, y1; /* NDC, relative to the bin for omni draws */
+   float color[4];
+   float tile_w, tile_h; /* omni: bin pitch in NDC */
+   uint32_t tiles_x;     /* omni: bins per row */
+   uint32_t omni;
+   float z;
+   float pad[3];
+};
+
+enum draw_variant {
+   VAR_LIGHT, /* one pipeline, push constants only */
+   VAR_HEAVY, /* switches pipeline every draw */
+   VAR_PAD,   /* light plus CP_NOP padding */
+};
+
+enum probe_pipeline {
+   PIPE_STRIPES,       /* incompressible output */
+   PIPE_STRIPES_ALT,   /* same, heavy passes switch between the two */
+   PIPE_STRIPES_BLEND, /* additive blend */
+   PIPE_FLAT,          /* compressible output */
+   PIPE_DEPTH,         /* stripes with depth test and write */
+   PIPE_DEPTH_ALWAYS,  /* incompressible depth, passing every fragment, so it needs no clear */
+   PIPE_ALU,
+   PIPE_TEX,
+   PIPE_COUNT,
+};
+
+enum probe_pass {
+   PASS_SYSMEM_OVERDRAW_N, /* fragment throughput */
+   PASS_SYSMEM_OVERDRAW_1, /* pass overhead */
+   PASS_GMEM_PIXEL_LIGHT_FEW_S1,  /* one pixel per draw, for skipped draw-bins */
+   PASS_GMEM_PIXEL_LIGHT_MANY_S1,
+   PASS_GMEM_PIXEL_LIGHT_FEW_S2,
+   PASS_GMEM_PIXEL_LIGHT_MANY_S2,
+   PASS_GMEM_PIXEL_HEAVY_FEW_S1,
+   PASS_GMEM_PIXEL_HEAVY_MANY_S1,
+   PASS_GMEM_PIXEL_HEAVY_FEW_S2,
+   PASS_GMEM_PIXEL_HEAVY_MANY_S2,
+   PASS_GMEM_PIXEL_PAD_FEW_S1,
+   PASS_GMEM_PIXEL_PAD_MANY_S1,
+   PASS_GMEM_PIXEL_PAD_FEW_S2,
+   PASS_GMEM_PIXEL_PAD_MANY_S2,
+   PASS_GMEM_OMNI_LIGHT_FEW_S1,   /* one pixel in every bin, for rendered draw-bins */
+   PASS_GMEM_OMNI_LIGHT_MANY_S1,
+   PASS_GMEM_OMNI_LIGHT_FEW_S2,
+   PASS_GMEM_OMNI_LIGHT_MANY_S2,
+   PASS_GMEM_OMNI_HEAVY_FEW_S1,
+   PASS_GMEM_OMNI_HEAVY_MANY_S1,
+   PASS_GMEM_OMNI_HEAVY_FEW_S2,
+   PASS_GMEM_OMNI_HEAVY_MANY_S2,
+   PASS_GMEM_OVERDRAW_N,
+   PASS_GMEM_OVERDRAW_1,
+   PASS_GMEM_LOAD,
+   PASS_GMEM_LOAD_STORE,
+   PASS_GMEM_STORE,
+   PASS_SYSMEM_FLAT_N,
+   PASS_SYSMEM_FLAT_1,
+   PASS_SYSMEM_BLEND_N,
+   PASS_SYSMEM_BLEND_1,
+   PASS_GMEM_BLEND_N,
+   PASS_GMEM_BLEND_1,
+   PASS_SYSMEM_DEPTH_N,       /* back to front, every layer passes */
+   PASS_SYSMEM_DEPTH_1,
+   PASS_GMEM_DEPTH_N,
+   PASS_GMEM_DEPTH_1,
+   PASS_SYSMEM_DEPTH_FTB_N,   /* front to back, only the first layer passes */
+   PASS_GMEM_DEPTH_FTB_N,
+   PASS_GMEM_DEPTH_LOAD_STORE,
+   PASS_GMEM_DEPTH_STORE,
+   PASS_GMEM_DEPTH_NONE,
+   PASS_GMEM_DEPTH_LOAD,
+   PASS_SYSMEM_ALU_N,
+   PASS_SYSMEM_ALU_1,
+   PASS_SYSMEM_TEX_N,
+   PASS_SYSMEM_TEX_1,
+   PASS_COUNT,
+};
+
+constexpr uint32_t MAX_QUERIES = 2 * MAX2(PROBE_ROUNDS * PASS_COUNT, WARMUP_PASSES);
+
+struct pass_desc {
+   const char *name;
+   probe_pipeline pipeline;
+   draw_variant variant;
+   bool sysmem;
+   bool s2;
+   bool pixel; /* scattered one-pixel rects, else full screen */
+   bool omni;  /* one-pixel rect in every bin */
+   uint32_t draws;
+   bool load;
+   bool store;
+   bool depth;       /* cleared unless depth_load, undefined for PIPE_DEPTH_ALWAYS */
+   bool depth_load;
+   bool depth_store;
+   bool ftb;         /* front to back */
+};
+
+const pass_desc pass_descs[PASS_COUNT] = {
+   /* name                        pipeline            variant    sysmem s2     pixel  omni   draws            load   store  depth  dload  dstore ftb */
+   { "sysmem stripes N",          PIPE_STRIPES,       VAR_LIGHT, true,  false, false, false, OVERDRAW_LAYERS, false, false, false, false, false, false },
+   { "sysmem stripes 1",          PIPE_STRIPES,       VAR_LIGHT, true,  false, false, false, 1,               false, false, false, false, false, false },
+   { "gmem pixel light few s1",   PIPE_STRIPES,       VAR_LIGHT, false, false, true,  false, DRAWS_FEW,       false, false, false, false, false, false },
+   { "gmem pixel light many s1",  PIPE_STRIPES,       VAR_LIGHT, false, false, true,  false, DRAWS_MANY,      false, false, false, false, false, false },
