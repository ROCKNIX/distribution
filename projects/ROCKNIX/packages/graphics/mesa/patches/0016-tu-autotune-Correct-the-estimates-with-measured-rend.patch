+tu_autotune::render_mode
+tu_autotune::adapt_decide(rp_history &history, rp_entry &entry, const double pred[2], render_mode model_mode,
+                          uint32_t draws)
+{
+   constexpr uint32_t MIN_DECISIONS_BEFORE_PROBE = 3;
+   constexpr uint32_t MIN_DRAWS_FOR_PROBE = 5;
+
+   /* The byte-count heuristic's estimates aren't times, so only the time model is corrected. */
+   if (!calib.valid || pred[0] <= 0.0 || pred[1] <= 0.0)
+      return model_mode;
+
+   const unsigned bucket = rp_history::adapt_bucket(draws);
+   entry.adapt_bucket = bucket;
+   auto &h = history.adapt[bucket];
+
+   /* Each mode's estimate corrected by what was measured in that mode for this pass. A mode that hasn't run keeps the
+    * table's estimate, since other passes' errors say little about it.
+    */
+   double adj[2];
+   for (int m = 0; m < 2; m++) {
+      const bool measured = adapt_cfg.hash && h.count[m].load(std::memory_order_relaxed) > 0;
+      adj[m] = pred[m] * (measured ? h.ratio[m].load(std::memory_order_relaxed) : 1.0);
+   }
+
+   const bool sysmem = adj[1] >= adj[0] * (1.0 - calib_margin);
+   render_mode mode = sysmem ? render_mode::SYSMEM : render_mode::GMEM;
+   const uint32_t decisions = h.decisions.fetch_add(1, std::memory_order_relaxed) + 1;
+
+   bool probing = false;
+   if (adapt_cfg.probe && draws >= MIN_DRAWS_FOR_PROBE && adj[0] > 0.0) {
+      const int cur = sysmem ? 0 : 1, other = 1 - cur;
+      const double r = adj[1] / adj[0];
+      const uint64_t now = os_time_get_nano();
+      const uint64_t other_last = h.last_ns[other].load(std::memory_order_relaxed);
+      const bool other_unknown =
+         h.count[other].load(std::memory_order_relaxed) == 0 || now - other_last > adapt_cfg.reprobe_ns;
+
+      if (r >= adapt_cfg.band_lo && r <= adapt_cfg.band_hi && decisions >= MIN_DECISIONS_BEFORE_PROBE &&
+          h.count[cur].load(std::memory_order_relaxed) >= 1 && other_unknown) {
+         uint64_t last = adapt.last_probe_ns.load(std::memory_order_relaxed);
+         if (now - last >= adapt_cfg.probe_interval_ns &&
+             adapt.last_probe_ns.compare_exchange_strong(last, now, std::memory_order_relaxed)) {
+            probing = true;
+            entry.probe = true;
+            mode = other == 0 ? render_mode::SYSMEM : render_mode::GMEM;
+         }
+      }
+   }
+
+   if (adapt_cfg.log) {
+      mesa_logi("autotune-adapt %016" PRIx64 "/%u: %s%s (model %s) adj sysmem %.1f gmem %.1f, ratio %.3f/%.3f "
+                "(n=%u/%u)",
+                history.hash, bucket, render_mode_str(mode), probing ? " probe" : "", render_mode_str(model_mode),
+                adj[0], adj[1], h.ratio[0].load(std::memory_order_relaxed), h.ratio[1].load(std::memory_order_relaxed),
+                h.count[0].load(std::memory_order_relaxed), h.count[1].load(std::memory_order_relaxed));
+   }
+   return mode;
+}
