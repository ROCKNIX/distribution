+
    /* The binning pass ran, so the first pipe_count VSC sizes are valid. */
    bool binning = false;
    uint32_t pipe_count = 0;
@@ -1042,6 +1099,64 @@ struct tu_autotune::rp_history {
    {
    }
 
+   /** Adaptive layers, per RP, draw count and mode (0 sysmem, 1 gmem) **/
+
+   /* The same RP can be a few draws one frame and hundreds the next, so each power of two of draws learns apart. */
+   static constexpr unsigned ADAPT_BUCKETS = 16;
+   static unsigned adapt_bucket(uint32_t draws)
+   {
+      return MIN2(util_logbase2(draws + 1), ADAPT_BUCKETS - 1);
+   }
+
+   struct adapt_history {
+      std::atomic<float> ratio[2]; /* EMA of measured / predicted */
+      std::atomic<uint32_t> count[2];
+      std::atomic<uint64_t> last_ns[2]; /* last measurement */
+      std::atomic<uint32_t> decisions;
+      adapt_history()
+      {
+         for (int m = 0; m < 2; m++) {
+            ratio[m] = 1.0f;
+            count[m] = 0;
+            last_ns[m] = 0;
+         }
+         decisions = 0;
+      }
+   } adapt[ADAPT_BUCKETS];
+
+   void adapt_update(rp_entry &entry, tu_autotune &at)
+   {
+      constexpr double MIN_MEASURED_US = 50.0;
+
+      const int m = entry.sysmem ? 0 : 1;
+      const double pred = entry.pred_us[m];
+      if (!at.calib.valid || pred <= 0.0)
+         return;
+      const double measured = (double) ticks_to_us(entry.get_rp_duration());
+      if (measured < MIN_MEASURED_US)
+         return;
+
+      const double raw = CLAMP(measured / pred, 0.1, 20.0); /* anything outside this isn't a model error */
+      adapt_history &h = adapt[entry.adapt_bucket];
+      float ratio = h.ratio[m].load(std::memory_order_relaxed);
+      if (at.adapt_cfg.hash) {
+         /* a plain mean over the first samples, then a slow average, so one outlier doesn't flip the pass */
+         uint32_t n = h.count[m].load(std::memory_order_relaxed);
+         ratio += (float) (MAX2(1.0 / (n + 1), 0.1) * (raw - ratio));
+         h.ratio[m].store(ratio, std::memory_order_relaxed);
+         h.count[m].store(n + 1, std::memory_order_relaxed);
+         h.last_ns[m].store(os_time_get_nano(), std::memory_order_relaxed);
+      }
+
+      if (at.adapt_cfg.log) {
+         mesa_logi("autotune-adapt %016" PRIx64 "/%u: measured %s%s %.1f us, predicted %.1f, raw %.4f, ratio %.3f "
+                   "(n=%u)",
+                   hash, entry.adapt_bucket, render_mode_str(entry.sysmem ? render_mode::SYSMEM : render_mode::GMEM),
+                   entry.probe ? " probe" : "", measured, pred, raw, ratio,
+                   h.count[m].load(std::memory_order_relaxed));
+      }
+   }
