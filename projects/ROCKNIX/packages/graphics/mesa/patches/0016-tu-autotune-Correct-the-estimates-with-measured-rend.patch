+
          UNUSED const VkExtent2D &extent = cmd_state->render_areas[0].extent;
          at_log_bandwidth_h(
             "%" PRIu32 " selecting %s\n"
@@ -1493,6 +1617,9 @@ struct tu_autotune::rp_history {
