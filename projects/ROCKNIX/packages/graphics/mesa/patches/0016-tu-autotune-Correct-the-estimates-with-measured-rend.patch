+/* Corrections from measured times: "hash" learns measured / predicted per render pass and draw count, and "probe" now
+ * and then runs the other mode when the two are close. TU_AUTOTUNE_FLAGS=adapt turns on both.
+ */
+static tu_autotune::adapt_config
+parse_adapt_config(bool flag)
+{
+   tu_autotune::adapt_config cfg;
+   const char *env = os_get_option("TU_AUTOTUNE_ADAPT");
+   if (!env) {
+      cfg.hash = cfg.probe = flag;
+      return cfg;
+   }
+
+   bool all = strstr(env, "all") != NULL;
+   cfg.hash = all || strstr(env, "hash") != NULL;
+   cfg.probe = all || strstr(env, "probe") != NULL;
+   cfg.log = strstr(env, "log") != NULL;
+   if (flag && !cfg.enabled())
+      cfg.hash = cfg.probe = true;
+
+   const char *band = os_get_option("TU_AUTOTUNE_ADAPT_BAND");
+   int lo, hi;
+   if (band && sscanf(band, "%d,%d", &lo, &hi) == 2 && lo > 0 && hi > lo) {
+      cfg.band_lo = lo / 100.0f;
+      cfg.band_hi = hi / 100.0f;
+   }
+   const char *probe_ms = os_get_option("TU_AUTOTUNE_ADAPT_PROBE_MS");
+   if (probe_ms && atoi(probe_ms) > 0)
+      cfg.probe_interval_ns = (uint64_t) atoi(probe_ms) * 1'000'000;
+   const char *reprobe_ms = os_get_option("TU_AUTOTUNE_ADAPT_REPROBE_MS");
+   if (reprobe_ms && atoi(reprobe_ms) > 0)
+      cfg.reprobe_ns = (uint64_t) atoi(reprobe_ms) * 1'000'000;
+   return cfg;
+}
