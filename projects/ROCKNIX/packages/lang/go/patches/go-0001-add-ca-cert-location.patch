Subject: [PATCH] x509: look for certificates in /etc/ssl

ROCKNIX keeps its CA bundle at /etc/ssl, which is not one of the
directories Go scans.

diff --git a/src/crypto/x509/root_linux.go b/src/crypto/x509/root_linux.go
--- a/src/crypto/x509/root_linux.go
+++ b/src/crypto/x509/root_linux.go
@@ -20,6 +20,7 @@
 var certDirectories = []string{
 	"/etc/ssl/certs",     // SLES10/SLES11, https://golang.org/issue/12139
 	"/etc/pki/tls/certs", // Fedora/RHEL
+	"/etc/ssl",           // ROCKNIX
 }
 
 func init() {
