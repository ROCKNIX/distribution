. /etc/profile

SDL2TEXT_DIR="/storage/.config/sdl2text"
GUIDE_PATH_FILE="${SDL2TEXT_DIR}/game_guide.path"

function set_guide_path_file() {
  cat <<EOF >"${GUIDE_PATH_FILE}"
$1
EOF
}

if [ ! -d "${SDL2TEXT_DIR}" ]; then
  mkdir -p "${SDL2TEXT_DIR}"
fi

# Check if guide exists for this game and store the game guide path for later launch
# Prioritize PDF over TXT if both guides exist.
if [ -n "${1}" ]; then
  GAME_GUIDE_BASE="${1%.*}"

  if [ -f "${GAME_GUIDE_BASE}.txt" ]; then
    set_guide_path_file "${GAME_GUIDE_BASE}.txt"
  fi

  if [ -f "${GAME_GUIDE_BASE}.pdf" ]; then
    set_guide_path_file "${GAME_GUIDE_BASE}.pdf"
  fi

  if [ ! -f "${GAME_GUIDE_BASE}.txt" ] && [ ! -f "${GAME_GUIDE_BASE}.pdf" ]; then
    rm -f "${GUIDE_PATH_FILE}"
  fi
  exit 0
fi

# Show game guide if exists
if [ ! -f "${GUIDE_PATH_FILE}" ]; then
  exit 1
fi

GAME_GUIDE_PATH="$(cat "${GUIDE_PATH_FILE}")"

GAME_GUIDE_EXT="${GAME_GUIDE_PATH##*.}"
if [[ "${GAME_GUIDE_EXT}" == "pdf" ]]; then
  /usr/bin/sdl2pdf "${GAME_GUIDE_PATH}" >/dev/null 2>&1 &
elif [[ "${GAME_GUIDE_EXT}" == "txt" ]]; then
  /usr/bin/sdl2text "${GAME_GUIDE_PATH}" >/dev/null 2>&1 &
fi

exit 0
