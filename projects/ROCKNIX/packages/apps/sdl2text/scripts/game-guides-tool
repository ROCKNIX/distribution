. /etc/profile

SDL2TEXT_DIR="/storage/.config/sdl2text"
GUIDE_PATH_FILE="${SDL2TEXT_DIR}/game_guide.path"

if [ ! -d "${SDL2TEXT_DIR}" ]; then
  mkdir -p "${SDL2TEXT_DIR}"
fi

if [ -n "${1}" ]; then
  # Check if guide exists for this game and output to temp path
  GAME_GUIDE_CHECK="${1%.*}.txt"
  if [ -f "${GAME_GUIDE_CHECK}" ]; then
cat <<EOF >"${GUIDE_PATH_FILE}"
${GAME_GUIDE_CHECK}
EOF
  else
    rm -f "${GUIDE_PATH_FILE}"
  fi
  exit 0
fi

# Show game guide if exists
if [ ! -f "${GUIDE_PATH_FILE}" ]; then
  exit 1
fi

GAME_GUIDE_PATH="$(cat "${GUIDE_PATH_FILE}")"

/usr/bin/sdl2text "${GAME_GUIDE_PATH}" >/dev/null 2>&1 &

exit 0
