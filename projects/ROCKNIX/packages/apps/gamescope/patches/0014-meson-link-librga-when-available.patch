From: Felix "Xilefian" Jones
Subject: [PATCH] meson: link librga for RGA hardware rotate/scale scanout when available

Detect the airockchip librga (im2d) 2D-engine library via pkg-config and link it
into gamescope when present, defining HAVE_LIBRGA. librga only builds for arm/aarch64,
so on other arches the dependency is not found and the RGA scanout path (patch 0015)
compiles out.
---
diff --git a/src/meson.build b/src/meson.build
index 806fe5d..ec26f73 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -23,6 +23,9 @@ sdl2_dep = dependency('SDL2', required: get_option('sdl2_backend'))
 avif_dep = dependency('libavif', version: '>=1.0.0', required: get_option('avif_screenshots'))
 pixman_dep = dependency('pixman-1')
 udev_dep = dependency('libudev')
+# ROCKNIX: optional Rockchip RGA 2D engine (librga) for HW rotate/scale scanout.
+# Only present for arm/aarch64; gamescope on other arches compiles the path out.
+rga_dep = dependency('librga', required: false)
 
 wlroots_dep = dependency(
   'wlroots-0.18',
@@ -151,6 +154,7 @@ gamescope_cpp_args += '-DHAVE_SDL2=@0@'.format(sdl2_dep.found().to_int())
 gamescope_cpp_args += '-DHAVE_AVIF=@0@'.format(avif_dep.found().to_int())
 gamescope_cpp_args += '-DHAVE_LIBCAP=@0@'.format(cap_dep.found().to_int())
 gamescope_cpp_args += '-DHAVE_LIBEIS=@0@'.format(eis_dep.found().to_int())
+gamescope_cpp_args += '-DHAVE_LIBRGA=@0@'.format(rga_dep.found().to_int())
 gamescope_cpp_args += '-DHAVE_SCRIPTING=1'
 
 src += spirv_shaders
@@ -198,7 +202,7 @@ gamescope_version = configure_file(
       xkbcommon, thread_dep, sdl2_dep, wlroots_dep,
       vulkan_dep, liftoff_dep, dep_xtst, dep_xmu, cap_dep, epoll_dep, pipewire_dep, librt_dep,
       stb_dep, displayinfo_dep, openvr_dep, dep_xcursor, avif_dep, dep_xi,
-      libdecor_dep, eis_dep, luajit_dep, libinput_dep, pixman_dep, udev_dep,
+      libdecor_dep, eis_dep, luajit_dep, libinput_dep, pixman_dep, udev_dep, rga_dep,
     ],
     install: true,
     cpp_args: gamescope_cpp_args,
