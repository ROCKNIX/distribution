diff --git a/src/shaders/cs_gsr.comp b/src/shaders/cs_gsr.comp
new file mode 100644
index 0000000..a754be0
--- /dev/null
+++ b/src/shaders/cs_gsr.comp
@@ -0,0 +1,121 @@
+#version 450
+// Copyright (c) 2025, Qualcomm Innovation Center, Inc. All rights reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+// Derived from SGSR1 sgsr1_shader_mobile.frag (RGBA mode).
+// Adapted to Gamescope descriptors, compute dispatch and runtime sharpness.
+// See LICENSE.sgsr in this directory for the full upstream license.
+#extension GL_GOOGLE_include_directive : require
+#extension GL_EXT_scalar_block_layout : require
+#include "descriptor_set.h"
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(binding = 0, scalar) uniform GsrConstants {
+    vec4 viewport; // reciprocal input size, input size
+    vec2 outputSize;
+    float u_edgeSharpness;
+};
+#define ps0 s_samplers[0]
+
+float fastLanczos2(float x)
+{
+	float wA = x-4.0;
+	float wB = x*wA-wA;
+	wA *= wA;
+	return wB*wA;
+}
+vec2 weightY(float dx, float dy,float c, float std)
+{
+	float x = ((dx*dx)+(dy* dy))* 0.55 + clamp(abs(c)*std, 0.0, 1.0);
+	float w = fastLanczos2(x);
+	return vec2(w, w * c);
+}
+
+vec4 GsrSample(vec2 uv)
+{
+	const int mode = 1;
+	const float edgeThreshold = 8.0 / 255.0;
+	float edgeSharpness = u_edgeSharpness;
+
+	vec4 color;
+	if(mode == 1)
+		color.xyz = textureLod(ps0,uv,0.0).xyz;
+	else
+		color.xyzw = textureLod(ps0,uv,0.0).xyzw;
+
+	float xCenter;
+	xCenter = abs(uv.x+-0.5);
+	float yCenter;
+	yCenter = abs(uv.y+-0.5);
+
+	//todo: config the SR region based on needs
+	//if ( mode!=4 && xCenter*xCenter+yCenter*yCenter<=0.4 * 0.4)
+	if ( mode!=4)
+	{
+		vec2 imgCoord = ((uv*viewport.zw)+vec2(-0.5,0.5));
+		vec2 imgCoordPixel = floor(imgCoord);
+		vec2 coord = (imgCoordPixel*viewport.xy);
+		vec2 pl = (imgCoord+(-imgCoordPixel));
+		vec4  left = textureGather(ps0,coord, mode);
+
+		float edgeVote = abs(left.z - left.y) + abs(color[mode] - left.y)  + abs(color[mode] - left.z) ;
+		if(edgeVote > edgeThreshold)
+		{
+			coord.x += viewport.x;
+
+			vec4 right = textureGather(ps0,coord + vec2(viewport.x, 0.0), mode);
+			vec4 upDown;
+			upDown.xy = textureGather(ps0,coord + vec2(0.0, -viewport.y),mode).wz;
+			upDown.zw  = textureGather(ps0,coord+ vec2(0.0, viewport.y), mode).yx;
+
+			float mean = (left.y+left.z+right.x+right.w)*0.25;
+			left = left - vec4(mean);
+			right = right - vec4(mean);
+			upDown = upDown - vec4(mean);
+			color.w =color[mode] - mean;
+
+			float sum = (((((abs(left.x)+abs(left.y))+abs(left.z))+abs(left.w))+(((abs(right.x)+abs(right.y))+abs(right.z))+abs(right.w)))+(((abs(upDown.x)+abs(upDown.y))+abs(upDown.z))+abs(upDown.w)));
+			if (sum < 1e-6) return vec4(color.rgb, 1.0);
+			float std = 2.181818/sum;
+
+			vec2 aWY = weightY(pl.x, pl.y+1.0, upDown.x,std);
+			aWY += weightY(pl.x-1.0, pl.y+1.0, upDown.y,std);
+			aWY += weightY(pl.x-1.0, pl.y-2.0, upDown.z,std);
+			aWY += weightY(pl.x, pl.y-2.0, upDown.w,std);
+			aWY += weightY(pl.x+1.0, pl.y-1.0, left.x,std);
+			aWY += weightY(pl.x, pl.y-1.0, left.y,std);
+			aWY += weightY(pl.x, pl.y, left.z,std);
+			aWY += weightY(pl.x+1.0, pl.y, left.w,std);
+			aWY += weightY(pl.x-1.0, pl.y-1.0, right.x,std);
+			aWY += weightY(pl.x-2.0, pl.y-1.0, right.y,std);
+			aWY += weightY(pl.x-2.0, pl.y, right.z,std);
+			aWY += weightY(pl.x-1.0, pl.y, right.w,std);
+
+			if (abs(aWY.x) < 1e-6) return vec4(color.rgb, 1.0);
+			float finalY = aWY.y/aWY.x;
+
+			float maxY = max(max(left.y,left.z),max(right.x,right.w));
+			float minY = min(min(left.y,left.z),min(right.x,right.w));
+			finalY = clamp(edgeSharpness*finalY, minY, maxY);
+
+			float deltaY = finalY -color.w;
+
+			//smooth high contrast input
+			deltaY = clamp(deltaY, -23.0 / 255.0, 23.0 / 255.0);
+
+			color.x = clamp((color.x+deltaY),0.0,1.0);
+			color.y = clamp((color.y+deltaY),0.0,1.0);
+			color.z = clamp((color.z+deltaY),0.0,1.0);
+		}
+	}
+
+	color.w = 1.0;  //assume alpha channel is not used
+	return color;
+}
+
+void main()
+{
+    uvec2 pos = gl_GlobalInvocationID.xy;
+    if (any(greaterThanEqual(pos, uvec2(outputSize))))
+        return;
+    vec2 uv = (vec2(pos) + 0.5) / outputSize;
+    imageStore(dst, ivec2(pos), GsrSample(uv));
+}
