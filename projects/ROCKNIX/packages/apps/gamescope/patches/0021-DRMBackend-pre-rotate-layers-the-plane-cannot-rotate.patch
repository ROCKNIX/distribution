+		// Where the panel is rotated, the plane rotates a client layer, or a blit rotates it into a
+		// panel-oriented copy when the plane can't: the overlays first, so the base keeps a pipe
+		// that rotates, then every layer. The blits only run once the display takes the layout.
+		// bProbe only asks the liftoff cache whether some way is left to try.
+		int PrepareScanout( FrameInfo_t *pFrameInfo, bool bAsync, bool bProbe = false )
+		{
+			const int nLayers = pFrameInfo->layers.count();
+			const std::shared_ptr<gamescope::BackendBlob> pPendingModeId = g_DRM.pending.mode_id;
+			uint32_t uTried = ~0u;
+			int ret = -EINVAL;
+
+			for ( int nFirstBlit : { nLayers, 1, 0 } )
+			{
+				uint32_t uBlits = 0;
+				bool bValid = true;
+				for ( int i = 0; i < nLayers; i++ )
+				{
+					FrameInfo_t::Layer_t &layer = pFrameInfo->layers.get( i );
+					layer.pBlitRotatedTex = nullptr;
+					if ( layer.bPreRotated )
+						continue;
+					if ( i < nFirstBlit )
+					{
+						// left to the plane, which can't rotate at all here
+						bValid &= !g_uPreRotation || !g_uOutputRotation;
+						continue;
+					}
+					layer.pBlitRotatedTex = g_uPreRotation ? vulkan_blit_rotate_target( layer.tex, g_uPreRotation, i, false ) : nullptr;
+					bValid &= layer.pBlitRotatedTex != nullptr;
+					uBlits |= 1u << i;
+				}
+				if ( !bValid || uBlits == uTried )
+					continue;
+				uTried = uBlits;
+
+				if ( bProbe )
+				{
+					if ( !is_liftoff_caching_enabled() || g_LiftoffStateCache.count( FrameInfoToLiftoffStateCacheEntry( &g_DRM, pFrameInfo ) ) == 0 )
+						return 0;
+					continue;
+				}
+
+				// a refused attempt rolls the pending mode back
+				g_DRM.pending.mode_id = pPendingModeId;
+				ret = drm_prepare( &g_DRM, bAsync, pFrameInfo );
+				if ( ret == 0 )
+				{
+					for ( int i = 0; i < nLayers; i++ )
+					{
+						FrameInfo_t::Layer_t &layer = pFrameInfo->layers.get( i );
+						if ( layer.pBlitRotatedTex )
+							vulkan_blit_rotate( layer.tex, vulkan_blit_rotate_target( layer.tex, g_uPreRotation, i, true ), g_uPreRotation );
+					}
+					return 0;
+				}
+				if ( ret == -EACCES )
+					break;
+			}
+
+			for ( int i = 0; i < nLayers; i++ )
+				pFrameInfo->layers.get( i ).pBlitRotatedTex = nullptr;
+			return ret;
+		}
