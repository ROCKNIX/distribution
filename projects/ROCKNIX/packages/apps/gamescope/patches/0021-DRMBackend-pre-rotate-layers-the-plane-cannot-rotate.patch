+// Scanout images, per layer slot, to rotate a client buffer into with a blit for a plane that
+// can't rotate it. bAdvance false peeks at the next one without taking it.
+gamescope::Rc<CVulkanTexture> vulkan_blit_rotate_target( gamescope::Rc<CVulkanTexture> pTex, uint32_t uRotation, uint32_t uSlot, bool bAdvance )
+{
+	if ( !g_bCompositeBlit || !g_device.supportsRotatedCopy() || !pTex || pTex->isYcbcr() )
+		return nullptr;
+
+	const uint32_t uDrmFormat = pTex->drmFormat();
+	if ( !GetBackend()->SupportsFormat( uDrmFormat ) )
+		return nullptr;
+
+	uint32_t uWidth = pTex->width();
+	uint32_t uHeight = pTex->height();
+	if ( uRotation & 1u )
+		std::swap( uWidth, uHeight );
+
+	struct BlitRotateTargets_t
+	{
+		gamescope::OwningRc<CVulkanTexture> pImages[ 3 ];
+		uint32_t uNext = 0;
+	};
+	static BlitRotateTargets_t s_Targets[ k_nMaxLayers ];
+	if ( uSlot >= k_nMaxLayers )
+		return nullptr;
+
+	auto &targets = s_Targets[ uSlot ];
+	auto &pFirst = targets.pImages[ 0 ];
+	if ( !pFirst || pFirst->width() != uWidth || pFirst->height() != uHeight || pFirst->drmFormat() != uDrmFormat )
+	{
+		CVulkanTexture::createFlags flags;
+		flags.bFlippable = true;
+		flags.bTransferDst = true;
+		for ( auto &pImage : targets.pImages )
+		{
+			pImage = new CVulkanTexture();
+			if ( !pImage->BInit( uWidth, uHeight, 1u, uDrmFormat, flags ) )
+			{
+				vk_log.errorf( "failed to allocate a %ux%u blit rotation target", uWidth, uHeight );
+				for ( auto &pClear : targets.pImages )
+					pClear = nullptr;
+				return nullptr;
+			}
+		}
+	}
+
+	gamescope::Rc<CVulkanTexture> pImage = targets.pImages[ targets.uNext ].get();
+	if ( bAdvance )
+		targets.uNext = ( targets.uNext + 1 ) % 3;
+	return pImage;
+}
+
+void vulkan_blit_rotate( gamescope::Rc<CVulkanTexture> pSrc, gamescope::Rc<CVulkanTexture> pDst, uint32_t uRotation )
+{
+	auto cmdBuffer = g_device.commandBuffer();
+	cmdBuffer->blitImageRotated( pSrc, pDst, uRotation );
+	g_device.wait( g_device.submit( std::move( cmdBuffer ) ), true );
+}
