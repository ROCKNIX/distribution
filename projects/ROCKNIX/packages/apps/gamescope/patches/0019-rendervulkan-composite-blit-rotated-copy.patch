 	//fprintf(stderr, "pDMA->width: %d pDMA->height: %d pDMA->format: 0x%x pDMA->modifier: 0x%lx pDMA->n_planes: %d\n",
 	//	pDMA->width, pDMA->height, pDMA->format, pDMA->modifier, pDMA->n_planes);
@@ -4360,6 +4418,71 @@ extern uint32_t g_reshade_technique_idx;
 
 ReshadeEffectPipeline *g_pLastReshadeEffect = nullptr;
 
+// one opaque, unscaled SDR layer that covers the output is a plain copy on the
+// transfer engine, much cheaper than the composite shader with its per-pixel
+// colour-management LUTs. Skipping colour management matches what direct
+// scanout of that layer does.
+static bool vulkan_composite_blit( CVulkanCmdBuffer *cmdBuffer, const struct FrameInfo_t *frameInfo, gamescope::Rc<CVulkanTexture> compositeImage, uint32_t uOutputRotation, bool bOverride )
+{
+	if ( !g_bCompositeBlit )
+		return false;
+
+	// log each reason once
+	static uint32_t s_uLoggedReasons = 0;
+	auto decline = [&]( uint32_t uBit, const char *pszReason, auto... args ) -> bool
+	{
+		if ( !( s_uLoggedReasons & ( 1u << uBit ) ) )
+		{
+			s_uLoggedReasons |= 1u << uBit;
+			vk_log.infof( pszReason, args... );
+		}
+		return false;
+	};
+
+	if ( bOverride )
+		return decline( 0, "composite-blit: not for output overrides (screenshots, upscale cache)" );
+	if ( !g_device.supportsRotatedCopy() )
+		return decline( 1, "composite-blit: driver lacks VK_QCOM_rotated_copy_commands" );
+	if ( frameInfo->layers.count() != 1 )
+		return decline( 2, "composite-blit: %d layers, need exactly 1", frameInfo->layers.count() );
+	if ( frameInfo->useFSRLayer0 || frameInfo->useNISLayer0 || frameInfo->useGSRLayer0 || frameInfo->blurLayer0 || !g_reshade_effect.empty() )
+		return decline( 3, "composite-blit: layer 0 uses a scaler, blur or reshade" );
+
+	const FrameInfo_t::Layer_t *layer = &frameInfo->layers.get( 0 );
+	if ( !layer->tex )
+		return decline( 4, "composite-blit: layer 0 has no texture" );
+	if ( layer->isYcbcr() )
+		return decline( 5, "composite-blit: layer 0 is YCbCr" );
+	if ( layer->ctm != nullptr )
+		return decline( 6, "composite-blit: layer 0 has a CTM" );
+	if ( layer->opacity != 1.0f )
+		return decline( 7, "composite-blit: layer 0 opacity %f", layer->opacity );
+	// LINEAR is a raw view of sRGB-encoded content (colorimetry.h), direct scanout copies it raw too
+	if ( layer->colorspace != GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB && layer->colorspace != GAMESCOPE_APP_TEXTURE_COLORSPACE_LINEAR &&
+	     layer->colorspace != GAMESCOPE_APP_TEXTURE_COLORSPACE_PASSTHRU )
+		return decline( 8, "composite-blit: layer 0 colorspace %u is not sRGB/linear-view/passthrough", (uint32_t)layer->colorspace );
+	if ( !close_enough( layer->scale.x, 1.0f ) || !close_enough( layer->scale.y, 1.0f ) )
+		return decline( 9, "composite-blit: layer 0 scale %f x %f", layer->scale.x, layer->scale.y );
+	if ( layer->offset.x != 0.0f || layer->offset.y != 0.0f )
+		return decline( 10, "composite-blit: layer 0 offset %f, %f", layer->offset.x, layer->offset.y );
+
+	const bool bTransposed = ( uOutputRotation & 1u ) != 0;
+	const uint32_t uSrcWidth = layer->tex->width();
+	const uint32_t uSrcHeight = layer->tex->height();
+	if ( ( bTransposed ? uSrcHeight : uSrcWidth ) != compositeImage->width() || ( bTransposed ? uSrcWidth : uSrcHeight ) != compositeImage->height() )
+		return decline( 11, "composite-blit: layer 0 is %ux%u, output %ux%u, rotation %u", uSrcWidth, uSrcHeight, compositeImage->width(), compositeImage->height(), uOutputRotation );
+
+	static bool s_bLogged = false;
+	if ( !s_bLogged )
+	{
+		vk_log.infof( "composite-blit: %ux%u -> %ux%u, rotation %u, transfer blit instead of the composite shader", uSrcWidth, uSrcHeight, compositeImage->width(), compositeImage->height(), uOutputRotation );
+		s_bLogged = true;
+	}
+
+	cmdBuffer->blitImageRotated( layer->tex, compositeImage, uOutputRotation );
+	return true;
+}
