 }
 
+// rotation is g_uOutputRotation, 1 is ROTATE_270 and 3 is ROTATE_90 to match unrotateOutputCoord
+void CVulkanCmdBuffer::blitImageRotated(gamescope::Rc<CVulkanTexture> src, gamescope::Rc<CVulkanTexture> dst, uint32_t rotation)
+{
+	prepareSrcImage(src.get());
+	prepareDestImage(dst.get());
+	insertBarrier();
+
+	VkSurfaceTransformFlagBitsKHR transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+	switch (rotation)
+	{
+		case 1u: transform = VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR; break;
+		case 2u: transform = VK_SURFACE_TRANSFORM_ROTATE_180_BIT_KHR; break;
+		case 3u: transform = VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR; break;
+		default: break;
+	}
+	const VkCopyCommandTransformInfoQCOM transformInfo = {
+		.sType = VK_STRUCTURE_TYPE_COPY_COMMAND_TRANSFORM_INFO_QCOM,
+		.transform = transform,
+	};
+	const VkImageBlit2 region = {
+		.sType = VK_STRUCTURE_TYPE_IMAGE_BLIT_2,
+		.pNext = transform != VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR ? &transformInfo : nullptr,
+		.srcSubresource = {
+			.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+			.layerCount = 1,
+		},
+		.srcOffsets = { { 0, 0, 0 }, { (int32_t)src->width(), (int32_t)src->height(), 1 } },
+		.dstSubresource = {
+			.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+			.layerCount = 1,
+		},
+		.dstOffsets = { { 0, 0, 0 }, { (int32_t)dst->width(), (int32_t)dst->height(), 1 } },
+	};
+	const VkBlitImageInfo2 blitInfo = {
+		.sType = VK_STRUCTURE_TYPE_BLIT_IMAGE_INFO_2,
+		.srcImage = src->vkImage(),
+		.srcImageLayout = VK_IMAGE_LAYOUT_GENERAL,
+		.dstImage = dst->vkImage(),
+		.dstImageLayout = VK_IMAGE_LAYOUT_GENERAL,
+		.regionCount = 1,
+		.pRegions = &region,
+		.filter = VK_FILTER_NEAREST,
+	};
+	m_device->vk.CmdBlitImage2(m_cmdBuffer, &blitInfo);
+
+	markDirty(dst.get());
+	m_textureRefs.emplace_back(std::move(src));
+	m_textureRefs.emplace_back(std::move(dst));
+}
