@@ -637,6 +640,11 @@ bool CVulkanDevice::createDevice()
 
 	enabledExtensions.push_back( VK_KHR_EXTERNAL_SEMAPHORE_FD_EXTENSION_NAME );
 
+	// Needed to export a composite completion fence as a sync_file for the RGA acquire
