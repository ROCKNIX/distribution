From: John Williams <porschemad911@gmail.com>
Date: Wed, 16 Sep 2026 22:13:07 +1000
Subject: [PATCH 1/2] SM6450 GPU

ROCKNIX SM6450: taken from patches/SM4450; the GPU devfreq node is the same (3d00000.gpu),
the hwmon match is gpu0_thermal because sm6450 exposes two GPU zones (gpu0/gpu1-thermal).

---
 src/gpu_fdinfo.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index c4d63f5..462f334 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -192,7 +192,7 @@ void GPU_fdinfo::find_hwmon_sensors()
     std::string hwmon;
 
     if (module == "msm_drm" || module == "msm_dpu" )
-        hwmon = find_hwmon_sensor_dir("gpu");
+        hwmon = find_hwmon_sensor_dir("gpu0_thermal");
     else if (module == "panfrost" || module == "panthor")
         hwmon = find_hwmon_sensor_dir("gpu_thermal");
     else
@@ -655,7 +655,7 @@ float GPU_fdinfo::amdgpu_helper_get_proc_vram() {
 }
 
 void GPU_fdinfo::init_kgsl() {
-    const std::string sys_path = "/sys/class/kgsl/kgsl-3d0";
+    const std::string sys_path = "/sys/class/devfreq/3d00000.gpu";
 
     try {
         if (!fs::exists(sys_path)) {
