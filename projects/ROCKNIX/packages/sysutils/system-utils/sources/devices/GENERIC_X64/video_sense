# video_sense for GENERIC_X64 - No-op version for VMs/x86_64
# HDMI detection via GPIO is not applicable to x86_64/VM environments

. /etc/profile

# For x86_64/VM environments, we don't need hardware HDMI detection
# Just sleep indefinitely to satisfy systemd service requirements
# Audio switching can be handled by desktop environment or manual configuration

log $0 "video_sense: GENERIC_X64 no-op version running"

# Keep the service alive but do nothing
while true; do
    sleep 3600  # Sleep for 1 hour intervals
done
