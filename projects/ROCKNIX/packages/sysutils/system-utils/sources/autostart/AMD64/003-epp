. /etc/profile.d/001-functions

### Only amd-pstate exposes EPP here; intel_pstate runs passive.
case $(cpu_vendor) in
  AuthenticAMD)
    tocon "Configuring CPU energy preference..."
    /usr/bin/set_epp boot
  ;;
esac
