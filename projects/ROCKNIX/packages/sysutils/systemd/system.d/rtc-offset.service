[Unit]
Description=Clock from an RTC that can't be set
DefaultDependencies=no
RequiresMountsFor=/storage
Conflicts=shutdown.target
Before=sysinit.target time-set.target systemd-timesyncd.service shutdown.target
Wants=time-set.target
ConditionPathExists=/sys/class/rtc/rtc0/since_epoch

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/rtc-offset restore
ExecStop=/usr/sbin/rtc-offset save

[Install]
WantedBy=sysinit.target
