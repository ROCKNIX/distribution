[Unit]
Description=Base Network Configuration
DefaultDependencies=no
After=local-fs.target systemd-tmpfiles-setup.service userconfig.service
# Before hostnamed and NetworkManager (fork #50). /etc/hostname is a symlink
# to /proc/sys/kernel/hostname, so systemd-hostnamed takes whatever the
# kernel is called when it starts as the "static" name and re-applies it
# on every later hostname1 call. NetworkManager activates hostnamed over
# D-Bus at ~2.3 s; this unit wrote the name at ~3.2 s; the device then
# spent the boot as ROCKNIX (GENERIC_X64 guest, 2026-09-13, one boot in
# two). Ordered this way, hostnamed starts after the name is written and
# reads the right one.
Before=systemd-hostnamed.service NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/network-base-setup
RemainAfterExit=yes

[Install]
WantedBy=network.target
