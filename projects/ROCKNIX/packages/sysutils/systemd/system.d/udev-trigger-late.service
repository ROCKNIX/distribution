[Unit]
Description=Coldplug kernel objects without boot-time udev rules
DefaultDependencies=no
After=systemd-udev-trigger.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
Slice=background.slice
EnvironmentFile=/usr/lib/udev/coldplug-late.conf
ExecStart=-udevadm trigger --type=devices --action=add $LATE_FILTER
ExecStart=-udevadm trigger --type=subsystems --action=add
