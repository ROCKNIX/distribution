--- a/src/basic/time-util.c
+++ b/src/basic/time-util.c
@@ -1692,8 +1692,22 @@
                 return r; /* Return EINVAL if not a symlink */
 
         const char *e = PATH_STARTSWITH_SET(t, "/usr/share/zoneinfo/", "../usr/share/zoneinfo/");
-        if (!e)
-                return -EINVAL;
+        if (!e) {
+                /* Our /etc/localtime points at a symlink under /var/run, so resolve the
+                 * whole chain before giving up. */
+                char resolved[PATH_MAX + 1];
+
+                if (realpath(etc_localtime(), resolved)) {
+                        free(t);
+                        t = strdup(resolved);
+                        if (!t)
+                                return -ENOMEM;
+
+                        e = PATH_STARTSWITH_SET(t, "/usr/share/zoneinfo/", "../usr/share/zoneinfo/");
+                }
+                if (!e)
+                        return -EINVAL;
+        }
         if (!timezone_is_valid(e, LOG_DEBUG))
                 return -EINVAL;
 
