CACHE=/storage/.cache/hwdb.bin
KEY=$( (stat -c "%n %s %Y" /usr/lib/udev/hwdb.d/*; cat /etc/udev/hwdb.d/*.hwdb) 2>/dev/null | md5sum)

if [ -s "${CACHE}" ] && [ "$(cat ${CACHE}.key 2>/dev/null)" = "${KEY}" ]; then
  ln -sf ${CACHE} /run/hwdb.bin
  exit 0
fi

rm -f /run/hwdb.bin ${CACHE}.key
systemd-hwdb update || exit
mv -f /run/hwdb.bin ${CACHE} && ln -sf ${CACHE} /run/hwdb.bin && echo "${KEY}" > ${CACHE}.key
