[Unit]
Description=AC/Battery Performance Service
# The first thing the loop does is read led.color from system.cfg, and on a
# first boot that file is still being seeded from /usr/config by
# userconfig-setup: pulled in by sysinit.target, but with no Before= on it,
# so this service started 0.1 s after it and 1.1 s before it finished (VM,
# 2026-09-11). Two "awk: system.cfg: No such file" lines in the journal of
# every fresh device's first boot (#121).
After=userconfig.service
Before=rocknix.target
StartLimitIntervalSec=0

[Service]
Environment=HOME=/storage
EnvironmentFile=/etc/profile
ExecStart=/usr/bin/powerstate
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
