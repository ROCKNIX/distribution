[Unit]
Description=Persistent Log Storage
# /var is a tmpfs, so without this mount every log on the device -- the
# journal, EmulationStation's es_log.txt, cloud_sync.log, the kernel's own
# messages -- is gone the moment the power is cut. That is precisely when it
# is wanted: the RG SP froze during a startup sync and the forced power-off
# that followed erased every line that could have said why (fork #102, #104).
# Upstream ships this unit switched off, as a debugging aid; here it is on by
# default (D-SYS-001). A device where card wear or space matters more than
# evidence opts out by creating /storage/.cache/volatile-log.
# systemd-journal-flush.service pulls this in through RequiresMountsFor, so
# the journal lands on /storage before anything else writes to it.
RequiresMountsFor=/var /storage
Requires=storage-log.service
After=storage-log.service
ConditionKernelCommandLine=!installer
ConditionPathExists=!/storage/.cache/volatile-log

[Mount]
What=/storage/.cache/log
Where=/var/log
Options=bind
LazyUnmount=yes
