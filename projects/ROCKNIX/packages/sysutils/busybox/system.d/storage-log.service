[Unit]
Description=Create Persistent Log Directory on /storage
DefaultDependencies=no
RequiresMountsFor=/storage

[Service]
Type=oneshot
RemainAfterExit=yes
# journal/ is what turns journald's Storage=auto persistent; pstore/ is where
# systemd-pstore archives a crash's kernel log (a symlink from
# /var/lib/systemd/pstore points here, see tmpfiles z_01_rocknix.conf).
ExecStart=/bin/mkdir -p /storage/.cache/log/journal /storage/.cache/log/pstore
