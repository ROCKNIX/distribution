# RTL8733BU combo chip: restore BT after resume only if it was enabled.
# Note: BT connections (e.g. headphones) are dropped during sleep when the
# chip powers off; user may need to reconnect or the stack may auto-reconnect.

. /etc/profile.d/001-functions

if [ "$(get_setting controllers.bluetooth.enabled)" = "1" ]; then
  rfkill unblock bluetooth 2>/dev/null
  modprobe btusb 2>/dev/null
fi
