# RTL8733BU combo chip: unload btusb and block BT rfkill before suspend
# so the chip can fully power down (if WiFi is also blocked by sleep.sh).

if lsmod | grep -q btusb; then
  modprobe -r btusb 2>/dev/null
fi
rfkill block bluetooth 2>/dev/null
