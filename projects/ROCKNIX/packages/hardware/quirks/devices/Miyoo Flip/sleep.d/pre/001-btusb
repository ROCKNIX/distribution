# RTL8733BU is a WiFi+BT combo chip on a single USB device.
# btusb holds a runtime PM reference that prevents the USB device
# from suspending, keeping the 5V boost converter and chip powered.
# Unload btusb before suspend so the USB device can fully power down.

if lsmod | grep -q btusb; then
  modprobe -r btusb 2>/dev/null
fi
