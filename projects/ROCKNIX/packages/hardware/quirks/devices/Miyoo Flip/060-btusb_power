# RTL8733BU WiFi+BT combo: btusb holds a runtime PM reference that keeps
# the entire USB device (and 5V boost converter) powered even when BT is
# not in use. Unload btusb at boot if BT is disabled; wrap the bluetooth
# service so btusb is loaded/unloaded with it.

. /etc/profile.d/001-functions

BT_ENABLED=$(get_setting controllers.bluetooth.enabled)

if [ "${BT_ENABLED}" != "1" ]; then
  modprobe -r btusb 2>/dev/null
fi

# Override systemd bluetooth service to manage btusb module lifecycle.
# When bluetooth starts -> load btusb first.
# When bluetooth stops -> unload btusb after.
OVERRIDE_DIR="/etc/systemd/system/bluetooth.service.d"
OVERRIDE_FILE="${OVERRIDE_DIR}/btusb-miyoo.conf"
if [ ! -f "${OVERRIDE_FILE}" ]; then
  mkdir -p "${OVERRIDE_DIR}"
  cat <<'EOF' >"${OVERRIDE_FILE}"
[Service]
ExecStartPre=/usr/sbin/modprobe btusb
ExecStopPost=-/usr/sbin/modprobe -r btusb
EOF
  systemctl daemon-reload
fi
