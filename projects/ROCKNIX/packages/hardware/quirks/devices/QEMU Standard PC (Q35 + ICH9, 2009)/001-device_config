# QEMU Q35 Virtual Machine Configuration
cat <<EOF >/storage/.config/profile.d/001-device_config
# Device Features
DEVICE_HAS_TOUCHSCREEN="false"
DEVICE_FAKE_JACKSENSE="false"
DEVICE_BATTERY_LED_STATUS="false"
DEVICE_PWR_LED_CONTROL="false"
DEVICE_SLEEP_DPMS="true"
DEVICE_HAS_HDMI="true"

# Virtual environment optimizations
DEVICE_IS_VIRTUAL="true"
DEVICE_VIRTUALIZATION_PLATFORM="QEMU"

# Default display configuration for virtual machine
DEVICE_DEFAULT_DISPLAY="HDMI"
DEVICE_DEFAULT_RESOLUTION="1920x1080"

# Temperature monitoring (virtual thermal zones)
DEVICE_TEMP_SENSOR="/sys/devices/virtual/thermal/thermal_zone*/temp"

# No hardware-specific power management
DEVICE_BASE_TDP=""
DEVICE_TDP_RANGE=""
EOF
