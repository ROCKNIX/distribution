# Anything that opens the controller's hidraw (SDL, Dolphin, ...) makes hid-steam
# unregister its gamepad for Steam. Remove the nodes so everything uses evdev.
mkdir -p /run/udev/rules.d
cat <<EOF2 >/run/udev/rules.d/70-steamdeck-hidraw.rules
SUBSYSTEM=="hidraw", KERNELS=="0003:28DE:1205.*", DRIVERS=="hid-steam", RUN+="/bin/rm -f /dev/%k"
EOF2
udevadm control --reload
udevadm trigger --action=add --subsystem-match=hidraw
