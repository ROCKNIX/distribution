cat <<EOF >/storage/.config/profile.d/060-sdl_hidapi
# SDL's Steam Deck HIDAPI driver keeps opening the controller's hidraw, and
# hid-steam drops and re-adds its gamepad every time; use the evdev device.
export SDL_JOYSTICK_HIDAPI_STEAMDECK=0
EOF

# ES falls back to matching by name, so drop configs saved for the HIDAPI
# device (GUID driver signature 68) and let SDL's evdev mapping apply.
ES_INPUT="/storage/.emulationstation/es_input.cfg"
HIDAPI_GUID='deviceGUID="[0-9a-f]\{8\}de2800000512[0-9a-f]\{8\}68[0-9a-f]\{2\}"'
if grep -q "${HIDAPI_GUID}" "${ES_INPUT}" 2>/dev/null; then
  sed -i "/${HIDAPI_GUID}/,/<\/inputConfig>/d" "${ES_INPUT}"
fi
