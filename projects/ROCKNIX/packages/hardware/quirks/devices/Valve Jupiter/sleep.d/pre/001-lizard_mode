# Resume resets the controller over USB, which turns lizard mode back on, and hid-steam
# has no resume hook. Writing the parameter re-sends the setting. Start the watcher before
# suspending so it runs as soon as userspace thaws, rather than after the other resume
# hooks (Wi-Fi recovery alone can take ~15 s), and repeat until the controller is back up.
systemd-run --no-block --collect --description="Steam Deck lizard mode after resume" sh -c '
  n=$(cat /sys/power/suspend_stats/success)
  for i in $(seq 1 600); do
    [ "$(cat /sys/power/suspend_stats/success)" != "${n}" ] && break
    sleep 0.1
  done
  for i in $(seq 1 40); do
    echo 0 >/sys/module/hid_steam/parameters/lizard_mode
    sleep 0.25
  done'
