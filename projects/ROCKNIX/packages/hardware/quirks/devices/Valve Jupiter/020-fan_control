# Valve's steamdeck-hwmon (steamdeck-platform) exposes the EC fan: fan1_input and
# fan1_target in RPM, where a target of 0 leaves the fan to the EC.
modprobe steamdeck 2>/dev/null
for i in $(seq 1 20); do
  for h in /sys/class/hwmon/hwmon*; do
    [ "$(cat ${h}/name 2>/dev/null)" = "steamdeck_hwmon" ] && FAN=${h}
  done
  [ -n "${FAN}" ] && break
  sleep 0.25
done
[ -n "${FAN}" ] || exit 0

cat <<EOF2 >/storage/.config/profile.d/020-fan_control
DEVICE_HAS_FAN="true"
DEVICE_FAN_TARGET="${FAN}/fan1_target"
DEVICE_FAN_INPUT="${FAN}/fan1_input"
EOF2
