# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

# Restore saved display settings on the DSI panel. Brightness
# reaches the sgm37604a backlight through the DRM panel link,
# the connector is auto-detected by paneladj.
for PROPERTY in brightness contrast saturation hue
do
  MYVAL=$(get_setting display.${PROPERTY})
  if [ -n "${MYVAL}" ]
  then
    paneladj ${PROPERTY} ${MYVAL}
  fi
done
