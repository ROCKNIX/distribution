# The touchscreen is the second output, which is empty outside dual-screen apps.
# A tap there takes keyboard focus from EmulationStation and SDL then drops all
# pad input, so let ES read the pad without focus.
ES_CONF="/storage/.config/emulationstation/es_settings.cfg"
if [ ! -f "${ES_CONF}" ]; then
  mkdir -p "${ES_CONF%/*}"
  cp /usr/config/emulationstation/es_settings.cfg "${ES_CONF}"
fi
if ! grep -q 'name="BackgroundJoystickInput"' "${ES_CONF}"; then
  sed -i 's|</config>|\t<bool name="BackgroundJoystickInput" value="true" />\n</config>|' "${ES_CONF}"
fi
