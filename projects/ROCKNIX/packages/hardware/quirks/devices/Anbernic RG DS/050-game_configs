#Set drastic-sa config for RG DS
if [ ! -d "/storage/.config/drastic" ]; then
    mkdir -p "/storage/.config/drastic"
    cp -r "/usr/config/drastic" "/storage/.config/"
fi
if [ -f "/storage/.config/drastic/config/drastic.cfg.rgds" ]; then
    mv /storage/.config/drastic/config/drastic.cfg.rgds /storage/.config/drastic/config/drastic.cfg
fi

#Set dsperate-sa config
if [ ! -d "/storage/.config/dsperate" ]; then
    mkdir -p "/storage/.config/dsperate"
    cp -r "/usr/config/dsperate" "/storage/.config/"
fi
if [ -f "/storage/.config/dsperate/dsperate.ini.rgds" ]; then
  mv /storage/.config/dsperate/dsperate.ini.rgds /storage/.config/dsperate/dsperate.ini
fi
