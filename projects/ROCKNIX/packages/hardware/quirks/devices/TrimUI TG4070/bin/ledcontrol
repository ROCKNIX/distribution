. /etc/profile.d/001-functions

LED="/sys/class/leds/rgb:status"
MAX=$(cat ${LED}/max_brightness)

# TODO: ES "LED BRIGHTNESS": max / mid / min, applied to the power button LED 
case $(get_setting led.brightness) in
  mid) MAX=$(( MAX / 2 )) ;;
  min) MAX=$(( MAX / 8 )) ;;
esac

function led_set() {
  echo ${1} ${2} ${3} >${LED}/multi_intensity
  echo ${4} >${LED}/brightness
}

function led_off() {
  led_set 0 0 0 0
}

case ${1} in
  red)    led_set 255 0 0 ${MAX};     set_setting led.color ${1} ;;
  green)  led_set 0 255 0 ${MAX};     set_setting led.color ${1} ;;
  blue)   led_set 0 0 255 ${MAX};     set_setting led.color ${1} ;;
  white)  led_set 255 255 255 ${MAX}; set_setting led.color ${1} ;;
  orange) led_set 255 20 0 ${MAX};    set_setting led.color ${1} ;;
  yellow) led_set 255 125 0 ${MAX};   set_setting led.color ${1} ;;
  purple) led_set 255 0 255 ${MAX};   set_setting led.color ${1} ;;
  off)
    led_off
    set_setting led.color ${1}
  ;;
  battery)
    led_off
    set_setting led.color ${1}
    systemctl restart batteryledstatus.service
  ;;
  brightness)
    set_setting led.brightness ${2}
    exec ${0} $(get_setting led.color)
  ;;
  poweroff)
    led_off
    for group in left right bar-left bar-right select start trigger-left trigger-right; do
      echo 0 >/sys/class/leds/trimui:rgb:${group}/brightness
    done
  ;;
  list)
cat <<EOT
off
battery
red
green
blue
white
orange
yellow
purple
EOT
  ;;
esac
