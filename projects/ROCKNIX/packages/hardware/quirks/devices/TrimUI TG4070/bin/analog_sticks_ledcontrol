# MCU LEDs: Left/Right division

LED_PATH="/sys/class/leds"

function led_set() {
  echo ${2} ${3} ${4} >${LED_PATH}/trimui:rgb:${1}/multi_intensity
  echo ${5} >${LED_PATH}/trimui:rgb:${1}/brightness
}

if [ $# -ne 7 ]; then
  echo "Usage: $0 <brightness> <right_red> <right_green> <right_blue> <left_red> <left_green> <left_blue>"
  echo "Example: $0 255 255 0 0 0 0 255"
  exit 1
fi

BRIGHTNESS=$1
RIGHT_RED=$2
RIGHT_GREEN=$3
RIGHT_BLUE=$4
LEFT_RED=$5
LEFT_GREEN=$6
LEFT_BLUE=$7

for group in left select bar-left trigger-left; do
  led_set ${group} ${LEFT_RED} ${LEFT_GREEN} ${LEFT_BLUE} ${BRIGHTNESS}
done
for group in right start bar-right trigger-right; do
  led_set ${group} ${RIGHT_RED} ${RIGHT_GREEN} ${RIGHT_BLUE} ${BRIGHTNESS}
done
