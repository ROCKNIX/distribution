. /etc/profile

PRE_SLEEP_LED_STATE=$(get_setting "led.color")
if [ ! -n "${PRE_SLEEP_LED_STATE}" ]; then
  PRE_SLEEP_LED_STATE="battery"
  set_setting "led.color" "battery"
fi
set_setting sleep.led.color "${PRE_SLEEP_LED_STATE}"
/usr/bin/ledcontrol "off"
