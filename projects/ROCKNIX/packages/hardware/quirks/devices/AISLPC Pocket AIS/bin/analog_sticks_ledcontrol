# The MCU only knows fixed colors, so each channel is treated as on or off
# and both sticks follow the right stick color.

if [ $# -ne 7 ]; then
  echo "Usage: $0 <brightness> <right_red> <right_green> <right_blue> <left_red> <left_green> <left_blue>"
  exit 1
fi

BRIGHTNESS=$1
RED=$(( $2 > 127 ))
GREEN=$(( $3 > 127 ))
BLUE=$(( $4 > 127 ))

case "${RED}${GREEN}${BLUE}" in
  010) MODE=1 ;;
  001) MODE=2 ;;
  100) MODE=3 ;;
  011) MODE=4 ;;
  110) MODE=5 ;;
  101) MODE=6 ;;
  111) MODE=7 ;;
  *)   MODE=9 ;;
esac
[ "${BRIGHTNESS}" -eq 0 ] && MODE=9

"$(dirname "$0")/mcu_led" $(( 51 - BRIGHTNESS * 3 / 255 )) ${MODE}
