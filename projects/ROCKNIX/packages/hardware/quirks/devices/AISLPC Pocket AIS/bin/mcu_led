# The stick LED MCU takes single byte commands, stock repeats each one 6 times.

MCU_TTY="/dev/ttyS1"

stty -F ${MCU_TTY} 9600 raw -echo
for CMD in "$@"; do
  for i in 1 2 3 4 5 6; do
    printf "\\$(printf '%03o' ${CMD})" >${MCU_TTY}
    sleep 0.003
  done
done
