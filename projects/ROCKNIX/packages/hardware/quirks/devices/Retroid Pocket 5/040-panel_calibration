. /etc/profile.d/001-functions

PANEL=/sys/bus/mipi-dsi/devices/ae94000.dsi.0
[ -e ${PANEL}/frame_len_60 ] || exit 0

cat <<EOF >/storage/.config/profile.d/040-panel_calibration
DEVICE_PANEL_CALIBRATION="true"
EOF

for RATE in 120 60; do
  VALUE=$(get_setting display.frame_len_${RATE})
  [ -n "${VALUE}" ] && echo ${VALUE} >${PANEL}/frame_len_${RATE}
done
