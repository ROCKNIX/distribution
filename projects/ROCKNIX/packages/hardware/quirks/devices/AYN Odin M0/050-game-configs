#Disable retroarch microphone, set default audio driver to pulse and joypad driver to udev
sed -i '/^microphone_enable =/c\microphone_enable = "false"' /storage/.config/retroarch/retroarch.cfg
sed -i '/^audio_driver =/c\audio_driver = "pulse"' /storage/.config/retroarch/retroarch.cfg
sed -i '/^input_joypad_driver =/c\input_joypad_driver = "udev"' /storage/.config/retroarch/retroarch.cfg
