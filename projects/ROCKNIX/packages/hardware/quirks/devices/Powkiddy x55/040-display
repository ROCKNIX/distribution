# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

# Legacy BSP connector props (brightness/contrast/saturation/hue) are not
# exposed on mainline Rockchip DRM. System-wide calibration is handled by
# x55-panelcalib.service via CRTC GAMMA_LUT / wlr-gamma-control.
#
# Optional overrides (get_setting / set_setting):
#   display.calib.enabled=1
#   display.calib.target_gamma=2.50
#   display.calib.monitor_gamma=1.70
#   display.calib.contrast=1.10
#   display.calib.black_level=-0.15
#   display.calib.bright_boost=0.0
#   display.calib.red=1.05
#   display.calib.green=1.0
#   display.calib.blue=0.95

if [ -z "$(get_setting display.calib.enabled)" ]
then
  set_setting display.calib.enabled 1
fi
