# System-wide panel calibration for Powkiddy X55 via wlr-gamma-control.
# Defaults match the ROCKNIX wiki Image Adjustment starting point (no saturation).

. /etc/profile.d/001-functions

SCRIPT="/usr/lib/autostart/quirks/sources/panelcalib.py"
if [ ! -f "${SCRIPT}" ]; then
  echo "panelcalib: missing ${SCRIPT}" >&2
  exit 1
fi

get_f() {
  local key="$1" default="$2" val
  val="$(get_setting "${key}" 2>/dev/null)"
  if [ -z "${val}" ]; then
    echo "${default}"
  else
    echo "${val}"
  fi
}

ENABLED="$(get_f display.calib.enabled 1)"
if [ "${ENABLED}" = "0" ]; then
  echo "panelcalib: disabled via display.calib.enabled=0"
  exit 0
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"
export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-1}"

exec python3 "${SCRIPT}" \
  --target-gamma "$(get_f display.calib.target_gamma 2.50)" \
  --monitor-gamma "$(get_f display.calib.monitor_gamma 1.70)" \
  --contrast "$(get_f display.calib.contrast 1.10)" \
  --black-level "$(get_f display.calib.black_level -0.15)" \
  --bright-boost "$(get_f display.calib.bright_boost 0.0)" \
  --red "$(get_f display.calib.red 1.05)" \
  --green "$(get_f display.calib.green 1.0)" \
  --blue "$(get_f display.calib.blue 0.95)" \
  "$@"
