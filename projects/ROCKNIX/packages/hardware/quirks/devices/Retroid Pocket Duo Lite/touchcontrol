. /etc/profile.d/001-functions

if [ "$(session_compositor)" = "kwin" ]; then
  mkdir -p /run/udev/rules.d/
  cat <<EOT >/run/udev/rules.d/99-touchscreen-calibration.rules
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Himax Touchscreen", ENV{WL_OUTPUT}="DSI-1"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="generic ft5x06 (a0)", ENV{WL_OUTPUT}="DP-1"
EOT
  udevadm control --reload
  udevadm trigger -s input
fi
