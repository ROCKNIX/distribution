# Simple script to watch the battery capacity and
# turn the power LED orange when it reaches 30%, red at 20%, and blinking red at 10%

. /etc/profile

LED="/sys/class/leds/rgb:status"

function bat_led() {
  echo "$1" > ${LED}/multi_intensity
  echo 255 > ${LED}/brightness
}

function bat_led_off() {
  echo 0 > ${LED}/brightness
}

PREV_BATCAP="null"
while true
  do
  BAT_LED_STATE=$(get_setting led.color)
  if [ ! ${BAT_LED_STATE} == "battery" ]; then
    break
  else
    CAP=$(cat /sys/class/power_supply/battery/capacity)
    STAT=$(cat /sys/class/power_supply/battery/status)
      if [ ${STAT} == "Discharging" ]; then
        if (( ${CAP} <= 10 ))
          then
            for ctr in $(seq 1 1 5)
          do
            bat_led "255 0 0"
            sleep .5
            bat_led_off
            sleep .5
          done
          PREV_BATCAP="null"
          continue
        elif (( ${CAP} <= 20 ))
        then
          BATCAP="D_RED"
          if [ ! ${BATCAP} = ${PREV_BATCAP} ]; then
            bat_led "255 0 0"
          fi
        elif (( ${CAP} <=  30 ))
        then
          BATCAP="D_ORANGE"
          if [ ! ${BATCAP} = ${PREV_BATCAP} ]; then
            bat_led "255 20 0"
          fi
        elif (( ${CAP} <=  40 ))
        then
          BATCAP="D_YELLOW"
          if [ ! ${BATCAP} = ${PREV_BATCAP} ]; then
            bat_led "255 125 0"
          fi
        else
          BATCAP="D_GREEN"
          if [ ! ${BATCAP} = ${PREV_BATCAP} ]; then
            bat_led "0 255 0"
          fi
        fi
      elif (( ${CAP} <= 94 ))
      then
        BATCAP="C_ORANGE"
        if [ ! ${BATCAP} = ${PREV_BATCAP} ]; then
          bat_led "255 20 0"
        fi
      elif (( ${CAP} >= 95 ))
      then
        BATCAP="C_GREEN"
        if [ ! ${BATCAP} = ${PREV_BATCAP} ]; then
          bat_led "0 255 0"
        fi
      fi
      PREV_BATCAP=${BATCAP}
      sleep 15
  fi
done
