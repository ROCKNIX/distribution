# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

LED="/sys/class/leds/rgb:status"

function led_off() {
  echo 0 > ${LED}/brightness
}

case ${1} in
  off)
    systemctl stop batteryledstatus.service
    led_off
    set_setting led.color ${1}
    ;;
  battery)
    led_off
    set_setting led.color ${1}
    systemctl restart batteryledstatus.service
    ;;
  poweroff)
    led_off
    ;;
  list)
cat <<EOT
off
battery
EOT
    ;;
esac
