if [ ! -d "/storage/.config/drastic" ]; then
    mkdir -p "/storage/.config/drastic"
    cp -r "/usr/config/drastic" "/storage/.config/"
fi
if [ -f "/storage/.config/drastic/config/drastic.cfg.duolite" ]; then
    mv /storage/.config/drastic/config/drastic.cfg.duolite /storage/.config/drastic/config/drastic.cfg
fi
