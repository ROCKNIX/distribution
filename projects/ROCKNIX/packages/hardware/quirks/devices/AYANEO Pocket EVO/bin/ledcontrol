# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

LED_PATH="/sys/class/leds"
RGB_CONTROL=
for RGB_CANDIDATE in /sys/bus/serial/drivers/ayaneo-serial-mcu/*/rgb; do
  if [ -r "${RGB_CANDIDATE}/abi_version" ]; then
    RGB_CONTROL=${RGB_CANDIDATE}
    break
  fi
done
RGB_GATE_LOCK="/run/ayaneo-pocket-evo-rgb-gate.lock"
POWER_FAKE_SUSPEND_FLAG="/var/run/power-fake-suspend-active.flag"
LID_CLOSED_FLAG="/var/run/lid-closed.flag"

fake_suspend_active() {
  [ -e "${POWER_FAKE_SUSPEND_FLAG}" ] || [ -e "${LID_CLOSED_FLAG}" ]
}

set_rgb_enabled() {
  [ -n "${RGB_CONTROL}" ] && [ -w "${RGB_CONTROL}/enabled" ] || return 0
  printf '%s\n' "${1}" >"${RGB_CONTROL}/enabled"
}

sync_rgb_enabled_to_fake_suspend_state() {
  exec 8>"${RGB_GATE_LOCK}" || return 1
  flock 8 || return 1

  RGB_GATE_ATTEMPT=0
  while [ "${RGB_GATE_ATTEMPT}" -lt 3 ]; do
    if fake_suspend_active; then
      RGB_ENABLED_DESIRED=0
    else
      RGB_ENABLED_DESIRED=1
    fi

    if set_rgb_enabled "${RGB_ENABLED_DESIRED}"; then
      # The write can take long enough for another power event to change the
      # marker. Only return after a stable before/after observation.
      if fake_suspend_active; then
        RGB_ENABLED_CURRENT=0
      else
        RGB_ENABLED_CURRENT=1
      fi
      if [ "${RGB_ENABLED_CURRENT}" = "${RGB_ENABLED_DESIRED}" ]; then
        return 0
      fi
    fi

    RGB_GATE_ATTEMPT=$((RGB_GATE_ATTEMPT + 1))
  done

  echo "Pocket EVO RGB: could not synchronize fake-suspend output gate" >&2
  return 1
}

led_brightness() {
  echo ${2} >${LED_PATH}/${1}/brightness
}

led_rgb() {
  echo ${2} ${3} ${4} >${LED_PATH}/${1}/multi_intensity
}

led_off() {
  led_brightness power-led 0
  led_rgb power-led 0 0 0
}

led_red() {
  led_brightness power-led 255
  led_rgb power-led 255 0 0
}

led_green() {
  led_brightness power-led 255
  led_rgb power-led 0 255 0
}

led_blue() {
  led_brightness power-led 255
  led_rgb power-led 0 0 255
}

led_white() {
  led_brightness power-led 255
  led_rgb power-led 255 255 255
}

led_orange() {
  led_brightness power-led 255
  led_rgb power-led 255 20 0
}

led_yellow() {
  led_brightness power-led 255
  led_rgb power-led 255 125 0
}

led_purple() {
  led_brightness power-led 255
  led_rgb power-led 255 0 255
}

case ${1} in
  red)
    led_red
    set_setting led.color ${1}
  ;;
  green)
    led_green
    set_setting led.color ${1}
  ;;
  blue)
    led_blue
    set_setting led.color ${1}
  ;;
  white)
    led_white
    set_setting led.color ${1}
  ;;
  orange)
    led_orange
    set_setting led.color ${1}
  ;;
  yellow)
    led_yellow
    set_setting led.color ${1}
  ;;
  purple)
    led_purple
    set_setting led.color ${1}
  ;;
  off)
    led_off
    set_setting led.color ${1}
  ;;
  rgb)
    if [ "${ROCKNIX_FAKE_SUSPEND_PHASE:-}" != "resume" ]; then
      LEDS_CONFIG=$(get_setting analogsticks.led)
      /usr/bin/analog_sticks_ledcontrol ${LEDS_CONFIG}
    fi
    set_setting led.color ${1}
  ;;
  battery)
    led_off
    set_setting led.color ${1}
    systemctl restart batteryledstatus.service
  ;;
  poweroff)
    led_off
  ;;
  list)
cat <<EOF
off
battery
red
green
blue
white
orange
yellow
purple
EOF
  ;;
esac

case "${ROCKNIX_FAKE_SUSPEND_PHASE:-}" in
  suspend)
    sync_rgb_enabled_to_fake_suspend_state
  ;;
  resume)
    sync_rgb_enabled_to_fake_suspend_state
  ;;
esac
