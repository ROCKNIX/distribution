#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)

# EmulationStation supplies one brightness followed by right and left RGB.
# Keep that Static-only ABI while routing the complete two-ring layout through
# the Pocket EVO serdev driver, which is the sole owner of the controller UART.

RGB_CONTROL=
for RGB_CANDIDATE in /sys/bus/serial/drivers/ayaneo-serial-mcu/*/rgb; do
  if [ -r "${RGB_CANDIDATE}/abi_version" ]; then
    RGB_CONTROL=${RGB_CANDIDATE}
    break
  fi
done

usage() {
  echo "Usage: $0 <brightness> <right-r> <right-g> <right-b> [<left-r> <left-g> <left-b>]" >&2
  echo "Example: $0 255 255 0 0 0 0 255" >&2
}

if [ "$#" -ne 4 ] && [ "$#" -ne 7 ]; then
  usage
  exit 1
fi

for value in "$@"; do
  case ${value} in
    ''|*[!0-9]*|????*)
      echo "Brightness and RGB values must be integers from 0 to 255" >&2
      exit 1
    ;;
  esac

  if [ "${value}" -gt 255 ]; then
    echo "Brightness and RGB values must be integers from 0 to 255" >&2
    exit 1
  fi
done

BRIGHTNESS=${1}
RIGHT_R=${2}
RIGHT_G=${3}
RIGHT_B=${4}

if [ "$#" -eq 7 ]; then
  LEFT_R=${5}
  LEFT_G=${6}
  LEFT_B=${7}
else
  LEFT_R=${RIGHT_R}
  LEFT_G=${RIGHT_G}
  LEFT_B=${RIGHT_B}
fi

if [ -z "${RGB_CONTROL}" ] || [ ! -w "${RGB_CONTROL}/zone_layout" ]; then
  echo "Pocket EVO RGB driver is unavailable" >&2
  exit 1
fi

# zone_index order is left-zone 270/0/90/180, then right-zone 270/0/90/180.
# One sysfs write is one serialized Static transaction; no separate advanced
# effect write is needed.
LEFT_ZONE="${LEFT_R} ${LEFT_G} ${LEFT_B} ${BRIGHTNESS}"
RIGHT_ZONE="${RIGHT_R} ${RIGHT_G} ${RIGHT_B} ${BRIGHTNESS}"
printf '%s %s %s %s %s %s %s %s\n' \
  "${LEFT_ZONE}" "${LEFT_ZONE}" "${LEFT_ZONE}" "${LEFT_ZONE}" \
  "${RIGHT_ZONE}" "${RIGHT_ZONE}" "${RIGHT_ZONE}" "${RIGHT_ZONE}" \
  >"${RGB_CONTROL}/zone_layout"
