[Unit]
Description=Hide the Duo Lite bottom screen from fbcon when sway stops.
ConditionFirmware=device-tree-compatible(retroidpocket,duolite)
After=sway.service
PartOf=sway.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'echo off > /sys/class/drm/card0-DP-1/status'

[Install]
WantedBy=sway.service
