[Unit]
Description=Hide the Duo Lite bottom screen from fbcon when KWin stops.
ConditionFirmware=device-tree-compatible(retroidpocket,duolite)
After=kwin.service
PartOf=kwin.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/bin/sh -c 'echo off > /sys/class/drm/card0-DP-1/status'

[Install]
WantedBy=kwin.service
