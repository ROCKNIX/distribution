[Unit]
Description=Powkiddy X55 panel calibration (wlr-gamma-control)
ConditionFirmware=device-tree-compatible(powkiddy,x55)
Requires=sway.service
After=sway.service
PartOf=sway.service

[Service]
Type=simple
Environment=HOME=/storage
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
Environment=WAYLAND_DISPLAY=wayland-1
EnvironmentFile=-/storage/.config/profile.d/095-sway
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ] && exit 0; sleep 0.1; done; exit 1'
ExecStart=/bin/bash "/usr/lib/autostart/quirks/devices/Powkiddy x55/bin/panelcalib"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=sway.service
