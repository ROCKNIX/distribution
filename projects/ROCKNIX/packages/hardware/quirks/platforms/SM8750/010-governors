. /etc/profile.d/001-functions

cat <<EOF >/storage/.config/profile.d/010-governors
CPU_FREQ=("/sys/devices/system/cpu/cpufreq/policy0" "/sys/devices/system/cpu/cpufreq/policy6")
GPU_FREQ=("/sys/devices/platform/soc@0/3d00000.gpu/devfreq/3d00000.gpu")
EOF

### Default the CPU governor to schedutil: it tracks per-task utilisation
### and picks intermediate OPPs, where ondemand (up_threshold=95) is
### effectively idle-or-max. Platform quirks run before the common
### autostart scripts, so this seeds the setting before 008-perfmode
### would persist its ondemand default; a governor the user chose is kept.
if [ -z "$(get_setting system.cpugovernor)" ]; then
  set_setting system.cpugovernor schedutil
fi
