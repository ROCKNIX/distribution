. /etc/profile.d/001-functions

cat <<EOF2 >/storage/.config/profile.d/002-turbo-mode_config
DEVICE_TURBO_MODE="true"
EOF2

### The firmware lists the prime cores' top frequencies, up to 4.32 GHz, as
### boost, so turbo is on by default. Earlier boots seeded it off; turn it on
### once, and keep whatever the user sets afterwards.
if [ "$(get_setting system.turbo-default)" != "1" ]; then
  set_setting enable.turbo-mode 1
  set_setting system.turbo-default 1
fi
