. /etc/profile.d/001-functions

### Systems follow the global schedutil and GPU governors: pinning CPUs at
### their lowest or highest frequency costs frame rate or power, and low and
### profile_peak are not devfreq governors, so they did nothing. Clear those
### seeded defaults once.
if [ "$(get_setting system.governor-defaults)" != "2" ]; then
  for SYSTEM in saturn ps2 gamecube wii 3ds ps3 xbox; do
    [ "$(get_setting ${SYSTEM}.cpugovernor)" = "performance" ] && del_setting ${SYSTEM}.cpugovernor
    [ "$(get_setting ${SYSTEM}.gpuperf)" = "profile_peak" ] && del_setting ${SYSTEM}.gpuperf
  done
  for SYSTEM in gb gbc gba nes sms gamegear genesis mastersystem sega32x megadrive segacd megacd; do
    [ "$(get_setting ${SYSTEM}.cpugovernor)" = "powersave" ] && del_setting ${SYSTEM}.cpugovernor
    [ "$(get_setting ${SYSTEM}.gpuperf)" = "low" ] && del_setting ${SYSTEM}.gpuperf
  done
  set_setting system.governor-defaults 2
fi

for SYSTEM in saturn st-v
do
  CORES=$(get_setting ${SYSTEM}.cores)
  if [ -z "${CORES}" ]
  then
    set_setting ${SYSTEM}.cores big
  fi
done
