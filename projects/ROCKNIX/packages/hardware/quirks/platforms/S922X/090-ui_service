### Set the default device configuration
cat <<EOF >/storage/.config/profile.d/090-ui_service
UI_SERVICE="sway.service essway.service"
if [ "$(gpudriver)" = "libmali" ]; then
MALI_DEFAULT_DISPLAY=wayland
WSIALLOC_USE_GBM=1
WLR_DRM_AFBC_ALT_PRIMARY=1
else
DISABLE_WSI_LAYER=1
fi
EOF

# libmali reads ./mali_debug.config
# Allows direct scanout, without this forces composition pass
if [ "$(gpudriver)" = "libmali" ] && [ ! -e /storage/mali_debug.config ]; then
  echo 'MALI_WAYLAND_AFBC=0' > /storage/mali_debug.config
fi
