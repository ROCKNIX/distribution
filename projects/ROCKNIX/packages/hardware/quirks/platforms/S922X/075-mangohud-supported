. /etc/profile

GPUDRIVER=$(/usr/bin/gpudriver)
MANGOHUD_ENABLED=$(get_setting "rocknix.mangohud.enabled")

# Default setting to 'disabled' if unset
if [ ! -n "${MANGOHUD_ENABLED}" ]; then
  set_setting "rocknix.mangohud.enabled" "0"
fi

# MangoHud is supported for both panfrost and libmali GPU drivers
cat <<EOF >/storage/.config/profile.d/075-mangohud-supported
DEVICE_MANGOHUD_SUPPORT="true"
EOF

# However, if not using panfrost GPU driver, override setting to 'disabled'
# as GLES-based emulators will crash. Users who know what they are doing
# can override this.
if [ ! "${GPUDRIVER}" == "panfrost" ]; then
  set_setting "rocknix.mangohud.enabled" "0"
fi
