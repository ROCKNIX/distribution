# The side and stick lights are four on/off blue LEDs

. /etc/profile.d/001-functions

set_leds() {
  for n in 1 2 3 4; do
    echo ${1} >/sys/class/leds/blue:backlight-${n}/brightness
  done
}

case ${1} in
  off)
    set_leds 0
    set_setting led.color off
  ;;
  poweroff)
    set_leds 0
  ;;
  list)
    cat <<EOT
default
off
EOT
  ;;
  default)
    set_leds 1
    del_setting led.color
  ;;
  *)
    set_leds 1
  ;;
esac
