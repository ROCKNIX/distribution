. /etc/profile.d/001-functions
. /storage/.config/profile.d/010-governors

### Set the minimum GPU frequency to reduce UI latency.
echo 400000000 >${GPU_FREQ}/min_freq

### Set GPU peak profile for demanding systems.
for SYSTEM in dreamcast n64 ports psp psx saturn gba pcfx cdi gamecube gc wii
do
  GPU_SETTING=$(get_setting ${SYSTEM}.gpuperf)
  if [ -z "${GPU_SETTING}" ]
  then
    set_setting ${SYSTEM}.gpuperf profile_peak
  fi
done

### Default GC/Wii to dolphin libretro core (Vulkan renderer via retroarch.cfg)
for SYSTEM in gamecube gc wii
do
  EMU_SETTING=$(get_setting ${SYSTEM}.emulator)
  if [ -z "${EMU_SETTING}" ]
  then
    set_setting ${SYSTEM}.emulator retroarch
    set_setting ${SYSTEM}.core dolphin
  fi
done

