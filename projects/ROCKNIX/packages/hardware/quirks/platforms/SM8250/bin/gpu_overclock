# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

if [ -z "${GPU_FREQ}" ]; then
  . /etc/profile
fi

# Set max gpu freq
case $1 in
  0)
    echo 587000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 0
  ;;
  650)
    echo 650000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 650
  ;;
  700)
    echo 700000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 700
  ;;
  725)
    echo 725000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 725
  ;;
  750)
    echo 750000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 750
  ;;
  800)
    echo 800000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 800
  ;;
  855)
    echo 855000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 855
  ;;
  905)
    echo 905000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 905
  ;;
  925)
    echo 925000000 > $GPU_FREQ/max_freq
    set_setting gpu-overclock-speed 925
  ;;
esac
