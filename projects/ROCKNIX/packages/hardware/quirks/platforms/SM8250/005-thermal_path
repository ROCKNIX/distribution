# Build the thermal sensor path list, CPU and GPU zones only.
DEVICE_TEMP_SENSOR=""
DEVICE_GPU_TEMP_SENSOR=""
for zone in /sys/devices/virtual/thermal/thermal_zone*/; do
  type=$(cat "${zone}type" 2>/dev/null)
  case "${type}" in
    cpu*|gpu*)
      DEVICE_TEMP_SENSOR="${DEVICE_TEMP_SENSOR} ${zone}temp"
      ;;
  esac
  case "${type}" in
    gpu-top*)
      DEVICE_GPU_TEMP_SENSOR="${zone}temp"
      ;;
  esac
done

cat <<EOF >/storage/.config/profile.d/005-thermal_path
DEVICE_TEMP_SENSOR="${DEVICE_TEMP_SENSOR}"
DEVICE_GPU_TEMP_SENSOR="${DEVICE_GPU_TEMP_SENSOR}"
EOF
