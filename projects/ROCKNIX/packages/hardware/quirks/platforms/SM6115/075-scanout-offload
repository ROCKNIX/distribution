. /etc/profile

# DEVICE_PLANE_ROTATION: the display plane rotates the output at scanout, so
# the compositor doesn't. A line count is the tallest frame it rotates by 90
# or 270 degrees. /storage/.config/rotator.disabled turns it off.
# Options: "false" (default), "true", or a line count such as "1088".

# DEVICE_PRE_ROTATION: the GPU rotates frames before scanout. Games render in
# the panel's orientation and gamescope rotates buffers with a blit, where the
# plane can't rotate a frame, and for every frame without plane rotation.
# Options: "true", "false" (default).

# DEVICE_SCANOUT_SCALING: the plane scales a game's buffer to the panel, so a
# game can render at another size without a GPU scaling pass. It also shows
# the scaling and sharpening menu in EmulationStation.
# Options: "true", "false" (default).

# DEVICE_SCANOUT_MAX_FETCH: widest source line, in pixels, a plane can fetch
# while scaling.
# Options: a width such as "2560". Unset means no limit.

# DEVICE_SCANOUT_MAX_RENDER: largest render size in percent of the screen,
# 400 when unset.
# Options: a percent such as "200".

# DEVICE_SCANOUT_SHARPNESS: sysfs directory of the display controller's
# sharpening and filter parameters. Without it those settings are hidden.
# Options: a directory such as "/sys/module/msm/parameters".

# GAMESCOPE_COMPOSITE_GRAPHICS: gamescope composites with a fragment shader
# instead of compute, so its output can stay compressed on GPUs that can't
# compress storage images.
# Options: 1, 0 (default).

cat <<CFG >/storage/.config/profile.d/075-scanout-offload
# Device Features
DEVICE_PLANE_ROTATION="false"
DEVICE_PRE_ROTATION="true"
DEVICE_SCANOUT_SCALING="true"
DEVICE_SCANOUT_MAX_FETCH="2560"
DEVICE_SCANOUT_SHARPNESS="/sys/module/msm/parameters"
export GAMESCOPE_COMPOSITE_GRAPHICS=1
CFG

# superseded by the file above
rm -f /storage/.config/profile.d/075-plane-rotation \
      /storage/.config/profile.d/077-scanout-scaling \
      /storage/.config/profile.d/017-gamescope-composite-graphics
