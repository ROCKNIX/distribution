# Set mixer controls for audio routing and volume.
amixer -c 0 cset name='SEC_MI2S_RX Audio Mixer MultiMedia1' 1 2>/dev/null
amixer -c 0 cset name='MultiMedia3 Mixer SEC_MI2S_TX' 1 2>/dev/null
amixer -c 0 cset name='HPVol SPKVol Switch' 3 2>/dev/null
amixer -c 0 cset name='DAC Playback Volume' 191 2>/dev/null
amixer -c 0 cset name='HPL Playback Volume' 191 2>/dev/null
amixer -c 0 cset name='HPR Playback Volume' 191 2>/dev/null
amixer -c 0 cset name='SPKL Playback Volume' 191 2>/dev/null
amixer -c 0 cset name='SPKR Playback Volume' 191 2>/dev/null
amixer -c 0 cset name='SPK_L PCM Playback Volume' 0 2>/dev/null
amixer -c 0 cset name='SPK_R PCM Playback Volume' 0 2>/dev/null
