. /etc/profile.d/001-functions

for SYSTEM in ps2 gamecube wii 3ds saturn dreamcast psp n64
do
  if [ -z "$(get_setting ${SYSTEM}.cpugovernor)" ]
  then
    set_setting ${SYSTEM}.cpugovernor schedutil
  fi
  if [ -z "$(get_setting ${SYSTEM}.gpuperf)" ]
  then
    set_setting ${SYSTEM}.gpuperf performance
  fi
done

for SYSTEM in ps2 gamecube wii saturn
do
  if [ -z "$(get_setting ${SYSTEM}.cores)" ]
  then
    set_setting ${SYSTEM}.cores big
  fi
done