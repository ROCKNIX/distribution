# Matches msm_irqbalance from downstream.

set_irq_affinity() {
  INTID=$(($1 + 32))
  CPUS="$2"
  for IRQ in $(awk -v id="${INTID}" '$0 ~ /GICv3/ { for (i = 1; i <= NF; i++) if ($i == "GICv3" && $(i+1) == id) { sub(":", "", $1); print $1 } }' /proc/interrupts)
  do
    [ -w "/proc/irq/${IRQ}/smp_affinity_list" ] && echo "${CPUS}" > "/proc/irq/${IRQ}/smp_affinity_list" 2>/dev/null
  done
}

set_irq_affinity 177 3      # GPU
set_irq_affinity 186 3      # MDSS
set_irq_affinity 348 1-2    # eMMC
set_irq_affinity 350 1-2    # SD card
set_irq_affinity 255 1-2    # USB
set_irq_affinity 327 2      # Gamepad
set_irq_affinity 194 1
set_irq_affinity 421 1      # BWMon

exit 0
