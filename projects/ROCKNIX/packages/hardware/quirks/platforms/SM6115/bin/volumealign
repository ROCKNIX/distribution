# SM6115 requires amixer to control speaker volume via the AW88261 amplifier.
# PipeWire's pactl/wpctl cannot drive the soft-mixer on this platform, so we
# map the saved audio.volume (0-100%) to the hardware attenuation register
# (0 = loudest, 720 = muted).

. /etc/profile.d/001-functions

VOLUME=$(get_setting "audio.volume")
if [ -z "${VOLUME}" ]; then
  VOLUME=50
fi

# AW88261 attenuation: 0 = full volume, 720 = muted
# Quadratic curve mapped between MIN_ATTEN (-6 dB floor at 100%) and
# MAX_ATTEN (-36 dB ceiling). 0% is a hard mute.
#   100% → 60  (-6 dB)     70% → 87  (-8.7 dB)
#    50% → 150 (-15 dB)    30% → 237 (-23.7 dB)
#    10% → 344 (-34.4 dB)   0% → 720 (muted)
MIN_ATTEN=60
MAX_ATTEN=360
if [ "${VOLUME}" -eq 0 ]; then
  HW_VOL=720
else
  HW_VOL=$(( MIN_ATTEN + (MAX_ATTEN - MIN_ATTEN) * (100 - VOLUME) * (100 - VOLUME) / 10000 ))
fi

amixer -c 0 -q cset name='SPK_L PCM Playback Volume' ${HW_VOL}
amixer -c 0 -q cset name='SPK_R PCM Playback Volume' ${HW_VOL}
