#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 ROCKNIX (https://github.com/ROCKNIX)

PS=/sys/class/power_supply/qcom-battmgr-usb
State=/sys/class/udc/a600000.usb/state
Mode=/sys/class/typec/port0/power_operation_mode

for _ in $(seq 1 40); do
	[ "$(cat ${State} 2>/dev/null)" = "configured" ] && break
	sleep 0.25
done
[ "$(cat ${State} 2>/dev/null)" = "configured" ] || exit 0

for _ in $(seq 1 15); do
	[ "$(cat ${Mode} 2>/dev/null)" = "default" ] || exit 0
	[ -d /sys/class/typec/port0-partner ] || exit 0
	case "$(cat ${PS}/usb_type 2>/dev/null)" in *"[SDP]"*) ;; *) exit 0 ;; esac
	[ "$(cat ${PS}/input_current_limit 2>/dev/null)" = "100000" ] || exit 0
	echo 500000 > ${PS}/input_current_limit
	sleep 1
	[ "$(cat ${PS}/input_current_limit 2>/dev/null)" = "500000" ] && exit 0
done
exit 0
