# Not every board in this family has an RK817 - only advertise the fuel
# gauge reset tool when the PMIC is actually present. Remove any stale
# file first: /storage persists across SD card moves between boards.
rm -f /storage/.config/profile.d/015-rk817_config
for DEV in /sys/bus/i2c/devices/*-0020; do
  [ "$(cat ${DEV}/name 2>/dev/null)" = "rk817" ] || continue
  cat <<EOF >/storage/.config/profile.d/015-rk817_config
DEVICE_RK817_FUEL_GAUGE="true"
EOF
done
