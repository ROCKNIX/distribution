# The RTL8821CS fails its first probe on some boots (SDIO data errors
# during the firmware download); binding it again succeeds.

. /etc/profile

wifi_probe_retry() {
  local try dev
  for try in 1 2 3
  do
    sleep 10
    for dev in /sys/bus/sdio/devices/*
    do
      [ -e "${dev}/driver" ] && continue
      case "$(cat "${dev}/modalias" 2>/dev/null)" in
        sdio:*v024CdC821*) ;;
        *) continue ;;
      esac
      log $0 "RTL8821CS did not probe, binding rtw88_8821cs to $(basename "${dev}") (try ${try})."
      basename "${dev}" > /sys/bus/sdio/drivers/rtw88_8821cs/bind 2>/dev/null
    done
  done
}

wifi_probe_retry &
