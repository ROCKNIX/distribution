cat <<EOF >/storage/.config/profile.d/006-panfrost
# Panfrost on Mali-G31 (H700) lacks a hardware blitter for tiled texture copies.
# Disabling copy-image extensions forces emulators like PPSSPP to use fast GPU shader
# or FBO blits instead of falling back to synchronous CPU untiling/copying routines.
export MESA_EXTENSION_OVERRIDE="-GL_OES_copy_image -GL_EXT_copy_image -GL_NV_copy_image -GL_ARB_copy_image \${MESA_EXTENSION_OVERRIDE}"
EOF
