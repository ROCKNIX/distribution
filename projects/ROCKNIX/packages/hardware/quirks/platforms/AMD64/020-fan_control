### Only EC fan drivers that accept pwm1_enable 1 (manual) and 2 (auto).
HAS_FAN="false"
for HWMON in /sys/class/hwmon/hwmon*
do
  case "$(cat ${HWMON}/name 2>/dev/null)" in
    ayaneo_ec|gpdfan|oxp_ec)
      if [ -e "${HWMON}/pwm1" ] && [ -e "${HWMON}/pwm1_enable" ]
      then
        HAS_FAN="true"
        PWM_FAN="${HWMON}/pwm1"
        FAN_INPUT="${HWMON}/fan1_input"
        break
      fi
    ;;
  esac
done

cat <<EOF >/storage/.config/profile.d/020-fan_control
DEVICE_HAS_FAN="${HAS_FAN}"
DEVICE_PWM_FAN="${PWM_FAN}"
DEVICE_FAN_INPUT="${FAN_INPUT}"
EOF
