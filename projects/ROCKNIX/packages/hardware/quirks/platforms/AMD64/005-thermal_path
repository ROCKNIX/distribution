for HWMON in /sys/class/hwmon/hwmon*
do
  case "$(cat ${HWMON}/name 2>/dev/null)" in
    k10temp|coretemp)
      CPU_TEMP_SENSOR="${HWMON}/temp1_input"
      break
    ;;
  esac
done

cat <<EOF >/storage/.config/profile.d/005-thermal_path
DEVICE_TEMP_SENSOR="${CPU_TEMP_SENSOR}"
DEVICE_GPU_TEMP_SENSOR=$(ls /sys/class/drm/card0/device/hwmon/hwmon*/temp1_input | head -n1)
EOF
