. /etc/profile.d/001-functions

LOG=/storage/wifi_resume.log

{
    echo
    echo "===== $(date) ====="
    cat /proc/uptime
    nmcli device status
    iw dev
    rfkill list

    WLAN=$(iw dev | awk '$1=="Interface"{print $2; exit}')
    if [ -n "$WLAN" ]; then
        echo "Interface details: $WLAN"
        ip link show "$WLAN"
    else
        echo "No WiFi interface found"
    fi

    dmesg | tail -100 | grep -iE "mt7921|mt76|firmware|wlan|pci|error|fail"
} >> "$LOG" 2>&1
