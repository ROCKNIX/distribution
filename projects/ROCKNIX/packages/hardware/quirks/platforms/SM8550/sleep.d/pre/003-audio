. /etc/profile

### An open playback stream keeps the ADSP awake, so close the sound cards for the suspend.
STATE="/tmp/sleep-audio-profiles"
: >"${STATE}"

pactl list cards | sed -n -e 's/^\tName: //p' -e 's/^\tActive Profile: //p' | while read -r CARD && read -r PROFILE
do
  [ "${PROFILE}" = "off" ] && continue
  printf '%s\t%s\n' "${CARD}" "${PROFILE}" >>"${STATE}"
  pactl set-card-profile "${CARD}" off
done
