# The wake is complete: end the blue indication and restore the LED state
# saved before sleep. ledcontrol restarts batteryledstatus when the saved
# state is battery.

. /etc/profile

POWER_LED="/sys/class/leds/power-led"

SLEEP_LED_STATE=$(get_setting "sleep.led.color")
if [ ! -n "${SLEEP_LED_STATE}" ]; then
  SLEEP_LED_STATE="battery"
  set_setting "sleep.led.color" "battery"
fi

if [ -d "${POWER_LED}" ]; then
  echo 0 >"${POWER_LED}/brightness"
fi

/usr/bin/ledcontrol ${SLEEP_LED_STATE}
