. /etc/profile

STATE="/tmp/sleep-audio-profiles"
[ -s "${STATE}" ] || exit 0

while IFS="$(printf '\t')" read -r CARD PROFILE
do
  pactl set-card-profile "${CARD}" "${PROFILE}"
done <"${STATE}"
rm -f "${STATE}"
