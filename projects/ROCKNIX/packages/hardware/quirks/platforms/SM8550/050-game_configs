GZDOOM_INI="/storage/.config/gzdoom/gzdoom.ini"

if [ ! -d "/storage/.config/gzdoom/" ]; then
  cp -rf /usr/config/gzdoom /storage/.config/
fi

if grep -q '^Axis2map=0$' "${GZDOOM_INI}"; then
  sed -i \
    -e '/^Axis2scale=/c\Axis2scale=1' \
    -e '/^Axis2map=/c\Axis2map=-1' \
    -e '/^Axis3deadzone=/c\Axis3deadzone=0.200001' \
    -e '/^Axis3scale=/c\Axis3scale=1' \
    -e '/^Axis3map=/c\Axis3map=0\nAxis4deadzone=0.200001\nAxis4scale=0.75\nAxis4map=1\nAxis5map=-1' \
    -e '/^\[Doom.Bindings\]/a\Joy2=menu_main\nAxis7Minus=weapprev\nAxis7Plus=weapnext\nAxis8Minus=togglemap\nAxis8Plus=centerview' \
    "${GZDOOM_INI}"
fi
