mkdir -p /run/udev/rules.d
cat <<EOR >/run/udev/rules.d/81-usb-input-current.rules
SUBSYSTEM=="typec", KERNEL=="port0-partner", ACTION=="add", RUN+="/usr/lib/autostart/quirks/platforms/SM4450/bin/usb-input-current"
EOR
udevadm control --reload

exit 0
