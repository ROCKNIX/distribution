### Set the default device configuration
cat <<EOF >/storage/.config/profile.d/090-ui_service
GPUDRIVER=$(/usr/bin/gpudriver)

case \${GPUDRIVER} in
  "libmali")
    UI_SERVICE="kwin.service essway.service"
    MALI_DEFAULT_DISPLAY=wayland
    WSIALLOC_USE_GBM=1
  ;;
  "panfrost")
     UI_SERVICE="kwin.service essway.service"
     DISABLE_WSI_LAYER=1
  ;;
esac
EOF
