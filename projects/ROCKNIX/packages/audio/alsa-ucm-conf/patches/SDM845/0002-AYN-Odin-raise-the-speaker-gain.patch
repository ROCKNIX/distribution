From: Jacob Cook <jacobmcook1984@gmail.com>
Subject: [PATCH] AYN Odin: raise the speaker gain

---
--- a/ucm2/AYN/Odin/HiFi.conf	2026-10-21 18:31:52.135057935 -0400
+++ b/ucm2/AYN/Odin/HiFi.conf	2026-10-21 18:31:52.147058022 -0400
@@ -4,6 +4,11 @@
 		cset "name='SLIMBUS_0_RX Audio Mixer MultiMedia1' 1"
 		cset "name='SLIMBUS_1_RX Audio Mixer MultiMedia3' 1"
 		cset "name='MultiMedia2 Mixer SLIMBUS_0_TX' 1"
+
+		# The WSA881x driver resets the speaker PA to its default gain on
+		# every power-up, so raise the codec's speaker gain instead
+		cset "name='RX7 Digital Volume' 120"
+		cset "name='RX8 Digital Volume' 120"
 	]
 
 	Include.wcde.File "/codecs/wcd934x/DefaultEnableSeq.conf"
