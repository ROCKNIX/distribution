Keep the shared sound card name and select Class-AB only for Nova.
Preserve the mode write's position before enabling the RX route.

diff --git a/ucm2/codecs/qcom-lpass/rx-macro/HeadphoneEnableSeq.conf b/ucm2/codecs/qcom-lpass/rx-macro/HeadphoneEnableSeq.conf
--- a/ucm2/codecs/qcom-lpass/rx-macro/HeadphoneEnableSeq.conf
+++ b/ucm2/codecs/qcom-lpass/rx-macro/HeadphoneEnableSeq.conf
@@ -0,0 +1,3 @@
+Define.WcdHphMode "CLS_H_LOHIFI"
+Include.nova.File "/Retroid/Nova/HeadphoneMode.conf"
+
@@ -3 +6 @@ EnableSequence
-	cset "name='RX HPH Mode' CLS_H_LOHIFI"
+	cset "name='RX HPH Mode' ${var:WcdHphMode}"
diff --git a/ucm2/Retroid/Nova/HeadphoneMode.conf b/ucm2/Retroid/Nova/HeadphoneMode.conf
new file mode 100644
--- /dev/null
+++ b/ucm2/Retroid/Nova/HeadphoneMode.conf
@@ -0,0 +1,8 @@
+If.nova {
+	Condition {
+		Type String
+		String1 "$${sys:firmware/devicetree/base/model}"
+		String2 "Retroid Pocket Nova"
+	}
+	True.Define.WcdHphMode "CLS_AB_LOHIFI"
+}
