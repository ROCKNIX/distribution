Select Class-AB only for Nova, preserving the upstream WCD mode-write position.
Initialize Nova's RX companders through the upstream RX BootSequence.

diff --git a/ucm2/codecs/wcd938x/HeadphoneEnableSeq.conf b/ucm2/codecs/wcd938x/HeadphoneEnableSeq.conf
--- a/ucm2/codecs/wcd938x/HeadphoneEnableSeq.conf
+++ b/ucm2/codecs/wcd938x/HeadphoneEnableSeq.conf
@@ -0,0 +1,3 @@
+Define.WcdHphMode "CLS_H_LOHIFI"
+Include.nova.File "/Retroid/Nova/HeadphoneMode.conf"
+
@@ -10 +13 @@ EnableSequence
-	cset "name='RX HPH Mode' CLS_H_LOHIFI"
+	cset "name='RX HPH Mode' ${var:WcdHphMode}"
diff --git a/ucm2/Retroid/Nova/HeadphoneMode.conf b/ucm2/Retroid/Nova/HeadphoneMode.conf
new file mode 100644
--- /dev/null
+++ b/ucm2/Retroid/Nova/HeadphoneMode.conf
@@ -0,0 +1,8 @@
+If.nova {
+	Condition {
+		Type String
+		String1 "$${sys:firmware/devicetree/base/model}"
+		String2 "Retroid Pocket Nova"
+	}
+	True.Define.WcdHphMode "CLS_AB_LOHIFI"
+}
diff --git a/ucm2/AYN/Odin2/AYN-Odin2.conf b/ucm2/AYN/Odin2/AYN-Odin2.conf
--- a/ucm2/AYN/Odin2/AYN-Odin2.conf
+++ b/ucm2/AYN/Odin2/AYN-Odin2.conf
@@ -31,0 +32,9 @@
+
+If.nova-rx-init {
+	Condition {
+		Type String
+		String1 "$${sys:firmware/devicetree/base/model}"
+		String2 "Retroid Pocket Nova"
+	}
+	True.Include.rx-init.File "/codecs/qcom-lpass/rx-macro/init.conf"
+}
