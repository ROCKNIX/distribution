Subject: [PATCH] pcm: log a recovered xrun at debug priority

A recovered xrun is not an error, and at debug priority it stays reachable with LIBASOUND_DEBUG.

diff --git a/src/pcm/pcm.c b/src/pcm/pcm.c
--- a/src/pcm/pcm.c
+++ b/src/pcm/pcm.c
@@ -8784,7 +8784,7 @@
 		else
 			s = "overrun";
 		if (!silent)
-			snd_error(PCM, "%s occurred", s);
+			snd_debug(PCM, "%s occurred", s);
 		err = snd_pcm_prepare(pcm);
 		if (err < 0) {
 			snd_error(PCM, "cannot recovery from %s, prepare failed: %s", s, snd_strerror(err));
