Subject: [PATCH] conf: add /run and /storage as config locations

/storage is the writable data partition, /run is where generated
configuration lands.  Replaces ~/.asoundrc, which has no meaning here.

diff --git a/src/conf/alsa.conf b/src/conf/alsa.conf
--- a/src/conf/alsa.conf
+++ b/src/conf/alsa.conf
@@ -12,7 +12,8 @@
 			"/usr/etc/alsa/conf.d"
 			"/etc/alsa/conf.d"
 			"/etc/asound.conf|||/usr/etc/asound.conf"
-			"~/.asoundrc"
+			"/run/asound.conf"
+			"/storage/.config/asound.conf"
 			{
 				@func concat
 				strings [
