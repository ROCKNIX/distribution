#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)
#
# This script will update the ABL on the internal eMMC/UFS.

[ -z "$SYSTEM_ROOT" ] && SYSTEM_ROOT=""
[ -z "$BOOT_ROOT" ] && BOOT_ROOT="/flash"

. $SYSTEM_ROOT/etc/os-release

case "$HW_DEVICE" in
  SM6115|SM8250|SM8550|SM8650)
    ;;
  *)
    echo "This script is not compatible with this device!"
    exit 1
    ;;
esac

# ---- Sanity checks ----
ELF="$SYSTEM_ROOT/usr/share/bootloader/rocknix_abl/abl_signed.elf"
if [ ! -f "${ELF}" ]; then
  echo "Error: ABL update not found"
  exit 1
fi

ABL_A="$($SYSTEM_ROOT/usr/sbin/blkid -t PARTLABEL=abl_a -o device)"
ABL_B="$($SYSTEM_ROOT/usr/sbin/blkid -t PARTLABEL=abl_b -o device)"
if [ ! -b "${ABL_A}" ] || [ ! -b "${ABL_B}" ]; then
  echo "Error: ABL partitions not found"
  exit 1
fi

# ---- Get sector size ----
SS="$($SYSTEM_ROOT/usr/sbin/blockdev --getss "${ABL_A}")"
if [ -z "${SS}" ]; then
  echo "Error: failed to get sector size"
  exit 1
fi

# ---- ABL installation check ----
if [ ! -f "$BOOT_ROOT/rocknix-abl" ]; then
  MSG="
****************************************************************
ROCKNIX requires a custom bootloader on internal storage.
Do you want to install this?

Volume UP   : YES
Volume DOWN : NO (May prevent booting)
****************************************************************"

  echo "$MSG"

  CHOICE=$(
    (
      for dev in /dev/input/event*; do
        $SYSTEM_ROOT/usr/bin/evtest "$dev" 2>/dev/null | while read -r line; do
          if echo "$line" | grep -q "KEY_VOLUMEUP.*value 1"; then
            echo "YES"
            kill -TERM 0
          elif echo "$line" | grep -q "KEY_VOLUMEDOWN.*value 1"; then
            echo "NO"
            kill -TERM 0
          fi
        done &
      done
      wait
    ) 2>/dev/null | head -n 1
  )

  if [ "$CHOICE" = "YES" ]; then
    echo "User confirmed. Proceeding with ABL installation..."
    touch "$BOOT_ROOT/rocknix-abl"
  else
    echo "User declined. Skipping ABL installation..."
    exit 0
  fi
fi

# ---- Flash ----
echo "Updating ABL partitions..."
dd if="${ELF}" of="${ABL_A}" bs="${SS}" conv=fsync,notrunc status=none
dd if="${ELF}" of="${ABL_B}" bs="${SS}" conv=fsync,notrunc status=none

sync

echo "ABL update completed successfully..."
