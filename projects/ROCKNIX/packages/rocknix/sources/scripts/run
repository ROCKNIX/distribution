. /etc/profile

ui_state() {
  clear >/dev/console
  systemctl ${1} ${UI_SERVICE}
}

if echo "${UI_SERVICE}" | grep "kwin"; then
  if [ -f "${*}" ]
  then
    foot -F "${*}"
  else
    foot -F ${*}
  fi
else
  ui_state stop
  clear >/dev/console
  $* >/dev/console
  if [ "$?" == 0 ]
  then
    ui_state start
    exit 0
  else
    "$*" >/dev/console
    ui_state start
    exit 0
  fi
fi

