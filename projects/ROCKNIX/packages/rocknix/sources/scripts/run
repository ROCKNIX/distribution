#!/bin/bash
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)

. /etc/profile

ui_state() {
  clear >/dev/console
  systemctl ${1} ${UI_SERVICE}
}

# Every branch exits with the status of what it ran. It used to exit 0 on
# both halves of the console branch whatever happened, so a caller could not
# tell a factory reset that reset nothing from one that worked -- and the two
# terminal branches exited with whatever the last thing in the `if` returned
# (#119). ES's runSystemCommand still throws the status away, but
# executeScriptLegacy reads it, and so does every shell caller.
if [ "${UI_SERVICE}" = "weston.service" ]
then
  if [ -f "${*}" ]
  then
    RUN=$(echo ${*} | sed 's# #\\ #g')
    weston-terminal --command="${RUN}"
  else
    weston-terminal --command="${*}"
  fi
  # The terminal's status, which is the closest thing to the command's that
  # these two branches can offer.
  exit $?
elif echo "${UI_SERVICE}" | grep "sway"; then
  if [ -f "${*}" ]
  then
    foot -F "${*}"
  else
    foot -F ${*}
  fi
  exit $?
else
  ui_state stop
  clear >/dev/console
  $* >/dev/console
  rc=$?
  if [ "${rc}" != 0 ]
  then
    # The fallback for a command that is a single path with spaces in it --
    # the same case the weston and sway branches above test for with -f, and
    # the only input "$*" (one word, the whole argument list) can name. It
    # ran unguarded on EVERY failure, so a composed command line came back
    # as `cloud_content_restore --all && cloud_restore --yes: not found`
    # flashed over the console before the UI returned, on top of whatever
    # the real failure had said (#114).
    if [ -f "${*}" ]
    then
      "$*" >/dev/console
      rc=$?
    fi
  fi
  ui_state start
  exit "${rc}"
fi

