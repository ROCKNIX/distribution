#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2022 kkoshelev (https://github.com/kkoshelev)
# Wi-Fi via NetworkManager (iwd backend). AP/netplay still uses iwctl on the interface.

. /etc/profile

NMCLI="$(command -v nmcli 2>/dev/null)"

###
### Basic WIFI properties used across the tool.
###
### Usage:
###     wifictl command [ssid] [psk]
###

IWD_AP_CFG_DIR="/storage/.cache/iwd/ap"
WIFI_TYPE=$(get_setting wifi.adhoc.enabled)
NETWORK_ADDRESS="192.168.80"
ADHOC_CLIENT_ID=$(get_setting wifi.adhoc.id)
WIFI_DEV="$(ls /sys/class/net | grep -m1 ^wlan)"
DEFAULT_CHAN="6"

# Exit the script if the WiFi device isn't available
[ -z "${WIFI_DEV}" ] && exit 0
[ ! -d "/sys/class/net/${WIFI_DEV}" ] && exit 0
[ -z "${NMCLI}" ] && exit 0

SSID="${2:-$(get_setting wifi.ssid 2>/dev/null)}"
PSK="${3:-$(get_setting wifi.key 2>/dev/null)}"
COUNTRY="${4:-$(get_setting wifi.country 2>/dev/null | tr -d '[:space:]')}"

if [ "${WIFI_TYPE}" = "1" ]; then
  SSID="NETPLAY_AP"
  PSK="deadbeef"
fi

ADHOC_CHAN=$(get_setting wifi.adhoc.channel)
if [ -z "${ADHOC_CHAN}" ]; then
  ADHOC_CHAN="${DEFAULT_CHAN}"
  set_setting wifi.adhoc.channel ${DEFAULT_CHAN}
fi

###
### Functions...
###

# Wait for iwd to start and have a device available
wait_for_wifi() {
  for i in $(seq 1 5); do
    iwctl device list | grep -q "${WIFI_DEV}" && break
    sleep 1
  done

  return 0
}

# Put the radio on the configured country, and record it where iw's udev hook
# (60-iw-regdomain.rules -> /usr/lib/iw/setregdomain) will find it on the next
# boot. That hook runs on ieee80211 "add", which is the only correct moment:
# the phy exists, nothing is associated yet, and it costs nothing on devices
# with no Wi-Fi at all. Applying the domain later rebuilds the channel list and
# drops any active link, so this is a no-op unless the country really changed.
#
# Not called from the scan or connect path either: emptying the scan cache
# immediately before "device wifi connect" makes the connect fail with the SSID
# not found -- it breaks the connection it is meant to enable.
apply_regdomain() {
  local current

  [ -z "${COUNTRY}" ] && return 0

  # regdomain.conf below is sourced by setregdomain as root at every boot,
  # and iw only takes ISO 3166-1 alpha-2 codes: refuse anything that is not
  # exactly two letters.
  case "${COUNTRY}" in
    [A-Za-z][A-Za-z]) COUNTRY="$(echo "${COUNTRY}" | tr '[:lower:]' '[:upper:]')" ;;
    *) return 0 ;;
  esac

  mkdir -p /storage/.cache
  echo "REGDOMAIN=${COUNTRY}" >/storage/.cache/regdomain.conf

  # Already there: don't touch the radio, re-applying would drop the link.
  # Self-managed drivers (ath12k) report their country in a phy# section;
  # everything else only has the global domain.
  current="$(iw reg get 2>/dev/null | sed -n '/^phy#/,$p' |
             awk '/^country/ { print substr($2, 1, 2); exit }')"
  [ -z "${current}" ] &&
    current="$(iw reg get 2>/dev/null |
               awk '/^country/ { print substr($2, 1, 2); exit }')"
  [ "${current}" = "${COUNTRY}" ] && return 0

  # cfg80211 is built into the kernel, so its single attempt at loading
  # regulatory.db happens before a rootfs exists and fails with -ENOENT. The
  # failure is cached and every hint afterwards is answered from an empty
  # database and dropped, which pins the domain at 00 whatever wifi.country
  # says. Reloading first is what makes the setting take effect.
  iw reg reload
  iw reg set "${COUNTRY}"

  return 0
}

# lists all wifi networks
list_wifi() {
  wait_for_wifi
  "${NMCLI}" -w 15 dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
  sleep 1
  "${NMCLI}" -t -f SSID dev wifi list ifname "${WIFI_DEV}" 2>/dev/null | sed '/^$/d' | sort -u
}

connect_wifi() {
  wait_for_wifi
  # Ensure NM has the device ready and has scanned
  for i in $(seq 1 10); do
    "${NMCLI}" -t -f DEVICE,STATE dev status 2>/dev/null | grep -q "^${WIFI_DEV}:disconnected" && break
    "${NMCLI}" -t -f DEVICE,STATE dev status 2>/dev/null | grep -q "^${WIFI_DEV}:connected" && return 0
    sleep 1
  done
  # "device wifi connect" fails outright when the SSID isn't in the scan cache,
  # which is normal for a radio that has only just come up. Rescan until it
  # appears rather than assuming one pass is enough.
  for i in $(seq 1 5); do
    "${NMCLI}" dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
    sleep 2
    "${NMCLI}" -t -f SSID dev wifi list ifname "${WIFI_DEV}" 2>/dev/null |
      grep -qxF "${SSID}" && break
  done
  # If a keyfile profile for this SSID already exists but is incomplete (e.g. missing
  # 802-11-wireless-security.key-mgmt), NM fails connection-update with "key-mgmt: property is missing".
  # Drop the stale profile so "device wifi connect" creates a clean one.
  "${NMCLI}" connection delete id "${SSID}" >/dev/null 2>&1 || true
  if [ -n "${PSK}" ]; then
    "${NMCLI}" -w 90 device wifi connect "${SSID}" password "${PSK}" ifname "${WIFI_DEV}" >/dev/null 2>&1
  else
    "${NMCLI}" -w 90 device wifi connect "${SSID}" ifname "${WIFI_DEV}" >/dev/null 2>&1
  fi
}

create_adhoc() {
  wait_for_wifi
  "${NMCLI}" device set "${WIFI_DEV}" managed no >/dev/null 2>&1

  # Create an iwd AP profile file
  mkdir -p "${IWD_AP_CFG_DIR}"
  cat <<EOF >"${IWD_AP_CFG_DIR}/${SSID}.ap"
[General]
Channel=${ADHOC_CHAN}
DisableHT=true

[Security]
Passphrase=${PSK}

[IPv4]
Address=${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}
Netmask=255.255.255.0
Gateway=${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}
EOF

  iwctl device ${WIFI_DEV} set-property Mode ap
  # Start the AP profile
  iwctl ap ${WIFI_DEV} start-profile "${SSID}" 2>/dev/null
}

destroy_adhoc() {
  iwctl ap ${WIFI_DEV} stop 2>/dev/null
  rm -f "${IWD_AP_CFG_DIR}/${SSID}.ap" 2>/dev/null
  "${NMCLI}" device set "${WIFI_DEV}" managed yes >/dev/null 2>&1
}

has_ap_mode() {
  wait_for_wifi

  PHY=$(basename "$(readlink /sys/class/net/${WIFI_DEV}/phy80211)")
  if iwctl adapter "$PHY" show | grep -q 'SupportedModes.*ap'; then
    exit 0
  else
    exit 1
  fi
}

case "${1}" in
  enable)
    rfkill unblock wifi
    apply_regdomain
    ;;
  disable)
    rfkill block wifi
    ;;
  connect)
    if [ "${WIFI_TYPE}" = "1" ] && \
       [ "${ADHOC_CLIENT_ID}" = "1" ]; then
      create_adhoc >/dev/null 2>&1
    else
      destroy_adhoc >/dev/null 2>&1
      # Allow NetworkManager time to re-initialize the device after setting managed=yes
      sleep 3
      connect_wifi >/dev/null 2>&1
    fi
  ;;
  disconnect)
    if [ "${WIFI_TYPE}" = "1" ]; then
      destroy_adhoc >/dev/null 2>&1
      iwctl ap ${WIFI_DEV} stop 2>/dev/null
    else
      "${NMCLI}" device disconnect "${WIFI_DEV}" >/dev/null 2>&1
    fi
    ;;
  reconnect)
    /usr/bin/wifictl disconnect
    /usr/bin/wifictl connect
    ;;
  list)
    list_wifi
    ;;
  channels)
    iw list | awk '/[0-9] MHz \[/ && ! /disabled|radar|no IR/ { gsub(/^.*\[/,""); gsub(/\].*$/,""); print}'
    ;;
  has_ap_mode)
    has_ap_mode
    ;;
  scan)
    "${NMCLI}" dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
    ;;
  scanlist)
    "${NMCLI}" dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
    sleep 2
    list_wifi
    ;;
esac
