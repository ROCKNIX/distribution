case "$1" in
  freeze|thaw)
    systemctl -q is-active games.slice || exit 0
    timeout 5 systemctl "$1" games.slice
    ;;
  *)
    echo "usage: $0 freeze|thaw" >&2
    exit 1
    ;;
esac
