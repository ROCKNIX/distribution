. /etc/profile.d/001-functions

case "$1" in
  freeze)
    [ "$(get_setting game_mode)" = "0" ] && exit 0
    systemctl -q is-active background.slice && timeout 5 systemctl freeze background.slice
    for cg in background.slice system.slice/essway.service; do
      cat /sys/fs/cgroup/${cg}/memory.current 2>/dev/null >/sys/fs/cgroup/${cg}/memory.reclaim
    done
    ;;
  thaw)
    systemctl -q is-active background.slice && timeout 5 systemctl thaw background.slice
    ;;
  *)
    echo "usage: $0 freeze|thaw" >&2
    exit 1
    ;;
esac
exit 0
