. /etc/profile

dir=/tmp/shaders

if [ -z "$UI_SHADER" ]; then
  find "$dir" \( -name "*.glslp" -o -name "*.slangp" \) 2>/dev/null |
    cut -c 14- |
    sed "s/$/,/" |
    sort
else
  find "$dir" -name "*.$UI_SHADER" 2>/dev/null |
    cut -c 14- |
    sed "s/$/,/" |
    sort
fi
