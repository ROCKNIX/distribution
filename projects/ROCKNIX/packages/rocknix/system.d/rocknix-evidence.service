[Unit]
Description=One page of device state into the persistent log tree
# The same marker that turns off var-log.mount turns this off: without the
# persistent tree the page would be written to RAM and lost with the freeze
# it exists to explain (fork #104).
ConditionPathExists=!/storage/.cache/volatile-log

[Service]
Type=oneshot
ExecStart=/usr/bin/rocknix-evidence snapshot
Nice=15
IOSchedulingClass=idle
