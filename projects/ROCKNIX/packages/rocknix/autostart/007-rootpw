# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

tocon "Setting root password..."

if [ ! -d "/storage/.cache/samba" ]
then
  mkdir -p /storage/.cache/samba
  touch /storage/.cache/samba/smbpasswd
fi

ROOTPASS=$(get_setting root.password)

# Empty means the setting is absent, which is the normal state on the first
# boot after a restore (backups strip credentials). setrootpass refuses it
# anyway; skipping the call here keeps that out of the boot log as a failure.
if [ -n "${ROOTPASS}" ]
then
  setrootpass "${ROOTPASS}"
else
  tocon "No device password set; leaving the existing one in place."
fi
