# Minimal OS variable loading for performance
. /etc/profile.d/001-functions

if [ -d "/storage/cache/.cores" ]
then
  rm -rf /storage/cache/.cores
fi

if [ ! -d "/tmp/cache" ]
then
  mkdir -p /tmp/cache
fi

ln -sf /tmp/cache /storage/cache/.cores

if [ ! -d "/storage/.config/profile.d" ]
then
  mkdir -p /storage/.config/profile.d
fi

### Inspect the system config and revert
### to last known good state if corrupt.
/usr/bin/chksysconfig verify

### Clean up settings
sort_settings

### The file is good now -- verify put it right if it was not, and
### sort_settings tidied it -- so make it the last known good copy. A forced
### power-off never reaches the shutdown-time backup, so the copy taken here
### is the one that is usually fresh (D-CLOUD-079).
/usr/bin/chksysconfig backup

### Set up the runtime directory.
if [ ! -d "/var/run/0-runtime-dir" ]
then
  mkdir -p /var/run/0-runtime-dir
fi

chmod 0700 /var/run/0-runtime-dir
