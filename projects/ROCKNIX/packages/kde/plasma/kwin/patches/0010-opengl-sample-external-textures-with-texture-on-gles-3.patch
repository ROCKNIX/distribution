From: sunshineinabox <aqemail@gmail.com>
Date: Wed, 18 Nov 2026 18:15:16 -0800
Subject: [PATCH] opengl: sample external textures with texture() on GLES 3

texture2D() doesn't exist in GLSL ES 3.00, which the Mali blob enforces.
---
--- a/src/opengl/base.frag
+++ b/src/opengl/base.frag
@@ -54,7 +54,9 @@
 #if TRAIT_MAP_MULTI_PLANE_TEXTURE
     result = vec4(texture(sampler, texcoord0).x, texture(sampler1, texcoord0).rg, 1.0);
 #endif
-#if TRAIT_MAP_EXTERNAL_TEXTURE
+#if TRAIT_MAP_EXTERNAL_TEXTURE && __VERSION__ >= 300
+    result = texture(sampler, texcoord0);
+#elif TRAIT_MAP_EXTERNAL_TEXTURE
     // external textures require texture2D for sampling
     result = texture2D(sampler, texcoord0);
 #endif
--- a/src/opengl/glshader.cpp
+++ b/src/opengl/glshader.cpp
@@ -86,6 +86,7 @@
         if (coreShader) {
             ret.append("#version 300 es\n");
             ret.append("#extension GL_OES_EGL_image_external : require\n");
+            ret.append("#extension GL_OES_EGL_image_external_essl3 : enable\n");
             ret.append("precision highp float;\n");
             ret.append("precision highp sampler2D;\n");
             ret.append("precision highp sampler3D;\n");
