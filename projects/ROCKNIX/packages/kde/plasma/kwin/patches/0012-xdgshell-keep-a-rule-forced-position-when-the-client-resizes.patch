From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 19 Nov 2026 20:12:44 -0800
Subject: [PATCH] xdgshell: keep a rule-forced position when the client resizes

Spontaneous resizes grew around the center and moved the window off the forced position.
---
--- a/src/xdgshellwindow.cpp
+++ b/src/xdgshellwindow.cpp
@@ -622,6 +622,7 @@ void XdgToplevelWindow::applyWindowRules()
 {
     WaylandWindow::applyWindowRules();
     updateCapabilities();
+    m_spontaneousGravity = preferredSpontaneousGravity();
 }
 
 void XdgToplevelWindow::closeWindow()
@@ -1337,6 +1338,7 @@ void XdgToplevelWindow::initialize()
     if (position) {
         place(*position);
     }
+    m_spontaneousGravity = preferredSpontaneousGravity();
     const QSizeF forcedSize = rules()->checkSize(initialSize(sessionData), true);
     if (forcedSize.isValid()) {
         resize(forcedSize);
@@ -1461,6 +1463,8 @@ Gravity XdgToplevelWindow::preferredSpontaneousGravity() const
 {
     if (m_plasmaShellSurface && m_plasmaShellSurface->isPositionSet()) {
         return Gravity::BottomRight;
+    } else if (rules()->checkPosition(invalidPoint) != invalidPoint) {
+        return Gravity::BottomRight;
     } else {
         return Gravity::Center;
     }
