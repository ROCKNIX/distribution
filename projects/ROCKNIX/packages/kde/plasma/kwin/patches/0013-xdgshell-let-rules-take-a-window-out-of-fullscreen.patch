From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 19 Nov 2026 20:58:21 -0800
Subject: [PATCH] xdgshell: let rules take a window out of fullscreen

A forced non-fullscreen rule made the window unfullscreenable, so it stayed fullscreen and ignored the forced geometry.
---
--- a/src/xdgshellwindow.cpp
+++ b/src/xdgshellwindow.cpp
@@ -1771,11 +1771,11 @@ void XdgToplevelWindow::installPlasmaShellSurface(PlasmaShellSurfaceInterface *s
 
 void XdgToplevelWindow::setFullScreen(bool set)
 {
-    if (!isFullScreenable()) {
+    set = rules()->checkFullScreen(set);
+    if (set && !isFullScreenable()) {
         return;
     }
 
-    set = rules()->checkFullScreen(set);
     if (m_isRequestedFullScreen == set) {
         return;
     }
@@ -1790,12 +1790,12 @@ void XdgToplevelWindow::setFullScreen(bool set)
     } else {
         m_fullScreenRequestedOutput.clear();
         if (fullscreenGeometryRestore().isValid()) {
-            moveResize(RectF(fullscreenGeometryRestore().topLeft(),
-                             constrainFrameSize(fullscreenGeometryRestore().size())));
+            moveResize(rules()->checkGeometrySafe(RectF(fullscreenGeometryRestore().topLeft(),
+                                                        constrainFrameSize(fullscreenGeometryRestore().size()))));
         } else {
             // this can happen when the window was first shown already fullscreen,
             // so let the client set the size by itself
-            moveResize(RectF(workspace()->clientArea(PlacementArea, this).topLeft(), QSize(0, 0)));
+            moveResize(rules()->checkGeometrySafe(RectF(workspace()->clientArea(PlacementArea, this).topLeft(), QSize(0, 0))));
         }
     }
 
