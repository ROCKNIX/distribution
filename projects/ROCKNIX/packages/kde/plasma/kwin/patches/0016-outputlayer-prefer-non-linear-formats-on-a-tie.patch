From: sunshineinabox <aqemail@gmail.com>
Date: Sat, 21 Nov 2026 06:00:00 -0800
Subject: [PATCH] outputlayer: prefer non-linear formats on a tie

---
--- a/src/core/outputlayer.cpp
+++ b/src/core/outputlayer.cpp
@@ -267,7 +267,12 @@
         }
         ret.push_back(*info);
     }
-    std::ranges::sort(ret, [tradeoff](const FormatInfo &before, const FormatInfo &after) {
+    const auto hasNonLinearModifier = [&formats](const FormatInfo &info) {
+        return std::ranges::any_of(formats.value(info.drmFormat), [](uint64_t modifier) {
+            return modifier != DRM_FORMAT_MOD_LINEAR && modifier != DRM_FORMAT_MOD_INVALID;
+        });
+    };
+    std::ranges::sort(ret, [tradeoff, &hasNonLinearModifier](const FormatInfo &before, const FormatInfo &after) {
         if (tradeoff == BackendOutput::ColorPowerTradeoff::PreferAccuracy && before.bitsPerColor != after.bitsPerColor) {
             return before.bitsPerColor > after.bitsPerColor;
         }
@@ -282,7 +287,10 @@
         if (before.bitsPerPixel != after.bitsPerPixel) {
             return before.bitsPerPixel < after.bitsPerPixel;
         }
-        return before.bitsPerColor > after.bitsPerColor;
+        if (before.bitsPerColor != after.bitsPerColor) {
+            return before.bitsPerColor > after.bitsPerColor;
+        }
+        return hasNonLinearModifier(before) && !hasNonLinearModifier(after);
     });
     return ret;
 }
