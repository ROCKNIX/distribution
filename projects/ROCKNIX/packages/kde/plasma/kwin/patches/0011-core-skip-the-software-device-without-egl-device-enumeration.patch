From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 19 Nov 2026 19:41:07 -0800
Subject: [PATCH] core: skip the software device without EGL device enumeration

eglQueryDevicesEXT aborts in libepoxy when the EGL lacks it, as the Mali blob does.
---
--- a/src/core/renderdevice.cpp
+++ b/src/core/renderdevice.cpp
@@ -370,6 +370,11 @@ std::unique_ptr<RenderDevice> RenderDevice::open(const QString &path, int authen
 
 std::unique_ptr<RenderDevice> RenderDevice::createSoftwareDevice(dev_t deviceId)
 {
+    const QByteArrayView clientExtensions(eglQueryString(EGL_NO_DISPLAY, EGL_EXTENSIONS));
+    if (!clientExtensions.contains("EGL_EXT_device_base")
+        && !(clientExtensions.contains("EGL_EXT_device_enumeration") && clientExtensions.contains("EGL_EXT_device_query"))) {
+        return nullptr;
+    }
     EGLint numDevices = 0;
     if (eglQueryDevicesEXT(0, nullptr, &numDevices) != EGL_TRUE) {
         return nullptr;
