. /etc/profile

DISPLAY_PROFILE=/storage/.config/profile.d/095-display
UNIT=/run/systemd/system/essway.service
KBD_UNIT=/run/systemd/system/touchkeyboard.service

display_profile() {
  local connector name con internal second angle=0
  for connector in /sys/class/drm/card*-*; do
    [ "$(cat "${connector}/status" 2>/dev/null)" = "connected" ] || continue
    name=${connector##*/}
    name=${name#*-}
    case ${name} in
      DSI-*|eDP-*) internal=${name} ;;
    esac
    [ "${name}" = "${DEVICE_SECOND_SCREEN}" ] || con=${name}
  done
  grep -qs Lontium /sys/class/drm/card*-DP-1/edid && con=DP-1
  [ "${QUIRK_DEVICE}" = "AYANEO Pocket S 2K" ] && [ -n "${internal}" ] && con=${internal}
  case ${con} in
    DSI-*|eDP-*) angle=$(fbcon_rotation) ;;
  esac
  second=${DEVICE_SECOND_SCREEN}
  [ -z "${second}" ] && [ "${internal}" != "${con}" ] && second=${internal}
  {
    echo "WLR_CON=${con}"
    echo "WLR_CON_TRANSFORM=${angle}"
    [ "${DEVICE_HAS_DUAL_SCREEN}" = "true" ] && [ -n "${second}" ] && echo "SDL_VIDEO_DISPLAY_PRIORITY=${con},${second}"
  } > ${DISPLAY_PROFILE}
  rm -f /storage/.config/profile.d/095-sway
}

if [ "$(session_compositor)" = "kwin" ]; then
  display_profile
  sed 's/sway\.service/kwin.service/g' /usr/lib/systemd/system/essway.service > ${UNIT}
  mkdir -p ${UNIT}.d
  printf '[Service]\nExecStartPre=-/usr/bin/timeout 30 /bin/sh -c "until [ -e /run/rocknix/kwin-ready ]; do sleep 0.1; done"\n' \
    > ${UNIT}.d/kwin-ready.conf
  systemctl mask --runtime sway.service sway-touch.service >/dev/null 2>&1
  systemctl stop sway-touch.service touchkeyboard.service >/dev/null 2>&1
  cat > ${KBD_UNIT} <<UNIT_EOF
[Unit]
Description=KWin touchscreen keyboard

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/bin/sh -c ". /etc/profile.d/001-functions; kwin_keyboard 1"
ExecStop=-/bin/sh -c ". /etc/profile.d/001-functions; kwin_keyboard 0; kwin_keyboard off"
UNIT_EOF
else
  rm -f ${UNIT} ${KBD_UNIT} ${UNIT}.d/kwin-ready.conf
  systemctl unmask --runtime sway.service sway-touch.service >/dev/null 2>&1
fi
systemctl daemon-reload
