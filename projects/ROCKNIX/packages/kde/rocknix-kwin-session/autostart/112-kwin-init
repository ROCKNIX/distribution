. /etc/profile

DISPLAY_PROFILE=/storage/.config/profile.d/095-display

display_profile() {
  local connector name con internal second angle=0
  for connector in /sys/class/drm/card*-*; do
    [ "$(cat "${connector}/status" 2>/dev/null)" = "connected" ] || continue
    name=${connector##*/}
    name=${name#*-}
    case ${name} in
      DSI-*|eDP-*) internal=${name} ;;
    esac
    [ "${name}" = "${DEVICE_SECOND_SCREEN}" ] || con=${name}
  done
  grep -qs Lontium /sys/class/drm/card*-DP-1/edid && con=DP-1
  [ "${QUIRK_DEVICE}" = "AYANEO Pocket S 2K" ] && [ -n "${internal}" ] && con=${internal}
  case ${con} in
    DSI-*|eDP-*) angle=$(fbcon_rotation) ;;
  esac
  second=${DEVICE_SECOND_SCREEN}
  [ -z "${second}" ] && [ "${internal}" != "${con}" ] && second=${internal}
  {
    echo "WLR_CON=${con}"
    echo "WLR_CON_TRANSFORM=${angle}"
    [ "${DEVICE_HAS_DUAL_SCREEN}" = "true" ] && [ -n "${second}" ] && echo "SDL_VIDEO_DISPLAY_PRIORITY=${con},${second}"
  } > ${DISPLAY_PROFILE}
  rm -f /storage/.config/profile.d/095-sway
}

display_profile
