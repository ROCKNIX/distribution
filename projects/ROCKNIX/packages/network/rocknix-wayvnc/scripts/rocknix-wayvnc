#!/bin/sh

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026-present UzuCore (https://github.com/UzuCore)

set -u

runtime_dir="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"
wayland_display="${WAYLAND_DISPLAY:-wayland-1}"

# RK3588 images can use either Weston or Sway. WayVNC only supports wlroots
# compositors, so wait until a real Sway IPC socket is available.
while :; do
  for sway_socket in "${runtime_dir}"/sway-ipc.*.sock; do
    [ -S "${sway_socket}" ] || continue
    [ -S "${runtime_dir}/${wayland_display}" ] || continue

    export SWAYSOCK="${sway_socket}"
    export WAYLAND_DISPLAY="${wayland_display}"

    if swaymsg -q -t get_version >/dev/null 2>&1; then
      exec /usr/bin/wayvnc --max-fps=15 --render-cursor 127.0.0.1:5900
    fi
  done

  sleep 2
done
