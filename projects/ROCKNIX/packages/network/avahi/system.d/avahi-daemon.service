[Unit]
Description=Avahi Daemon
# After network-base.service by name: network.target does not order after
# the units wanted by it, and the daemon publishes whatever the kernel is
# called when it starts (fork #50).
After=network.target network-base.service avahi-defaults.service
Requires=avahi-defaults.service
ConditionPathExists=/storage/.cache/services/avahi.conf

[Service]
Restart=on-failure
EnvironmentFile=-/run/rocknix/debug/avahi.conf
ExecStart=/usr/sbin/avahi-daemon -s $AVAHI_DEBUG
ExecReload=/usr/sbin/avahi-daemon -r
TimeoutStopSec=1s
RestartSec=2
StartLimitInterval=60
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
