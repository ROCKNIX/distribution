STATE_DIR = "/var/run/cloud_oauth"
RCLONE = "/usr/bin/rclone"
LOCAL_AUTH = "http://127.0.0.1:53682"
# How long `rclone authorize` has to print its local link.
AUTHORIZE_WAIT = 20
LOG_FILE = "/var/log/cloud_sync.log"


def log(message):
    import datetime
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(LOG_FILE, "a") as handle:
            handle.write("[%s] [INFO] [cloud_oauth] %s\n" % (stamp, message))
    except OSError:
        pass


def state_path(name):
    return os.path.join(STATE_DIR, name)


# session.json is written by three threads of the serve (the collector, the
# request handlers, the main thread) and read by other processes (`status`,
# `info`, the interface). It was truncated and rewritten in place, and
# read_state turns a half-written file into {} -- a status that read idle
# for a moment while a sign-in was completing, and a merge that could write
# that emptiness back (#308 claude F-RS-23, gpt F-RS-17). So: one writer at
# a time within the process, and every write a whole file renamed over the
# old one, which a reader in any process sees before or after, never during.
#
# And one writer across processes too: a serve being cancelled and the one
# replacing it write the same file, so a read-modify-write holds an flock on
# session.lock as well (the audit of stream C, G-C-02). flock is bound here,
# not looked up through the fcntl module, so a test that stands in for the
# module's ioctl leaves it alone.
_STATE_LOCK = threading.Lock()
_flock, _LOCK_EX = fcntl.flock, fcntl.LOCK_EX


@contextlib.contextmanager
def _state_locked():
    with _STATE_LOCK:
        os.makedirs(STATE_DIR, exist_ok=True)
        fd = os.open(state_path("session.lock"), os.O_RDWR | os.O_CREAT, 0o600)
        try:
            _flock(fd, _LOCK_EX)
            yield
        finally:
            os.close(fd)


def _write_whole(data):
    os.makedirs(STATE_DIR, exist_ok=True)
    path = state_path("session.json")
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w") as handle:
        json.dump(data, handle)
    os.replace(tmp, path)


def write_state(**fields):
    with _state_locked():
        existing = read_state()
        existing.update(fields)
        _write_whole(existing)


def write_owned(attempt, owner=None, from_status=None, **fields):
    """write_state, if the state still belongs to this serve's attempt.

    Each serve stamps the state with an attempt id of its own (cmd_serve's
    reset_state). A collector from a serve that has since been replaced --
    its rclone killed by the replacement, or dying as the old serve tears
    down -- would otherwise write its failure over the new attempt's state,
    and the merge kept that error beside the new attempt's "waiting" (G-C-02
    claude). An attempt of None owns whatever is there: a Session made
    outside a serve.

    owner, when given, is the session within the serve that must still be
    the one the state names (SessionHolder.start writes it): a restart
    replaces the session and keeps the serve. from_status, when given, is
    the statuses this write may move the state from. Together they keep the
    state moving forward: a dead attempt is not republished as waiting, and
    an attempt that was replaced, cancelled or timed out is not reopened as
    signed-in (the audit of the fix round, PL-032). A state with no status
    yet -- a Session made outside a serve -- counts as None. Checked and
    written under the state's lock. Returns whether it wrote.
    """
    with _state_locked():
        existing = read_state()
        if attempt is not None and existing.get("attempt") != attempt:
            return False
        if owner is not None and existing.get("session") != owner:
            return False
        if from_status is not None and existing.get("status") not in from_status:
            return False
        existing.update(fields)
        _write_whole(existing)
        return True


def reset_state(**fields):
    """Replace the state, rather than merging into it.

    write_state merges, which is right while one sign-in is running and wrong
    between two: a finished attempt leaves its address, PIN and provider link
    behind, and the next page to read them shows a previous session's code as
    though it were live. Anyone typing it in gets a flat refusal from a
    listener that is waiting for a different number.
    """
    os.makedirs(STATE_DIR, exist_ok=True)
    # The markers are part of the state. A completion marker left by the last
    # attempt would tell the next one's window to show "Finishing up" before
    # anybody had signed in to anything.
    for name in ("open-browser", "close-browser", "signed-in", "page",
                 "phone-keyboard", "field"):
        try:
            os.unlink(state_path(name))
        except OSError:
            pass
    with _state_locked():
        _write_whole(dict(fields))


def read_state():
    try:
        with open(state_path("session.json")) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def lan_address():
    """The address a phone on the same network would use.

    Asks the routing table which source address reaches the outside world,
    without sending anything -- a connected UDP socket only picks a route.
    """
    probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        probe.connect(("192.0.2.1", 9))  # TEST-NET-1: routable, never answers
        return probe.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        probe.close()


def provider_url(local_url):
    """Turn rclone's local auth URL into the provider's real sign-in URL.

    rclone answers /auth with a redirect carrying its own client id, scopes
    and state. Following it here rather than in the player's browser is the
    whole trick: the phone then goes straight to the provider and never needs
    to reach this device.
    """
    request = urllib.request.Request(local_url)

    class NoRedirect(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, *args, **kwargs):
            return None

    opener = urllib.request.build_opener(NoRedirect)
    try:
        opener.open(request, timeout=10)
    except urllib.error.HTTPError as exc:
        location = exc.headers.get("Location")
        if location:
            return location
    except OSError:
        pass
    return None


class Session:
    """One sign-in attempt: rclone's process, its URL, and the result."""

    def __init__(self, backend, remote_name, timeout):
        self.backend = backend
        self.remote_name = remote_name
        self.timeout = timeout
        self.proc = None
        self.provider = None
        self.token = None
        # Set by the holder, so a sign-in that finishes on the device can
        # close the window without this needing to know what a window is.
        self.on_signed_in = None
        # True once the remote exists and has answered -- never earlier (see
        # _write_config).
        self.configured = False
        self._config_lock = threading.Lock()
        self._config_result = None
        # Set by the holder when this attempt stops speaking for the state:
        # another attempt replaced it (whose start kills this one's rclone),
        # or the serve is ending (holder.end kills it). Either way this
        # one's collector is woken by a death it must not report as a
        # failed sign-in (PL-050, G-C-02).
        self.superseded = False
        # The serve's attempt id, which the state carries (write_owned), and
        # this session's own within it (SessionHolder.start): a restart keeps
        # the serve and replaces the session (PL-032).
        self.attempt = None
        self.gen = None
        # The thread that collects rclone's output and finishes the job;
        # SessionHolder.end lets one that is saving a remote finish.
        self.collector = None
        self.error = None
        # rclone's own last words. It exits fatally when the exchange fails,
        # and what it says -- "code doesn't exist or has expired" against
        # anything else -- is the difference between "you were too slow, here
        # is another link" and "something is actually wrong". Reporting a
        # generic failure for both sent the tester back to the handheld when
        # one tap would have done.
        self.rclone_says = ""

    def finished(self):
        return self.proc is not None and self.proc.poll() is not None

    def start(self):
        # A previous attempt still holding 53682 would make this one fail with
        # "address already in use", which reads as a provider problem.
        subprocess.run(["pkill", "-f", "rclone authorize"],
                       capture_output=True)
        time.sleep(1)

        self.proc = subprocess.Popen(
            [RCLONE, "authorize", self.backend, "--auth-no-open-browser"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)

        # The wait for the link is bounded by the clock, not by rclone. It
        # was a readline() under a deadline checked between lines, so an
        # authorize that printed nothing held this -- and the interface's
        # sign-in page -- for as long as it cared to (#308 gpt F-RS-19).
        # Raw reads under select(), then: whatever arrived after the link
        # goes to the collector with the rest.
        deadline = time.time() + AUTHORIZE_WAIT
        fd = self.proc.stdout.fileno()
        pending = b""
        local = None
        while local is None:
            left = deadline - time.time()
            if left <= 0:
                break
            ready, _, _ = select.select([fd], [], [], left)
            if not ready:
                break
            chunk = os.read(fd, 4096)
            if not chunk:
                break
            pending += chunk
            match = re.search(rb"(http://127\.0\.0\.1:53682/auth\?state=\S+)\s", pending)
            if match:
                local = match.group(1).decode()
        self.early_output = pending.decode("utf-8", "replace")
        if not local:
            self.error = "rclone did not offer a sign-in link"
            if self.proc.poll() is None:
                self.proc.terminate()
                try:
                    self.proc.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    self.proc.kill()
            return False

        self.provider = provider_url(local)
        if not self.provider:
            self.error = "could not read the provider's sign-in address"
            return False

        # Everything after this point is rclone waiting for the redirect, so
        # collect its output off-thread; the token appears there when the
        # replay lands.
        self.collector = threading.Thread(target=self._collect, daemon=True)
        self.collector.start()
        log("sign-in started for %s" % self.backend)
        return True

    def _collect(self):
        # What start() read past the link comes first, through the same
        # checks: a provider that refuses at once puts rclone's last words in
        # that first read, and they went into the buffer without being looked
        # at, so the failure said nothing of why (the audit of stream C,
        # G-C-10).
        buffer = ""
        early = getattr(self, "early_output", "")
        for line in itertools.chain(early.splitlines(True), self.proc.stdout):
            buffer += line
            if line.startswith("Error: ") or "Fatal error:" in line:
                self.rclone_says = line.split("error: ")[-1].strip() or line.strip()
            if "<---End paste" in buffer or "Paste the following" in buffer:
                match = re.search(r"(\{.*\})", buffer, re.S)
                if match:
                    self.token = match.group(1).strip()
                    break
        self.proc.wait()

        # Finish the job. rclone's own server takes the redirect when the page
        # is on the handheld, so nothing is ever pasted back and submit() --
        # which was the only caller of _write_config -- never runs. The token
        # arrived, was collected here, and stopped: no remote was created and
        # the status stayed "waiting", so a sign-in that had actually
        # succeeded was reported as unfinished and had to be started again.
        if self.token and not self.configured:
            ok, detail = self._write_config()
            if ok:
                log("sign-in completed on the device")
                if self.on_signed_in:
                    try:
                        self.on_signed_in()
                    except Exception as exc:      # never take the thread down
                        log("post-sign-in step failed: %s" % exc)
            else:
                log("could not finish the sign-in: %s" % detail)
                # Only while this attempt still speaks for the state: a
                # restart may have replaced it while its remote was being
                # created (G-C-02 gpt).
                if not self.superseded:
                    self._fail_owned(detail, ("starting", "waiting", "failed"))
        elif not self.token and not self.superseded:
            # rclone ended without a token: the provider refused, the
            # exchange failed, or it was killed. Nothing else is going to
            # finish this attempt, and the on-device path has no page to
            # say so -- the status stayed "waiting" until the serve timed
            # out, and the interface's STILL WAITING told the player to
            # finish an attempt that was already dead (audit #307 PL-050).
            if self._fail_owned(self.failure_reason(), ("starting", "waiting")):
                log("the sign-in ended without a token")

    def _fail_owned(self, error, from_status):
        """Mark the attempt failed -- only while this serve's attempt owns
        the state and the status is one of from_status, checked and written
        under the state's lock."""
        with _state_locked():
            existing = read_state()
            if self.attempt is not None and existing.get("attempt") != self.attempt:
                return False
            if self.gen is not None and existing.get("session") != self.gen:
                return False
            if existing.get("status") not in from_status:
                return False
            existing.update(status="failed", error=error)
            _write_whole(existing)
            return True

    def failure_reason(self):
        """Why the attempt died, in words a player can act on."""
        said = self.rclone_says
        if "expired" in said or "invalid_grant" in said:
            return ("That address had already expired — they are only good "
                    "for a couple of minutes.")
        if said:
            return "The provider refused it: %s" % said[:160]
        return "The provider did not accept that address."

    def submit(self, pasted):
        """Replay the provider's redirect to rclone's waiting server.

        Accepts the whole failed URL or just the code, because the player is
        copying from a phone's address bar on a page that did not load, and
        which of the two they manage to grab is not something to be strict
        about.
        """
        pasted = pasted.strip()
        query = None
        if "code=" in pasted:
            parsed = urllib.parse.urlparse(pasted)
            query = parsed.query or pasted.split("?", 1)[-1]
        elif pasted:
            state = urllib.parse.parse_qs(
                urllib.parse.urlparse(self.provider).query).get("state", [""])[0]
            query = urllib.parse.urlencode({"code": pasted, "state": state})
        if not query:
            # Nothing was replayed, so the attempt is still alive and they can
            # simply paste again -- worth distinguishing from the dead-session
            # case below.
            return False, ("Nothing was pasted. Go to the page that failed "
                           "to load, copy its whole address from the browser "
                           "bar, and paste it here.")

        try:
            urllib.request.urlopen("%s/?%s" % (LOCAL_AUTH, query), timeout=15).read()
        except urllib.error.HTTPError:
            pass  # rclone answers the redirect with its own page; not an error
        except OSError as exc:
            return False, "could not hand the code back to rclone: %s" % exc

        for _ in range(40):
            if self.token:
                return self._write_config()
            if self.proc.poll() is not None and not self.token:
                # rclone's authorize server serves exactly one redirect and
                # then exits, so a wrong or expired code ends the attempt
                # rather than allowing another go. Say that, because the
                # player is looking at a page that still has a working-looking
                # form on it and would otherwise keep pasting into a session
                # that no longer exists.
                return False, self.failure_reason()
            time.sleep(0.5)
        return False, "Timed out waiting for the provider."

    def _write_config(self):
        """Create the remote, once per attempt, and say how it went.

        Two paths can reach this -- the redirect landing on rclone directly
        (the collector) and a code pasted back from a phone (submit) -- and
        they can overlap. The first does the work; the second waits for it
        and is handed the same answer. `configured` used to be set on the
        way in, so a second caller was told "Connected" while the first was
        still creating and checking the remote, and even when that then
        failed (audit #307 PL-048). It is set now only from the result.
        """
        with self._config_lock:
            if self._config_result is None:
                self._config_result = self._create_remote()
                self.configured = bool(self._config_result[0])
            return self._config_result

    def _create_remote(self):
        # One create at a time within the serve: an attempt that finishes
        # late removes what it made (below) before a newer one asks whether
        # that name is taken.
        with _CREATE_LOCK:
            return self._create_remote_locked()

    def _create_remote_locked(self):
        name = self.remote_name or self.backend
        # Replaced or closed before its token could be saved: nothing is
        # made (PL-032).
        if self.superseded:
            log("the sign-in was closed before its remote was saved; nothing was saved")
            return False, CLOSED_EARLY
        # Which remotes exist, or no create at all: a listing that failed
        # read as "none of that name" and the create went ahead over
        # whatever was there (#308 gpt F-RS-23).
        listed = subprocess.run([RCLONE, "listremotes"],
                                capture_output=True, text=True)
        if listed.returncode != 0:
            log("could not list the configured remotes (exit %d); not creating one"
                % listed.returncode)
            return False, ("The sign-in worked, but your handheld's cloud "
                           "settings couldn't be read.")
        if "%s:" % name in listed.stdout.split():
            return False, "a remote called '%s' already exists" % name

        result = subprocess.run(
            [RCLONE, "config", "create", name, self.backend,
             "token=%s" % self.token, "--non-interactive"],
            capture_output=True, text=True)
        if result.returncode != 0:
            # A fixed sentence, and rclone's exit code in the log -- never its
            # words. They went to cloud_sync.log as "could not finish the
            # sign-in: <rclone's stderr>" and into the page, and an rclone
            # that echoed a parameter would have put the token there (audit
            # #307 PL-074).
            log("rclone could not save the remote (exit %d)" % result.returncode)
            return False, ("The sign-in worked, but it couldn't be saved on "
                           "your handheld.")

        # Prove it before saying so. A token that parses is not a token that
        # works, and cloud_remote takes the same posture.
        check = subprocess.run(
            [RCLONE, "lsd", "%s:" % name, "--contimeout", "10s",
             "--timeout", "20s", "--low-level-retries", "1", "--retries", "1"],
            capture_output=True, text=True)
        if check.returncode != 0:
            gone = subprocess.run([RCLONE, "config", "delete", name],
                                  capture_output=True)
            if gone.returncode != 0:
                log("remote %s did not respond and could not be removed either "
                    "(rclone config delete exited %d); it stays until the next "
                    "sign-in replaces it" % (name, gone.returncode))
            return False, "signed in, but the remote did not respond"

        # Published only while this attempt still speaks for the state, and
        # only from starting or waiting. The write's answer used to be
        # dropped: an attempt a restart had replaced, or one the serve had
        # already closed -- its timeout's failed, a cancel's idle -- went on
        # to return success, and its caller stopped the pad and wrote the
        # signed-in marker `wait` returns on, over a state that said
        # otherwise; a remote no screen had reported stayed, and the next
        # sign-in of that name was refused as already there (the audit of
        # the fix round, PL-032: gpt G2-C-03, the blind pass's S-25, claude
        # G2-C-03). Refused, the remote this attempt made is taken away
        # again, so what the device holds is what the state says.
        if not write_owned(self.attempt, owner=self.gen,
                           from_status=(None, "starting", "waiting"),
                           status="signed-in", remote=name):
            # Checked, not assumed (the audit of the fixes, gpt G3-D-06): a
            # delete that fails leaves the remote installed, and the log
            # said it was gone.
            gone = subprocess.run([RCLONE, "config", "delete", name],
                                  capture_output=True)
            if gone.returncode == 0:
                log("the sign-in finished after it had been closed or replaced; "
                    "the remote it made was removed")
            else:
                log("the sign-in finished after it had been closed or replaced; "
                    "the remote it made could NOT be removed (rclone config "
                    "delete exited %d) and stays until the next sign-in "
                    "replaces it" % gone.returncode)
            return False, CLOSED_EARLY
        log("remote %s created for %s" % (name, self.backend))
        return True, name


# What a closed or replaced attempt's own late ending says, on the phone and
# in the log, when it has one to say.
CLOSED_EARLY = "That sign-in was closed before it finished."

# One remote created at a time in this process (Session._create_remote).
_CREATE_LOCK = threading.Lock()


# rclone's backend names are lowercase identifiers ("dropbox", "onedrive").
# They are not what the provider calls itself, and a page headed "Connect
# dropbox" reads like a typo on the one screen where the player is deciding
# whether to trust us with their storage. The handheld passes the curated name
# it already shows in its own menu; this map is the fallback for a backend
# reached some other way, and title-casing is the fallback for that.
DISPLAY_NAMES = {
    "acd": "Amazon Drive", "box": "Box", "drive": "Google Drive",
    "dropbox": "Dropbox", "gcs": "Google Cloud Storage",
    "gphotos": "Google Photos", "hidrive": "HiDrive", "jottacloud": "Jottacloud",
    "mailru": "Mail.ru Cloud", "onedrive": "Microsoft OneDrive",
    "opendrive": "OpenDrive", "pcloud": "pCloud",
    "premiumizeme": "premiumize.me", "putio": "put.io",
    "sharefile": "Citrix ShareFile", "sugarsync": "SugarSync",
    "yandex": "Yandex Disk", "zoho": "Zoho WorkDrive",
    "filefabric": "Enterprise File Fabric",
}


def display_name(backend, label=None):
    # Our curated name wins where we have one: rclone's descriptions are
    # written for its documentation ("Google Cloud Storage (this is not Google
    # Drive)"), which is accurate and wrong as a page heading. The passed
    # label -- rclone's description, by way of the handheld's menu -- covers
    # everything else, and title-casing covers a backend reached from a shell.
    if backend in DISPLAY_NAMES:
        return DISPLAY_NAMES[backend]
    if label:
        return label
    return backend.replace("_", " ").title()


# Single %, not %%: this is substituted into the templates as a *value*
# (%(style)s), so its percent signs are never seen by the formatter. Escaping
# them the way the templates do shipped "width:100%%" as literal CSS, which
# every browser discards -- which is how a four-character PIN box ended up
# rendering at its default twenty-character width with wide letter spacing,
# overflowing the card on a phone.
