"""


# Linux input constants, from include/uapi/linux/input-event-codes.h.
EV_SYN, EV_KEY = 0x00, 0x01
SYN_REPORT = 0
UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_SET_RELBIT = 0x40045566
EV_REL = 0x02
REL_X, REL_Y, REL_WHEEL = 0x00, 0x01, 0x08
BTN_LEFT = 0x110
# vendor:product:name, as sway forms it -- 0x1209/0x0002 and the device name
# with spaces turned into underscores.
POINTER_ID = "4617:2:ROCKNIX_cloud_pointer"
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502

# US layout, which is what the on-screen keyboard and the browser both assume.
# Only what a sign-in needs: an address, a password, and the keys to correct
# and submit them.
KEYMAP = {}
for _i, _c in enumerate("abcdefghijklmnopqrstuvwxyz"):
    KEYMAP[_c] = ((30, 48, 46, 32, 18, 33, 34, 35, 23, 36, 37, 38, 50,
                   49, 24, 25, 16, 19, 31, 20, 22, 47, 17, 45, 21, 44)[_i], False)
for _i, _c in enumerate("1234567890"):
    KEYMAP[_c] = (2 + _i, False)
KEYMAP.update({
    " ": (57, False), "-": (12, False), "=": (13, False), "[": (26, False),
    "]": (27, False), "\\": (43, False), ";": (39, False), "'": (40, False),
    "`": (41, False), ",": (51, False), ".": (52, False), "/": (53, False),
})
for _plain, _shifted in zip("1234567890-=[]\\;',./`", '!@#$%^&*()_+{}|:"<>?~'):
    KEYMAP[_shifted] = (KEYMAP[_plain][0], True)
for _c in "abcdefghijklmnopqrstuvwxyz":
    KEYMAP[_c.upper()] = (KEYMAP[_c][0], True)

NAMED_KEYS = {"enter": 28, "backspace": 14, "tab": 15, "escape": 1,
              "left": 105, "right": 106, "up": 103, "down": 108,
              "home": 102, "end": 107, "delete": 111,
              "pageup": 104, "pagedown": 109,
              "f1": 59, "f2": 60, "f3": 61, "f4": 62}
KEY_LEFTSHIFT = 42

# How long a key is held, and the gap before the next one. Roughly 130 words
# per minute -- faster than anyone types, slow enough that a page's own input
# handling sees each keystroke as a separate event.
KEY_HOLD = 0.012
KEY_GAP = 0.022


class RemoteMouse:
    """A pointer the phone can drag, for the page on the handheld.

    A real uinput pointer rather than a cursor we draw: sway renders it and
    WebKit receives genuine pointer events, so hovering, clicking and
    dismissing work on anything a page can put on screen -- including a
    cross-origin iframe, whose contents no amount of focus traversal can
    reach. That is what a consent banner and a "sign in with Google" prompt
    turned out to be, between them covering most of a four-inch screen with
    no way to dismiss either.

    The phone is the natural surface to drag it from: it has the touchscreen
    the handheld does not.
    """

    def __init__(self):
        self.fd = None

    def open(self):
        if self.fd is not None:
            return True
        try:
            fd = os.open(UINPUT, os.O_WRONLY | os.O_NONBLOCK)
        except OSError as exc:
            log("no virtual pointer: %s" % exc)
            return False
        try:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_REL)
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_SYN)
            for axis in (REL_X, REL_Y, REL_WHEEL):
                fcntl.ioctl(fd, UI_SET_RELBIT, axis)
            fcntl.ioctl(fd, UI_SET_KEYBIT, BTN_LEFT)
            name = b"ROCKNIX cloud pointer".ljust(80, b"\0")
            os.write(fd, name + struct.pack("HHHHi", 0x03, 0x1209, 0x0002, 1, 0)
                     + b"\0" * (4 * 64 * 4))
            fcntl.ioctl(fd, UI_DEV_CREATE)
        except OSError as exc:
            log("could not create the virtual pointer: %s" % exc)
            os.close(fd)
            return False
        time.sleep(0.5)
        self.fd = fd

        # Flat profile, no acceleration. libinput's default adapts to speed,
        # which is right for a hand on a desk and wrong for a finger on a
        # phone driving somebody else's screen: the same drag covers a
        # different distance depending how fast it was, so the pointer feels
        # to pull towards things and to drift. Flat makes a delta a delta.
        for setting in (["accel_profile", "flat"], ["pointer_accel", "0"]):
            try:
                subprocess.run(["swaymsg", "input", POINTER_ID] + setting,
                               capture_output=True, timeout=5,
                               env=dict(os.environ, **sway_env()))
            except (OSError, subprocess.SubprocessError) as exc:
                log("could not flatten the pointer: %s" % exc)
        log("virtual pointer ready")
        return True

    def _emit(self, etype, code, value):
        now = time.time()
        os.write(self.fd, struct.pack("llHHi", int(now),
                                      int((now % 1) * 1000000),
                                      etype, code, value))

    def move(self, dx, dy):
        if self.fd is None and not self.open():
            return False
        if dx:
            self._emit(EV_REL, REL_X, int(dx))
        if dy:
            self._emit(EV_REL, REL_Y, int(dy))
        self._emit(EV_SYN, SYN_REPORT, 0)
        return True

    def click(self):
        if self.fd is None and not self.open():
            return False
        # Press and release as separate reports, for the same reason the
        # keyboard does: a page's own handlers read one fused report as a
        # single indivisible event and often ignore it.
        self._emit(EV_KEY, BTN_LEFT, 1)
        self._emit(EV_SYN, SYN_REPORT, 0)
        time.sleep(0.03)
        self._emit(EV_KEY, BTN_LEFT, 0)
        self._emit(EV_SYN, SYN_REPORT, 0)
        return True

    def scroll(self, clicks):
        if self.fd is None and not self.open():
            return False
        self._emit(EV_REL, REL_WHEEL, int(clicks))
        self._emit(EV_SYN, SYN_REPORT, 0)
        return True

    def close(self):
        if self.fd is None:
            return
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except OSError:
            pass
        os.close(self.fd)
        self.fd = None


class RemoteKeyboard:
    """A keyboard the phone can type on, for the window on the handheld.

    The player reads the provider's page on the device's own screen and types
    on the keyboard they already know how to use. Nothing is mirrored, so the
    only thing crossing the network is a keystroke -- which is why this
    replaced streaming the display.

    uinput rather than the Wayland virtual-keyboard protocol: it needs no
    Wayland client of our own, and sway picks the device up through libinput
    exactly as it would a keyboard someone plugged in.
    """

    def __init__(self):
        self.fd = None

    def open(self):
        if self.fd is not None:
            return True
        try:
            fd = os.open(UINPUT, os.O_WRONLY | os.O_NONBLOCK)
        except OSError as exc:
            log("no virtual keyboard: %s" % exc)
            return False
        try:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_SYN)
            for code in set(list(NAMED_KEYS.values())
                            + [c for c, _ in KEYMAP.values()] + [KEY_LEFTSHIFT]):
                fcntl.ioctl(fd, UI_SET_KEYBIT, code)
            # struct uinput_user_dev: name[80], id{bustype,vendor,product,
            # version}, ff_effects_max, then the absmin/max/fuzz/flat arrays.
            name = b"ROCKNIX cloud sign-in".ljust(80, b"\0")
            os.write(fd, name + struct.pack("HHHHi", 0x03, 0x1209, 0x0001, 1, 0)
                     + b"\0" * (4 * 64 * 4))
            fcntl.ioctl(fd, UI_DEV_CREATE)
        except OSError as exc:
            log("could not create the virtual keyboard: %s" % exc)
            os.close(fd)
            return False
        # udev and libinput need a moment to notice a new device.
        time.sleep(0.5)
        self.fd = fd
        log("virtual keyboard ready")
        return True

    def _emit(self, etype, code, value):
        now = time.time()
        os.write(self.fd, struct.pack("llHHi", int(now),
                                      int((now % 1) * 1000000), etype, code, value))

    def _tap(self, code, shift=False):
        """One keypress, reported the way a real keyboard reports it.

        Each state change is its own SYN_REPORT, and press and release are
        separated in time. Sending press and release in a single report, with
        zero timestamps, is not what any hardware does: libinput and the
        page's own input handling both read it as one indivisible blur, and a
        typed address arrived truncated -- six characters of sixteen. The
        delays below are what a fast typist produces, and cost nothing that
        matters when the whole point is to save somebody a minute on a d-pad.
        """
        if shift:
            self._emit(EV_KEY, KEY_LEFTSHIFT, 1)
            self._emit(EV_SYN, SYN_REPORT, 0)
            time.sleep(KEY_GAP)
        self._emit(EV_KEY, code, 1)
        self._emit(EV_SYN, SYN_REPORT, 0)
        time.sleep(KEY_HOLD)
        self._emit(EV_KEY, code, 0)
        self._emit(EV_SYN, SYN_REPORT, 0)
        if shift:
            time.sleep(KEY_GAP)
            self._emit(EV_KEY, KEY_LEFTSHIFT, 0)
            self._emit(EV_SYN, SYN_REPORT, 0)

    def type_text(self, text):
        """Send printable characters. Returns how many were sent."""
        if not self.open():
            return 0
        sent = 0
        for char in text:
            entry = KEYMAP.get(char)
            if entry is None:
                continue        # not on a US layout; silently skipped
            self._tap(*entry)
            time.sleep(KEY_GAP)
            sent += 1
        return sent

    def press(self, name):
        code = NAMED_KEYS.get(name)
        if code is None or not self.open():
            return False
        self._tap(code)
        return True

    def close(self):
        if self.fd is None:
            return
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except OSError:
            pass
        os.close(self.fd)
        self.fd = None


# The handheld's controls, as the kernel reports them. A gamepad is not a
# keyboard: sway classifies this one as a tablet_pad, so GTK and WebKit
# receive nothing at all from it. Without this bridge the sign-in page is
# visible on the device and cannot be touched from the device -- and, worse,
# cannot be left.
BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST = 304, 305, 307, 308
BTN_TL, BTN_TR, BTN_SELECT, BTN_START, BTN_MODE = 310, 311, 314, 315, 316
BTN_DPAD_UP, BTN_DPAD_DOWN, BTN_DPAD_LEFT, BTN_DPAD_RIGHT = 544, 545, 546, 547
# A d-pad is not always four buttons. HID and xpad-class pads report it as a
# hat -- two axes that read -1, 0 or 1 -- and the bridge used to find only
# pads with BTN_DPAD_UP and to drop every EV_ABS event, so on such a pad the
# page could not be driven and Select+Start never reached it (#308 gpt
# F-RS-16, claude F-RS-06).
EV_ABS = 0x03
ABS_HAT0X, ABS_HAT0Y = 0x10, 0x11
HAT_KEYS = {(ABS_HAT0X, -1): "left", (ABS_HAT0X, 1): "right",
            (ABS_HAT0Y, -1): "up", (ABS_HAT0Y, 1): "down"}
SYS_INPUT = "/sys/class/input"

# Arrows rather than Tab: WebKit's spatial navigation moves focus in the
# direction pressed, which is what a d-pad means. Tab order on a login page
# wanders through cookie banners and footer links.
# BTN_EAST is the button labelled A on this hardware, not BTN_SOUTH. These
# handhelds use the Nintendo layout, where A sits in the east position --
# EmulationStation's own es_input.cfg maps a=button 1 (BTN_EAST) and
# b=button 0 (BTN_SOUTH). Taking the Xbox reading meant the player pressed A
# and got a backspace.
GAMEPAD_KEYS = {
    BTN_DPAD_UP: "up", BTN_DPAD_DOWN: "down",
    BTN_DPAD_LEFT: "left", BTN_DPAD_RIGHT: "right",
    BTN_EAST: "enter",             # A activates what is focused
    BTN_SOUTH: "backspace",        # B goes back, as it does everywhere else
    # Y reaches a consent banner first, then behaves as Tab. The d-pad
    # cannot get to one at all -- spatial navigation will not descend into a
    # fixed-position element -- and Tab alone costs about ten presses.
    BTN_NORTH: "f4",
    BTN_WEST: "f1",                # X shows and hides the on-screen keyboard
    # L1/R1 scroll the page. The window turns these into a scroll in the
    # page rather than page-up/page-down, which do nothing while a text
    # field has the caret -- which is most of a sign-in form, and exactly
    # when the button below the fold is what cannot be reached.
    BTN_TL: "f2", BTN_TR: "f3",
}

# Select held, then Start: the same combination RetroArch uses to leave a
# game on this hardware, so it is already in players' fingers.
# A combination rather than any single button. Select alone is far too easy
# to catch while reaching across a small handheld, and losing a half-typed
# password to a stray thumb is worse than needing two buttons to leave.
#
# Either Select or Mode holds it, because which one is "the hotkey" is not
# the same on every handheld. On the RG35XX SP, ES's own es_input.cfg maps
# hotkeyenable to button 8, which is BTN_MODE on that pad -- not Select. A
# player whose muscle memory is Mode+Start would find Select+Start does
# nothing, and a player who knows Select+Start would find the same. Both
# are two-button combinations and neither is reachable by a stray thumb,
# so accepting both costs nothing and guesses at nothing.
GAMEPAD_HOLD = (BTN_SELECT, BTN_MODE)
GAMEPAD_QUIT = BTN_START


def find_gamepad():
    """The device node for the handheld's controls, and the buttons it has.

    Named lookups would need a table per device -- "H700 Gamepad" on one
    handheld is something else on the next. A device carrying BTN_SOUTH and a
    d-pad is a gamepad whatever it calls itself.

    Returns (node, codes) so callers can ask what the pad actually has
    rather than assume. Nothing here is uniform across handhelds: the
    RG35XX SP has a Mode button and ES maps its hotkey to it, while smaller
    pads have no such button at all.
    """
    try:
        entries = sorted(os.listdir(SYS_INPUT))
    except OSError:
        return None, set()
    for entry in entries:
        if not entry.startswith("event"):
            continue
        codes = _capabilities(entry, "key")
        if codes is None:
            continue
        axes = _capabilities(entry, "abs") or set()
        if BTN_SOUTH in codes and (BTN_DPAD_UP in codes or ABS_HAT0Y in axes):
            return "/dev/input/" + entry, codes
    return None, set()


def _capabilities(entry, kind):
    """The codes an input device reports for one event type, from sysfs's
    bitmap (hex words, most significant first), or None when unreadable."""
    try:
        with open("%s/%s/device/capabilities/%s" % (SYS_INPUT, entry, kind)) as handle:
            words = handle.read().split()
    except (OSError, ValueError):
        return None
    codes = set()
    for index, word in enumerate(reversed(words)):
        value = int(word, 16)
        codes |= {index * 64 + bit for bit in range(value.bit_length())
                  if value >> bit & 1}
    return codes


def exit_hint():
    """What the page and the window call the exit combination: one string,
    the same on every handheld. It reads nothing from the pad.

    Either Select or Mode holds it (GAMEPAD_HOLD), because which one a player
    reaches for differs by device -- the RG351M and RG353M have no Mode
    button, the RG35XX SP does and ES maps its own hotkey to it. The words
    name only the pair every handheld has (#308 claude F-RS-14: this said it
    read the pad).
    """
    # One combination on screen, always. "MODE OR SELECT + START" read as
    # though Mode alone were a way out, and a help line that has to be parsed
    # is worse than one that covers fewer of the buttons that happen to work.
    # Mode is still accepted -- see GAMEPAD_HOLD -- it is simply not what we
    # tell people, because Select and Start are labelled on every handheld we
    # ship for and Mode is not.
    return "SELECT + START"


# _IOW('E', 0x90, int) -- take a device exclusively, so nobody else sees it.
EVIOCGRAB = 0x40044590


def signin_window_running():
    """Is the sign-in window up?

    Matched on argv[0], not on comm: comm truncates at 15 characters, so
    "cloud-signin-window" appears there as "cloud-signin-wi". A pattern that
    looks right and matches nothing has already cost this project a cleanup
    loop that silently did nothing.
    """
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % entry, "rb") as handle:
                argv = handle.read().split(b"\0")
        except OSError:
            continue
        if argv and argv[0].decode("utf-8", "replace") == SIGNIN_WINDOW:
            return True
    return False


def pad_is_free():
    """Can somebody else open the gamepad exclusively?

    This is the condition EmulationStation needs before it re-initialises:
    SDL re-opens the joystick on init, and if our bridge still held the grab
    ES would come back with no gamepad at all until it was restarted. Testing
    the grab directly beats sleeping and hoping.
    """
    node, _codes = find_gamepad()
    if not node:
        return True
    try:
        fd = os.open(node, os.O_RDONLY)
    except OSError:
        return True
    try:
        fcntl.ioctl(fd, EVIOCGRAB, 1)
        fcntl.ioctl(fd, EVIOCGRAB, 0)
        return True
    except OSError:
        return False
    finally:
        os.close(fd)


class GamepadBridge:
    """Turn the handheld's buttons into keystrokes for the sign-in page.

    Reads the gamepad's event node and replays each press through the same
    virtual keyboard the phone types on.

    It takes the pad **exclusively** (EVIOCGRAB) for as long as the window is
    up. EmulationStation is still running behind this page and holds the same
    node open; SDL joystick events are not gated on window focus the way
    keyboard events are, and `InputManager::parseEvent` runs for every event
    with no foreground check. So without the grab every d-pad press and every
    A meant for the provider's page is also driving the menu behind it --
    scrolling it, and activating whatever row happens to be selected.

    Typing was never affected: keys reach the compositor, which delivers them
    to the focused surface only.

    A grab that outlived the window would leave the player holding a handheld
    whose buttons do nothing, so the loop watches the browser process and
    releases the moment it is gone -- see the select() timeout below, which
    exists to make that check happen even when nobody is pressing anything.
    """

    def __init__(self, keyboard, on_quit, alive=None):
        self.keyboard = keyboard
        self.on_quit = on_quit
        self.alive = alive
        self.thread = None
        self.stop_flag = threading.Event()

    def start(self):
        node, _codes = find_gamepad()
        if not node:
            log("no gamepad found; the sign-in page can only be driven from a phone")
            return False
        self.thread = threading.Thread(target=self._run, args=(node,), daemon=True)
        self.thread.start()
        log("gamepad bridge reading %s" % node)
        return True

    def _run(self, node):
        try:
            fd = os.open(node, os.O_RDONLY)
        except OSError as exc:
            log("could not read the gamepad: %s" % exc)
            return

        grabbed = False
        try:
            fcntl.ioctl(fd, EVIOCGRAB, 1)
            grabbed = True
        except OSError as exc:
            # Not fatal: the page is still drivable, EmulationStation just
            # sees the same presses. Worth saying so in the log, because the
            # symptom is a menu that moved on its own.
            log("could not take the gamepad exclusively: %s" % exc)

        size = struct.calcsize("llHHi")
        held = set()
        hat = {}
        try:
            while not self.stop_flag.is_set():
                # The timeout is the watchdog's heartbeat, not a poll for
                # input: without it this blocks in read() and a window that
                # died would leave the pad grabbed until someone pressed a
                # button.
                ready, _, _ = select.select([fd], [], [], 0.5)
                if self.alive is not None and not self.alive():
                    log("sign-in window is gone; releasing the gamepad")
                    self.on_quit()
                    return
                if not ready:
                    continue
                data = os.read(fd, size)
                if len(data) < size:
                    continue
                _, _, etype, code, value = struct.unpack("llHHi", data)
                if etype == EV_ABS:
                    # A hat moving off centre is the arrow's press; back to
                    # centre, or on to the same side again, is nothing.
                    name = HAT_KEYS.get((code, value))
                    if name and hat.get(code) != value:
                        self.keyboard.press(name)
                    if code in (ABS_HAT0X, ABS_HAT0Y):
                        hat[code] = value
                    continue
                if etype != EV_KEY:
                    continue

                if value == 0:
                    held.discard(code)
                    continue
                if value != 1:            # 2 is autorepeat; ignore
                    continue
                held.add(code)

                # Either order, so it does not matter which thumb gets there
                # first.
                held_any = any(h in held for h in GAMEPAD_HOLD)
                if ((code == GAMEPAD_QUIT and held_any)
                        or (code in GAMEPAD_HOLD and GAMEPAD_QUIT in held)):
                    log("player ended the sign-in from the handheld")
                    self.on_quit()
                    return

                # A hold button does not type on its own.
                if code in GAMEPAD_HOLD:
                    continue
                name = GAMEPAD_KEYS.get(code)
                if name:
                    self.keyboard.press(name)
        except OSError:
            pass
        finally:
            if grabbed:
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 0)
                except OSError:
                    pass
            os.close(fd)

    def stop(self):
        self.stop_flag.set()
        # Wait for the reader to actually leave, because it releases the
        # gamepad on its way out and the caller's next move may be to hand
        # the pad back to EmulationStation.
        thread, self.thread = self.thread, None
        if thread and thread is not threading.current_thread():
            thread.join(timeout=2)


class SessionHolder:
    """The server outlives any one sign-in attempt.

    rclone's authorize server answers exactly one redirect and then exits, so
    a code that arrives expired -- which is the normal way this fails, the
    window being a couple of minutes -- ends the attempt. Without somewhere to
    start another, the player is sent back to the handheld to redo a flow they
    had almost finished. So the attempt is replaceable and the *server* is what
    persists, along with the PIN: the handheld is showing that PIN and a QR
    built from it, and neither can be re-issued from here.
    """

    def __init__(self, backend, remote_name, label, timeout):
        self.backend = backend
        self.remote_name = remote_name
        self.name = display_name(backend, label)
        self.timeout = timeout
        self.pin = "%04d" % secrets.randbelow(10000)
        # Which serve the shared state belongs to (write_owned).
        self.attempt = secrets.token_hex(6)
        self.pin_attempts = 0
        self.lock = threading.Lock()
        self.session = None
        self.browser = None
        self.keyboard = RemoteKeyboard()
        self.mouse = RemoteMouse()
        self.gamepad = None

    def start(self):
        session = Session(self.backend, self.remote_name, self.timeout)
        # When the sign-in finishes on the device, take the page away rather
        # than leaving rclone's own "All done, go back to rclone" sitting
        # there -- a sentence about a program the player has never heard of,
        # on a screen with no way out but a button combination.
        session.on_signed_in = self.signed_in
        session.attempt = self.attempt
        # The state names this session from here, and moves to starting:
        # the old session's collector can write nothing more, whatever
        # wakes it, and this one's own failure -- its rclone dying before
        # anybody says waiting -- is recorded where the caller's waiting
        # write will find it (PL-032). Not over a sign-in that has landed,
        # a cancel's idle, or another serve's state.
        session.gen = secrets.token_hex(4)
        if not write_owned(self.attempt, from_status=(None, "starting", "waiting", "failed"),
                           status="starting", session=session.gen, error=""):
            if read_state().get("status") == "signed-in":
                return False, "You're signed in already."
            return False, "Another sign-in has taken over from this one."
        # Before the new attempt kills the old one's rclone (Session.start),
        # so the old collector knows its end is not a failure to report.
        if self.session:
            self.session.superseded = True
        if not session.start():
            # Said in the state as well as to the caller: a restart whose
            # rclone offered no link left the handheld reading waiting, with
            # the old rclone killed and nothing able to finish it (claude
            # G2-C-04).
            write_owned(self.attempt, owner=session.gen, status="failed",
                        error=session.error)
            return False, session.error
        with self.lock:
            self.stop_browser()
            self.session = session
        return True, None

    def signed_in(self):
        """The sign-in landed.

        The window is deliberately left open. EmulationStation is suspended
        while the page owns the screen and takes several seconds to rebuild
        everything it released; closing here put a black screen in front of
        the player at the moment their sign-in had just succeeded, which
        reads as a crash rather than as progress. The window switches itself
        to "Finishing up" when it sees this marker, and is closed once ES is
        drawing again and asks for it.

        The pad is handed back first, though, before the marker exists.
        "Finishing up" takes no input, and `wait` returns on this marker --
        after which EmulationStation re-opens the joystick, which it cannot
        do while the bridge holds EVIOCGRAB (pad_is_free). The bridge used to
        let go only when the window died, which is after that re-open (audit
        #307 PL-018).
        """
        gamepad, self.gamepad = self.gamepad, None
        if gamepad:
            gamepad.stop()
        os.makedirs(STATE_DIR, exist_ok=True)
        try:
            open(state_path("signed-in"), "w").close()
        except OSError:
            self.stop_browser()

    def start_browser(self):
        """Open the provider's page here, for the handheld or a phone to drive."""
        if not browser_stack_available() or not self.session:
            return False
        self.stop_browser()
        host = urllib.parse.urlparse(self.session.provider).hostname or ""
        browser = BrowserSession(self.session.provider, host)
        if not browser.start():
            return False
        with self.lock:
            self.browser = browser

        # The handheld's own controls, and with them a way back out. Without
        # this the page is on the screen, cannot be driven from the device,
        # and cannot be closed -- which strands the handheld in a browser.
        self.keyboard.open()
        self.mouse.open()
        self.gamepad = GamepadBridge(self.keyboard, self.stop_browser,
                                     alive=browser.is_running)
        self.gamepad.start()
        return True

    def end(self):
        """Take everything this serve started down: the window, and rclone.

        The session is marked first: killing its rclone wakes its collector,
        and a serve ending -- cancelled, timed out, finished -- is not a
        sign-in that failed (G-C-02 claude). What the serve had to say about
        how it ended it has already written.
        """
        if self.session:
            self.session.superseded = True
        self.stop_browser()
        if self.session and self.session.proc \
                and self.session.proc.poll() is None:
            self.session.proc.send_signal(signal.SIGTERM)
        # A collector that had its token and is saving the remote is let
        # finish -- bounded by rclone's own create and the check's 20 s --
        # so what it made is published or taken away again (PL-032), not
        # left half made by a process that exits under it. One without a
        # token ends as soon as its rclone does.
        collector = self.session.collector if self.session else None
        if collector and collector is not threading.current_thread():
            collector.join(timeout=45)

    def stop_browser(self):
        gamepad, self.gamepad = self.gamepad, None
        if gamepad:
            gamepad.stop()
        browser, self.browser = self.browser, None
        if browser:
            browser.stop()
        self.keyboard.close()
        self.mouse.close()

    def pin_exhausted(self):
        with self.lock:
            return self.pin_attempts >= 10

    def pin_failed(self):
        with self.lock:
            self.pin_attempts += 1
            return self.pin_attempts >= 10

    def authorised(self, pin):
        return secrets.compare_digest(str(pin), self.pin)


# What an unauthenticated client on the LAN can make this spend before the
# PIN is checked. The body was read whole, whatever Content-Length said, on
# a thread per connection with no read deadline and no limit on threads --
# memory and threads that WebKit, on a 1 GB handheld, needs more (#308 gpt
# F-RS-18). The keyboard's largest request is a paste of a few hundred
# bytes.
MAX_BODY = 64 * 1024
REQUEST_TIMEOUT = 15
MAX_CONNECTIONS = 16


class BoundedHTTPServer(http.server.ThreadingHTTPServer):
    """ThreadingHTTPServer with a cap on connections handled at once: one
    past the cap is closed on arrival rather than given a thread."""

    daemon_threads = True

    def __init__(self, *args, **kwargs):
        self.slots = threading.BoundedSemaphore(MAX_CONNECTIONS)
        super().__init__(*args, **kwargs)

    def process_request(self, request, client_address):
        if not self.slots.acquire(blocking=False):
            self.shutdown_request(request)
            return
        try:
            super().process_request(request, client_address)
        except Exception:
            self.slots.release()
            raise

    def process_request_thread(self, request, client_address):
        try:
            super().process_request_thread(request, client_address)
        finally:
            self.slots.release()


def make_server(address, port, holder, shutdown):
    """The listener, bound -- OSError when the address or port cannot be."""
    server = BoundedHTTPServer((address, port), None)
    server.RequestHandlerClass = make_handler(holder, shutdown)
    return server


def make_handler(holder, shutdown):
    class Handler(http.server.BaseHTTPRequestHandler):
        # Applied to the socket by StreamRequestHandler.setup: a request
        # that stalls -- mid-headers or mid-body -- is dropped at this.
        timeout = REQUEST_TIMEOUT

        def log_message(self, *args):
            pass  # its default writes request lines to stderr

        def _send(self, body, status=200):
            encoded = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)

        def _render(self, message=""):
            # A phone is a keyboard for the page on the handheld, and nothing
            # else. It used to be offered the whole sign-in -- a link to the
            # provider and a box to paste the redirect back into -- which is
            # what a tester did on scanning the QR, because it was there. That
            # flow only ever existed because the handheld could not show the
            # page itself; where it can, offering both is offering a wrong
            # turn.
            if browser_stack_available():
                self._send(REMOTE_PAGE % {
                    "style": STYLE,
                    "name": holder.name,
                    "pin": holder.pin,
                })
                return

            self._send(PAGE % {
                "style": STYLE,
                "name": holder.name,
                "provider": holder.session.provider if holder.session else "",
                "pin": holder.pin,
                "message": message,
                "here": "",
            })

        def _render_pin(self, message="", supplied=""):
            self._send(PIN_PAGE % {
                "style": STYLE,
                "message": message,
                # Pre-fills the box. Every caller passes nothing: a wrong PIN
                # is not echoed back, so a guess learns nothing from the page
                # (#308 claude F-RS-14: this said a mistyped digit was
                # carried back).
                "pin": supplied,
            })

        def _render_done(self, remote):
            self._send(DONE_PAGE % {
                "style": STYLE, "name": holder.name, "remote": remote,
            })

        def _gate(self, pin):
            """True when the request may proceed; renders the refusal if not."""
            if holder.pin_exhausted():
                self.send_error(403, "Too many wrong PINs. Start again on "
                                     "the handheld.")
                return False
            if holder.authorised(pin):
                return True
            # No PIN at all is somebody typing the bare address, which is the
            # documented fallback -- ask, do not refuse. A wrong one is either
            # a typo or a guess, and both are answered the same way so neither
            # learns anything the other does not.
            if not pin:
                self._render_pin()
            elif holder.pin_failed():
                self.send_error(403, "Too many wrong PINs. Start again on "
                                     "the handheld.")
            else:
                self._render_pin('<div class=err>That PIN did not match.</div>',
                                 supplied="")
            return False

        def _supplied(self):
            """The PIN, from wherever this request carries it.

            The address shown on the handheld is http://<device>:8080/7677 --
            the PIN is the tail of the one thing on screen, rather than a
            second number displayed beside it that only the minority who type
            the address rather than scanning it will ever need. ?pin= is still
            accepted: it is what the prompt below submits, and what an older
            QR still in somebody's camera roll would carry.
            """
            parsed = urllib.parse.urlparse(self.path)
            from_query = urllib.parse.parse_qs(parsed.query).get("pin", [""])[0]
            if from_query:
                return from_query
            return parsed.path.strip("/").split("/")[0]

        def do_GET(self):
            if not self._gate(self._supplied()):
                return

            # Is the page actually up on the handheld yet? The keyboard page
            # asks every couple of seconds, because it is scanned before the
            # window exists and has to start working by itself when it does.
            query = urllib.parse.parse_qs(
                urllib.parse.urlparse(self.path).query)
            if query.get("probe"):
                # The page token is a short hash of the address the window is
                # showing: enough for the phone to notice a change, without
                # putting a provider URL with its state parameter into a
                # response anybody on the LAN could ask for.
                token = ""
                try:
                    with open(state_path("page")) as handle:
                        token = hashlib.sha256(
                            handle.read().encode()).hexdigest()[:8]
                except OSError:
                    pass
                # open once a field on the window's page has had the caret
                # (the window's field record); loading while it is up and
                # nothing has. The window's process starting was open, and
                # the phone sent what it held at once, while the provider's
                # page was still loading and focus_first had placed no
                # caret: the text went nowhere and, being counted as sent,
                # was never resent (the audit of the fix round, claude
                # G2-C-01).
                # A sign-in that has landed stays open: the window shows its
                # own "Finishing up" page, which has no field.
                if not holder.browser:
                    body = b"waiting"
                elif os.path.exists(state_path("field")) \
                        or os.path.exists(state_path("signed-in")):
                    body = ("open " + token).strip().encode()
                else:
                    body = ("loading " + token).strip().encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/plain; charset=utf-8")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
                return

            self._render()

        def do_POST(self):
            # Checked before a byte of the body is read.
            try:
                length = int(self.headers.get("Content-Length", 0))
            except ValueError:
                length = -1
            if length < 0 or length > MAX_BODY:
                self.send_response(413 if length > MAX_BODY else 400)
                self.send_header("Content-Length", "0")
                self.send_header("Connection", "close")
                self.end_headers()
                self.close_connection = True
                return
            fields = urllib.parse.parse_qs(
                self.rfile.read(length).decode("utf-8", "replace"))
            if not self._gate(fields.get("pin", [""])[0] or self._supplied()):
                return

            if fields.get("move") or fields.get("click") or fields.get("wheel"):
                if not holder.browser:
                    self.send_response(409)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                moved = fields.get("move", [""])[0]
                if moved:
                    try:
                        dx, dy = (int(float(v)) for v in moved.split(",", 1))
                    except ValueError:
                        dx = dy = 0
                    holder.mouse.move(dx, dy)
                wheel = fields.get("wheel", [""])[0]
                if wheel:
                    try:
                        holder.mouse.scroll(int(float(wheel)))
                    except ValueError:
                        pass
                if fields.get("click"):
                    holder.mouse.click()
                self.send_response(204)
                self.send_header("Content-Length", "0")
                self.end_headers()
                return

            if fields.get("type") or fields.get("key"):
                if not holder.browser:
                    # 409 rather than a rendered page: the keyboard posts by
                    # fetch and throwing HTML at it would replace nothing and
                    # tell nobody. Its own poll is what reports this state.
                    self.send_response(409)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                text = fields.get("type", [""])[0]
                named = fields.get("key", [""])[0]
                sent = holder.keyboard.type_text(text) if text else 0
                if named:
                    holder.keyboard.press(named)
                self.send_response(204)
                self.send_header("Content-Length", "0")
                self.end_headers()
                # Counts only: what was typed may be a password.
                log("typed %d characters%s%s" % (
                    sent, " + " + named if named else "",
                    ", %d not on the keyboard" % (len(text) - sent) if len(text) > sent else ""))
                return

            if fields.get("restart"):
                ok, error = holder.start()
                # Waiting only from the starting the new attempt began with:
                # its rclone may already have died, and its collector said
                # so, before this line ran (PL-032, gpt G2-C-02).
                if ok and write_owned(holder.attempt, owner=holder.session.gen,
                                      from_status=("starting",),
                                      status="waiting",
                                      provider=holder.session.provider):
                    self._render('<div class=ok>Ready for another go. '
                                 'Sign in below.</div>')
                    return
                if ok:
                    error = read_state().get("error") or \
                        "That sign-in ended before it could start."
                again = ""
                if read_state().get("status") != "signed-in":
                    again = ('<form method=post>'
                             '<input type=hidden name=pin value="%s">'
                             '<input type=hidden name=restart value="1">'
                             '<button class=minor type=submit>'
                             'Start a new sign-in</button></form>' % holder.pin)
                self._render('<div class=err>%s</div>%s' % (error, again))
                return

            session = holder.session
            if session is None:
                self._render('<div class=err>No sign-in is running.</div>')
                return

            ok, detail = session.submit(fields.get("code", [""])[0])
            if ok:
                self._render_done(detail)
                threading.Timer(2.0, shutdown).start()
                return

            # A dead attempt gets a way forward on this page rather than an
            # instruction to walk back to the handheld and redo the flow.
            restart = ""
            if session.finished():
                restart = ('<form method=post>'
                           '<input type=hidden name=pin value="%s">'
                           '<input type=hidden name=restart value="1">'
                           '<button class=minor type=submit>'
                           'Start a new sign-in</button></form>' % holder.pin)
            self._render('<div class=err>%s</div>%s' % (detail, restart))

    return Handler


def cmd_serve(backend, remote_name, label, port, timeout):
    if not shutil.which("rclone") and not os.path.exists(RCLONE):
        sys.stderr.write("rclone is not installed\n")
        return 2

    # Nothing from the last attempt survives into this one -- including a
    # serve still holding the port.
    stop_other_serves()
    holder = SessionHolder(backend, remote_name, label, timeout)
    # The state is this serve's from here, stamped with its attempt id; every
    # write this serve makes afterwards is conditional on still owning it
    # (write_owned, G-C-02).
    reset_state(status="starting", backend=backend, attempt=holder.attempt)

    # SIGTERM is how `cancel` and the next serve end this one
    # (stop_other_serves). With no handler Python died on it at once: the
    # teardown below never ran, and the fullscreen window -- a plain child
    # with no death signal -- stayed on the screen with the gamepad bridge
    # gone, nothing left on the device to drive it or close it (audit #307
    # PL-049). Raising here unwinds through the finally instead; a second
    # SIGTERM while the teardown runs is ignored so that it finishes.
    def on_term(signum, frame):
        signal.signal(signal.SIGTERM, signal.SIG_IGN)
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, on_term)

    try:
        return serve_with(holder, backend, port, timeout)
    finally:
        holder.end()


def serve_with(holder, backend, port, timeout):
    ok, error = holder.start()
    if not ok:
        sys.stderr.write("%s\n" % error)
        write_owned(holder.attempt, status="failed", error=error)
        return 2

    address = lan_address()
    # Listen on the address the page is served at, not on every interface
    # (#308 claude F-RS-18). A VPN or tethering interface no longer takes
    # the keyboard; and the port is shared with the offline achievements
    # proxy, which listens on 127.0.0.1:8080 -- a wildcard bind cannot share
    # a port with a socket on a specific address, so with offline
    # achievements on, every sign-in ended in EADDRINUSE. 127.0.0.1 is
    # lan_address's answer when there is no route, and it is bound as it is:
    # the wildcard it used to keep for that case listened on every
    # interface while advertising loopback, which no phone can reach anyway
    # (the audit of stream C, G-C-06). With no route there is no provider to
    # sign in to either.
    listen = address
    # A port something else holds used to end the serve with a traceback and
    # the status left at "starting", rclone's authorize still running, and
    # the interface waiting on a sign-in that could never be reached (audit
    # #307 PL-050, claude F-RS-22).
    server = None

    def shutdown():
        if server is not None:
            threading.Thread(target=server.shutdown, daemon=True).start()

    try:
        server = make_server(listen, port, holder, shutdown)
    except OSError as exc:
        why = "port %d is already in use on this device" % port \
            if exc.errno == errno.EADDRINUSE else "could not listen on port %d" % port
        log("sign-in could not start: %s (%s)" % (why, exc.strerror or exc))
        sys.stderr.write("%s\n" % why)
        # The port and the errno stay in the log; the state carries words
        # (G-C-03, the audit of stream C).
        write_owned(holder.attempt, status="failed",
                    error="Something else on this handheld is using the "
                          "sign-in's connection. Restart it and try again.")
        return 2

    bare = "http://%s:%d" % (address, port)
    url = "%s/%s" % (bare, holder.pin)
    # Waiting only from starting, and only while this session is the one
    # the state names. Authorize can print its link and die at once; its
    # collector records failed while this was still binding, and this write
    # used to put waiting over it -- a dead attempt republished, the
    # handheld reading STILL WAITING until the serve's timeout (PL-032, gpt
    # G2-C-02). What the state says then stands, and the serve ends.
    if not write_owned(holder.attempt, owner=holder.session.gen,
                       from_status=("starting",), status="waiting",
                       backend=backend, url=url, address=bare,
                       provider=holder.session.provider, pin=holder.pin,
                       name=holder.name):
        log("the sign-in ended before it could be offered")
        server.server_close()
        return 2

    # The window is not opened here. It covers the screen the moment it
    # appears, and the address and QR the handheld is showing are how
    # somebody gets a phone keyboard onto it -- opening it immediately means
    # that screen flashes past before it can be read or scanned. The handheld
    # asks for it when the player is ready.
    #
    # Best effort throughout: an image without the browser stack falls
    # through to the paste flow rather than failing the sign-in, and the page
    # says which one you are looking at.
    def open_when_asked():
        # Loops rather than opening once: pressing Start closes the window
        # and gives the handheld back, and the player may well want it again
        # -- to correct an address, or because they closed it by accident.
        flag = state_path("open-browser")
        shut = state_path("close-browser")
        deadline = time.time() + timeout
        while time.time() < deadline:
            if os.path.exists(shut):
                try:
                    os.unlink(shut)
                except OSError:
                    pass
                holder.stop_browser()
            if os.path.exists(flag):
                try:
                    os.unlink(flag)
                except OSError:
                    pass
                if holder.start_browser():
                    log("sign-in window opened for %s" % backend)
            time.sleep(0.4)

    if browser_stack_available():
        threading.Thread(target=open_when_asked, daemon=True).start()

    # stdout is the contract for the caller (the ES page reads these).
    print("URL=%s" % url)
    print("ADDRESS=%s" % bare)
    print("PIN=%s" % holder.pin)
    print("NAME=%s" % holder.name)
    print("PROVIDER=%s" % holder.session.provider)
    print("EXIT_HINT=%s" % exit_hint())
    sys.stdout.flush()

    # The listener is only open while someone is actually signing in.
    timer = threading.Timer(timeout, shutdown)
    timer.daemon = True
    timer.start()
    try:
        server.serve_forever()
    finally:
        timer.cancel()
        server.server_close()

    # One write, checked under the lock: failed only from starting or
    # waiting, so a sign-in that lands between a read and the write is not
    # turned back (PL-032).
    if write_owned(holder.attempt, from_status=("starting", "waiting"),
                   status="failed", error="sign-in did not complete"):
        return 1
    return 0 if read_state().get("status") == "signed-in" else 1


def main(argv):
    if len(argv) < 2:
        sys.stderr.write(
            "usage: cloud_oauth serve <backend> [--name NAME] "
            "[--label 'Dropbox'] [--port N] [--timeout SECONDS]\n"
            "       cloud_oauth url | info | status | open [--phone] "
            "| wait | close | cancel\n")
        return 1

    command = argv[1]

    if command == "serve":
        if len(argv) < 3:
            return main([argv[0]])
        backend = argv[2]
        name, label, port, timeout = None, None, 8080, 600
        rest = argv[3:]
        for i, arg in enumerate(rest):
            if arg == "--name" and i + 1 < len(rest):
                name = rest[i + 1]
            elif arg == "--label" and i + 1 < len(rest):
                label = rest[i + 1]
            elif arg == "--port" and i + 1 < len(rest):
                port = int(rest[i + 1])
            elif arg == "--timeout" and i + 1 < len(rest):
                timeout = int(rest[i + 1])
        return cmd_serve(backend, name, label, port, timeout)

    if command == "url":
        print(read_state().get("url", ""))
        return 0

    if command == "open":
        # Asked for by the handheld once the player has had a chance to read
        # the address and scan the code.
        os.makedirs(STATE_DIR, exist_ok=True)

        # Which keyboard the player chose. Raising the on-screen one for
        # somebody who asked to type on their phone covers the form they are
        # reading with a keyboard they did not ask for.
        marker = state_path("phone-keyboard")
        if "--phone" in argv:
            open(marker, "w").close()
        elif os.path.exists(marker):
            try:
                os.unlink(marker)
            except OSError:
                pass

        open(state_path("open-browser"), "w").close()

        # Return once the window is actually up, not once the request is
        # filed. The caller's next act is to tear down its own renderer, and
        # doing that before there is anything to look at leaves the player
        # staring at the wallpaper for the seconds WebKit takes to start.
        deadline = time.time() + 20
        while time.time() < deadline:
            if signin_window_running():
                return 0
            time.sleep(0.2)
        log("sign-in window did not appear")
        return 1

    if command == "wait":
        # Block until the page is finished with, so a caller can bracket this
        # with its own suspend/resume. Bounded well past the session timeout
        # so a serve that died without tidying up cannot strand the caller.
        deadline = time.time() + 1800
        while time.time() < deadline and signin_window_running():
            # A finished sign-in releases the caller without waiting for the
            # window: it stays up saying so while the caller rebuilds itself,
            # and asks for it to be closed afterwards. Waiting for the window
            # to go first is what produced a black screen. Not without the
            # pad, though -- the settle below runs on this path too (PL-018).
            if os.path.exists(state_path("signed-in")):
                break
            time.sleep(0.3)

        # And not a moment before the pad is handed back -- see pad_is_free.
        settle = time.time() + 5
        while time.time() < settle and not pad_is_free():
            time.sleep(0.1)
        return 0

    if command == "close":
        # Asked for once the caller is drawing again, so there is something
        # behind the window when it goes.
        os.makedirs(STATE_DIR, exist_ok=True)
        open(state_path("close-browser"), "w").close()
        deadline = time.time() + 10
        while time.time() < deadline and signin_window_running():
            time.sleep(0.2)

        # The serve process is what normally takes the window away, and it may
        # not be there to do it -- it times out on its own, and a sign-in that
        # finished near that deadline leaves the window with nobody to close
        # it. That is a fullscreen page reading "Finishing up" sitting on top
        # of an EmulationStation that has already come back, escapable only by
        # a button combination. Close it here rather than depending on
        # somebody else being alive.
        if signin_window_running():
            log("sign-in window outlived its server; closing it directly")
            for signum in (signal.SIGTERM, signal.SIGKILL):
                for entry in os.listdir("/proc"):
                    if not entry.isdigit():
                        continue
                    try:
                        with open("/proc/%s/cmdline" % entry, "rb") as handle:
                            argv = handle.read().split(b"\0")
                    except OSError:
                        continue
                    if argv and argv[0].decode("utf-8", "replace") == SIGNIN_WINDOW:
                        try:
                            os.kill(int(entry), signum)
                        except OSError:
                            pass
                for _ in range(15):
                    if not signin_window_running():
                        break
                    time.sleep(0.2)
                if not signin_window_running():
                    break
            # The serve that set the pointer's hide timeout to never is not
            # there to set it back (#308 claude F-RS-19).
            BrowserSession._cursor_timeout(1000)

        settle = time.time() + 5
        while time.time() < settle and not pad_is_free():
            time.sleep(0.1)
        # Honest about the outcome: a window still standing means the screen
        # is not handed back, whatever the caller does next.
        return 0 if not signin_window_running() else 1

    if command == "info":
        # One KEY=VALUE per line. `url` stays exactly as it was: the ES page
        # reads whichever of the two the running image provides, so an older
        # script and a newer page still agree on something.
        state = read_state()
        state["on_device"] = "yes" if browser_stack_available() else "no"
        # The window's own words for the way back (exit_hint): Select and
        # Start, which every handheld we ship for has and labels.
        state["exit_hint"] = exit_hint()
        for key in ("url", "address", "pin", "name", "provider", "status",
                    "on_device", "exit_hint"):
            print("%s=%s" % (key.upper(), state.get(key, "")))
        return 0

    if command == "status":
        print(read_state().get("status", "idle"))
        return 0

    if command == "cancel":
        stop_other_serves()
        subprocess.run(["pkill", "-f", "rclone authorize"], capture_output=True)
        # Clears the address, PIN and provider link as well as the status --
        # a dead session's details are not something to leave lying in
        # /var/run for the next page to pick up and display.
        reset_state(status="idle")
        return 0

    return main([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
