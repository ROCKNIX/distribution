  // the order this flow asks for, since the QR is on the screen the sign-in
  // page replaces.
  var sent = "";

  function deliver(v) {
    if (v === sent) return;
    if (v.length > sent.length && v.indexOf(sent) === 0) {
      send("type=" + encodeURIComponent(v.slice(sent.length)));
    } else if (v.length < sent.length && sent.indexOf(v) === 0) {
      for (var i = 0; i < sent.length - v.length; i++) send("key=backspace");
    } else {
      for (var j = 0; j < sent.length; j++) send("key=backspace");
