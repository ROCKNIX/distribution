  function move(e) {
    if (!tracking) return;
    var p = at(e);
    var dx = (p.x - px) * SPEED + restX, dy = (p.y - py) * SPEED + restY;
    px = p.x; py = p.y;
    var ix = Math.trunc(dx), iy = Math.trunc(dy);
    restX = dx - ix; restY = dy - iy;
    moved += Math.abs(ix) + Math.abs(iy);
    if (ix || iy) pushMove(ix, iy);
    e.preventDefault();
  }
  function up(e) {
    if (!tracking) return;
    tracking = false;
    pad.classList.remove("live");
    // Let any outstanding movement land first, so the click happens where
    // the finger finished rather than where it was a moment earlier.
    if (moved < 8) setTimeout(function () { send("click=1"); }, 60);
    e.preventDefault();
