        // for it.
        if (isUp && parts[1] && parts[1] !== page) {
          if (page !== null) { box.value = ""; sent = ""; }
          page = parts[1];
        }
        up = isUp;
        state.className = open ? "ok" : "note";
        state.textContent = open
          ? "Connected."
          : isUp
          ? "Opening on your handheld. You can keep typing here; it goes "
            + "across once a box on that page is ready."
          : "Not open yet -- choose CONTINUE on your handheld. You can type "
            + "or paste here meanwhile; it goes across when the page opens.";
        // The box is never disabled. It was, until this said the handheld was
        // ready -- so somebody who scanned the QR first, which is the order
        // this flow asks for, could not type at all and saw nothing appear.
        // Re-asserting disabled every two seconds also dismisses a phone
        // keyboard in the middle of typing.
        //
        // And what was typed meanwhile goes across the moment it opens. The
        // box only ever sent on an input event, so text typed while the page
        // said "not open yet" -- the order this flow asks for -- was never
        // delivered at all, and the next keystroke added only itself (audit
        // #307 PL-016). The window opens on an empty field, so nothing has
        // been sent to it yet: `sent` starts again from nothing. And not
        // before a field has the caret -- open is that, not the window's
        // process starting (claude G2-C-01) -- and again on each new page.
        var opened = open && !ready;
        ready = open;
        if (opened) { sent = ""; deliver(box.value); }
      })
      .catch(function () {})
      .then(function () { setTimeout(poll, 2000); });
