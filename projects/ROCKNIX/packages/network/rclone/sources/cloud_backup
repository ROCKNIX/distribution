# Script configuration and global variables
SCRIPT_NAME=$(basename "$0")
LOG_FILE="/var/log/cloud_sync.log"
START_TIME=$(date +%s)

# The two exits that mean "nothing ran", which EmulationStation names
# (SKIPPED - ANOTHER CLOUD SYNC IS RUNNING / SKIPPED - NO NETWORK CONNECTION).
# They were 3 and 4 until 2026-09-09 -- and rclone's own 3 and 4 are
# "directory not found" and "file not found", so a failed phase carrying
# rclone's code up to the final exit read as a sentinel nobody had raised: a
# restore against a cloud with no Saves folder yet said a sync was running
# (#99, blindspot 33). sysexits.h's EX_TEMPFAIL and EX_UNAVAILABLE sit above
# everything rclone returns (0-9) and below the 128+signal range, so nothing
# this script forwards can produce them. EmulationStation reads the same two
# numbers; scripts and ES ship in one image.
readonly EXIT_LOCK_HELD=75 EXIT_NO_NETWORK=69

# The bound on a reachability probe: one attempt, 10 s to connect, 20 s in
# all. Tighter than the transfers' bound below, because a probe is a single
# listing whose whole point is to answer quickly. Used by check_internet,
# by the mkdir that doubles as the pre-run probe, and by
# network_lost_during_run after a failure.
readonly -a RCLONE_PROBE_OPTS=(--contimeout 10s --timeout 20s --low-level-retries 1 --retries 1)
# A listing's bound (#143). rclone's S3 backend hands --low-level-retries to
# the AWS SDK as its number of attempts, with the SDK's exponential backoff
# between them, and --contimeout never enters it: a refused endpoint costs
# 0.03 s at 1 attempt, 2 s at 2, 6 s at 3 and 230 s at 10 (rclone 1.75 on
# the VM, 2026-09-12). Ten is right for a write -- Dropbox answers a
# concurrent write with a lock error a retry clears (#107) -- and wrong for
# a listing, which has nothing to clear. Three covers a rate-limit answer
# and keeps a dead endpoint under ten seconds on every backend.
readonly -a RCLONE_LIST_OPTS=(--contimeout 15s --timeout 30s --low-level-retries 3 --retries 1)

# What bounds every other rclone command this script runs against the cloud
# -- the transfers, the listings, the archive upload and its size check.
# The value is RCLONE_NET_OPTS in cloud_sync.conf (the reasoning for the
# numbers is beside it in cloud_sync.conf.defaults), seeded there by
# cloud_sync_helper; load_config turns it into RCLONE_NET_OPTS_ARRAY. This
# is the same value for a config the helper has not reached -- the helper
# binary missing, the line blanked -- so the bound holds on the first run
# after an update too. Until 2026-09-09 only the probes were bounded and
# every transfer ran on rclone's defaults: a 60 s connect timeout, a 5 min
# idle timeout, 10 low-level retries, 3 whole-run retries. A link that
# dropped mid-run held the process for over ten minutes, and on the RG SP
# that froze the startup card at 113/113 with the launch gate held (#101,
# #102, #103). Keep the two values in step.
RCLONE_NET_OPTS_FALLBACK="--contimeout 15s --timeout 30s --low-level-retries 10 --retries 1"
# The automatic sync's bound (D-CLOUD-118), appended after the caller's flags
# by the rclone() wrapper below; the ceiling is enforced by timeout. The two
# are RCLONE_SYNC_NET_OPTS and SYNC_CEILING_SECONDS in cloud_sync.conf, and
# these are the same values for a config the helper has not reached.
RCLONE_SYNC_NET_OPTS_FALLBACK="--contimeout 5s --timeout 5s --retries 1 --max-duration 90s --low-level-retries 5 --transfers 1"
SYNC_CEILING_SECONDS_FALLBACK=90
RCLONE_NET_OPTS_ARRAY=()

# Non-interactive support for hooks and the ES menu:
#   --yes / -y      answer prompts automatically (headless mode)
#   --method=X      override the configured transfer method (sync or copy)
#   --update        add rclone --update (skip files newer on the destination)
#   --system-only   only the system-settings archive, not the saves
#   --saves-only    only the saves, not the system-settings archive
#   --recent        only saves changed since the last backup that worked
#                   (the game-exit sync); always copies, never tidies
#
# Exit codes the UI names: EXIT_LOCK_HELD (75) = skipped, another cloud sync
# holds the lock; EXIT_NO_NETWORK (69) = skipped, no network. Neither writes a
# last-run stamp -- nothing ran. Defined below, with why those two numbers.
ASSUME_YES=0
METHOD_OVERRIDE=""
EXTRA_UPDATE=0
SYSTEM_ONLY=0
# The settings phase's own summary word when it is not the exit code's
# (SKIPPED - NOTHING TO SEND YET), and whether a --system-only run did any
# work at all -- when it did not, the settings stamp is not rewritten (#126).
SETTINGS_OUTCOME=""
SETTINGS_NOTHING_RAN=0
# The saves phase's, for the same reason: under --system-only the phase is
# skipped, and its summary line said COMPLETED for work that was never run.
SAVES_OUTCOME=""
SAVES_ONLY=0
# --automatic: this run is the startup sync or the sync after a game, not a
# back up or restore somebody pressed (D-CLOUD-113). A player is waiting to
# play, so the run is bounded the way #135 measured it should be (D-CLOUD-118):
# connect in 5 s, give a stalled transfer up after 5 s with nothing moving,
# and never run past SYNC_CEILING_SECONDS in all -- against a cloud that
# accepts and never answers the unbounded run took 321 s, with the outcome
# landing behind the screensaver. The bound is applied here, on every rclone
# this script runs: RCLONE_SYNC_NET_OPTS goes last on the command line so it
# outranks the caller's bound, and busybox timeout enforces the ceiling on
# what rclone's own flags cannot reach (a stalled listing retried ten times).
# The low-level retry count is left to the caller's: ten for a transfer,
# because Dropbox answers concurrent writes with a lock error that a retry
# clears (#107), and the ceiling -- not the retries -- is what bounds a stall.
# A run the ceiling ends returns 124 (timeout) or 10 (rclone's own
# --max-duration); why_for says what that means to the player.
AUTOMATIC=0
SYNC_DEADLINE=0
RCLONE_SYNC_NET_OPTS_ARRAY=()
RECENT=0
for CLI_ARG in "$@"; do
    case "${CLI_ARG}" in
        --yes|-y) ASSUME_YES=1 ;;
        --method=sync|--method=copy) METHOD_OVERRIDE="${CLI_ARG#--method=}" ;;
        --method=*) echo "Ignoring invalid --method value: ${CLI_ARG#--method=}" ;;
        --update) EXTRA_UPDATE=1 ;;
        --system-only) SYSTEM_ONLY=1 ;;
        --saves-only) SAVES_ONLY=1 ;;
        --recent) RECENT=1 ;;
        --automatic) AUTOMATIC=1 ;;
    esac
done

# Every rclone this script runs goes through the rclone() function below:
# the automatic run's bound on one branch, the deliberate run's on the
# other (D-CLOUD-126, #153). The function and its helpers sit at column 0
# so tools/last-good-scripts-test can lift them by their first lines.
#
# An rclone function the environment exported -- the round-trip harness's
# lock-descriptor probe does exactly that, to count what a child of a run
# can see -- used to reach a deliberate run unwrapped, because no function
# was defined for one. It still runs: it is kept under another name and
# the deliberate branch calls it in place of the binary, in the foreground.
# A shell function cannot be ended the way a process can, and the only
# environments that export one are harnesses.
RCLONE_OUTER=""
if declare -F rclone >/dev/null 2>&1; then
    eval "outer_$(declare -f rclone)"
    RCLONE_OUTER=outer_rclone
fi

# The deliberate run's ceiling (D-CLOUD-126, #153). RCLONE_NET_OPTS bounds
# a dead link with --timeout 30s, rclone's idle limit: nothing moved for
# that long, the connection is dropped and the operation retried. On the
# path-based backends a retry against a dead link fails at once and the
# run ends inside the outage, exit 69. rclone's S3 backend hands
# --low-level-retries to the AWS SDK as its attempt count, and the SDK
# backs off exponentially between attempts with no timeout of ours in the
# way (the note beside RCLONE_LIST_OPTS: 230 s at ten). So a deliberate
# `cloud_backup --system-only` whose link dropped sat through the outage,
# re-dialled when the link came back, uploaded the whole archive again and
# exited 0 -- 88.8 s after a 40 s cut, 163.6 s after a 120 s one -- past
# the 90 s tools/cloud-round-trip's LINK cells hold every run to, and
# stamped success for a run the network had left (LINK5 on MinIO,
# 2026-09-13). --low-level-retries itself is not the knob (D-CLOUD-083).
#
# The ceiling is the automatic run's mechanism -- end the process, return
# 124 -- measured differently. The automatic run is bounded from its
# start, because a player is waiting to play and the run is small by
# construction. A deliberate run is the one that moves a first backup of
# every save state, or a settings archive carrying a theme pack, so a
# ceiling from its start would end exactly the transfers it exists for.
# This one is measured from the last moment rclone made progress: the
# byte, check, file or delete count in its own stats block exceeding what
# it had reached before. The block goes to stdout under --progress and is
# copied to a trace on its way through; rclone's transferred count never
# falls on a retry, only its total grows (the LINK5 capture shows
# 8.902 MiB standing for 45 s under a total that went from 12.0 to
# 20.9 MiB), so a count above its previous high is progress and nothing
# else is. A transfer that keeps moving is never ended; one that has moved
# nothing for the idle timeout plus a grace is. The grace gives a healthy
# link's retry after the idle timeout time to show progress -- the SDK's
# first backoffs are a second or two -- and stays short enough that a run
# whose link is down ends before an outage of the LINK cells' shape is
# over, with the link still down, exit 69 like the other backends.
# load_config sizes the ceiling from RCLONE_NET_OPTS; the value here is
# for a config the helper has not reached. Calls that print no stats block
# -- a mkdir, a size, a deletefile, each carrying the transfer's ten
# retries -- are bounded from their start by the same figure, which is
# what they need.
#
# A run the ceiling ends returns 124, as the automatic run's does; why_for
# says what that means to a player who pressed the button: YOUR CLOUD
# STOPPED ANSWERING, with TRY AGAIN in reach.
DELIBERATE_CEILING_GRACE=6
DELIBERATE_CEILING_SECONDS=36
CEILING_DIR_ROOT=/var/run
RCLONE_CHILD=""
RCLONE_MOVED=0

# Is this child still running? kill -0 says yes of one that has exited and
# not been waited for, so the state in /proc is read: Z is done. The comm
# field holds no spaces for rclone, so the third field is the state.
child_running() {
    local _pid _comm state
    { read -r _pid _comm state _ < "/proc/$1/stat"; } 2>/dev/null || return 1
    [ "${state}" != "Z" ]
}

# The furthest rclone's stats block in the tail of a trace has got: bytes
# transferred, checks done, files transferred, files deleted, entries
# listed -- five integers on one line. The listed count is the Checks line's
# "Listed N" (#308, the seats' claude F-CS-13): a first backup against a
# folder of tens of thousands of files lists for longer than the ceiling
# before its first check completes, and a count that only read checks
# ended that run as a stall. The bytes line is the Transferred: with a unit in
# it; the one without is the file count. A block's last line is glued to
# the next block's Transferred: (the rule's "Progress output" section),
# which the sed unglues. Rates, ETAs, percentages and the elapsed time are
# not progress and are not read.
progress_mark() {
    tail -c 8192 "$1" 2>/dev/null | tr '\r' '\n' | sed 's/Transferred:/\nTransferred:/g' | awk '
        function unit(u) {
            if (u ~ /^K/) return 1024
            if (u ~ /^M/) return 1048576
            if (u ~ /^G/) return 1073741824
            if (u ~ /^T/) return 1099511627776
            return 1
        }
        /^Transferred:/ {
            s = $0; sub(/^Transferred:[ \t]*/, "", s); sub(/ \/.*$/, "", s)
            n = split(s, w, " ")
            if (n >= 2) { b = w[1] * unit(w[2]); if (b > bytes) bytes = b }
            else if (n == 1 && w[1] ~ /^[0-9]+$/ && w[1] + 0 > files) files = w[1] + 0
        }
        /^Checks:/  { s = $0; sub(/^Checks:[ \t]*/, "", s);  sub(/[^0-9].*$/, "", s); if (s + 0 > checks)  checks  = s + 0
                      if ($0 ~ /Listed [0-9]/) { l = $0; sub(/^.*Listed /, "", l); sub(/[^0-9].*$/, "", l); if (l + 0 > listed) listed = l + 0 } }
        /^Deleted:/ { s = $0; sub(/^Deleted:[ \t]*/, "", s); sub(/[^0-9].*$/, "", s); if (s + 0 > deleted) deleted = s + 0 }
        END { printf "%d %d %d %d %d\n", bytes, checks, files, deleted, listed }'
}

# Did any count in <mark> exceed <high water>? Prints the new high water --
# each field the larger of the two, so a count that falls back (a phase
# that starts over) never lets an old level read as new progress -- and
# returns 0 when something grew.
advance_mark() {
    local a=($1) b=(${2:-0 0 0 0 0}) i grew=1
    for i in 0 1 2 3 4; do
        if [ "${a[$i]:-0}" -gt "${b[$i]:-0}" ] 2>/dev/null; then
            b[$i]="${a[$i]}"
            grew=0
        fi
    done
    echo "${b[*]}"
    return "${grew}"
}

# rclone under the stall ceiling. Its stdout goes through a fifo to tee,
# which copies it to the trace and on to wherever the caller pointed it --
# the page's pipe, a $(...), /dev/null; stderr is not touched. A transfer
# verb that was given no --progress is given it: the block is the only
# progress signal there is, and without one the ceiling would be measured
# from the start (the shipped RCLONEOPTS carries --progress; a hand-edited
# one might not). Nothing else is added: -P refreshes every 500 ms on its
# own, and a --stats 1s beside it would halve the card's liveness signal.
# Waiting for tee at the end keeps the caller's stream whole: nothing
# printed afterwards overtakes rclone's last block.
bounded_rclone() {
    local dir="${CEILING_DIR_ROOT}/cloud_sync.${$}.${RANDOM}" fifo trace pid tee_pid rc
    local mark high="0 0 0 0 0" new since now ticks=0 ended=0 n progress_verb=0
    if ! mkdir -p "${dir}" 2>/dev/null || ! mkfifo "${dir}/fifo" 2>/dev/null; then
        # Nowhere to trace through. On a device /var/run is tmpfs and this
        # does not happen; when it does, the call runs as it did before the
        # ceiling and the log says so -- a backup refused for want of a
        # fifo would be the worse failure.
        log_message "cannot make ${dir}/fifo; rclone $1 runs without the stall ceiling" "false" "WARN"
        rm -rf "${dir}" 2>/dev/null
        command rclone "$@"
        return
    fi
    fifo="${dir}/fifo"; trace="${dir}/trace"
    : > "${trace}"
    local -a args=("$@")
    case "$1" in
        copy|copyto|sync|move|moveto)
            progress_verb=1
            local has_progress=0 a
            for a in "$@"; do
                case "${a}" in --progress|-P) has_progress=1 ;; esac
            done
            [ "${has_progress}" -eq 1 ] || args+=(--progress) ;;
    esac
    tee -a "${trace}" < "${fifo}" &
    tee_pid=$!
    command rclone "${args[@]}" > "${fifo}" &
    pid=$!
    RCLONE_CHILD="${pid}"
    since=$(date +%s)
    while child_running "${pid}"; do
        sleep 0.25
        ticks=$((ticks + 1))
        [ $((ticks % 4)) -eq 0 ] || continue
        mark=$(progress_mark "${trace}")
        if new=$(advance_mark "${mark}" "${high}"); then
            high="${new}"
            since=$(date +%s)
            continue
        fi
        now=$(date +%s)
        if [ $((now - since)) -ge "${DELIBERATE_CEILING_SECONDS}" ]; then
            ended=1
            kill -TERM "${pid}" 2>/dev/null
            # Three seconds to go, as timeout -k 3 gives the automatic run.
            n=0
            while [ "${n}" -lt 30 ] && child_running "${pid}"; do sleep 0.1; n=$((n + 1)); done
            kill -KILL "${pid}" 2>/dev/null
            break
        fi
    done
    wait "${pid}" 2>/dev/null; rc=$?
    RCLONE_CHILD=""
    # tee ends when the fifo's last writer has gone. rclone starts no
    # children; a shim under test might leave one holding the fifo, so tee
    # gets the same three seconds and is then ended too.
    n=0
    while [ "${n}" -lt 30 ] && child_running "${tee_pid}"; do sleep 0.1; n=$((n + 1)); done
    kill -KILL "${tee_pid}" 2>/dev/null
    wait "${tee_pid}" 2>/dev/null
    # rclone ends each redraw of its stats block on a " * file" line with no
    # newline (the rule's "Progress output"), so a transfer ended inside a
    # redraw -- the ceiling's kill lands there -- leaves that line open on
    # the stream, and the sentence the caller prints next is glued to it:
    # " * ...SETTINGS.tar.gz:  0% / 12.011 MiB, 0 B/s, -Couldn't finish:
    # lost the network during the settings backup." (LINK5 on MinIO,
    # 4d7eb1f303, 2026-09-13). Every reader that takes the stream by lines
    # -- the card, the page, the round-trip's outcome gate -- then sees
    # rclone's line and never the outcome. When the block was left open,
    # close it; only on the verbs whose stdout is the block, so a listing
    # the caller captures is handed over byte for byte. A block that ended
    # on its own newline gets nothing, and neither reader minds a blank
    # line (CloudText::liveLine reads one as nothing).
    if [ "${progress_verb}" -eq 1 ] && [ -s "${trace}" ] && [ -n "$(tail -c1 "${trace}")" ]; then
        printf '\n'
    fi
    # Whether this call moved anything -- a file transferred or deleted --
    # for the stamp of a run the network later ends (#308 claude F-CS-24).
    local moved_bytes moved_checks moved_files moved_deleted moved_listed
    read -r moved_bytes moved_checks moved_files moved_deleted moved_listed <<< "$(progress_mark "${trace}")"
    { [ "${moved_files:-0}" -gt 0 ] || [ "${moved_deleted:-0}" -gt 0 ]; } 2>/dev/null && RCLONE_MOVED=1
    rm -rf "${dir}" 2>/dev/null
    if [ "${ended}" -eq 1 ]; then
        log_message "rclone $1 made no progress for ${DELIBERATE_CEILING_SECONDS}s and was ended (it returned ${rc}); reporting 124" "false" "WARN"
        rc=124
    fi
    return "${rc}"
}

# Did rclone log moving a file -- "<path>: Copied (...)", "Moved (...)",
# "Deleted" -- since <offset> into LOG_FILE, or in <file> (its stderr, when
# the options carry no --log-file)? An automatic run's rclone runs under
# timeout, not the stall ceiling, so it has no trace for progress_mark to
# read; what it logs is how RCLONE_MOVED is known for it (the audit of the
# fixes, claude G-A-01: the game-exit sync stamped a bare 69, SKIPPED, over
# saves that went up).
logged_moved() { # <offset into LOG_FILE> [file]
    local now
    {
        now=$(stat -c %s "${LOG_FILE}" 2>/dev/null) && [ "${now}" -gt "$1" ] 2>/dev/null \
            && tail -c +$(( $1 + 1 )) "${LOG_FILE}" 2>/dev/null
        [ -n "${2:-}" ] && cat "$2" 2>/dev/null
    } | grep -qE ': (Copied|Moved) \(|: Deleted$'
}

rclone() {
    if [ "${AUTOMATIC}" -eq 1 ]; then
        if [ "${SYNC_DEADLINE}" -gt 0 ]; then
            local left=$(( SYNC_DEADLINE - $(date +%s) ))
            # Past the ceiling nothing more is started (#308 gpt F-CS-34): each
            # call used to be given a second more and three to die in, so a
            # run that met its ceiling went on for as many seconds again as it
            # had calls left -- the probe that words the failure, the tidy.
            # The call's answer is the ceiling's own, 124.
            if [ "${left}" -lt 1 ]; then
                log_message "rclone $1 not started: the automatic ceiling had passed" "false"
                return 124
            fi
            local log0 rc
            log0=$(stat -c %s "${LOG_FILE}" 2>/dev/null || echo 0)
            command timeout -k 3 "${left}" rclone "$@" "${RCLONE_SYNC_NET_OPTS_ARRAY[@]}"; rc=$?
            logged_moved "${log0}" && RCLONE_MOVED=1
            return "${rc}"
        else
            command rclone "$@"
        fi
    elif [ -n "${RCLONE_OUTER}" ]; then
        "${RCLONE_OUTER}" "$@"
    else
        bounded_rclone "$@"
    fi
}

# The pauses between sections give somebody reading the console time to see
# each one before the next scrolls in. Under --yes nobody is reading -- the
# output is a progress card -- and seven seconds of them was over a third of
# an 18-second game-exit sync that moved nothing.
pause() {
    [ "${ASSUME_YES}" -eq 1 ] || sleep "$1"
}

# Logging function that supports different severity levels and optional console output
# 
# This function formats and records log messages with timestamps and severity levels.
# It can optionally display messages on screen with appropriate color coding.
#
# Parameters:
#   $1: Message text to log
#   $2: Whether to echo to screen (true/false, defaults to true)
#   $3: Log level (INFO, WARN, ERROR, defaults to configured LOG_LEVEL or INFO)
log_message() {
    local message="$1"
    local echo_to_screen="${2:-true}"  # Default to true
    local level="${3:-${LOG_LEVEL:-INFO}}"  # Use configured LOG_LEVEL as default
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    
    echo "[${timestamp}] [${level}] [${SCRIPT_NAME}] ${message}" >> ${LOG_FILE}
    
    if [[ "${echo_to_screen}" == "true" ]]; then
        # Color output based on level
        case "${level}" in
            ERROR) echo -e "\e[31m${message}\e[0m" ;;
            WARN)  echo -e "\e[33m${message}\e[0m" ;;
            *)     echo -e "${message}" ;;
        esac
    fi
}

# One cloud transfer at a time, whoever asked for it.
#
# Three callers can start one: EmulationStation at boot (the startup sync,
# which ran headless from autostart/102-cloud-saves until #94), EmulationStation
# after a game exits, and a person in the menu. Until
# 2026-09-04 the game-exit path was an OS hook with a pgrep guard; moving it
# into ES kept the visible progress and dropped the guard, so exiting a game
# during the boot sync started a second rclone against the same remote. Two
# writers on one folder is how a mirror deleted another handheld's saves
# (D-CLOUD-014); two copies racing is milder, and still nothing anybody asked
# for.
#
# The lock lives here, in the script, so no caller has to know about the
# others. /var/run is tmpfs, so a lock cannot survive a reboot and go stale.
# Non-blocking, because a request that queues silently behind a twenty-minute
# transfer looks exactly like one that hung. Exit EXIT_LOCK_HELD (75) means
# "skipped: another sync is running" -- the UI names it, and no last-run stamp
# is written for work that did not happen.
#
# The descriptor is this shell's and nothing else's. A shell redirection
# carries no close-on-exec, so `exec 9>` hands fd 9 to every child the
# script starts, and rclone then holds the lock for the whole of a transfer
# (watched in /proc on the VM, #124). While the script outlives its
# children that is invisible, because bash waits for each of them before it
# exits. The moment it does not -- killed or orphaned while rclone is still
# copying, a child left in the background -- the lock outlives the run that
# took it and every sync afterwards is refused with "another cloud sync is
# running" when nothing is running at all. So the body runs with fd 9
# closed ("9>&-"): bash keeps the lock on a descriptor of its own, which it
# does mark close-on-exec, and nothing this script starts can see it.
#
# The refusal also waits a moment before saying no, as belt and braces for
# a holder this script does not own: a descriptor leaked by an older build,
# or a process in the act of exiting, frees itself in milliseconds, while a
# real concurrent transfer does not. One second of patience turns a raced
# skip into a run that works and costs a genuinely blocked run one second.
CLOUD_SYNC_LOCK=/var/run/cloud_sync.lock
take_cloud_lock() {
    local tries=0
    exec 9>"${CLOUD_SYNC_LOCK}"
    while ! flock -n 9; do
        if [ "${tries}" -ge 4 ]; then
            echo "Skipped: another cloud sync is already running. Try again when it's done."
            log_message "skipped: another cloud sync holds ${CLOUD_SYNC_LOCK}" "false"
            exit "${EXIT_LOCK_HELD}"
        fi
        tries=$((tries + 1))
        sleep 0.25
    done
}

# The configured remote, by the same rule as `rclone listremotes | head -1`
# -- the first section name in sorted order -- read from the config file
# rather than by starting rclone, which costs close to a second on a
# handheld. rclone remains the fallback if the file yields nothing.
first_remote() {
    local name
    name=$(grep -o '^\[[^]]*\]' /storage/.config/rclone/rclone.conf 2>/dev/null \
           | tr -d '[]' | sort | head -1)
    if [ -n "${name}" ]; then
        printf '%s:\n' "${name}"
    else
        rclone listremotes 2>/dev/null | head -1
    fi
}

# Does the remote compare files by size alone? rclone decides equality by
# size, then modtime, then hash. Plain WebDAV supports neither modification
# times nor hashes; rclone supports both only on Fastmail Files, ownCloud
# (and its Infinite Scale), Nextcloud and its own serve (rclone.org/webdav,
# "Modification times and hashes"; the vendor names from `rclone help
# backend webdav`). On every other WebDAV vendor -- SharePoint, `other`,
# none -- the modtime is "not supported" and never consulted, so two files
# of one size are equal to it whatever their bytes: a battery save, the
# same size every time it is written, never moved again after its first
# upload (#315, D-CLOUD-153; measured on 8196071ff5, `Sizes identical` at
# -vv, `backend features` Precision 3153600000000000000, Hashes []). A
# crypt or alias remote over such a WebDAV inherits it, so one hop through
# its `remote =` is followed (audit of the fix, F-SS-04). Read from the
# config file, never by starting rclone (a second on a handheld); the
# section is matched as a string, never as a pattern (a `.` in a name is
# not a wildcard, F-SS-03/05). The answer is "no" for a remote this cannot
# read, so every other remote keeps its passes as they were; over-detecting
# is harmless, since the flag it enables is what rclone does with real
# modtimes anyway.
# RCLONE_CONF_FILE: the harness points it at a fixture (tools/last-good-scripts-test);
# RCLONE_CONFIG is rclone's own override, honoured the same way.
remote_compares_by_size() {
    local remote="${1%:}" conf="${RCLONE_CONF_FILE:-${RCLONE_CONFIG:-/storage/.config/rclone/rclone.conf}}" type vendor inner hop
    [ -r "${conf}" ] || return 1
    for hop in 1 2 3; do
        [ -n "${remote}" ] || return 1
        type=$(_rclone_conf_key "${conf}" "${remote}" type)
        case "${type}" in
            webdav)
                vendor=$(_rclone_conf_key "${conf}" "${remote}" vendor)
                case "${vendor}" in
                    nextcloud|owncloud|infinitescale|fastmail|rclone) return 1 ;;
                    *) return 0 ;;
                esac ;;
            crypt|alias)
                inner=$(_rclone_conf_key "${conf}" "${remote}" remote)
                remote="${inner%%:*}"; [ "${remote}" != "${inner}" ] || return 1 ;;
            *) return 1 ;;
        esac
    done
    return 1
}
# _rclone_conf_key <conf> <section> <key>: the key's first value in that
# section, the section name compared as a string.
_rclone_conf_key() {
    awk -v want="[$2]" -v key="$3" '
        /^\[/ { insec = ($0 == want); next }
        insec && index($0, key) == 1 {
            rest = substr($0, length(key) + 1); sub(/^[ \t]*=[ \t]*/, "", rest)
            if (rest != substr($0, length(key) + 1)) { sub(/[ \t]+$/, "", rest); print rest; exit }
        }' "$1" 2>/dev/null
}

# Exit EXIT_NO_NETWORK (69) means "skipped: no network". Answered locally,
# before any remote probe: with no default route there is nothing to sync to,
# and somebody exiting a game should not wait for rclone to time out learning
# that (its probe allows 10 s to connect and 20 s overall). `ip route` reads the
# kernel's table and sends nothing. An interface that is up but has no route
# yet -- Wi-Fi still associating, DHCP not answered -- counts as no network,
# which is the right answer for a job that has to run now.
has_default_route() {
    ip -4 route show default 2>/dev/null | grep -q . \
        || ip -6 route show default 2>/dev/null | grep -q .
}

check_network_link() {
    if ! has_default_route; then
        echo "Skipped: there's no network connection. Try again when you're online."
        log_message "skipped: no default route, nothing to sync to" "false"
        exit "${EXIT_NO_NETWORK}"
    fi
}

# Load controller configuration if available
if [ -f "/storage/.config/profile.d/098-controller" ]; then
    source /storage/.config/profile.d/098-controller
    log_message "Controller config loaded: SOUTH=${DEVICE_BTN_SOUTH}, DPAD_UP=${DEVICE_BTN_DPAD_UP}" "false"
fi

# Simple controller input function using evtest for actual joystick input
# Improved controller input: persistent evtest for low-latency input
read_controller_input() {
    local timeout="${1:-0}" # Default to no timeout
    local input_device=""
    for dev in /dev/input/event*; do
        if [ -c "$dev" ]; then
            local supports=$(udevadm info "$dev" 2>/dev/null | awk '/ID_INPUT_JOYSTICK=1/ {print "joystick"}')
            if [ "$supports" = "joystick" ]; then
                input_device="$dev"
                break
            fi
        fi
    done
    if [ -z "$input_device" ]; then
        # Fallback to keyboard input if no controller is found
        if [ "$timeout" -gt 0 ]; then
            read -t "$timeout" -sn1 input 2>/dev/null
        else
            read -sn1 input 2>/dev/null
        fi
        case "$input" in
            "w"|"W"|$'\e[A') echo "up" ;;
            "s"|"S"|$'\e[B') echo "down" ;;
            "a"|"A"|$'\e[D') echo "left" ;;
            "d"|"D"|$'\e[C') echo "right" ;;
            $'\n'|" ")       echo "confirm" ;;
            "q"|"Q"|$'\e')   echo "cancel" ;;
            "") echo "timeout" ;;
            *) echo "unknown" ;;
        esac
        return
    fi
    
    # For controllers, block and wait for the first button press event.
    # This is more responsive than polling with a timeout.
    local event_output
    if [ "$timeout" -gt 0 ]; then
        event_output=$(timeout "$timeout" evtest "$input_device" 2>/dev/null | grep -m 1 "value 1")
    else
        event_output=$(evtest "$input_device" 2>/dev/null | grep -m 1 "value 1")
    fi
    
    if [ -z "$event_output" ]; then
        echo "timeout"
        return
    fi
    
    # Parse the first button press event found
    log_message "Raw event data: $event_output" "false"
    if [[ "$event_output" =~ BTN_DPAD_UP.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0Y.*value[[:space:]]+-1 ]]; then
        echo "up"
    elif [[ "$event_output" =~ BTN_DPAD_DOWN.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0Y.*value[[:space:]]+1 ]]; then
        echo "down"
    elif [[ "$event_output" =~ BTN_DPAD_LEFT.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0X.*value[[:space:]]+-1 ]]; then
        echo "left"
    elif [[ "$event_output" =~ BTN_DPAD_RIGHT.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0X.*value[[:space:]]+1 ]]; then
        echo "right"
    elif [[ "$event_output" =~ BTN_SOUTH.*value[[:space:]]+1 ]] || [[ "$event_output" =~ BTN_A.*value[[:space:]]+1 ]] || [[ "$event_output" =~ BTN_EAST.*value[[:space:]]+1 ]]; then
        echo "confirm"
    elif [[ "$event_output" =~ BTN_B.*value[[:space:]]+1 ]]; then
        echo "cancel"
    elif [[ "$event_output" =~ BTN_START.*value[[:space:]]+1 ]]; then
        echo "start"
    elif [[ "$event_output" =~ BTN_SELECT.*value[[:space:]]+1 ]]; then
        echo "select"
    else
        log_message "Unrecognized button event: $event_output" "false"
        echo "unknown"
    fi
}

# Simple controller-friendly confirmation using the same pattern as other ROCKNIX scripts
# Parameters: $1=message, $2=initial_selection (0=yes, 1=no, defaults to 0)
controller_confirm() {
    local message="$1"
    local selected="${2:-0}"         # Default to Yes initially selected
    local options=("Yes" "No")
    local last_selected=-1
    log_message "Starting controller_confirm with message: '$message', initial: $selected" "false"
    
    while true; do
        # Only redraw if selection changed
        if [ $selected -ne $last_selected ]; then
            printf "\033[2J\033[H"  # Clear screen and move to top
            echo -e "\e[33m${message}\e[0m"
            echo ""
            for i in "${!options[@]}"; do
                if [ $i -eq $selected ]; then
                    echo -e "\e[34m> \e[32m${options[$i]}\e[0m"
                else
                    echo "  ${options[$i]}"
                fi
            done
            echo ""
            echo "Controls: D-Pad Up/Down=Navigate, A=Confirm, B=Cancel"
            echo "Keyboard: W/S=Navigate, Enter=Confirm, Q=Cancel"
            echo ""
            last_selected=$selected
        fi
        
        local input=$(read_controller_input)
        log_message "Received input: '$input'" "false"
        case "$input" in
            "up")
                selected=$(( (selected - 1 + 2) % 2 ))
                log_message "Selection changed to: $selected (moved up)" "false"
                ;;
            "down")
                selected=$(( (selected + 1) % 2 ))
                log_message "Selection changed to: $selected (moved down)" "false"
                ;;
            "confirm")
                log_message "Confirmed with selection: $selected" "false"
                sleep 0.3
                return $selected
                ;;
            "cancel")
                log_message "Cancelled" "false"
                return 1
                ;;
            "timeout")
                # Continue waiting for input
                ;;
            *)
                log_message "Unknown input received: '$input'" "false"
                ;;
        esac
        sleep 0.05
    done
}

# Somebody who starts a backup and walks away has no way to learn how it went:
# the progress card is gone by the time they come back, and the toast that
# reported the outcome went with it. Leave the answer where the menu can read
# it later.
#
# Device-local state, so it lives under /storage/.cache rather than
# /storage/.config -- a stamp swept into the settings backup and restored onto
# a second device would be describing a run that device never made.
#
# Whole or not at all: to a temporary name beside the stamp, then renamed
# over it, as ThreadedCloudSync::recordOutcome does. A kill mid-write leaves
# the previous stamp; it used to leave an empty file, which the row read as
# "never" and --recent as "no successful backup" (D-CLOUD-078, #105).
write_stamp() {
    local file="$1" line="$2" tmp
    mkdir -p "$(dirname "${file}")" 2>/dev/null
    tmp="${file}.tmp.$$"
    { printf '%s\n' "${line}" > "${tmp}"; } 2>/dev/null \
        && mv -f "${tmp}" "${file}" 2>/dev/null \
        || rm -f "${tmp}" 2>/dev/null
}

# The stamp's third field: why the run did not finish, as the token the
# menu row reads back (D-UI-028) -- the >>> why sentence with its spaces as
# underscores, so a reader that splits on spaces still gets one field.
# Nothing when the run completed, or ended on a sentinel the reader names
# itself.
record_last_run() {
    local exit_code="$1"
    local name="backup" why=""
    [ "${SYSTEM_ONLY}" -eq 1 ] && name="settings-backup"
    # A settings-only run that found nothing to send ran nothing; the stamp
    # keeps describing the last upload that happened (#126).
    if [ "${SYSTEM_ONLY}" -eq 1 ] && [ "${SETTINGS_NOTHING_RAN}" -eq 1 ]; then
        return 0
    fi
    case "${exit_code}" in
        0|9|"${EXIT_NO_NETWORK}"|"${EXIT_LOCK_HELD}") ;;
        *) [ -n "${LAST_WHY}" ] && why=" $(printf '%s' "${LAST_WHY}" | tr ' ' '_')" ;;
    esac
    # SKIPPED means nothing was touched (#308 claude F-CS-24): a run the
    # network ended after a transfer of this run had moved a file keeps its
    # 69 and adds the gaps token and a why, which the rows read as COULDN'T
    # FINISH. Known for the deliberate runs from the stall ceiling's trace,
    # and for the automatic ones from what their rclone logs (logged_moved).
    if [ "${exit_code}" = "${EXIT_NO_NETWORK}" ] && [ "${RCLONE_MOVED}" -eq 1 ]; then
        why=" gaps YOU WENT OFFLINE PART-WAY THROUGH"
    fi
    write_stamp "/storage/.cache/cloud_sync/last-${name}" "$(date +%s) ${exit_code}${why}"
}

# Is this settings archive whole? tar lists every member or fails. For a zip,
# an unzip that can test its members is asked to, and its "no" stands (audit
# #307 PL-070): the check was `unzip -t || unzip -l`, so a zip whose central
# directory lists but whose member's bytes are damaged failed -t and then
# passed -l, and was sent as this device's newest. The image's busybox unzip
# has -t: it inflates every member, so a damaged compressed stream fails it
# (it checks no CRC, so a STORED member's bytes are beyond it -- measured on
# 1.36.1; the settings archives are tar.gz now, and older zips deflated).
# Only an unzip that does not know the option falls back to a listing,
# which still catches a zip cut short (no central directory to list).
# Whether it knows the option is asked once: one that does not says so
# before it opens anything.
UNZIP_CAN_TEST=""
unzip_can_test() {
    if [ -z "${UNZIP_CAN_TEST}" ]; then
        if unzip -t /nonexistent-cloud-backup-probe.zip 2>&1 \
            | grep -qiE 'invalid option|unrecognized option|illegal option|unknown option'; then
            UNZIP_CAN_TEST=0
        else
            UNZIP_CAN_TEST=1
        fi
    fi
    [ "${UNZIP_CAN_TEST}" = 1 ]
}
archive_whole() {
    case "${1}" in
        *.tar.gz) tar -tzf "${1}" >/dev/null 2>&1 ;;
        *)
            if unzip_can_test; then
                unzip -t "${1}" >/dev/null 2>&1
            else
                unzip -l "${1}" >/dev/null 2>&1
            fi ;;
    esac
}

# Why a run did not finish, in the player's words (D-UI-028, D-CLOUD-077).
#
# One `>>> why <SENTENCE>` protocol line at the point of failure is what the
# sync card and the transfer page read; rclone's own taxonomy and every exit
# code stay in the log. The sentences are the vocabulary table's in
# es-native-ui.md. One per phase: a phase resets WHY_SAID, and the second
# speaker in a phase (network_lost_during_run first, then
# report_rclone_error) says nothing. LAST_WHY feeds the stamp.
WHY_SAID=0
LAST_WHY=""
say_why() {
    [ "${WHY_SAID}" -eq 0 ] || return 0
    WHY_SAID=1
    LAST_WHY="$1"
    echo ">>> why $1"
    log_message "why: $1" "false"
}
# The summary's word for a phase (D-UI-028): COMPLETED, or COULDN'T FINISH.
# rclone's 9 (nothing needed moving) is a completion. SUCCESS and COMPLETED
# WITH ERRORS -- a partial success reported as errors -- retire.
outcome_word() {
    case "$1" in
        0|9) echo "COMPLETED" ;;
        *)   echo "COULDN'T FINISH" ;;
    esac
}
why_for() {
    case "$1" in
        3|4) echo "COULDN'T FIND YOUR CLOUD FOLDER" ;;
        5)   echo "YOUR CLOUD STOPPED ANSWERING" ;;
        6)   echo "SOME FILES DIDN'T FINISH" ;;
        7|8) echo "YOUR CLOUD WOULDN'T TAKE THE FILES" ;;
        130) echo "IT WAS STOPPED" ;;
        10|124)
            # The ceiling ended the run. An automatic sync runs again on its
            # own; a run somebody pressed has TRY AGAIN in reach, and what
            # they saw was a cloud that stopped answering (D-CLOUD-126).
            if [ "${AUTOMATIC:-0}" -eq 1 ]; then
                echo "THE CLOUD TOOK TOO LONG - IT'LL TRY AGAIN NEXT TIME"
            else
                echo "YOUR CLOUD STOPPED ANSWERING"
            fi ;;
        *)   echo "SOMETHING WENT WRONG" ;;
    esac
}

# The value of --timeout among rclone options, in whole seconds: 30s, 1m,
# 2h, a bare number (seconds, as rclone reads one), or --timeout=30s.
# Nothing when it is absent or not a shape this knows.
idle_timeout_seconds() {
    local v="" prev="" a
    for a in "$@"; do
        case "${a}" in
            --timeout=*) v="${a#--timeout=}" ;;
            *) [ "${prev}" = "--timeout" ] && v="${a}" ;;
        esac
        prev="${a}"
    done
    case "${v}" in
        *h) [[ "${v%h}" =~ ^[0-9]+$ ]] && echo $(( ${v%h} * 3600 )) ;;
        *m) [[ "${v%m}" =~ ^[0-9]+$ ]] && echo $(( ${v%m} * 60 )) ;;
        *s) [[ "${v%s}" =~ ^[0-9]+$ ]] && echo "${v%s}" ;;
        *)  [[ "${v}" =~ ^[0-9]+$ ]] && echo "${v}" ;;
    esac
}

# The run's own outcome line, printed last, in the sentence form the other
# outcome lines use (D-UI-028): Completed. / Couldn't finish: <why>. Try
# again. / Skipped: <reason>. The phase lines above it say which tier did
# what; this is the answer for a reader that takes the last line --
# tools/cloud-round-trip's vocabulary gate does, and "Settings backup:
# COMPLETED" was not a sentence it accepts (#153, D-CLOUD-126).
# A saves folder at the cloud's root keeps no record of the cloud saves a
# backup replaces (G-A-09); a run that completed says so after Completed.
REPLACED_NOT_KEPT=0
REPLACED_NOT_KEPT_LINE="Your saves folder is your cloud's top folder, so no replaced cloud saves are kept."
run_outcome_line() {
    local rc="$1" why
    case "${rc}" in
        0|9)
            # A settings-only run that found nothing to send ran nothing, and
            # said so where it was skipped (D-CLOUD-090).
            if [ "${SYSTEM_ONLY}" -eq 1 ] && [ "${SETTINGS_NOTHING_RAN}" -eq 1 ]; then
                echo "Skipped: there's no settings backup on this device to send yet."
            elif [ "${REPLACED_NOT_KEPT}" -eq 1 ]; then
                echo "Completed. ${REPLACED_NOT_KEPT_LINE}"
            else
                echo "Completed."
            fi ;;
        *)
            why=$(printf '%s' "${LAST_WHY}" | tr 'A-Z' 'a-z')
            if [ -n "${why}" ]; then
                echo "Couldn't finish: ${why}. Try again."
            else
                echo "Couldn't finish. Try again."
            fi ;;
    esac
}

# Performs cleanup operations and exits with the specified code
# Records total execution time in the log for performance tracking
# Parameters:
#   $1: Exit code to return
clean_exit() {
    local exit_code=$1
    local duration=$(($(date +%s) - START_TIME))

    # A deliberate run's rclone runs in the background under the stall
    # ceiling; a signal that reached the script mid-copy ends it here rather
    # than leaving it to finish unwatched, and its trace goes with it.
    if [ -n "${RCLONE_CHILD}" ] && child_running "${RCLONE_CHILD}"; then
        kill -TERM "${RCLONE_CHILD}" 2>/dev/null
    fi
    rm -rf "${CEILING_DIR_ROOT}/cloud_sync.${$}."* 2>/dev/null
    
    # A failed phase leaves with the code the phase gave -- rclone's, when a
    # transfer failed -- unremapped. Nothing rclone returns can read as the
    # lock or no-network sentinel now that those are 75 and 69 (#99).
    record_last_run "${exit_code}"
    # A run that completed is the new known-good state, so the copies the
    # helper took before touching the config -- and the migration copy it
    # used to keep for ever -- are superseded and go, leaving one record at
    # rest (D-CLOUD-078 (3), D-CLOUD-079). The next run takes fresh copies
    # before it touches anything.
    case "${exit_code}" in
        0|9) rm -f /storage/.config/cloud_sync.conf.bak \
                   /storage/.config/cloud_sync-rules.txt.bak \
                   /storage/.config/cloud_sync.conf.pre-copy-default 2>/dev/null ;;
    esac
    log_message "Script completed in ${duration} seconds with exit code ${exit_code}" "false"
    exit ${exit_code}
}

# Verifies rclone is properly configured before attempting operations
# Exits with error if configuration file is missing
check_rclone_config() {
    if [ ! -e "/storage/.config/rclone/rclone.conf" ]; then
        log_message "Your cloud storage isn't set up yet. Set it up under GAME SETTINGS > MANAGE CLOUD STORAGE first." "true" "ERROR"
        say_why "YOUR CLOUD STORAGE ISN'T SET UP YET"
        pause 3
        clean_exit 1
    fi
}

# What has to be reachable is the configured cloud storage, not the internet at
# large. Pinging google.com gets both answers wrong: it fails on a setup that
# works fine - a self-hosted or LAN remote needs no internet, and that host is
# unreachable on some networks outright - and it succeeds while the user's
# provider is down or their sign-in has expired. Test the remote itself, and
# probe further only to word the failure correctly, because the two causes have
# different fixes.
check_internet() {
    log_message "Checking cloud storage reachability..." "false"

    local remote probe_rc=1
    remote=$(rclone listremotes 2>/dev/null | head -1)
    if [ -n "${remote}" ]; then
        rclone lsd "${remote}" "${RCLONE_PROBE_OPTS[@]}" >/dev/null 2>&1; probe_rc=$?
        if [ "${probe_rc}" -eq 0 ]; then
            log_message "Cloud storage ${remote} is reachable" "false"
            return 0
        fi
    fi

    # A probe the automatic ceiling ended (the wrapper's 124) is the
    # ceiling's answer, not the sign-in's: it fell through to the branch
    # below and read COULDN'T REACH YOUR CLOUD - CHECK YOUR SIGN-IN (the
    # audit of the fixes, claude G-A-09).
    if [ "${AUTOMATIC}" -eq 1 ] && [ "${probe_rc}" -eq 124 ]; then
        log_message "the reachability probe was ended by the automatic ceiling; reporting that" "false"
        log_message "Couldn't finish: the cloud took too long. It'll try again next time." "true" "ERROR"
        say_why "$(why_for 124)"
        clean_exit 124
    fi

    if ping -q -c1 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -q -c1 -W 3 8.8.8.8 >/dev/null 2>&1; then
        log_message "Couldn't reach your cloud.\nYou may need to sign in again, then try again." "true" "ERROR"
        say_why "COULDN'T REACH YOUR CLOUD - CHECK YOUR SIGN-IN"
        pause 3
        clean_exit 1
    fi
    # A route with nothing behind it -- Wi-Fi associated to an access point
    # whose uplink is down, or a link that has already gone quiet -- is no
    # network, the same answer check_network_link gives when there is no
    # route at all, and with the same code: EmulationStation shows SKIPPED -
    # NO NETWORK CONNECTION for it, where a 1 read as FAILED and sent
    # somebody to a log to learn that nothing had gone wrong. Nothing has
    # run yet, so no stamp, as for the other sentinel exits.
    log_message "You're not online right now.\nCheck your connection and try again." "true" "ERROR"
    log_message "skipped: no network -- the remote and the internet both unreachable before the run" "false"
    pause 3
    exit "${EXIT_NO_NETWORK}"
}

# Why did rclone fail? Asked after a transfer or a listing came back
# non-zero, with rclone's code and the phase's name.
#
# rclone's code says an operation failed. It does not say whether the cause
# was the cloud, the sign-in, or the Wi-Fi going away underneath it -- and
# on a handheld the last is the common one: the RG SP left the LAN a minute
# into its startup sync and the card sat on 113/113 until rclone gave up
# (#101). Told apart the way check_internet tells them apart before a run:
# is there a default route, does the remote answer a bounded probe now, does
# anything at all.
#
# The network gone -- no route, or a route nothing gets through -- ends the
# run with EXIT_NO_NETWORK (69), which EmulationStation names on the card
# and on the row (SKIPPED - NO NETWORK CONNECTION). Through clean_exit, so
# the stamp records a run that did not complete: never 0, because a 0 here
# would let the next --recent pass skip everything this one never sent, and
# not rclone's code, because "no network" is the true answer and the one
# the player can act on. No second phase is attempted -- it would stall for
# another minute against the same dead link.
#
# Anything else is rclone's failure to report, and the caller passes
# rclone's own code through unchanged as it always did: the remote answers
# again (a blip rclone did not survive), or the internet answers and the
# remote does not (the provider, or the sign-in) -- neither is "no network",
# and saying so would be the phantom sentinel #99 removed.
network_lost_during_run() {
    local rc="$1" what="$2"
    # The code goes to the log; the screen gets the words (D-UI-028).
    if ! has_default_route; then
        log_message "the network went away during ${what} (rclone exit ${rc}): no default route now" "false" "ERROR"
        log_message "Couldn't finish: lost the network during ${what}. Try again when you're online." "true" "ERROR"
        clean_exit "${EXIT_NO_NETWORK}"
    fi
    # An automatic run its ceiling ended (124, or rclone's own 10 for
    # --max-duration) has no time left to probe with -- the wrapper starts
    # nothing past the deadline (#308 gpt F-CS-34) -- and the true answer is
    # the ceiling's: why_for says THE CLOUD TOOK TOO LONG.
    if [ "${AUTOMATIC}" -eq 1 ] && { [ "${rc}" = 124 ] || [ "${rc}" = 10 ]; }; then
        log_message "${what} was ended by the automatic ceiling (rclone exit ${rc}); reporting that" "false"
        return 0
    fi
    if rclone lsd "${REMOTENAME}" "${RCLONE_PROBE_OPTS[@]}" >/dev/null 2>&1; then
        log_message "${what} failed (rclone exit ${rc}) but ${REMOTENAME} answers now; reporting rclone's own result" "false"
        return 0
    fi
    if ping -q -c1 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -q -c1 -W 3 8.8.8.8 >/dev/null 2>&1; then
        log_message "the cloud stopped responding during ${what} (rclone exit ${rc}); the internet answers" "false" "ERROR"
        log_message "Your cloud stopped answering during ${what}.\nYou may need to sign in again, then try again." "true" "ERROR"
        say_why "YOUR CLOUD STOPPED ANSWERING"
        return 0
    fi
    log_message "the network went away during ${what} (rclone exit ${rc}): nothing answers now" "false" "ERROR"
    log_message "Couldn't finish: lost the network during ${what}. Try again when you're online." "true" "ERROR"
    clean_exit "${EXIT_NO_NETWORK}"
}

# Is this saves allowlist whole? Its last rule is the catch-all "- /**",
# and a file cut before it admits everything under the saves folder. The
# line itself, whole: "- /**/*.db" starts the same way (audit #307 PL-020,
# the same test cloud_sync_helper makes before it installs a rules file).
rules_whole() {
    [ -s "$1" ] && grep -qx -- '- /\*\*' "$1"
}
# The allowlist this device writes and keeps (cloud_sync_helper).
MANAGED_RULES=/storage/.config/cloud_sync-rules.txt

# Is this a cloud_sync.conf that can be run with? bash -n, and a grammar
# nothing but assignments of text can pass. Every line is blank, a
# comment, or KEY=value, where the value is
#   - "double quoted": any text but a backtick, a $ that is not a plain
#     $NAME or ${NAME}, and a backslash that is not the line's last
#     character (the continuation RCLONEOPTS is written with) or one of
#     bash's own escapes inside double quotes, \" \\ \$ and \`, each of
#     which is the one character bash makes of it;
#   - 'single quoted' on one line, with no $( or backtick in it;
#   - or a bare word of letters, digits and . / : @ % + , = _ -;
# and after it nothing, or blanks and a # comment. The shape check matters
# because a torn line -- SAVES_REMOTE="/ROCK, cut mid-value -- can have its
# quote closed by whatever is appended after it, and then parses.
#
# The escapes were refused until the audit of the fix round (PL-015): the
# validator before this grammar passed them, so an upgraded device whose
# hand-edited RCLONEOPTS read --exclude \"*.tmp\" was told its settings
# could not be read on every run. A backslash before anything else is
# still refused; bash would keep it, and nothing needs it.
#
# A blank is a space or a tab, and nothing else is: no line may carry a
# control character but a tab (the audit of the fix round, PL-002). Bash
# does not split a word on a carriage return, a vertical tab or a form
# feed, so EXTRA="x"<CR>#$(cmd) is one word whose $(cmd) runs, and so is a
# "comment" line <CR>#$(cmd) -- and this grammar read all three as blanks
# ([ \t\r] after a value, [[:space:]] before a comment) and passed them.
#
# And nothing in it runs when it is sourced (audit #307 PL-051's script
# half). The setup page writes the folder values from what a player typed
# or picked, and an earlier build wrote one that held "$(...)" as it
# stood, which every `source` of this file then ran; a folder value
# (SAVESPATH, SETTINGS_BACKUPS, SAVES_REMOTE, SETTINGS_REMOTE,
# CONTENT_REMOTE) is plain text on one line, with no $, backtick,
# backslash or control character. The first cut of this refused only $(
# and a backtick, and let a continued line through unchecked: a quoted
# value continued onto a line that closed the quote and went on
# (`RCLONEOPTS="--progress \` then `"; touch x; : ""`), a value closed and
# followed by `; command`, and ${W@P}, which runs the command a value
# spells out, all passed and ran (the audit of the fixes, G-A-05). A
# config that fails is not sourced: the caller falls back to the good
# copy or refuses (YOUR CLOUD SYNC SETTINGS COULDN'T BE READ).
#
# CONF_WHY says why a file was refused -- "line N: <its shape>", never the
# value -- for the caller's log (PL-015): a refusal that names nothing
# leaves whoever reads the log to guess which line of a hand edit it was.
conf_valid() {
    CONF_WHY=""
    if [ ! -s "$1" ]; then CONF_WHY="the file is missing or empty"; return 1; fi
    if ! bash -n "$1" 2>/dev/null; then CONF_WHY="bash cannot parse it"; return 1; fi
    # A NUL byte ends awk's record on the device's busybox, so the grammar below
    # would read "EXTRA=x"<NUL>"#$(cmd)" as EXTRA=x (the audit of the fixes,
    # claude G3-D-02); counted before anything reads the file.
    if [ "$(tr -d '\000' < "$1" 2>/dev/null | wc -c)" -ne "$(wc -c < "$1")" ]; then CONF_WHY="a NUL byte"; return 1; fi
    CONF_WHY=$(awk '
        function bad(why) { if (!failed) print "line " NR ": " why; failed = 1; exit 1 }
        # A double-quoted value from position i of s: the position after
        # its closing quote, or 0 when the line ends in a continuation.
        function dq(s, i,    n, c, d) {
            n = length(s)
            while (i <= n) {
                c = substr(s, i, 1)
                if (c == "\"") return i + 1
                if (c == "`") bad("a backtick inside double quotes")
                if (c == "\\") {
                    if (i == n) return 0
                    d = substr(s, i + 1, 1)
                    if (d == "$" && substr(s, i + 2, 1) ~ /[(\[{]/) bad("a \\$ followed by (, [ or { -- a literal $( that a shell context could still run (audit of the fixes, G3-D-01)")
                    if (d == "\"" || d == "\\" || d == "$" || d == "`") { val = val c d; i += 2; continue }
                    bad("a backslash inside double quotes that is not one of the escapes bash reads there")
                }
                if (c == "$") {
                    d = substr(s, i + 1)
                    if (match(d, /^[A-Za-z_][A-Za-z0-9_]*/) || match(d, /^\{[A-Za-z_][A-Za-z0-9_]*\}/)) {
                        val = val c substr(d, 1, RLENGTH); i += 1 + RLENGTH; continue
                    }
                    bad("a $ inside double quotes that is not a plain $NAME or ${NAME}")
                }
                val = val c; i++
            }
            bad("a double-quoted value that runs on past the line without a backslash")
        }
        # After a value: nothing, or blanks and a comment.
        function rest(s, i) { if (substr(s, i) !~ /^([ \t]+(#.*)?)?$/) bad("something after the value that is not a # comment") }
        function whole() {
            if (key ~ /^(SAVESPATH|SETTINGS_BACKUPS|SAVES_REMOTE|SETTINGS_REMOTE|CONTENT_REMOTE)$/ \
                && (val ~ /[$`\\]/ || val ~ /[[:cntrl:]]/ || lines > 1)) bad("a folder value that is not plain text on one line")
        }
        {
            s = $0
            t = s; gsub(/\t/, "", t)
            if (t ~ /[[:cntrl:]]/) bad("a control character other than a tab")
            if (indq) {
                lines++
                j = dq(s, 1)
                if (j == 0) next
                indq = 0; rest(s, j); whole(); next
            }
            if (s ~ /^[ \t]*(#|$)/) next
            if (!match(s, /^[A-Za-z_][A-Za-z0-9_]*=/)) bad("a line that is not KEY=value, a comment or blank")
            key = substr(s, 1, RLENGTH - 1); i = RLENGTH + 1; val = ""; lines = 1
            # A name the shell owns is refused whatever its value: bash evaluates an
            # assignment to RANDOM, SECONDS or LINENO as arithmetic, and arithmetic
            # runs a $( ) it finds (the audit of the fixes, gpt G3-D-01: a sourced
            # RANDOM="BASH_VERSINFO[\\$(cmd)0]" ran cmd on the host); PATH, IFS and
            # the rest change what every later command means.
            if (key ~ /^(RANDOM|SRANDOM|SECONDS|LINENO|HISTCMD|BASHPID|BASH_[A-Z_]*|EPOCH[A-Z]*|FUNCNAME|GROUPS|DIRSTACK|PIPESTATUS|SHELLOPTS|BASHOPTS|COMP_[A-Z_]*|READLINE_[A-Z_]*|PATH|IFS|ENV|BASH_ENV|CDPATH|HOME|PS[0-4]|PROMPT_COMMAND|TMPDIR|SHELL|LANG|LC_[A-Z_]*|GLOBIGNORE|HISTFILE|TMOUT|OPTIND|OPTARG|PWD|OLDPWD|SHLVL|UID|EUID|PPID|LD_[A-Z_]*)$/) bad("a name the shell owns (" key ")")
            c = substr(s, i, 1)
            if (c == "\"") {
                j = dq(s, i + 1)
                if (j == 0) { indq = 1; next }
                rest(s, j); whole(); next
            }
            if (c == "'"'"'") {
                j = index(substr(s, i + 1), "'"'"'")
                if (!j) bad("a single-quoted value that does not close on its line")
                val = substr(s, i + 1, j - 1)
                if (val ~ /\$\(|`/) bad("a $( or a backtick inside single quotes")
                rest(s, i + j + 1); whole(); next
            }
            match(substr(s, i), /^[A-Za-z0-9_.\/:@%+,=-]*/)
            val = substr(s, i, RLENGTH)
            rest(s, i + RLENGTH); whole()
        }
        END {
            if (failed) exit 1
            if (indq) { print "line " NR ": a double-quoted value that never closes"; exit 1 }
        }
    ' "$1")
}

# Loads user configuration from cloud_sync.conf
# Applies default values for any missing configuration parameters
load_config() {
    # The helper first: it carries renamed keys across (D-UI-022) and appends
    # new defaults, and the values sourced below must be the migrated ones.
    if [ -f "/usr/bin/cloud_sync_helper" ]; then
        log_message "Updating cloud sync rules and config" "false"
        /usr/bin/cloud_sync_helper ${LOG_FILE}
    fi
    log_message "Loading configuration from cloud_sync.conf" "false"
    # A config that does not parse is not run with. `source` used to be
    # unchecked, so a torn file -- a partial trailing line -- was read up to
    # the tear and the run went on with whatever was missing (SAVES_REMOTE
    # unset means remote:/). The helper's copy from before this run's
    # update is the fallback; with no good copy the run refuses and says so
    # (D-CLOUD-078, #105).
    local conf="/storage/.config/cloud_sync.conf"
    if ! conf_valid "${conf}"; then
        # Which line, and what about it -- never the value (PL-015).
        log_message "cloud_sync.conf is not run with: ${CONF_WHY}" "false" "WARN"
        if [ -f "${conf}.bak" ] && conf_valid "${conf}.bak"; then
            log_message "cloud_sync.conf does not parse; putting back the copy taken before this run's update" "false" "WARN"
            cp -f "${conf}.bak" "${conf}.tmp.$$" && mv -f "${conf}.tmp.$$" "${conf}"
        else
            rm -f "${conf}.tmp.$$" 2>/dev/null
            log_message "Your cloud sync settings couldn't be read, and there's no good copy to fall back on.\nNothing was changed. Set up cloud storage again under GAME SETTINGS > MANAGE CLOUD STORAGE." "true" "ERROR"
            say_why "YOUR CLOUD SYNC SETTINGS COULDN'T BE READ"
            clean_exit 1
        fi
    fi
    if ! source "${conf}"; then
        log_message "Your cloud sync settings couldn't be read. Nothing was changed.\nSet up cloud storage again under GAME SETTINGS > MANAGE CLOUD STORAGE." "true" "ERROR"
        say_why "YOUR CLOUD SYNC SETTINGS COULDN'T BE READ"
        clean_exit 1
    fi

    # Saves have one local folder (D-CLOUD-040). RESTOREPATH used to let a
    # restore land somewhere other than the live saves -- a safety valve from
    # when restore was a mirror. A config still pointing it elsewhere would
    # give the saves tier two local trees, so every saves transfer refuses
    # until the setting is removed. The helper has already logged it.
    if [ -n "${RESTOREPATH:-}" ] && [ "${RESTOREPATH%/}" != "${SAVESPATH%/}" ]; then
        log_message "RESTOREPATH=${RESTOREPATH} differs from SAVESPATH=${SAVESPATH}; saves have one local folder since D-CLOUD-040" "false" "ERROR"
        log_message "An old setting is still sending restores to a different folder, and saves have just one folder now.\nNothing was changed. Remove the RESTOREPATH line from your cloud sync settings, then try again." "true" "ERROR"
        say_why "AN OLD FOLDER SETTING IS IN THE WAY"
        clean_exit 1
    fi

    # Check for duplicate variable assignments in config
    local conf_file="/storage/.config/cloud_sync.conf"
    local dupes_found=0
    # List of variable names that appear more than once
    mapfile -t duplicate_vars < <(awk -F= '/^[A-Za-z0-9_]+=/{gsub(/"/,"",$1); count[$1]++} END{for (v in count) if(count[v]>1) print v}' "$conf_file")
    if [ ${#duplicate_vars[@]} -gt 0 ]; then
        dupes_found=1
    fi

    if [ $dupes_found -eq 1 ]; then
        # Build the full message including the duplicate info
        local dupe_message="Warning: duplicate settings were found in the cloud sync configuration:"
        for var in "${duplicate_vars[@]}"; do
            dupe_message="${dupe_message}\n  - $var"
        done
        dupe_message="${dupe_message}\n\nWould you like to automatically clean up duplicates?"
        
        if [ "${ASSUME_YES}" -eq 1 ]; then
            local cleanup_choice=0
        else
            controller_confirm "$dupe_message" 0
            local cleanup_choice=$?
        fi
        log_message "Cleanup choice returned: $cleanup_choice" "false"
        
        if [ $cleanup_choice -eq 0 ]; then
            # User selected Yes - cleanup duplicates
            echo -e "\e[34m> Running duplicate cleanup...\e[0m"
            # The cleanup rewrites the file this run has already checked, so
            # what it leaves is checked again before it is sourced -- the one
            # `source` PL-051 left unchecked (the audit of the fixes, claude
            # G-A-14). A cleanup that fails, or leaves a file conf_valid
            # refuses, has the copy from before it put back, and the run goes
            # on with that: the last known good state (D-CLOUD-078).
            #
            # The copy is the last known good only once it is known to be
            # whole (the audit of the fix round, PL-004): cp's status, a byte
            # compare with the live file, and conf_valid on the copy itself.
            # The put-back below used to take any copy that was merely not
            # empty, so a cp that filled the card part-way left a prefix, the
            # cleanup never ran, and the prefix replaced the untouched, valid
            # file. A copy that is not whole is removed, no cleanup runs
            # without one, and the run goes on with the file as it is -- it
            # was checked and sourced above.
            local pre_cleanup="${conf_file}.pre-cleanup.$$"
            if ! { cp -f "${conf_file}" "${pre_cleanup}" 2>/dev/null \
                   && cmp -s "${conf_file}" "${pre_cleanup}" \
                   && conf_valid "${pre_cleanup}"; }; then
                rm -f "${pre_cleanup}"
                log_message "the copy of cloud_sync.conf to keep before the duplicate cleanup could not be made whole; the cleanup was not run and the file is as it was" "false" "WARN"
                log_message "Couldn't clean up the duplicate settings, so they were left as they were." "true" "WARN"
                pause 2
            elif /usr/bin/cloud_sync_cleanup_duplicates.sh "$conf_file" \
               && conf_valid "${conf_file}"; then
                rm -f "${pre_cleanup}"
                echo -e "\e[34m> Duplicates cleaned.\e[0m"
                echo ""
                pause 2
                # Reload config after cleanup
                source "${conf_file}"
            elif mv -f "${pre_cleanup}" "${conf_file}"; then
                log_message "the duplicate cleanup failed or left cloud_sync.conf not whole (${CONF_WHY:-the cleanup itself failed}); the copy from before it is back" "false" "WARN"
                log_message "Couldn't clean up the duplicate settings, so they were left as they were." "true" "WARN"
                pause 2
            else
                rm -f "${pre_cleanup}"
                log_message "the duplicate cleanup left cloud_sync.conf not whole and the copy from before it could not be put back" "false" "ERROR"
                log_message "Your cloud sync settings couldn't be read. Nothing was changed.\nSet up cloud storage again under GAME SETTINGS > MANAGE CLOUD STORAGE." "true" "ERROR"
                say_why "YOUR CLOUD SYNC SETTINGS COULDN'T BE READ"
                clean_exit 1
            fi
        else
            # User selected No or cancelled - skip cleanup
            echo -e "\e[34m> Skipped duplicate cleanup.\e[0m"
            pause 2
        fi

    fi

    # Clean and normalize rclone options to ensure proper spacing
    # Convert multi-line options to a properly spaced single line
    # First, save original options for debugging
    log_message "Original RCLONEOPTS: ${RCLONEOPTS}" "false"
    
    # Replace any line continuations and normalize spaces
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | tr '\n\\' '  ' | tr -s ' ')
    log_message "After newline cleanup: ${RCLONEOPTS}" "false"
    
    # Remove conflicting --verbose and -v flags that conflict with --log-level
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | sed 's/--verbose//g' | sed 's/-v / /g')
    # The remote does not only hold saves. It holds every device's system
    # backup under SETTINGS_REMOTE, and whatever else the owner keeps in
    # that folder. --delete-excluded deletes everything the allowlist does
    # not admit, so in sync mode a saves backup removed the backup folder
    # of every device including other people's -- the phase that follows
    # re-uploads only this device's, so the rest were simply gone.
    #
    # Found by testing sync mode against a remote seeded as a second
    # handheld: its archive was carried off with its saves. cloud_restore
    # has stripped this flag for the same class of reason since issue #5;
    # the comment there says backup keeps it because it only tidies the
    # remote, and that premise was wrong.
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | sed 's/--delete-excluded//g')
    log_message "After removing verbose flags: ${RCLONEOPTS}" "false"
    
    # Ensure each option starts with a space (except the first one)
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | sed 's/--/ --/g' | sed 's/^ //')
    log_message "After spacing fix: ${RCLONEOPTS}" "false"
    
    # Clean up any double spaces left by removal
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | tr -s ' ')
    log_message "After final cleanup: ${RCLONEOPTS}" "false"
    
    # Convert to array to ensure proper word splitting
    RCLONE_OPTS_ARRAY=()
    for opt in ${RCLONEOPTS}; do
        RCLONE_OPTS_ARRAY+=("$opt")
    done
    log_message "Options array has ${#RCLONE_OPTS_ARRAY[@]} elements" "false"

    # The network bound, as an array like RCLONEOPTS above. It goes on the
    # command line AFTER RCLONEOPTS, so a timeout somebody once put there
    # does not outrank it -- RCLONE_NET_OPTS is where the bound is changed.
    # Empty or unset -- a config the helper has not seeded, a line somebody
    # blanked -- means the shipped values, never rclone's defaults: the bound
    # is a guard, and a guard a missing line switches off is no guard.
    local net_opts
    net_opts=$(echo "${RCLONE_NET_OPTS:-}" | tr '\n\\' '  ' | tr -s ' ' | sed 's/^ //; s/ $//')
    [ -n "${net_opts}" ] || net_opts="${RCLONE_NET_OPTS_FALLBACK}"
    RCLONE_NET_OPTS_ARRAY=()
    for opt in ${net_opts}; do
        RCLONE_NET_OPTS_ARRAY+=("$opt")
    done
    log_message "rclone network bound: ${net_opts}" "false"

    # The deliberate run's ceiling, from the idle timeout in that bound
    # (D-CLOUD-126): --timeout is when rclone gives a stalled link up; the
    # ceiling is that plus DELIBERATE_CEILING_GRACE seconds for the retry
    # to show progress on a link that is merely slow. A value that cannot
    # be read -- the flag missing, a unit this does not know, a zero that
    # would mean no idle limit at all -- leaves the shipped figure, never
    # no ceiling.
    if [ "${AUTOMATIC}" -eq 0 ]; then
        local idle
        idle=$(idle_timeout_seconds "${RCLONE_NET_OPTS_ARRAY[@]}")
        if [ -n "${idle}" ] && [ "${idle}" -ge 1 ] 2>/dev/null; then
            DELIBERATE_CEILING_SECONDS=$(( idle + DELIBERATE_CEILING_GRACE ))
        fi
        log_message "deliberate run: stall ceiling ${DELIBERATE_CEILING_SECONDS}s (rclone idle timeout ${idle:-unreadable}s + ${DELIBERATE_CEILING_GRACE}s grace)" "false"
    fi

    # The automatic sync's bound on top (D-CLOUD-118), read the same way and
    # with the same rule for an empty line; the ceiling is whole seconds.
    if [ "${AUTOMATIC}" -eq 1 ]; then
        local sync_opts ceiling
        sync_opts=$(echo "${RCLONE_SYNC_NET_OPTS:-}" | tr '\n\\' '  ' | tr -s ' ' | sed 's/^ //; s/ $//')
        [ -n "${sync_opts}" ] || sync_opts="${RCLONE_SYNC_NET_OPTS_FALLBACK}"
        RCLONE_SYNC_NET_OPTS_ARRAY=()
        for opt in ${sync_opts}; do
            RCLONE_SYNC_NET_OPTS_ARRAY+=("$opt")
        done
        ceiling="${SYNC_CEILING_SECONDS:-}"
        [[ "${ceiling}" =~ ^[0-9]+$ ]] && [ "${ceiling}" -ge 1 ] || ceiling="${SYNC_CEILING_SECONDS_FALLBACK}"
        SYNC_DEADLINE=$(( START_TIME + ceiling ))
        log_message "automatic run: ${sync_opts}; ceiling ${ceiling}s from start" "false"
    fi

    # Apply command-line overrides
    if [ "${SYSTEM_ONLY}" -eq 1 ]; then
        BACKUPFILE_BACKUP_OPTION="yes"
        log_message "System-backup phase forced on by --system-only" "false"
    fi
    if [ -n "${METHOD_OVERRIDE}" ]; then
        BACKUPMETHOD="${METHOD_OVERRIDE}"
        log_message "Transfer method overridden from command line: ${METHOD_OVERRIDE}" "false"
    fi
    if [ "${EXTRA_UPDATE}" -eq 1 ]; then
        RCLONE_OPTS_ARRAY+=("--update")
        log_message "Added --update from command line" "false"
    fi

    # A settings or ROMs and BIOS folder inside SAVES_REMOTE. Each tier belongs
    # beside the saves folder, not in it: a folder nested there rides with
    # every tool that moves the saves folder whole (the layout migration moved
    # the settings archives into Saves/backup/ that way, audit #307 PL-025),
    # and the setup page no longer writes such a layout (PL-015, stream C). An
    # earlier build derived /GAMES/Content inside a top-level /GAMES, and a
    # config that says so is read as it stands and warned about, never
    # rewritten -- the layout is the owner's, and TIDY UP YOUR CLOUD FOLDERS
    # is what moves it. The warning used to cover the settings folder alone,
    # and only while RCLONEOPTS carried --delete-excluded, which load_config
    # strips above -- so it could never fire (#308 claude F-CS-17). Logged on
    # every run; on the screen for a run somebody pressed, not the automatic
    # syncs, where it would sit on every game-exit card. Not for a saves
    # folder at the root ("" or "/", one root as F-CS-25 reads it): every
    # folder is inside that one, the tidy cannot move a folder out of it, and
    # the backup says what such a folder costs instead (the audit of the
    # fixes, claude G-A-08: "/" was warned about on every run, "" never).
    local nested_key nested_val nested_what
    for nested_key in SETTINGS_REMOTE CONTENT_REMOTE; do
        nested_val="${!nested_key}"
        [ -n "${nested_val}" ] && [ -n "${SAVES_REMOTE%/}" ] || continue
        case "${nested_val%/}/" in
            "${SAVES_REMOTE%/}/"?*)
                log_message "${nested_key}=${nested_val} is inside SAVES_REMOTE=${SAVES_REMOTE}" "false" "WARN"
                if [ "${nested_key}" = "SETTINGS_REMOTE" ]; then nested_what="settings folder"; else nested_what="ROMs and BIOS folder"; fi
                [ "${AUTOMATIC}" -eq 1 ] || log_message "Your ${nested_what} in the cloud sits inside your saves folder. TIDY UP YOUR CLOUD FOLDERS in MANAGE CLOUD STORAGE moves it out." "true" "WARN"
                ;;
        esac
    done

    log_message "Configuration loaded successfully" "false"
}

# cloud_device_id, beside this script or installed. Beside first, so a copy of
# these scripts staged for a test resolves the helper staged with it; never
# via PATH. Empty when neither exists, and every caller treats empty as "do
# not know" rather than inventing a name.
device_id_tool() {
    local tool
    tool="$(dirname "$(readlink -f "$0")")/cloud_device_id"
    [ -x "${tool}" ] || tool="/usr/bin/cloud_device_id"
    [ -x "${tool}" ] && echo "${tool}"
}

# This device's folder in the cloud. cloud_device_id owns the derivation --
# one implementation, because backup and restore disagreeing here means a
# device cannot find the archive it wrote.
device_folder() {
    local id="" tool
    tool=$(device_id_tool)
    [ -n "${tool}" ] && id=$("${tool}" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')
    [ -z "${id}" ] && id="device-unknown"
    echo "${id}"
}

# What this device's archives are named after. backuptool writes
# <stamp>-<label>-ROCKNIX_SETTINGS.tar.gz with the label cloud_device_id
# derives from the device tree ("Anbernic-RG-SP"), so an archive's name says
# which handheld made it (2026-09-08). Letters, digits, _ and - only, so the
# value is literal inside a regular expression. Empty when the helper is
# missing; the callers then cannot tell this device's archives from another's,
# and say so.
device_label() {
    local tool
    tool=$(device_id_tool)
    [ -n "${tool}" ] && "${tool}" --label 2>/dev/null | tr -cd 'A-Za-z0-9_-'
}

# The OS name the archive's name ends with. backuptool has OS_NAME from
# /etc/profile; this script is started by systemd and by EmulationStation,
# where no profile has run, so it is read from the file the profile reads it
# from. Never empty, so the pattern built on it always names a whole archive.
os_name() {
    local name="${OS_NAME}"
    [ -z "${name}" ] && name=$(sed -n 's/^OS_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release 2>/dev/null | head -1)
    [ -z "${name}" ] && name="ROCKNIX"
    printf '%s\n' "${name}" | tr -cd 'A-Za-z0-9_-'
}

# Enhanced error reporting function
#
# rclone's taxonomy -- "Directory not found or permission denied", "Fatal
# error - rclone giving up" -- went to the screen with the code until
# 2026-09-10. The code and rclone's name go to the log; the screen gets the
# outcome in the player's words and the one `>>> why` line the card and the
# page read (D-UI-028, D-CLOUD-077).
report_rclone_error() {
    local exit_code=$1
    local operation="$2"
    local words

    case $exit_code in
        0) log_message "${operation}: completed." "true"; return ;;
        9) log_message "${operation}: completed, nothing needed moving." "true"; return ;;
    esac
    log_message "${operation}: rclone exit ${exit_code}" "false" "ERROR"
    words=$(why_for "${exit_code}" | tr 'A-Z' 'a-z')
    case $exit_code in
        6) log_message "${operation}: ${words}." "true" "WARN" ;;
        *) log_message "${operation}: ${words}." "true" "ERROR" ;;
    esac
    say_why "$(why_for "${exit_code}")"
}

# What cloud_saves_root printed when it refused: its own `>>> why` line
# becomes the phase's why, and the rest is the reason on the screen.
relay_refusal() {
    local text="$1" why
    why=$(printf '%s\n' "${text}" | sed -n 's/^>>> why //p' | head -1)
    [ -n "${why}" ] && say_why "${why}"
    log_message "$(printf '%s\n' "${text}" | grep -v '^>>> ')" "true" "ERROR"
}

# Enhanced rclone execution function with better error handling
execute_rclone_with_error_handling() {
    local method="$1"
    local source="$2"
    local dest="$3"
    shift 3
    local extra_opts=("$@")
    
    log_message "About to execute: rclone ${method} ${extra_opts[*]} ${source} ${dest}" "false"
    
    # Use a temporary file to capture stderr while allowing stdout (progress) to display
    local stderr_file="/tmp/rclone_stderr_$$"
    
    # Execute rclone with real-time progress display
    # stdout goes to terminal (shows progress), stderr goes to temp file for logging
    rclone "${method}" "${extra_opts[@]}" "${RCLONE_NET_OPTS_ARRAY[@]}" "${source}" "${dest}" 2>"$stderr_file"
    local rclone_exit_code=$?
    # With no --log-file in the options rclone's own lines, the ones that
    # say what moved, are on stderr (claude G-A-01).
    logged_moved "$(stat -c %s "${LOG_FILE}" 2>/dev/null || echo 0)" "$stderr_file" && RCLONE_MOVED=1
    
    # Log any stderr output for debugging
    if [ -s "$stderr_file" ]; then
        while IFS= read -r line; do
            log_message "rclone stderr: $line" "false"
        done < "$stderr_file"
    fi
    
    # Clean up
    rm -f "$stderr_file"
    
    return $rclone_exit_code
}

# One record at rest under the remote --backup-dir root: the folder this run
# wrote. It is named by this run and kept by that name, and every other
# folder goes (D-CLOUD-078 (3)). The root is shared by every device on the
# cloud and the names are stamps from each device's own clock, so name order
# is not age: a folder from a device whose clock runs ahead, or from this
# one before its clock was corrected, sorted after this run's, and "keep the
# newest by name" purged the record this run had just written (audit #307
# PL-021). When this run replaced nothing it wrote no folder, nothing is
# superseded, and the newest by name is kept as before. The root not
# existing, or not listing, removes nothing.
prune_replaced_remote() {
    local root="$1" pinned="$2" names doomed d
    names=$(rclone lsf --dirs-only "${root}/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | tr -d '/' | grep .)
    if [ -n "${pinned}" ] && printf '%s\n' "${names}" | grep -qxF -- "${pinned}"; then
        doomed=$(printf '%s\n' "${names}" | grep -vxF -- "${pinned}")
    else
        doomed=$(printf '%s\n' "${names}" | sort -r | tail -n +2)
    fi
    printf '%s\n' "${doomed}" | while read -r d; do
        [ -n "${d}" ] || continue
        log_message "removing replaced-saves folder ${root}/${d} (superseded)" "false"
        rclone purge "${root}/${d}" "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null \
            || log_message "could not remove ${root}/${d}" "false" "WARN"
    done
}

# PART 1: Game saves backup function
# Backs up game saves to cloud storage
backup_game_saves() {
    WHY_SAID=0
    log_message "====================================" "true"
    log_message "BACKING UP YOUR GAME SAVES" "true"
    echo ">>> unit SAVES||"
    log_message "====================================" "true"
    
    log_message "Starting backup from ${SAVESPATH} to ${REMOTENAME}${SAVES_REMOTE}" "false"
    log_message "Backup started at $(date)" "false"

    # Which card is the saves folder on? A two-card device flips /storage/roms
    # to the internal card when the second one is missing at boot, and a stale
    # tree would then be pushed as this device's newest saves (#83). Refuse
    # until the owner accepts the change.
    local saves_root_tool saves_root_id=""
    # Installed beside this script (/usr/bin on a device; the same
    # directory wherever a copy of these scripts is run from).
    saves_root_tool="$(dirname "$(readlink -f "$0")")/cloud_saves_root"
    [ -x "${saves_root_tool}" ] || saves_root_tool=/usr/bin/cloud_saves_root
    if [ -x "${saves_root_tool}" ]; then
        # At boot the second card is bound over the saves folder a moment
        # after the interface starts, so a mismatch is given 15 seconds to
        # clear before it is a refusal. check prints the identity it
        # confirmed, or the reason it refused.
        if ! saves_root_id=$("${saves_root_tool}" check --wait 15); then
            relay_refusal "${saves_root_id}"
            return 1
        fi
    fi
    
    # Check if local backup path exists and has content
    if [ ! -d "${SAVESPATH}" ]; then
        log_message "the saves folder ${SAVESPATH} is not on this device" "false" "ERROR"
        log_message "Your saves folder isn't on this device." "true" "ERROR"
        say_why "YOUR SAVES FOLDER ISN'T ON THIS DEVICE"
        return 1
    fi
    
    # Check if we have any files to backup (excluding directories we'll skip anyway)
    local files_to_backup=$(find "${SAVESPATH}" -type f ! -path "*/bios/*" ! -path "*/backups/*" ! -name "*.zip" ! -name "*.tar.gz" | head -1)
    if [ -z "$files_to_backup" ]; then
        log_message "no saves to back up in ${SAVESPATH}" "false" "WARN"
        log_message "There are no saves to back up yet." "true" "WARN"
        return 0
    fi
    
    # Test remote connectivity before starting backup
    # One round trip, not two. mkdir is idempotent and fails when the remote
    # is unreachable or the sign-in has lapsed, so it is the reachability
    # test as well; the separate `lsd` that used to run first cost a second
    # on every run and proved nothing mkdir would not. If it fails,
    # check_internet does the slower work of wording the error.
    #
    # Not on a --recent run. Starting rclone costs a second on a handheld
    # and the round trip another, for a directory the copy creates itself
    # when it has something to put there -- and when it has nothing, the
    # remote is never touched at all, which is the point of --recent. If
    # the copy does fail, check_internet words the reason below.
    if [ "${RECENT}" -eq 0 ]; then
        log_message "Ensuring remote sync path exists: ${REMOTENAME}${SAVES_REMOTE}" "false"
        rclone mkdir "${REMOTENAME}${SAVES_REMOTE}" "${RCLONE_PROBE_OPTS[@]}" 2>/dev/null
        local mkdir_rc=$?
        if [ ${mkdir_rc} -ne 0 ]; then
            log_message "remote ${REMOTENAME}${SAVES_REMOTE} not accessible (rclone exit ${mkdir_rc})" "false" "ERROR"
            log_message "Couldn't reach your saves folder in the cloud." "true" "ERROR"
            # Exits 69 or 1 with its own why when the network or the cloud
            # is the cause; returns when the remote answers, so the folder is.
            check_internet
            say_why "$(why_for "${mkdir_rc}")"
            return 1
        fi
    fi
    
    # Pass an explicit --log-level INFO when LOG_LEVEL is INFO
    local rclone_debug=""
    local filtered_opts=("${RCLONE_OPTS_ARRAY[@]}")
    
    # Add debug logging if LOG_LEVEL is INFO
    if [ "${LOG_LEVEL}" == "INFO" ]; then
        rclone_debug="--log-level"
    fi

    # Build the complete options array
    local all_opts=()
    if [ ${#filtered_opts[@]} -gt 0 ]; then
        all_opts+=("${filtered_opts[@]}")
    else
        all_opts+=(
            "--progress"
            "--log-file" "/var/log/cloud_sync.log"
            "--filter-from" "/storage/.config/cloud_sync-rules.txt"
        )
    fi

    # The saves allowlist is not optional. RCLONEOPTS is a user-editable line
    # that invites changes (a --bwlimit, dropping --progress), and until
    # 2026-09-11 the allowlist rode along only inside the shipped default
    # value: an edited RCLONEOPTS that did not happen to keep --filter-from
    # sent the whole ROM library into the saves folder, silently (#71). So
    # whatever the options say, the rules file is applied unless the user
    # named a filter file themselves.
    local has_filter=0 opt
    for opt in "${all_opts[@]}"; do
        case "${opt}" in --filter-from|--filter-from=*|--filters-file|--filters-file=*) has_filter=1 ;; esac
    done
    if [ "${has_filter}" = 0 ]; then
        all_opts+=("--filter-from" "/storage/.config/cloud_sync-rules.txt")
        log_message "RCLONEOPTS carried no --filter-from; the saves allowlist was added (#71)" "false" "WARN"
    fi
    # And the allowlist is whole (audit #307 PL-020): its last rule, the
    # catch-all "- /**", is what keeps everything the rules do not name --
    # the ROMs, the BIOS, the artwork -- out of the saves backup. A file cut
    # before that line admits all of it, so a rules file without the line,
    # whole and alone on it, is refused rather than run with. The helper no
    # longer installs such a file; this is for one it did not write.
    #
    # The device's own allowlist only: a filter file the player named
    # themselves is theirs to write, catch-all or not (#71's contract, the
    # round-trip's "a user's own --filter-from is honoured"). The first cut
    # held every named file to the catch-all and refused the player's.
    local next_is_rules=0 rules_bad="" named
    for opt in "${all_opts[@]}"; do
        named=""
        if [ "${next_is_rules}" = 1 ]; then
            next_is_rules=0
            named="${opt}"
        else
            case "${opt}" in
                --filter-from|--filters-file) next_is_rules=1 ;;
                --filter-from=*|--filters-file=*) named="${opt#*=}" ;;
            esac
        fi
        [ -n "${named}" ] || continue
        if [ "$(readlink -f -- "${named}" 2>/dev/null || printf '%s' "${named}")" = "${MANAGED_RULES}" ]; then
            rules_whole "${named}" || rules_bad="${named}"
        else
            log_message "the saves rules are the player's own file ${named}; used as written" "false"
        fi
    done
    if [ -n "${rules_bad}" ]; then
        log_message "the rules file ${rules_bad} has no catch-all line (- /**); refusing the saves backup" "false" "ERROR"
        log_message "The list of what to sync is damaged, so nothing was sent. Try again." "true" "ERROR"
        say_why "YOUR CLOUD SYNC SETTINGS COULDN'T BE READ"
        return 1
    fi
    # Add debug logging if enabled
    if [ -n "$rclone_debug" ]; then
        all_opts+=("$rclone_debug" "INFO")
    fi

    # Keep the settings-backup archive out of the saves payload -- phase 2 sends it
    # to SETTINGS_REMOTE on its own. rclone matches paths relative to the transfer
    # root, so the two rules that used to sit here never matched anything:
    # "${SETTINGS_BACKUPS}/**" is absolute, and "backups/**" names a directory that
    # does not exist (it is "backup"). Only the blanket "*.zip" was doing the
    # work, and it also overrode any user rule that deliberately included a zip.
    # Derive the pattern from SETTINGS_BACKUPS instead, so it keeps working if the
    # folder is renamed and is simply skipped when it lives outside the payload.
    # --stats-one-line collapses the whole display to a single totals line, so
    # the per-file block goes away -- and the per-file block is the part that
    # says the transfer is alive. A thousand small files spend minutes between
    # percentage changes; the name of the file it is on right now is the only
    # thing that distinguishes working from hung. The status page parses both.
    all_opts+=("--stats" "1s" "--exclude=bios/**")

    # --recent: only what changed since the last backup that worked.
    #
    # The game-exit sync used to compare every save on the device with the
    # cloud. On a handheld that reads as "syncing every game", and it costs
    # a remote listing each time. rclone can restrict a copy to files newer
    # than an age, and skip listing the destination when few files qualify
    # -- so with nothing changed it never touches the remote at all. The age
    # runs from the last successful backup's stamp plus ten minutes, so a
    # save written while that run was still listing stays inside the window.
    #
    # Time, not the game's name. Standalone emulators keep saves under their
    # own layouts -- PPSSPP by game ID, Dreamcast in a shared VMU folder --
    # and a filter on the ROM's name would miss every one of them.
    #
    # Full passes still happen: the boot sync and the menu rows. A file with
    # a wrong mtime -- written before the clock was set, on a device with no
    # RTC -- is caught there. And --recent always copies: a filtered sync
    # would weigh deleting whatever the filter hid.
    if [ "${RECENT}" -eq 1 ]; then
        local stamp_file=/storage/.cache/cloud_sync/last-backup
        local stamp_epoch="" stamp_rc="" now
        now=$(date +%s)
        [ -r "${stamp_file}" ] && read -r stamp_epoch stamp_rc < "${stamp_file}"
        if [ "${stamp_rc}" = "0" ] && [ "${stamp_epoch:-0}" -gt 0 ] 2>/dev/null \
           && [ "${stamp_epoch}" -le "${now}" ]; then
            local age=$(( now - stamp_epoch + 600 ))
            all_opts+=("--max-age" "${age}s" "--no-traverse")
            log_message "recent: only files changed in the last ${age}s, since the last successful backup" "false"
        else
            log_message "recent: no successful backup on record, doing a full pass" "false"
        fi
        if [ "${BACKUPMETHOD}" != "copy" ]; then
            log_message "recent: BACKUPMETHOD=${BACKUPMETHOD} overridden to copy for a filtered run" "false"
            BACKUPMETHOD="copy"
        fi
    fi
    # #315 (D-CLOUD-153, refined by the audit of the fix, D-CLOUD-154): on
    # a remote that compares by size alone, every saves pass runs with
    # --update -- the recent set too. rclone then compares the local mtime
    # with the cloud's upload time (it substitutes a one-second window itself
    # where precision is unsupported; --modify-window changes nothing, and
    # --ignore-times on the recent set would have re-sent the ten-minute
    # slack every exit and replayed an untouched save over another device's
    # newer copy): a save written after its upload is sent, one written
    # before it is skipped. The one case this cannot see is a save written
    # while the device's clock was wrong; the recent window already needs
    # the clock, and #317 (the content-based transport) is its answer. A
    # remote that keeps modtimes or hashes gets nothing here.
    if remote_compares_by_size "${REMOTENAME}"; then
        local has_update=0
        for opt in "${all_opts[@]}"; do [ "${opt}" = "--update" ] && has_update=1; done
        [ "${has_update}" = 1 ] || all_opts+=("--update")
        log_message "the remote compares by size alone (#315): the local mtime is compared with the cloud's upload time (--update)" "false"
    else
        log_message "the remote keeps modtimes or hashes: rclone's own comparison" "false"
    fi
    local backup_rel="${SETTINGS_BACKUPS#${SAVESPATH%/}/}"
    if [ "${backup_rel}" != "${SETTINGS_BACKUPS}" ]; then
        all_opts+=("--exclude=${backup_rel}/**")
    fi

    # A mirror deletes whatever the destination has and this device does not.
    # With one cloud folder shared by several handhelds -- which is the whole
    # point of the folder -- that means the last device to run wipes every
    # other device's saves. It happened: 70 files, another handheld's entire
    # save library, gone in one run of the shipped default.
    #
    # The default is "copy" now, which never deletes. Where somebody has
    # deliberately chosen "sync", the deletions are moved aside instead of
    # destroyed, so a mirror is recoverable rather than final. Dated, because
    # the interesting question afterwards is always "what did the run on
    # Tuesday take away".
    #
    # In copy mode as well, since 2026-09-10. copy never deletes, but it does
    # replace: a cloud save overwritten by this device's copy -- with a wrong
    # clock, an older one -- had no kept version (D-CLOUD-078's named gap,
    # #105). rclone moves each file it would replace into --backup-dir before
    # writing the new one, so the previous cloud copy survives one cycle.
    # A sibling of SAVES_REMOTE, never inside it: rclone refuses a
    # --backup-dir that overlaps the destination, and the same reasoning
    # already applies to SETTINGS_REMOTE. One folder per run; after a full
    # run that completed, every folder but the newest is removed, so there
    # is one record at rest (D-CLOUD-078 (3)). The folder is shared by every
    # device using the saves folder, so "one cycle" is one cycle of whichever
    # device ran last.
    local replaced_root="${SAVES_REMOTE%/}-replaced" replaced_stamp=""
    # A saves folder at the remote's root ("" or "/") has no sibling: the
    # folder above would be "-replaced" under the root, inside the
    # destination, and rclone refuses the run outright ("destination and
    # parameter to --backup-dir mustn't overlap", exit 7) -- every saves
    # backup failed for such a config (#308 claude F-CS-25). The backup goes
    # on without the one-cycle record -- rclone can keep none on that
    # remote -- and the player is told so, on the console and in the run's
    # outcome line (the audit of the fixes, G-A-09: it was said only in the
    # log, which nobody is told the path of).
    case "${SAVES_REMOTE}" in
        ""|"/")
            replaced_root=""
            REPLACED_NOT_KEPT=1
            log_message "the saves folder is the cloud's root: no replaced-saves folder is kept (it would sit inside the saves folder)" "false" "WARN"
            log_message "${REPLACED_NOT_KEPT_LINE}" "true" "WARN"
            ;;
        *)
            replaced_stamp=$(date +%Y_%m_%d-%H%M%S)
            all_opts+=("--backup-dir=${REMOTENAME}${replaced_root}/${replaced_stamp}")
            log_message "anything replaced (or, in sync mode, removed) in the cloud goes to ${replaced_root}" "false"
            ;;
    esac

    # Check if the rclone version supports the terminal width flag

    # Execute rclone with enhanced error handling
    execute_rclone_with_error_handling \
        "${BACKUPMETHOD}" \
        "${SAVESPATH}/" \
        "${REMOTENAME}${SAVES_REMOTE}/" \
        "${all_opts[@]}"

    BACKUP_STATUS=$?
    # A failed transfer says why. The network gone ends the run as 69 here;
    # anything else falls through to report_rclone_error with rclone's code.
    # Every run, not only --recent: the pre-run probe above proves the remote
    # was there when the run started, and #101 is about the link that goes
    # away after that.
    if [ $BACKUP_STATUS -ne 0 ] && [ $BACKUP_STATUS -ne 9 ]; then
        network_lost_during_run "$BACKUP_STATUS" "the saves backup"
    fi

    # The card the saves folder is on must still be the one the transfer
    # started on. A bind that landed mid-run means part of the run went to
    # the other card: a failed run, and not one to record. A good run
    # records the card, so the next transfer has something to compare.
    #
    # Only a transfer that completed is recorded (#308 gpt F-CS-20): a
    # failed first run used to establish the card as if it had synced. A
    # failed one is still compared, so a card that changed under it says so.
    local root_note=""
    if [ -x "${saves_root_tool}" ]; then
        if [ $BACKUP_STATUS -eq 0 ] || [ $BACKUP_STATUS -eq 9 ]; then
            if ! root_note=$("${saves_root_tool}" record "${saves_root_id}"); then
                BACKUP_STATUS=1
            fi
        else
            root_note=$("${saves_root_tool}" record "${saves_root_id}" --no-write) || true
        fi
    fi

    # Report the result with detailed error information
    if [ -n "${root_note}" ]; then
        relay_refusal "${root_note}"
    else
        report_rclone_error $BACKUP_STATUS "Backing up your saves"
    fi

    # The replaced files of the run that just completed are the one record
    # kept; older stamp folders go. Not on a --recent run: a remote round
    # trip the game-exit sync should not pay (the next full pass trims).
    if [ -n "${replaced_root}" ] && [ "${RECENT}" -eq 0 ] && { [ $BACKUP_STATUS -eq 0 ] || [ $BACKUP_STATUS -eq 9 ]; }; then
        prune_replaced_remote "${REMOTENAME}${replaced_root}" "${replaced_stamp}"
    fi

    # RSYNCRMDIR: after a successful backup, remove orphaned empty directories on
    # the remote (--leave-root keeps the sync root itself). Exit code 9 means
    # "success, no files transferred", so tidy on that too.
    # Not on a --recent run: tidying is a full-pass job, and a remote round
    # trip the game-exit sync should not pay.
    if [ "${RSYNCRMDIR}" == "yes" ] && [ "${RECENT}" -eq 0 ] && { [ $BACKUP_STATUS -eq 0 ] || [ $BACKUP_STATUS -eq 9 ]; }; then
        log_message "Removing orphaned empty directories on remote: ${REMOTENAME}${SAVES_REMOTE}" "false"
        rclone rmdirs "${REMOTENAME}${SAVES_REMOTE}" "${RCLONE_NET_OPTS_ARRAY[@]}" --leave-root --log-file /var/log/cloud_sync.log 2>/dev/null \
            || log_message "Tidying empty cloud folders didn't finish; nothing else is affected." "true" "WARN"
    fi

    return $BACKUP_STATUS
}

# PART 2: Settings backup file transfer function
# Transfers existing settings backup files to cloud storage
# Only runs when BACKUPFILE_BACKUP_OPTION is set to "yes"
backup_system_files() {
    WHY_SAID=0
    echo
    log_message "====================================" "true"
    log_message "SENDING YOUR SETTINGS BACKUP" "true"
    # The transfer page's marker for this phase. The label is the item's
    # name on the page (D-UI-022: settings), and EmulationStation announces
    # `>>> unit SETTINGS||` itself before backuptool writes the archive; the
    # page folds a repeated identical label into the same item, so this one
    # must match it byte for byte (#95). It read SETTINGS BACKUP until then.
    echo ">>> unit SETTINGS||"
    log_message "====================================" "true"
    
    if [ "${BACKUPFILE_BACKUP_OPTION}" == "yes" ]; then
        # Check if backup folder exists first
        # Nothing to send is not a failure. These used to return 1, which the
        # summary then printed as "COMPLETED WITH ERRORS" on a device that had
        # simply never made a settings backup. backup_game_saves already returns
        # 0 with a warning in the same situation.
        #
        # Nor is it a completion. The summary said "Settings backup: COMPLETED"
        # under a line saying there was nothing to send (#126); the tier did
        # not run, and the vocabulary's word for that is SKIPPED. The exit
        # stays 0 -- nothing failed -- and the last-run stamp is left alone,
        # as for the other runs that did nothing (D-UI-028: a stamp records a
        # run that happened).
        if [ ! -d "${SETTINGS_BACKUPS}" ] || [ -z "$(ls -A "${SETTINGS_BACKUPS}" 2>/dev/null)" ]; then
            if [ ! -d "${SETTINGS_BACKUPS}" ]; then
                log_message "the settings backups folder ${SETTINGS_BACKUPS} does not exist" "false" "WARN"
            else
                log_message "the settings backups folder ${SETTINGS_BACKUPS} is empty" "false" "WARN"
            fi
            log_message "Skipped settings this time - there's no settings backup on this device to send yet." "true" "WARN"
            SETTINGS_OUTCOME="SKIPPED - NOTHING TO SEND YET"
            SETTINGS_NOTHING_RAN=1
            return 0
        fi
        
        # Each device writes into its own folder. A single shared filename
        # meant the second device to run replaced the first device's archive,
        # with no remote history to recover it from -- the local archive/
        # rotation never leaves the device (fork #49).
        #
        # cloud_device_id heals a stored id whose hash is the shared constant
        # of #86 on this very call, so from this call on device_dest is the
        # new folder. Whether the archive is then sent is decided below, by
        # the upload marker -- which records where the last upload went as
        # well as what it was, so the first backup after healing sends the
        # archive to the new folder even when it has not changed since it
        # went to the old one. The folder it wrote under before is left
        # exactly as it is: cloud_restore reads it (cloud_device_id
        # --previous), and nothing here writes to it or trims it.
        local device_dest="${REMOTENAME}${SETTINGS_REMOTE}/$(device_folder)"

        log_message "Starting transfer of settings backup files from ${SETTINGS_BACKUPS} to ${device_dest}" "false"
        log_message "Sending your settings backup to the cloud..." "true"
        log_message "Settings backup file transfer started at $(date)" "false"
        
        # Test remote backup path connectivity
        log_message "Testing remote backup path connectivity: ${device_dest}" "false"
        rclone mkdir "${device_dest}/" "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null
        local mkdir_status=$?
        if [ $mkdir_status -ne 0 ]; then
            network_lost_during_run "$mkdir_status" "the settings backup"
            log_message "Couldn't reach your settings folder in the cloud." "true" "ERROR"
            report_rclone_error $mkdir_status "Reaching your settings folder"
            return $mkdir_status
        fi
        
        # No --filter-from here on purpose. The saves allowlist is anchored to
        # SAVESPATH, but this transfer's root is SETTINGS_BACKUPS, so its rules
        # describe paths that do not exist in this tree -- and its "- /**/*.zip"
        # matches the archive itself. This phase only ever kept working because
        # rclone applies --include ahead of --filter-from; borrowing the rules
        # bought nothing and left the transfer one precedence change from
        # silently sending nothing.
        #
        # The include is anchored with a leading slash so it matches only the
        # current archive at the root. backuptool rotates older backups into
        # SETTINGS_BACKUPS/archive/, and an unanchored "*.zip" matches at any depth,
        # which would upload every rotated archive on every sync.
        local backup_opts=(
            "--progress"
            "--log-file" "/var/log/cloud_sync.log"
            "--include=/*.{zip,tar.gz}"
            "--stats" "1s"
        )

        # Check if the rclone version supports the terminal width flag
        if rclone help | grep -q progress-terminal-width; then
            backup_opts+=("--progress-terminal-width=80")
        fi
        
        # rclone decides whether to send a file by comparing it with the one
        # already there. Given neither modification times nor hashes it falls
        # back to size alone, and plenty of remotes offer neither -- a WebDAV
        # server commonly reports `Precision` unsupported and `Hashes: []`.
        #
        # The archive is ~17 MB of OS-shipped assets wrapped around a few KB of
        # configuration, so its size barely moves when settings change:
        # "preamp=7" -> "preamp=8" is exactly the same width, as is any value
        # swapped for another of equal length. rclone then judges the local and
        # remote copies identical, skips the transfer, and the run reports
        # success while the cloud copy silently stays stale. Fork issue #53.
        #
        # So decide here, on content, instead of leaving it to metadata the
        # remote may not have. The marker records what this device last
        # actually put in the cloud, and where: "<hash> <destination>". When
        # the archive differs from that, or the destination does, the
        # transfer is forced past rclone's comparison. A game-exit backup runs
        # this on every quit, so uploading 17 MB unconditionally is not an
        # option -- the archive only changes when someone runs `backuptool
        # backup`, and this uploads exactly then.
        #
        # The destination joined the marker on 2026-09-08 (#86): a device
        # whose id was healed writes to a new folder, and a marker that knew
        # only what was sent said "unchanged; nothing to send" on every
        # game-exit backup until the next `backuptool backup`, leaving the
        # new folder empty -- no archive, no device.json. A marker from before
        # holds the bare hash, which never equals the pair, so an upgraded
        # device sends exactly once more and is then in step.
        local state_dir="/storage/.cache/cloud_sync"
        local uploaded_marker="${state_dir}/settings-backup.uploaded"
        mkdir -p "${state_dir}" 2>/dev/null

        # Identify the payload the way the transfer does -- the zip files at
        # the root of SETTINGS_BACKUPS, which is exactly what "--include=/*.{zip,tar.gz}"
        # sends. Deriving a filename instead would mean depending on OS_NAME,
        # which is empty in this script (the banner above prints a blank for
        # the same reason), and on backuptool's naming staying in step.
        local local_sum=""
        local last_sum=""
        local local_bytes=0
        # Collect the archives that exist rather than branching on ls's exit
        # status: busybox ls returns non-zero when ANY argument is unmatched,
        # and after the tar change SETTINGS_BACKUPS normally holds exactly one
        # format -- the previous one having been rotated into archive/. The
        # gate therefore failed on every device that had taken one backup,
        # leaving local_sum empty, which silently switched off the post-upload
        # size verification below. That check is the #53 guard: a backup that
        # reported success while sending nothing.
        local archives=()
        local a
        for a in "${SETTINGS_BACKUPS}"/*.zip "${SETTINGS_BACKUPS}"/*.tar.gz; do
            [ -f "${a}" ] && archives+=("${a}")
        done
        if [ ${#archives[@]} -gt 0 ]; then
            # Hash of the members' hashes, so more than one archive at the
            # root is still covered by a single comparison.
            local_sum=$(md5sum "${archives[@]}" 2>/dev/null | md5sum | cut -d' ' -f1)
            local_bytes=$(cat "${archives[@]}" 2>/dev/null | wc -c)
        fi
        if [ -f "${uploaded_marker}" ]; then
            last_sum=$(cat "${uploaded_marker}" 2>/dev/null)
        fi

        if [ -n "${local_sum}" ] && [ "${local_sum} ${device_dest}" = "${last_sum}" ]; then
            # Say what is true. Reporting a transfer that did not happen is
            # how the stale-copy bug stayed invisible.
            log_message "Settings backup is unchanged since the last upload to ${device_dest}; nothing to send" "false"
            log_message "Your settings backup hasn't changed since the last one, so there's nothing to send." "true"
            BACKUP_SYSTEM_STATUS=0
            return 0
        fi

        # Force it past the size comparison. We have already established the
        # content differs, so rclone's own check can only be wrong here.
        backup_opts+=("--ignore-times")

        # Uploaded under a dated name, one file at a time, rather than by
        # mirroring the folder.
        #
        # The cloud used to hold exactly one archive per device, overwritten on
        # every run: nothing to tell you when it was taken, and no way back to
        # the state before whatever you are trying to undo. Dates lead the name
        # so a listing sorts chronologically by itself --
        # 2026_09_02-143000-ROCKNIX_BACKUP.zip.
        #
        # copyto rather than the configured method, always. A mirror would look
        # at a folder holding one local archive and delete every dated one in
        # the cloud, which is the opposite of keeping history.
        # The folder options minus anything that selects files: copyto is
        # given one path and rejects filters.
        local copy_opts=()
        local opt
        local skip_next=0
        for opt in "${backup_opts[@]}"; do
            # A flag and its value may be one element ("--include=/*.{zip,tar.gz}") or
            # two ("--include" "/*.zip"). Dropping only the flag in the second
            # form leaves the bare pattern behind, and rclone reads it as
            # another path -- copyto then has three and fails with an
            # uncategorised error, having transferred nothing.
            if [ ${skip_next} -eq 1 ]; then
                skip_next=0
                continue
            fi
            case "${opt}" in
                --include|--exclude|--filter|--filter-from)
                    skip_next=1; continue ;;
                --include=*|--exclude=*|--filter*) continue ;;
                # The guard that adds this greps `rclone help`, which mentions
                # the flag on builds that do not accept it -- so it reaches the
                # command line and rclone exits with "unknown flag", having
                # transferred nothing while the run still reported success. It
                # only shapes the progress display, so nothing is lost here.
                --progress-terminal-width*) continue ;;
            esac
            copy_opts+=("${opt}")
        done

        local stamp
        stamp=$(date +%Y_%m_%d-%H%M%S)
        BACKUP_SYSTEM_STATUS=0
        local sent_any=0
        # What this run actually put there, so the check afterwards measures
        # those and not the whole history beside them.
        local uploaded_names=()
        local archive
        for archive in "${SETTINGS_BACKUPS}"/*.zip "${SETTINGS_BACKUPS}"/*.tar.gz; do
            [ -f "${archive}" ] || continue
            local base target
            base=$(basename "${archive}")
            # Whole before it is sent. A truncated archive under the newest
            # name -- what a backup killed mid-write used to leave -- was
            # uploaded as this device's newest and counted toward the kept
            # history, and the restore side then refused it with nothing to
            # fall back to (D-CLOUD-078, #105). tar lists every member or
            # fails; a zip is tested member by member (archive_whole).
            if ! archive_whole "${archive}"; then
                log_message "The settings archive ${base} does not list; not sending it" "false" "ERROR"
                log_message "This device's settings backup is damaged, so it wasn't sent. Back up settings again." "true" "ERROR"
                say_why "THIS DEVICE'S SETTINGS BACKUP IS DAMAGED"
                BACKUP_SYSTEM_STATUS=1
                continue
            fi
            # backuptool names archives with the date now, so the local name is
            # already the one the cloud should carry -- stamping it again gave
            # "2026_09_02-...-2026_09_01-...-ROCKNIX_BACKUP.zip". Only an
            # archive made before that carries no date, and gets one here so
            # the folder still sorts.
            case "${base}" in
                [0-9][0-9][0-9][0-9]_*) target="${base}" ;;
                *) target="${stamp}-${base}" ;;
            esac
            log_message "Uploading ${base} as ${target}" "false"
            # Without the filter flags. copyto names one file explicitly, and
            # rclone refuses filters on a single-file copy -- "--include=/*.{zip,tar.gz}"
            # came from the folder transfer this replaced and made every upload
            # exit with a usage error.
            rclone copyto "${archive}" "${device_dest}/${target}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
                "${copy_opts[@]}"
            local rc=$?
            if [ ${rc} -ne 0 ]; then
                # The marker below is not written on this path: the upload
                # did not finish, so the next run sends the archive again.
                network_lost_during_run "${rc}" "the settings backup"
                BACKUP_SYSTEM_STATUS=${rc}
                report_rclone_error ${rc} "Sending your settings backup"
                break
            fi
            uploaded_names+=("${target}")
            sent_any=1
        done

        # Say what this folder is. "ROCKNIX-ee5013fc56" told its owner
        # nothing -- not which handheld it came from, nor what the hex means.
        # (That hex was not even the device's: it is md5 of the literal
        # "notset" that every sit-tunnel kernel fed the hash, #86, which
        # cloud_device_id now heals. The folder name is still the identifier;
        # it is just a real one now.)
        # The folder name has to stay the stable identifier, because it is what
        # a device finds its own backups by, so the explanation goes inside it.
        if [ ${BACKUP_SYSTEM_STATUS} -eq 0 ] && [ ${sent_any} -eq 1 ]; then
            local model="unknown"
            if [ -r /sys/firmware/devicetree/base/model ]; then
                model=$(tr -d '\0' < /sys/firmware/devicetree/base/model)
            fi
            local manifest="${state_dir}/device.json"
            # Written whole or not at all (temp beside it, then renamed), and
            # the upload's result read rather than discarded: the folder's
            # description is not the backup, so a failure here does not fail
            # the run, but it is said and logged instead of vanishing.
            cat > "${manifest}.tmp.$$" <<MANIFEST
{
  "id": "$(basename "${device_dest}")",
  "model": "${model}",
  "family": "${HW_DEVICE:-unknown}",
  "hostname": "$(hostname 2>/dev/null)",
  "os_version": "$(grep -m1 '^OS_VERSION=' /etc/os-release 2>/dev/null | cut -d'"' -f2)",
  "last_backup": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "keep": "${CLOUD_BACKUP_KEEP:-3}"
}
MANIFEST
            if mv -f "${manifest}.tmp.$$" "${manifest}" 2>/dev/null; then
                rclone copyto "${manifest}" "${device_dest}/device.json" "${RCLONE_NET_OPTS_ARRAY[@]}" \
                    --log-file /var/log/cloud_sync.log 2>/dev/null
                local manifest_rc=$?
                if [ ${manifest_rc} -ne 0 ]; then
                    log_message "device.json could not be sent to ${device_dest} (rclone exit ${manifest_rc}); the archive arrived, the folder's description did not" "false" "WARN"
                    log_message "Your settings backup arrived. A small note describing it didn't, which is harmless." "true" "WARN"
                fi
            else
                rm -f "${manifest}.tmp.$$" 2>/dev/null
                log_message "could not write ${manifest}; the folder's description was not sent" "false" "WARN"
            fi
        fi

        # Only record the upload once the remote actually holds a file of the
        # right size. An exit code says the command ended, not that the bytes
        # arrived, and a marker written on a failed transfer would suppress
        # every retry afterwards.
        if [ ${BACKUP_SYSTEM_STATUS} -eq 0 ] && [ -n "${local_sum}" ]; then
            # The archives we just wrote, not everything in the folder. The
            # cloud keeps a dated history now, so sizing the whole folder adds
            # up every archive it holds and compares three of them against the
            # one local file -- "51486484 vs 17162184", a mismatch reported as
            # a failed upload on a transfer that worked perfectly. The check is
            # right; what it was measuring stopped being true when retention
            # arrived.
            local remote_bytes=0
            local checked=0
            local uploaded
            for uploaded in "${uploaded_names[@]}"; do
                local one
                # A listing's bound, not a transfer's (#308 claude F-CS-21).
                one=$(rclone size "${device_dest}/${uploaded}" --json "${RCLONE_LIST_OPTS[@]}" 2>/dev/null \
                    | sed -n 's/.*"bytes":[[:space:]]*\([0-9]*\).*/\1/p')
                [ -n "${one}" ] || continue
                remote_bytes=$((remote_bytes + one))
                checked=1
            done
            [ ${checked} -eq 1 ] || remote_bytes=""
            # Nothing came back at all: the check itself could not reach the
            # cloud, which after a finished upload most likely means the link
            # went in between. The marker stays unwritten either way -- the
            # upload is unconfirmed -- and the run says why it ended.
            [ -n "${remote_bytes}" ] || network_lost_during_run 1 "the settings backup's size check"
            if [ -n "${remote_bytes}" ] && [ "${remote_bytes}" = "${local_bytes}" ]; then
                write_stamp "${uploaded_marker}" "${local_sum} ${device_dest}"
            else
                log_message "the cloud copy is ${remote_bytes:-none} bytes against the ${local_bytes} sent; it will be sent again next time" "false" "WARN"
                log_message "The copy in your cloud isn't complete. Nothing was lost - it'll be sent again next time." "true" "WARN"
                say_why "THE COPY IN YOUR CLOUD ISN'T COMPLETE"
                BACKUP_SYSTEM_STATUS=1
            fi
        fi

        # Keep a bounded history of THIS device's archives. Names lead with
        # the date, so sorting them is ordering them by age and no metadata
        # call is needed.
        #
        # After the size check, not before it. Until 2026-09-10 this ran on
        # the strength of an upload not yet proven whole, so the previous
        # records went while the new one might be short -- obligation (3)
        # before obligation (1) (D-CLOUD-078, #105). The check above sets
        # BACKUP_SYSTEM_STATUS to 1 when the bytes do not match, and this
        # then does nothing.
        #
        # Where this runs: device_dest is SETTINGS_REMOTE/<device id>/, the
        # folder cloud_device_id names this device (Anbernic-RG-SP-f058e3e9e8).
        # A folder this device wrote under a healed-away id (#86) is not
        # device_dest and nothing here reaches it either.
        # A different device's own archives are in a different folder, and
        # nothing here reaches them. Within this folder, the newest
        # CLOUD_BACKUP_KEEP archives carrying this device's label
        # (<stamp>-<label>-ROCKNIX_SETTINGS.tar.gz) are kept and the rest of
        # those removed. An archive carrying no label -- every one from before
        # names carried a device: ROCKNIX_SETTINGS, ROCKNIX_BACKUP, the
        # undated zip -- or another device's label is left alone. Until
        # 2026-09-08 the newest CLOUD_BACKUP_KEEP of everything here survived
        # and the rest went, so one device's backup could evict another's.
        #
        # An archive carrying this device's label but made by another device
        # can be in this folder in exactly two ways, and is counted with this
        # device's own in both, because the label cannot tell them apart: it
        # was restored here from that device's folder and sent up again by the
        # loop above (the fresh-device journey, #26); or the two devices share
        # an id and so share this folder (a cloned id, fork #86 -- the RG SP
        # and the RG35XX SP shared the hash ee5013fc56, the constant a
        # sit-tunnel kernel produced, until cloud_device_id healed it on
        # 2026-09-08; two devices of one model on a build from before that
        # still do). The id is deliberately not in the archive name.
        #
        # The unlabelled ones are bounded: the older rule had already trimmed
        # them to CLOUD_BACKUP_KEEP, and no new ones are written, so they cost
        # at most that many archives per folder until the owner removes them.
        # Deleting what cannot be attributed is the failure this exists to
        # stop, so the guard fails closed: no label, no deletion.
        if [ ${BACKUP_SYSTEM_STATUS} -eq 0 ] && [ ${sent_any} -eq 1 ]; then
            local keep="${CLOUD_BACKUP_KEEP:-3}"
            case "${keep}" in
                ''|*[!0-9]*) keep=3 ;;
            esac
            local label
            label=$(device_label)
            if [ -z "${label}" ]; then
                log_message "Cannot tell this device's archives from another device's (cloud_device_id gave no name); nothing removed from ${device_dest}" "false" "WARN"
            else
                local osn listing mine total_n mine_n old_archive
                osn=$(os_name)
                listing=$(rclone lsf --files-only --include "*.{zip,tar.gz}" "${device_dest}/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null)
                mine=$(printf '%s\n' "${listing}" \
                       | grep -E "^[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{6}-${label}-${osn}_SETTINGS\.tar\.gz$" | sort -r)
                total_n=$(printf '%s\n' "${listing}" | grep -c .)
                mine_n=$(printf '%s\n' "${mine}" | grep -c .)
                if [ "${total_n}" -gt "${mine_n}" ]; then
                    log_message "Leaving $((total_n - mine_n)) archive(s) not named for this device (${label}) alone in ${device_dest}" "false"
                fi
                # The archives this run uploaded are kept by name, whatever
                # the others' names say: a date is the clock of the device
                # that wrote it, and three archives stamped by a clock that
                # ran ahead used to leave this run's upload as the one past
                # the count (audit #307 PL-021). The rest are kept by count,
                # newest name first, to CLOUD_BACKUP_KEEP in all.
                local others left
                others=$(printf '%s\n' "${mine}" | grep -v '^$' | grep -vxF -f <(printf '%s\n' "${uploaded_names[@]}"))
                left=$(( keep - ${#uploaded_names[@]} )); [ "${left}" -ge 0 ] || left=0
                printf '%s\n' "${others}" | grep -v '^$' | tail -n +$((left + 1)) | while read -r old_archive
                do
                    [ -n "${old_archive}" ] || continue
                    log_message "Removing old cloud backup ${old_archive}" "false"
                    rclone deletefile "${device_dest}/${old_archive}" "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null
                done
            fi
        fi

        return $BACKUP_SYSTEM_STATUS
    else
        log_message "Backing up settings to the cloud is turned off, so it was skipped." "true"
        BACKUP_SYSTEM_STATUS=0
    fi
    
    return $BACKUP_SYSTEM_STATUS
}

# Main script execution
main() {
    check_network_link
    check_rclone_config
    load_config
    # backup_game_saves proves the remote reachable with the mkdir it needs
    # anyway; only the system-only path has no such step of its own. After
    # load_config, which sets an automatic run's deadline: the probe ran
    # before it, outside the ceiling (#308 gpt F-CS-34).
    [ "${SYSTEM_ONLY}" -eq 1 ] && check_internet
    
    # Use the first configured remote in rclone
    # Note: This assumes at least one remote is configured and the first one should be used
    REMOTENAME=$(first_remote)
    
    # Begin main script operations with user-friendly header
    log_message "=> ${OS_NAME} CLOUD BACKUP\n"
    
    # Execute Part 1: Game saves backup
    # This performs the primary save file backup operation using the configured method
    if [ "${SYSTEM_ONLY}" -eq 1 ]; then
        log_message "Skipped game saves this time - settings only." "true"
        SAVES_OUTCOME="SKIPPED - SETTINGS ONLY"
        BACKUP_STATUS=0
    else
        backup_game_saves
        BACKUP_STATUS=$?
    fi
    
    # Add a pause for better visual separation between operations
    pause 2
    
    # Execute Part 2: Settings backup file transfer
    # This backs up settings backup files (zip files) if enabled in configuration
    if [ "${SAVES_ONLY}" -eq 1 ]; then
        log_message "Skipped settings this time - saves only." "true"
        SETTINGS_OUTCOME="SKIPPED - SAVES ONLY"
        BACKUP_SYSTEM_STATUS=0
    else
        backup_system_files
        BACKUP_SYSTEM_STATUS=$?
    fi
    
    # Add a pause before summary
    pause 2
    
    # Add a line break for better visual separation
    echo
    
    # The run's exit, decided by both phases (the note below the summary
    # says why); computed here because the outcome line reads it.
    # rclone's 9 -- nothing needed moving -- is a completion wherever a
    # phase is judged (outcome_word, run_outcome_line), so it is here too: a
    # saves phase that returned 9 used to keep a settings phase's failure
    # out of the exit and the stamp, and the run said Completed. over an
    # archive that never moved (audit #307 PL-028).
    local overall=${BACKUP_STATUS}
    case "${overall}" in
        0|9) overall=${BACKUP_SYSTEM_STATUS} ;;
    esac

    # Provide final summary of all operations
    log_message "====================================" "true"
    log_message "BACKUP SUMMARY:" "true"
    log_message "Game saves: ${SAVES_OUTCOME:-$(outcome_word $BACKUP_STATUS)}" "true"
    [ "${BACKUPFILE_BACKUP_OPTION}" == "yes" ] && log_message "Settings backup: ${SETTINGS_OUTCOME:-$(outcome_word $BACKUP_SYSTEM_STATUS)}" "true"
    case "${overall}" in
        0|9) log_message "$(run_outcome_line "${overall}")" "true" ;;
        *)   log_message "$(run_outcome_line "${overall}")" "true" "ERROR" ;;
    esac
    log_message "Log file: ${LOG_FILE}" "false"
    log_message "====================================" "true"
    
    # Add a final pause before exiting
    pause 3
    
    # Both phases decide the exit. It was the saves phase's alone -- "use the
    # game saves backup status as the overall exit code", from when this was
    # a console tool with one phase that mattered -- so a settings upload
    # that failed exited 0, and under --system-only, where the saves phase
    # is skipped and reports 0, every failure did: the card said COMPLETED
    # SUCCESSFULLY and last-settings-backup recorded 0 for an archive that
    # never arrived (found while bounding the runs, #103). A run is good when
    # every phase it ran is; otherwise it carries the first failing phase's
    # code, the saves phase's when both failed.
    clean_exit ${overall}
}

# Set up signal trap to handle user interruption gracefully
trap 'log_message "Script interrupted by user" "false" "WARN"; clean_exit 130' INT TERM

# Start script execution. The body runs with the lock descriptor closed,
# so nothing it starts can hold the lock after this shell is gone -- see
# take_cloud_lock.
take_cloud_lock
main 9>&-
