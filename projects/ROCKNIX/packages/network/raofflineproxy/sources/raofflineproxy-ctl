def read_cursor():
    try:
        return cursor_file.read_text(encoding="utf-8", errors="surrogateescape").rstrip("\n") if cursor_file else ""
    except OSError:
        return ""


def propose_cursor(value):
    """The cursor this walk proposes -- the path of the last file it took,
    or nothing when the walk came round -- written whole to
    scan-cursor.next for the ctl to keep once the run has worked through its
    jobs (commit_cursor): a run cancelled or stopped after its listing
    leaves the cursor where it was, so the next scan takes the same slice
    (audit of the fixes, claude G-D-06). False when it could not be written
    -- and the ctl says so rather than promising a continuation it cannot
    keep (gpt G-D-06)."""
    if cursor_file is None:
        return True
    proposal = cursor_file.with_name(cursor_file.name + ".next")
    tmp = proposal.with_name(proposal.name + ".tmp")
    try:
        tmp.write_text(value + "\n" if value else "", encoding="utf-8", errors="surrogateescape")
        os.replace(tmp, proposal)
        return True
    except OSError:
        try:
            tmp.unlink()
        except OSError:
            pass
        return False


# The walk is a circle from a cursor (#307 PL-059). Cached files are passed
# over before the cap counts (#186 PL-17), but a file that never caches -- a
# ROM RetroAchievements does not know is skipped, and stays uncached --
# counted every run, so the first MAX_SCAN_ENTRIES such files held the front
# of the walk for ever and the files past them were never reached. So a walk
# the cap cuts proposes the path of the last file it took (scan-cursor.next),
# the ctl keeps it as scan-cursor once the run has worked through its jobs,
# and the next walk takes the files after it first, then comes round to the
# start. A walk that fits under the cap removes the cursor; a cursor that
# names a file the walk no longer meets (deleted, or its folder now indexed)
# starts the circle from the top.
walked = []
walked_cached = 0
truncated = 0
cursor_saved = 1
if mode == "all":
    cursor = read_cursor()
    passed = not cursor
    before, after = [], []   # the candidates up to the cursor, and past it
    full = False
    for name in walk_systems:
        root = roms_root / name
        if not root.is_dir():
            continue
        try:
            if root.resolve() in indexed_dirs:
                continue
        except OSError:
            pass
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = sorted(d for d in dirnames if not d.startswith(".") and d.lower() not in SKIP_DIRS)
            has_sheet = any(f.lower().endswith(DISC_SHEETS) for f in filenames)
            for fn in sorted(filenames):
                if fn.startswith("."):
                    continue
                path = Path(dirpath) / fn
                at_cursor = not passed and str(path) == cursor
                # Before the cursor only the first cap's worth is ever
                # taken (the circle's tail), so past that the walk only
                # looks for the cursor.
                if not passed and len(before) > MAX_SCAN_ENTRIES:
                    passed = passed or at_cursor
                    continue
                take = False
                if is_supported_browser_file(path) and not (has_sheet and fn.lower().endswith(".bin")):
                    try:
                        take = path.is_file() and path.stat().st_size > 0
                    except OSError:
                        take = False
                if take and normalize_cached_rom_path(path) in cached_paths:
                    walked_cached += 1
                    take = False
                if take:
                    (after if passed else before).append(path)
                passed = passed or at_cursor
                if len(after) > MAX_SCAN_ENTRIES:
                    full = True
                    break
            if full:
                break
        if full:
            break
    candidates = after + before
    walked = candidates[:MAX_SCAN_ENTRIES]
    truncated = 1 if len(candidates) > MAX_SCAN_ENTRIES else 0
    cursor_saved = 1 if propose_cursor(str(walked[-1]) if truncated and walked else "") else 0

hash_jobs = walked

lines = [f"I\t{indexed_jobs[p][0]}\t{indexed_jobs[p][1]}\t{p}\n" for p in by_history(list(indexed_jobs))]
lines += [f"H\t\t\t{p}\n" for p in by_history(hash_jobs)]
out.write_text("".join(lines), encoding="utf-8")
found = indexed_seen + len(walked) + walked_cached
new = len(lines)
print(f"found={found} new={new} cached={found - new} indexed={len(indexed_jobs)} hashing={len(hash_jobs)} truncated={truncated} cursor_saved={cursor_saved}")
PY
}

# One field of list_jobs' summary line, or 0.
count_of() {
    local V="${1#*${2}=}"
    V="${V%% *}"
    case "${V}" in ''|*[!0-9]*) echo 0 ;; *) echo "${V}" ;; esac
}

# The helper that works the job list: beside this script, so a copy of the
# two files runs from anywhere they are put together.
case "$0" in
    */*) HELPER="${0%/*}/raofflineproxy-cache-indexed"; IMAGE_HELPER="${0%/*}/raofflineproxy-cache-images"; REFRESH_HELPER="${0%/*}/raofflineproxy-refresh" ;;
    *)   HELPER="/usr/bin/raofflineproxy-cache-indexed"; IMAGE_HELPER="/usr/bin/raofflineproxy-cache-images"; REFRESH_HELPER="/usr/bin/raofflineproxy-refresh" ;;
esac

# Run the job list $2 of $3 games through the helper and read its lines as
# they come -- "OK i/n <file>", "FAIL i/n <file>: <reason>", "DONE cached=
# failed= indexed=" -- stopping it after three lookups in a row that
# RetroAchievements did not answer, or on a refused sign-in, or when the
# client reports its cap. $1 is page (the >>> lines for GuiOfflineScan) or
# quiet (nothing on stdout, for the top-up); $4 a bound in seconds, 0 for
# none. Leaves R_CACHED R_SKIPPED R_ERRORS R_LIMIT R_WHY R_STOPPED R_INDEXED
# R_CLIENT_RC for the caller, and the helper's stderr in the scan log. The
# helper's stdout goes through a fifo so it can be stopped between two lines.
run_jobs() {
    local MODE="$1" LIST="$2" TOTAL="$3" BUDGET="${4:-0}"
    local -a PATHS
    mapfile -t PATHS < "${LIST}"
    JOBS_FIFO="$(mktemp -u /tmp/raofflineproxy-scan-out.XXXXXX)"
    mkfifo "${JOBS_FIFO}" || fail "cannot create ${JOBS_FIFO}"
    if [ "${BUDGET}" -gt 0 ]; then
        timeout "${BUDGET}" python3 "${HELPER}" "${LIST}" > "${JOBS_FIFO}" 2>>"${SCAN_LOG}" &
    else
        python3 "${HELPER}" "${LIST}" > "${JOBS_FIFO}" 2>>"${SCAN_LOG}" &
    fi
    CLIENT=$!
    exec 8< "${JOBS_FIFO}"

    R_CACHED=0; R_SKIPPED=0; R_ERRORS=0; R_LIMIT=0; R_WHY=""; R_STOPPED=0; R_INDEXED=0; R_DONE=0
    local IN_A_ROW=0 line index name
    if [ "${TOTAL}" -gt 0 ]; then
        name="${PATHS[0]##*/}"
        mark_running " index=1 total=${TOTAL} name=${name//[[:space:]]/_}"
        [ "${MODE}" = page ] && tell "game 1|${TOTAL}|${name%.*}"
    fi
    while IFS= read -r line <&8; do
        slog "client: ${line}"
        case "${line}" in
            OK\ *)
                R_CACHED=$((R_CACHED + 1)); IN_A_ROW=0 ;;
            DONE\ *)
                # The helper's verdict on the games: whatever the process does
                # afterwards (badge downloads outliving the bound, fork #188) is
                # not the run's outcome.
                R_INDEXED="$(count_of "${line}" indexed)"; R_DONE=1
                continue ;;
            *"Cache limit reached"*)
                # The client says it will cache no more (no ROCKNIX client
                # does since patch 004; kept for one that says so): every
                # further ROM would be hashed and looked up only to be
                # refused.
                R_LIMIT=1; R_STOPPED=1
                slog "run: the client reports its cache limit; stopping"
                kill "${CLIENT}" 2>/dev/null
                break ;;
            *"No RetroAchievements match"*|*"Hash failed"*|*": not found")
                # Not a game RetroAchievements knows, or not a file it can
                # read: the proxy's docs skip these silently, and so does
                # the page -- counted here for the log and the stamp.
                R_SKIPPED=$((R_SKIPPED + 1)); IN_A_ROW=0 ;;
            *"login required"*|*"HTTP Error 401"*|*"HTTP Error 403"*)
                # The account, not the link: no retry changes it.
                R_WHY=SIGN_IN_REFUSED; R_STOPPED=1
                kill "${CLIENT}" 2>/dev/null
                break ;;
            FAIL\ *)
                # A lookup or a fetch that did not come back: the link, the
                # server, a 429. A run of them is the scan asking a question
                # nobody is answering.
                R_ERRORS=$((R_ERRORS + 1)); IN_A_ROW=$((IN_A_ROW + 1))
                if [ "${IN_A_ROW}" -ge "${ERRORS_IN_A_ROW}" ]; then
                    R_WHY=RETROACHIEVEMENTS_STOPPED_ANSWERING; R_STOPPED=1
                    kill "${CLIENT}" 2>/dev/null
                    break
                fi ;;
            *)
                continue ;;
        esac
        # The helper finished game i (1-based); what it is on now is i+1.
        index="${line#* }"; index="${index%%/*}"
        case "${index}" in ''|*[!0-9]*) index=0 ;; esac
        if [ "${index}" -gt 0 ] && [ "${index}" -lt "${TOTAL}" ]; then
            name="${PATHS[${index}]##*/}"
            mark_running " index=$((index + 1)) total=${TOTAL} name=${name//[[:space:]]/_}"
        fi
        [ "${MODE}" = page ] || continue
        tell "cached ${R_CACHED}|${R_SKIPPED}"
        if [ "${index}" -gt 0 ] && [ "${index}" -lt "${TOTAL}" ]; then
            tell "game $((index + 1))|${TOTAL}|${name%.*}"
        fi
    done
    exec 8<&-
    wait "${CLIENT}" 2>/dev/null
    R_CLIENT_RC=$?
    unset CLIENT
    rm -f "${JOBS_FIFO}"; JOBS_FIFO=""
    unmark_running
    if [ "${R_DONE}" -eq 1 ] && [ "${R_CLIENT_RC}" -ne 0 ]; then
        slog "run: the helper had reported DONE and ended with rc ${R_CLIENT_RC} afterwards (badge downloads cut short) -- not the run's verdict (#188)"
    fi
}

# A run asked to stop (disable's SIGTERM, #186 PL-30) exits through its
# EXIT trap: the helper is ended, the run's files go, no stamp is written --
# the line under the row keeps the last run that finished.
stopped() {
    say "${1}: stopped; offline RetroAchievements was turned off"
    exit 143
}

# A scan the player cancelled from its page (SIGINT from the interface,
# fork #241, D-UI-078). Not a failure: what the run saved stays saved, and
# the next scan passes over those games. So the stamp is written with the
# counts the run had reached -- the line under the row says SKIPPED and the
# ready count is right -- the page is told why, and the run exits 130
# through its EXIT trap (the helper ended, the run's files gone). R_CACHED
# and the rest are the run's so far; before run_jobs they are unset, and
# read as 0. added= is measured as the run's own end measures it -- the
# ready set the run took before its jobs against the store now -- and is
# unknown when either cannot be read, never the games cached so far
# (PL-031).
cancelled() {
    local READY MADE=""
    READY="$(count_ready)"
    if [ -n "${READY_BEFORE:-}" ] && READY_AFTER="$(mktemp /tmp/raofflineproxy-ready.XXXXXX 2>/dev/null)" && ready_games_into "${READY_AFTER}"; then
        MADE="$(games_made_ready "${READY_BEFORE}" "${READY_AFTER}")"
    fi
    tell "why CANCELLED"
    write_stamp 130 "${1}" "${R_CACHED:-0}" "${R_SKIPPED:-0}" "${READY}" 0 "${R_INDEXED:-0}" "${R_ERRORS:-0}" CANCELLED "${MADE}"
    slog "${1} cancelled by the player: cached=${R_CACHED:-0} skipped=${R_SKIPPED:-0} errors=${R_ERRORS:-0} ready=${READY}"
    say "${1}: cancelled"
    exit 130
}

# The images of what is cached, fetched until none is missing (#212). A
# game's achievements and its images are one action to a player -- the
# maintainer, 2026-09-18: "whenever we cache the achievements, we cache the
# images for the achievements" -- so this runs at the end of a scan and of a
# top-up that cached anything, and on its own as the `images` verb.
#
# The helper walks the store, not the library: every cached set row, every
# image path in it, and the ones with no file get fetched. Idempotent (the
# check is the file's existence and the client's own download no-ops on one)
# and resumable (nothing marks a game done but its files), so a run that
# stops at its ceiling costs the next one nothing. Bounded by what is left of
# the caller's deadline, or IMAGE_PASS_SECONDS on its own.
#
# Its verdict is part of the run's (#307 PL-060). A game whose badges are
# missing offline reads as half working (D-RA-027), and a run whose parts
# disagree is COULDN'T FINISH (D-UI-030), so a pass that left images behind
# -- the helper's `why` line, or an exit it gives no reason for -- leaves
# R_IMAGES_WHY=SOME_IMAGES_NOT_SAVED for the caller to stamp, the games
# still counted as cached. A verify slice that did not come round the store
# (the helper's exit 3) is the sweep doing its work a slice a run, by design
# (D-RA-024), and is no failure; every other exit is, a crash included. An
# image the image server does not have (404, 410) is recorded absent by the
# helper and is no failure either: SOME_IMAGES_NOT_SAVED means images that
# did not come this time -- a timeout, a 5xx, a short read -- and are asked
# for again (PL-060's follow-up).
IMAGE_PASS_SECONDS="${RAOFFLINEPROXY_IMAGE_PASS_SECONDS:-300}"

run_image_pass() {
    local VERB="$1" SECONDS_LEFT="${2:-${IMAGE_PASS_SECONDS}}" MODE="${3:-}" RC=0
    R_IMAGES_WHY=""
    [ -x "${IMAGE_HELPER}" ] || { slog "${VERB}: no image helper at ${IMAGE_HELPER}"; return 0; }
    # No time left is no pass: the images were not looked at, and the run
    # does not say it finished (audit of the fixes, gpt G-D-01).
    [ "${SECONDS_LEFT}" -gt 10 ] 2>/dev/null || { slog "${VERB}: no time left for the image pass (${SECONDS_LEFT}s); not run"; R_IMAGES_WHY=TOOK_TOO_LONG; return 0; }
    slog "${VERB}: image pass, up to ${SECONDS_LEFT}s${MODE:+ (${MODE})}"
    # In the background and waited for, as the jobs and the recently played
    # pass are: bash runs a trap only once the foreground command has
    # returned, so with the helper in the foreground the page's CANCEL (INT)
    # and a stop from disable or STOP IT AND PLAY (TERM) waited for the whole
    # pass before the run could answer either (#307 PL-013, #308 F-RA-11).
    # wait returns the moment a trapped signal arrives, and CLIENT is what
    # the EXIT trap ends. CLIENT is timeout, which puts itself and the
    # helper in a process group of their own: the interface's SIGINT to the
    # run's group reaches this script, not the helper, and the EXIT trap's
    # kill of timeout is forwarded to the helper as SIGTERM -- the path the
    # harness's D23 runs under GNU timeout (audit of the fixes, claude
    # G-D-03).
    # Bounded at the process as well (#308 F-RA-10): the helper checks its
    # --seconds between one blocking call and the next, so it is given ten
    # seconds less than the pass has and timeout ends it at the pass's
    # bound whatever it is blocked on (a timeout is images not saved).
    # shellcheck disable=SC2086 -- MODE is one flag or empty, on purpose
    timeout "${SECONDS_LEFT}" "${IMAGE_HELPER}" --seconds "$(( SECONDS_LEFT - 10 ))" ${MODE} >>"${SCAN_LOG}" 2>&1 &
    CLIENT=$!
    wait "${CLIENT}" || RC=$?
    unset CLIENT
    # 0: every image there. 3: every image there, a verify slice left for
    # the next pass. Anything else -- images left behind (1), no store or
    # account (2), a helper that died -- is the pass not done.
    case "${RC}" in
        0|3) ;;
        *) R_IMAGES_WHY=SOME_IMAGES_NOT_SAVED ;;
    esac
    slog "${VERB}: image pass rc=${RC}${R_IMAGES_WHY:+ why=${R_IMAGES_WHY}}"
    return "${RC}"
}

do_images() {
    local MODE=""
    [ "${1:-}" = "--verify" ] && MODE=--verify
    refuse_unless_ready images
    if ! is_online; then
        say "images: refused, this device is offline"
        tell "why NO_NETWORK"
        exit ${EX_UNAVAILABLE}
    fi
    # The lock carries this pid, so `disable` can ask the run to stop
    # (stop_running_run, #186 PL-30); the TERM trap ends the helper and
    # the EXIT trap clears the progress file, as scan's do. The progress
    # line is route=images at=<epoch>: RUN_ROUTE names the verb, and
    # mark_running's argument is the rest of the line, not the verb --
    # `mark_running images` wrote at=<epoch>images (audit #258 PL-013).
    trap 'stopped images' TERM
    RUN_ROUTE=images
    take_lock images
    mark_running
    trap 'unmark_running; [ -n "${CLIENT:-}" ] && kill "${CLIENT}" 2>/dev/null' EXIT
    local RC=0
    # Bounded at the process too, a grace past the helper's own --seconds
    # (#308 F-RA-10).
    # shellcheck disable=SC2086 -- MODE is one flag or empty, on purpose
    timeout "$(( IMAGE_PASS_SECONDS + 10 ))" "${IMAGE_HELPER}" --seconds "${IMAGE_PASS_SECONDS}" ${MODE} &
    CLIENT=$!
    wait "${CLIENT}" || RC=$?
    CLIENT=""
    slog "images: rc=${RC}${MODE:+ (${MODE})}"
    exit "${RC}"
}

# refresh [--game <id>|--all]. The service's own pass re-reads, each online
# hour while the proxy is idle, the cached games played in the last seven
# days (upstream 59b167c, D-RA-029; patch 005 keeps only its exception
# boundary), which covers the ordinary case -- not every cached game, and not
# daily, as this said until #308 F-RA-28. This is for the player standing in
# front of the device who has just changed
# something on the site -- reset an achievement, earned one elsewhere -- and
# wants it true here before going offline (#223).
do_refresh() {
    local WHICH=()
    case "${1:-}" in
        --all)  WHICH=(--all) ;;
        --game) [ -n "${2:-}" ] || { echo "usage: raofflineproxy-ctl refresh [--all|--game <id>]" >&2; exit ${EX_USAGE}; }
                WHICH=(--game "${2}") ;;
        "")     ;;
        *)      echo "usage: raofflineproxy-ctl refresh [--all|--game <id>]" >&2; exit ${EX_USAGE} ;;
    esac
    refuse_unless_ready refresh
    if ! is_online; then
        say "refresh: refused, this device is offline"
        tell "why NO_NETWORK"
        exit ${EX_UNAVAILABLE}
    fi
    # As images: the pid in the lock, a TERM trap over the helper, the
    # verb in RUN_ROUTE (audit #258 PL-013).
    trap 'stopped refresh' TERM
    RUN_ROUTE=refresh
    take_lock refresh
    mark_running
    trap 'unmark_running; [ -n "${CLIENT:-}" ] && kill "${CLIENT}" 2>/dev/null' EXIT
    local RC=0
    # The helper looks at its --seconds between games; a game's requests
    # can block past it, so the process is bounded too, a minute's grace
    # past the helper's own ceiling (#308 F-RA-10).
    timeout "$(( TOPUP_TIMEOUT + 60 ))" "${REFRESH_HELPER}" --seconds "${TOPUP_TIMEOUT}" "${WHICH[@]}" &
    CLIENT=$!
    wait "${CLIENT}" || RC=$?
    CLIENT=""
    slog "refresh: rc=${RC} ${WHICH[*]}"
    exit "${RC}"
}

do_scan() {
    trap 'stopped scan' TERM
    trap 'cancelled scan' INT
    RUN_ROUTE=scan
    take_lock scan
    refuse_unless_ready scan
    mkdir -p "${PROXY_DIR}" || fail "cannot create ${PROXY_DIR}"
    if ! is_online; then
        say "scan: refused, RetroAchievements is not reachable"
        slog "scan refused: offline by the proxy's probe"
        exit ${EX_UNAVAILABLE}
    fi

    local LIST
    LIST="$(mktemp /tmp/raofflineproxy-scan.XXXXXX)" || fail "cannot create the list"
    # Everything of the run's goes when the run does, however it ends.
    trap 'rm -f "${LIST}" "${JOBS_FIFO:-}" "${READY_BEFORE:-}" "${READY_AFTER:-}" "${SCAN_CURSOR}.next" "${RUNNING}" "${RUNNING}.tmp"; [ -n "${CLIENT:-}" ] && kill "${CLIENT}" 2>/dev/null' EXIT

    local COUNTS
    R_IMAGES_WHY=""
    mark_running
    tell "doing listing"
    if ! COUNTS="$(list_jobs "${LIST}" all 0 2>>"${SCAN_LOG}")"; then
        slog "scan: the library could not be listed"
        tell "why LIBRARY_UNREADABLE"
        write_stamp 1 scan 0 0 "$(count_ready)" 0 0 0 LIBRARY_UNREADABLE
        exit 1
    fi
    local FOUND NEW TRUNC
    FOUND="$(count_of "${COUNTS}" found)"
    NEW="$(count_of "${COUNTS}" new)"
    TRUNC="$(count_of "${COUNTS}" truncated)"
    slog "scan start: ${COUNTS}"
    if [ "${TRUNC}" -eq 1 ]; then
        slog "scan: the walk stopped at the client's cap of files per run; the next scan walks on from ${SCAN_CURSOR}"
    fi

    local READY
    if [ "${FOUND}" -eq 0 ]; then
        READY="$(count_ready)"
        slog "scan: no games found under ${ROMS_ROOT}"
        tell "why NO_GAMES_FOUND"
        write_stamp 1 scan 0 0 "${READY}" 0 0 0 NO_GAMES_FOUND
        exit 1
    fi
    tell "total ${NEW}"
    if [ "${NEW}" -eq 0 ]; then
        tell "note NOTHING_NEW"
        commit_cursor || slog "scan: an old cursor could not be removed; the next walk starts from the top all the same"
        # No game to cache, but the images of what is cached may still be
        # missing -- a pass the last run cut, a badge that did not come --
        # and pressing SCAN again is how a player asks for them (#307
        # PL-060). The same pass, the same verdict.
        run_image_pass scan "${IMAGE_PASS_SECONDS}"
        READY="$(count_ready)"
        local RC0=0 WHY0="${R_IMAGES_WHY}"
        [ -n "${WHY0}" ] && { RC0=1; tell "why ${WHY0}"; }
        slog "scan done: nothing new, ready=${READY}${WHY0:+ why=${WHY0}}"
        write_stamp "${RC0}" scan 0 0 "${READY}" 0 0 0 "${WHY0}"
        tell "done 0|0|${READY}|0"
        exit "${RC0}"
    fi

    READY_BEFORE="$(mktemp /tmp/raofflineproxy-ready.XXXXXX 2>/dev/null)" && { ready_games_into "${READY_BEFORE}" || { rm -f "${READY_BEFORE}"; READY_BEFORE=""; }; }
    run_jobs page "${LIST}" "${NEW}" 0

    READY="$(count_ready)"
    local ADDED=""
    READY_AFTER="$(mktemp /tmp/raofflineproxy-ready.XXXXXX 2>/dev/null)" && ready_games_into "${READY_AFTER}" && ADDED="$(games_made_ready "${READY_BEFORE}" "${READY_AFTER}")"
    rm -f "${READY_BEFORE}" "${READY_AFTER}"; READY_BEFORE=""; READY_AFTER=""
    # A measurement that failed is said as one (added_count, PL-031).
    ADDED="$(added_count "${ADDED}" "${R_CACHED}")"
    [ "${ADDED}" = "unknown" ] && slog "scan: the store could not be read before or after the jobs; how many games they made ready is not known (added=unknown)"
    local RC=0 WHY="${R_WHY}"
    if [ -n "${WHY}" ]; then
        RC=1
    elif [ "${R_STOPPED}" -eq 0 ] && [ "${R_CLIENT_RC}" -ne 0 ] && [ "${R_DONE}" -eq 0 ]; then
        # The helper died on its own, before its DONE, without a reason the
        # lines above named: the log has its traceback. (After DONE the games
        # are cached and the exit is the badge downloads', fork #188.)
        RC=1; WHY=SOMETHING_WENT_WRONG
    elif [ "${R_ERRORS}" -gt 0 ]; then
        # A fetch that failed for any game, even between games that went
        # through, is a run that did not finish (D-UI-030: a run whose
        # parts disagree is COULDN'T FINISH); the next run tries them again.
        RC=1; WHY=SOME_GAMES_NOT_SAVED
    fi
    # The images of what this run cached, and of anything cached before it
    # that is still missing one (#212): the same action, finished.
    # The scan has no deadline of its own (the top-up's TOPUP_TIMEOUT is the
    # one clock here), so the pass gets its own ceiling.
    # Whenever the run worked through its jobs -- cached one or not: a
    # library with a ROM RetroAchievements does not know lists a job at
    # every scan, and gating the pass on a cached game left such a scan
    # COMPLETED over badges it never looked at (audit of the fixes, claude
    # G-D-02 = gpt G-D-01). Not after a stop on a refused sign-in or a
    # server that stopped answering.
    [ "${R_STOPPED}" -eq 0 ] && run_image_pass scan "${IMAGE_PASS_SECONDS}"
    # The games' own why comes first; a pass that left images behind is the
    # run's why when the games went through (#307 PL-060).
    if [ -z "${WHY}" ] && [ -n "${R_IMAGES_WHY}" ]; then
        RC=1; WHY="${R_IMAGES_WHY}"
    fi

    # The walk's cursor is kept once the run has worked through its jobs; a
    # run stopped short leaves it where it was (claude G-D-06). A cut walk
    # whose cursor could not be kept promises no continuation: the run could
    # not finish, and neither the page nor the stamp says TRUNCATED (gpt
    # G-D-06).
    if [ "${R_DONE}" -eq 1 ] && [ "${R_STOPPED}" -eq 0 ]; then
        if [ "${TRUNC}" -eq 1 ]; then
            if [ "$(count_of "${COUNTS}" cursor_saved)" -ne 1 ] || ! commit_cursor; then
                slog "scan: the walk's cursor could not be saved; the next scan would take the same slice"
                TRUNC=0
                [ -z "${WHY}" ] && { RC=1; WHY=SOMETHING_WENT_WRONG; }
            fi
        else
            commit_cursor || slog "scan: an old cursor could not be removed; the next walk starts from the top all the same"
        fi
    elif [ "${TRUNC}" -eq 1 ]; then
        slog "scan: the run stopped short of its jobs; the cursor stays where it was"
    fi
    rm -f "${SCAN_CURSOR}.next"
    [ "${R_LIMIT}" -eq 1 ] && tell "note LIMIT_REACHED"
    # Not every folder was walked: the page says so (GuiOfflineScan's
    # NOT EVERY FOLDER WAS LOOKED AT. SCAN AGAIN TO CONTINUE.) and the stamp
    # carries it -- the log alone said it before (#307 PL-059).
    [ "${TRUNC}" -eq 1 ] && tell "note TRUNCATED"
    [ "${R_ERRORS}" -gt 0 ] && tell "errors ${R_ERRORS}"
    [ -n "${WHY}" ] && tell "why ${WHY}"
    write_stamp "${RC}" scan "${R_CACHED}" "${R_SKIPPED}" "${READY}" "${R_LIMIT}" "${R_INDEXED}" "${R_ERRORS}" "${WHY}" "${ADDED}" "${TRUNC}"
    slog "scan done: rc=${RC} cached=${R_CACHED} indexed=${R_INDEXED} skipped=${R_SKIPPED} errors=${R_ERRORS} ready=${READY} limit=${R_LIMIT}${WHY:+ why=${WHY}}"
    say "scan: cached ${R_CACHED} (${R_INDEXED} from the index), skipped ${R_SKIPPED}, ${READY} ready${WHY:+; ${WHY}}"
    tell "done ${R_CACHED}|${R_SKIPPED}|${READY}|${R_LIMIT}"
    exit "${RC}"
}

# index-offline: the interface's index had games to identify and
# RetroAchievements' hash library did not come -- offline, nearly always
# (fork #299, D-UI-104). The marker the after-index run leaves when its
# probe fails is written here without a probe, since the interface already
# knows the library did not come: the next link-return topup lists the
# library once, inside the half hour or not, and clears it once that
# listing's games are handled. The games this index could not identify are
# not among them -- they have no cheevosId until an index with the library
# gives them one; the interface runs that index when the link comes up, and
# its topup --after-index caches them (#308 F-RA-22). Nothing else is
# touched; exit 0.
# index-pending holds a token -- when it was written and by which process --
# so a top-up can tell the marker its listing was made for from a newer one
# an index writes while it runs (audit of the fixes, gpt G-D-03). Whole or
# not at all. A marker an earlier build left is an empty file, and reads as
# one token like any other.
#
# The marker has a lock of its own (audit of the fix round, gpt G2-D-03):
# the top-up's token check and its removal are one step under it
# (ack_index_pending), and a write takes it too, so an index's newer marker
# cannot land between that check and that removal and go with the older
# one. It is held for a read, a rename or an unlink, never across anything
# that waits. Busybox flock has no -w: five tries a second apart. A lock
# that cannot be had leaves the safe side -- the write goes ahead, since a
# notification lost leaves the player's games uncached, and the removal
# does not, since a marker kept costs one more listing.
PENDING_LOCK="/var/run/raofflineproxy-index-pending.lock"
pending_lock() {
    local TRY=0
    exec 6<>"${PENDING_LOCK}" 2>/dev/null || return 1
    until flock -n 6; do
        TRY=$((TRY + 1))
        if [ "${TRY}" -ge 5 ]; then exec 6>&-; return 1; fi
        sleep 1
    done
}

pending_unlock() {
    exec 6>&-
}

write_index_pending() {
    local LOCKED=0 RC=0
    if pending_lock; then LOCKED=1; else say "index-pending: its lock could not be had; written without it"; fi
    printf '%s %s %s\n' "$(date +%s)" "$$" "${RANDOM}" > "${INDEX_PENDING}.tmp" 2>/dev/null \
        && mv -f "${INDEX_PENDING}.tmp" "${INDEX_PENDING}" || RC=1
    [ "${LOCKED}" -eq 1 ] && pending_unlock
    return "${RC}"
}

# ack_index_pending <token>: remove index-pending if it is still the marker
# the caller's listing was made for. 0 removed, 1 kept (a newer marker), 2
# kept because the lock could not be had.
ack_index_pending() {
    # Taken aside by rename before it is read: a writer that could not have
    # the lock renames a newer marker into place (write_index_pending's
    # fallback), and a compare-then-rm on the shared path removed that newer
    # one (the audit of the fixes, gpt G3-D-03). Whatever lands on the path
    # after the rename is somebody else's and stays; a moved marker that is
    # not the caller's token goes back.
    local RC=1 mine="${INDEX_PENDING}.ack.$$"
    pending_lock || return 2
    if mv -f "${INDEX_PENDING}" "${mine}" 2>/dev/null; then
        if [ "$(cat "${mine}" 2>/dev/null)" = "${1}" ]; then
            rm -f "${mine}" && [ ! -e "${mine}" ] && RC=0
        else
            [ -e "${INDEX_PENDING}" ] || mv -f "${mine}" "${INDEX_PENDING}" 2>/dev/null
            rm -f "${mine}" 2>/dev/null
        fi
    fi
    pending_unlock
    return "${RC}"
}

do_index_offline() {
    mkdir -p "${PROXY_DIR}" || fail "cannot create ${PROXY_DIR}"
    write_index_pending || fail "cannot write ${INDEX_PENDING}"
    slog "index ran offline: the hash library did not come (index-pending); the library is listed once at the link's return"
}

# topup [--after-index]. --after-index is the run the interface starts as
# its hasher finishes (ThreadedHasher, with the toggle on): it waits for a
# top-up already running instead of giving way to it, and it does not count
# the half-hour since the last attempt against itself -- the index has just
# grown, and that is the one moment a top-up is sure to have something to
# do. It marks the attempt like any other, once its probe has answered.
do_topup() {
    local AFTER_INDEX=0 AI_NOTE=""
    RUN_ROUTE=topup
    if [ "${1:-}" = "--after-index" ]; then AFTER_INDEX=1; AI_NOTE=" (after the index)"; fi
    trap 'stopped topup' TERM
    # One deadline, taken before anything can wait: the lock, the probes,
    # the listing and both passes all spend from it, so the run ends within
    # TOPUP_TIMEOUT of this moment whatever each part costs (#186 PL-28).
    local START
    START="$(date +%s)"
    take_lock topup "${AFTER_INDEX}" "${START}"
    refuse_unless_ready topup >/dev/null
    mkdir -p "${PROXY_DIR}" || fail "cannot create ${PROXY_DIR}"

    # Bounded: one attempt per interval, whatever the link does. The mark
    # is read here and set only below, once a probe has reached the server.
    # An index that ran offline (index-pending, below) is the one reason to
    # run inside the interval: the player added games and the toast said
    # they are looked up next time the device is connected (fork #299,
    # D-UI-104), and "next time" is this link, not the one after the half
    # hour. Only a marker written since the last attempt: one a failed
    # attempt left behind (#307 PL-055, below) waits out the half hour like
    # any other run, so a link that flaps does not turn it into a request
    # storm.
    local PENDING_DUE=0
    if [ -e "${INDEX_PENDING}" ] && { [ ! -e "${TOPUP_MARK}" ] || [ "${INDEX_PENDING}" -nt "${TOPUP_MARK}" ]; }; then
        PENDING_DUE=1
    fi
    if [ "${AFTER_INDEX}" -eq 0 ] && [ -e "${TOPUP_MARK}" ] && [ "${PENDING_DUE}" -eq 0 ]; then
        local AGE=$(( $(date +%s) - $(stat -c %Y "${TOPUP_MARK}" 2>/dev/null || echo 0) ))
        if [ "${AGE}" -ge 0 ] && [ "${AGE}" -lt "${TOPUP_INTERVAL}" ]; then
            exit 0
        fi
        # The link's return has one question -- was a game played since the
        # last attempt? -- and no game means nothing to look for: out before
        # the probe, the mark untouched (fork #299, D-RA-035: the maintainer,
        # a nine-second check at wake with nothing to add).
        local HIST
        HIST="$(history_path)"
        if [ ! -e "${INDEX_PENDING}" ] && { [ ! -e "${HIST}" ] || [ ! "${HIST}" -nt "${TOPUP_MARK}" ]; }; then
            slog "topup: no game played since the last attempt (${HIST} is not newer than the mark); nothing to look for, skipped"
            exit 0
        fi
    fi

    # The hook fires when the address arrives, which can be well before the
    # resolver answers (fork #175: 20-45 s behind on that boot shape), so
    # the probe gets the token check's patience -- PROBE_TRIES tries,
    # PROBE_INTERVAL apart, inside the deadline. A probe that never reached
    # RetroAchievements is not an attempt: no mark, so the next link event
    # (or the after-index run) tries again rather than waiting out the half
    # hour on a connect that was never tested (#186 PL-04).
    local TRY=0 ONLINE=0
    while [ "${TRY}" -lt "${PROBE_TRIES}" ]; do
        TRY=$((TRY + 1))
        if is_online; then ONLINE=1; break; fi
        [ "${TRY}" -lt "${PROBE_TRIES}" ] || break
        [ "$(time_left "${START}")" -gt "${PROBE_INTERVAL}" ] || break
        pause "${PROBE_INTERVAL}"
    done
    if [ "${ONLINE}" -eq 0 ]; then
        slog "topup refused: offline by the proxy's probe (${TRY} probes); not counted as an attempt"
        if [ "${AFTER_INDEX}" -eq 1 ]; then
            write_index_pending
            slog "topup: the index's games wait for the link (index-pending)"
        fi
        exit ${EX_UNAVAILABLE}
    fi
    touch "${TOPUP_MARK}"

    local LIST
    LIST="$(mktemp /tmp/raofflineproxy-topup.XXXXXX)" || fail "cannot create the list"
    trap 'rm -f "${LIST}" "${JOBS_FIFO:-}" "${SC_OUT:-}" "${READY_BEFORE:-}" "${READY_AFTER:-}" "${RUNNING}" "${RUNNING}.tmp"; [ -n "${CLIENT:-}" ] && kill "${CLIENT}" 2>/dev/null' EXIT
    mark_running
    # The games ready for this account before either pass, for added=.
    READY_BEFORE="$(mktemp /tmp/raofflineproxy-ready.XXXXXX 2>/dev/null)" && { ready_games_into "${READY_BEFORE}" || { rm -f "${READY_BEFORE}"; READY_BEFORE=""; }; }

    # First, every game the interface's index knows and the client has not
    # cached -- the games added and indexed since the last run, and with a
    # library nobody scanned, as many as the deadline allows (the rest next
    # time). Nothing is hashed here.
    local COUNTS LRC NEW=0 CACHED=0 SKIPPED=0 INDEXED=0 LIMIT=0 ERRORS=0 WHY="" LEFT ADDED="" LISTED=0 LIST_WHY=""
    local PENDING_SEEN=0 PENDING_TOKEN=""
    LEFT="$(time_left "${START}")"
    if [ "${LEFT}" -le 0 ]; then
        WHY=TOOK_TOO_LONG
        slog "topup${AI_NOTE}: the deadline passed while waiting for the lock and the probe"
    elif [ "${AFTER_INDEX}" -eq 0 ] && [ ! -e "${INDEX_PENDING}" ]; then
        # New games are the index's to find -- at startup and with UPDATE
        # GAMELISTS, both of which end in this run with --after-index -- so
        # the link's return does not list the library (fork #299, D-RA-035),
        # unless an index ran offline and left its marker: then once, below.
        slog "topup at the link's return: the recently played pass alone (new games are the index's)"
    else
        # The marker stays until the listing it stands for, and the games
        # that listing found, have been handled -- removed below, never
        # here: a listing that failed, a run cut by the deadline or stopped
        # part-way (STOP IT AND PLAY, disable), a game whose fetch failed,
        # each left no marker and so no retry (#307 PL-055).
        if [ "${AFTER_INDEX}" -eq 0 ]; then
            slog "topup at the link's return: an index ran offline (index-pending); the library listed once for it -- again after the half hour if this run does not finish"
        fi
        # The marker this listing answers, as it reads now: one written
        # after this moment is a newer promise, and stays (gpt G-D-03).
        if [ -e "${INDEX_PENDING}" ]; then PENDING_SEEN=1; PENDING_TOKEN="$(cat "${INDEX_PENDING}" 2>/dev/null)"; fi
        COUNTS="$(list_jobs "${LIST}" indexed "${LEFT}" 2>>"${SCAN_LOG}")"
        LRC=$?
        if [ "${LRC}" -eq 0 ]; then
            LISTED=1
            NEW="$(count_of "${COUNTS}" new)"
            slog "topup start${AI_NOTE}: ${COUNTS}"
        elif [ "${LRC}" -eq 124 ]; then
            WHY=TOOK_TOO_LONG
            slog "topup${AI_NOTE}: the listing did not finish inside the deadline"
        else
            # The recently played pass still runs -- it needs no index -- but
            # a run a part of which failed is one that could not finish
            # (D-UI-030): the why is kept for the stamp below (audit of the
            # fixes, claude G-D-13; it read COMPLETED before).
            slog "topup${AI_NOTE}: the interface's index could not be read; the recently played pass runs alone"
            LIST_WHY=LIBRARY_UNREADABLE
        fi
    fi
    if [ -z "${WHY}" ] && [ "${NEW}" -gt 0 ]; then
        LEFT="$(time_left "${START}")"
        if [ "${LEFT}" -le 0 ]; then
            WHY=TOOK_TOO_LONG
        else
            run_jobs quiet "${LIST}" "${NEW}" "${LEFT}"
            CACHED="${R_CACHED}"; SKIPPED="${R_SKIPPED}"; INDEXED="${R_INDEXED}"; LIMIT="${R_LIMIT}"; ERRORS="${R_ERRORS}"; WHY="${R_WHY}"
            # A helper killed by the bound after its DONE finished its games
            # (fork #188: badge downloads kept it alive); only one cut before
            # DONE makes the run one that did not finish.
            if [ -z "${WHY}" ] && [ "${R_STOPPED}" -eq 0 ] && [ "${R_CLIENT_RC}" -ne 0 ] && [ "${R_DONE}" -eq 0 ]; then
                WHY=RETROACHIEVEMENTS_STOPPED_ANSWERING
                [ "${R_CLIENT_RC}" -eq 124 ] && WHY=TOOK_TOO_LONG
            fi
            # As in scan: a game whose fetch failed is a run that did not
            # finish, and the next top-up tries it again (#186 PL-24).
            [ -z "${WHY}" ] && [ "${ERRORS}" -gt 0 ] && WHY=SOME_GAMES_NOT_SAVED
            slog "topup indexed pass: cached=${CACHED} indexed=${INDEXED} skipped=${SKIPPED} errors=${ERRORS} rc=${R_CLIENT_RC}${WHY:+ why=${WHY}}"
        fi
    fi

    # The index's games are handled -- listed, and each cached or passed
    # over -- so whatever index-pending stood for is done; after-index runs
    # included, since their listing is the same (#307 PL-055).
    # The check and the removal are one step under the marker's lock
    # (ack_index_pending, gpt G2-D-03).
    if [ "${LISTED}" -eq 1 ] && [ -z "${WHY}" ] && [ -e "${INDEX_PENDING}" ]; then
        local ACK=1
        [ "${PENDING_SEEN}" -eq 1 ] && { ack_index_pending "${PENDING_TOKEN}"; ACK=$?; }
        case "${ACK}" in
            0) slog "topup: the pending index's listing and its games are handled; index-pending removed" ;;
            1) slog "topup: an index left index-pending while this run was at its jobs; kept for the next run" ;;
            *) slog "topup: index-pending's lock could not be had; the marker is kept and the next run lists for it again" ;;
        esac
    fi

    # Then the client's own recently-played pass for what the index missed
    # -- RetroArch's history, PPSSPP's recent list -- each not yet cached,
    # with the client's own pause between requests, in what is left of the
    # deadline. Its progress lines are JSON; the last line is the result.
    # Run in the background and waited for, so a stop request (disable)
    # reaches this process at once and its EXIT trap ends the client.
    LEFT="$(time_left "${START}")"
    if [ -z "${WHY}" ] && [ "${LEFT}" -ge 60 ]; then
        local SRC RESULT
        SC_OUT="$(mktemp /tmp/raofflineproxy-topup-sc.XXXXXX)" || fail "cannot create the result file"
        mark_running
        timeout "${LEFT}" ${PROXY_PY} run-smart-cache > "${SC_OUT}" 2>>"${SCAN_LOG}" &
        CLIENT=$!
        wait "${CLIENT}" 2>/dev/null
        SRC=$?
        unset CLIENT
        unmark_running
        RESULT="$(grep '"type":"result"' "${SC_OUT}" 2>/dev/null | tail -n 1)"
        rm -f "${SC_OUT}"; SC_OUT=""
        local SC=0 SS=0 SL=0
        if [ -n "${RESULT}" ]; then
            read -r SC SS SL < <(python3 -c '
import json, sys
r = json.loads(sys.argv[1])
print(int(r.get("cached", 0)), int(r.get("skipped", 0)), 1 if r.get("limit_reached") else 0)
' "${RESULT}" 2>/dev/null || echo "0 0 0")
        fi
        CACHED=$((CACHED + SC)); SKIPPED=$((SKIPPED + SS)); [ "${SL}" -eq 1 ] && LIMIT=1
        slog "topup recently played: rc=${SRC} cached=${SC} skipped=${SS} limit=${SL}"
        if [ "${SRC}" -ne 0 ]; then
            WHY=RETROACHIEVEMENTS_STOPPED_ANSWERING
            [ "${SRC}" -eq 124 ] && WHY=TOOK_TOO_LONG
        fi
    elif [ -z "${WHY}" ]; then
        slog "topup: no time left for the recently played pass (${LEFT}s)"
    fi

    # A listing that could not be read is the run's why when nothing later
    # had one of its own.
    [ -z "${WHY}" ] && [ -n "${LIST_WHY}" ] && WHY="${LIST_WHY}"
    local READY MADE
    READY="$(count_ready)"
    # added=: the games the two passes made ready for this account, from the
    # store before and after (#308 F-RA-10, F-RA-15); unknown when the store
    # could not be read, never the passes' cache operations in its place
    # (added_count, PL-031).
    READY_AFTER="$(mktemp /tmp/raofflineproxy-ready.XXXXXX 2>/dev/null)" && ready_games_into "${READY_AFTER}" && MADE="$(games_made_ready "${READY_BEFORE}" "${READY_AFTER}")" && ADDED="${MADE}"
    rm -f "${READY_BEFORE}" "${READY_AFTER}"; READY_BEFORE=""; READY_AFTER=""
    ADDED="$(added_count "${ADDED}" "${CACHED}")"
    [ "${ADDED}" = "unknown" ] && slog "topup${AI_NOTE}: the store could not be read before or after the passes; how many games they made ready is not known (added=unknown)"
    slog "topup done: cached=${CACHED} added=${ADDED} indexed=${INDEXED} skipped=${SKIPPED} errors=${ERRORS} ready=${READY} limit=${LIMIT} took=$(( $(date +%s) - START ))s${WHY:+ why=${WHY}}"

    # The line under the row changes only when the top-up has something to
    # say: games it added, or a run that could not finish. Nothing new
    # leaves the last scan's line as it was.
    if [ -n "${WHY}" ]; then
        write_stamp 1 topup "${CACHED}" "${SKIPPED}" "${READY}" "${LIMIT}" "${INDEXED}" "${ERRORS}" "${WHY}" "${ADDED}"
        say "topup could not finish (${WHY}); cached ${CACHED}, ${READY} ready"
        exit 1
    fi
    if [ "${CACHED}" -gt 0 ]; then
        # The top-up is the background run, so it is where the store is
        # verified as well as filled: a slice per run from the cursor, so
        # the whole store comes round without any one run being long (#213).
        run_image_pass topup "$(time_left "${START}")" --verify
        if [ -n "${R_IMAGES_WHY}" ]; then
            # The games are cached; their images are not all there (#307
            # PL-060): a run whose parts disagree could not finish.
            write_stamp 1 topup "${CACHED}" "${SKIPPED}" "${READY}" "${LIMIT}" "${INDEXED}" "${ERRORS}" "${R_IMAGES_WHY}" "${ADDED}"
            say "topup could not finish (${R_IMAGES_WHY}); cached ${CACHED}, ${READY} ready"
            exit 1
        fi
        write_stamp 0 topup "${CACHED}" "${SKIPPED}" "${READY}" "${LIMIT}" "${INDEXED}" "${ERRORS}" "" "${ADDED}"
        say "topup: cached ${CACHED} game(s), ${INDEXED} from the index; ${READY} ready"
    fi
    exit 0
}

case "${1:-}" in
    enable)  do_enable ;;
    disable) do_disable ;;
    start)   do_start ;;
    stop)    do_stop ;;
    status)  do_status ;;
    pending) do_pending ;;
    pending-ids) do_pending_ids ;;
    account) do_account ;;
    summary) do_summary ;;
    flushed) do_flushed ;;
    scan)    do_scan ;;
    topup)   do_topup "${2:-}" ;;
    index-offline) do_index_offline ;;
    ready)   do_ready ;;
    listening) do_listening "${2:-}" "${3:-}" ;;
    images)  do_images "${2:-}" ;;
    refresh) do_refresh "${2:-}" "${3:-}" ;;
    *)
        echo "Usage: raofflineproxy-ctl {enable|disable|start|stop|status|pending|pending-ids|account|summary|flushed|scan|topup [--after-index]|index-offline|images [--verify]|refresh [--all|--game <id>]|listening [--wait <seconds>]|ready}" >&2
        exit 2
    ;;
esac
