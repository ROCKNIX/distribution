     CacheGameAuthError,
@@ -39,6 +40,11 @@ from .utils import (
 MAX_RETRIES = 5
 GENESIS_HASH = "genesis"
 MAX_AWARD_OFFSET_SECONDS = 14 * 24 * 60 * 60
+# "<epoch> <flushed>", written after a flush that sent at least one award, for
+# an OS integration to read (and remove, once it has told the player) -- the
+# same kind of file as es_export's cached_game_ids.txt. The log says the same
