+FLUSH_STAMP_FILE = CONFIG_DIR / "last-flush"
 LOGGER = logging.getLogger("raofflineproxy")
 
 
@@ -486,6 +492,8 @@ def flush_pending_awards(storage: Storage, config_data: dict) -> FlushOutcome:
         skipped_stale,
         pending_remaining,
     )
+    if flushed:
+        write_flush_stamp(flushed)
 
     return FlushOutcome(
         flushed=flushed,
@@ -496,6 +504,18 @@ def flush_pending_awards(storage: Storage, config_data: dict) -> FlushOutcome:
     )
 
 
+def write_flush_stamp(flushed: int) -> None:
+    # Whole or not at all: a reader on another thread or in another process
+    # must never see half a line.
+    try:
+        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
+        tmp_path = FLUSH_STAMP_FILE.with_name(FLUSH_STAMP_FILE.name + ".tmp")
+        tmp_path.write_text(f"{int(time.time())} {int(flushed)}\n")
+        os.replace(tmp_path, FLUSH_STAMP_FILE)
+    except Exception:
+        LOGGER.exception("Failed to write the flush stamp")
+
+
 def purge_processed_awards_if_safe(storage: Storage) -> None:
     if storage.pending_awards_exist_by_status(PENDING_AWARD_STATUS_PENDING):
         return
