+# One connection per thread per host, reused across images.
+#
+# Every badge was fetched with its own urllib.request.urlopen, which means a
+# TCP connect and a TLS handshake for a file whose median size is 5.6 KB. On a
+# guest that measured 161 ms per image against 28 ms over a connection already
+# open -- so a first-time fill of a 494-game library spent over half an hour
+# almost entirely in handshakes (ROCKNIX fork maxengel/rocknix#217).
+#
+# Reuse is also the politer shape: the same bytes and the same request count,
+# a fraction of the setup, so it is not a licence to raise concurrency and the
+# pool size is deliberately unchanged.
+#
+# A pooled connection can be closed by the server between uses and there is no
+# way to tell until the write fails, so every fetch retries once on a fresh
+# connection before giving up. Bodies are always read in full, because a
+# response left unread poisons the connection for the next caller.
+_pool = threading.local()
+
+
+def _pooled_connection(scheme: str, host: str, timeout: float, fresh: bool = False):
+    connections = getattr(_pool, "connections", None)
+    if connections is None:
+        connections = _pool.connections = {}
+    key = (scheme, host)
+    existing = connections.get(key)
+    if fresh and existing is not None:
+        try:
+            existing.close()
+        except Exception:
+            pass
+        existing = None
+        connections.pop(key, None)
+    if existing is None:
+        if scheme == "https":
+            existing = http.client.HTTPSConnection(host, timeout=timeout)
+        else:
+            existing = http.client.HTTPConnection(host, timeout=timeout)
+        connections[key] = existing
+    return existing
+
+
+def _drop_connection(scheme: str, host: str) -> None:
+    connections = getattr(_pool, "connections", None) or {}
+    connection = connections.pop((scheme, host), None)
+    if connection is not None:
+        try:
+            connection.close()
+        except Exception:
+            pass
+
+
+def fetch_static_asset(url: str, headers: dict, timeout: float = 10.0, _redirects: int = 3):
+    """GET url over a reused connection. Returns (response headers, body).
+
+    Raises on a non-2xx status, as urlopen did, so callers that already treat
+    any failure as "not cached" keep their behaviour.
+    """
+    parsed = urllib.parse.urlsplit(url)
+    scheme = parsed.scheme or "https"
+    host = parsed.netloc
+    target = parsed.path or "/"
+    if parsed.query:
+        target = f"{target}?{parsed.query}"
+
+    last_error: Exception | None = None
+    for attempt in (False, True):
+        connection = _pooled_connection(scheme, host, timeout, fresh=attempt)
+        try:
+            connection.request("GET", target, headers=headers)
+            response = connection.getresponse()
+            body = response.read()  # always, or the connection cannot be reused
+            status = response.status
+            if status in (301, 302, 303, 307, 308) and _redirects > 0:
+                location = response.headers.get("Location")
+                if location:
+                    return fetch_static_asset(
+                        urllib.parse.urljoin(url, location), headers, timeout, _redirects - 1
+                    )
+            if status < 200 or status >= 300:
+                raise urllib.error.HTTPError(url, status, response.reason, response.headers, None)
+            return response.headers, body
+        except urllib.error.HTTPError:
+            raise
+        except Exception as exc:  # a closed or broken connection: retry once
+            last_error = exc
+            _drop_connection(scheme, host)
+    raise last_error if last_error else RuntimeError("fetch failed")
+
+
