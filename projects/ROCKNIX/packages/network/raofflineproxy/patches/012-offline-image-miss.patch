+# ROCKNIX (fork #190, #199): the request header that asks for the store and
+# nothing else. On a dorequest.php call it is served by handle_offline_request
+# whatever this process believes about the link; on an image it is the
+# store's copy or a 404, at once.
+STORE_ONLY_HEADER = "X-RA-Store-Only"
 
 
 def is_passthrough_client_error(path: str, status: int) -> bool:
@@ -115,6 +120,11 @@ def is_static_asset_request(path: str) -> bool:
     return any(clean_path.startswith(prefix) for prefix in IMAGE_PATH_PREFIXES)
 
 
+def store_only_requested(headers: dict[str, str]) -> bool:
+    value = next((v for k, v in headers.items() if k.lower() == STORE_ONLY_HEADER.lower()), None)
+    return value == "1"
+
+
 def guess_content_type(path: Path) -> str:
     suffix = path.suffix.lower()
     if suffix == ".png":
@@ -233,6 +243,16 @@ def game_id_cache_miss() -> bytes:
     )
 
 
+def image_not_cached() -> bytes:
+    # ROCKNIX (fork #199): the store's answer for an image it does not hold,
+    # when it is not to look further. A 404 rather than the 204 a failed
+    # fetch gives: RetroArch writes a badge for a 200 only and treats the two
+    # alike, and a client that saves the body to a file keeps a non-2xx
+    # answer out of its image cache, where a 204 lands as an empty file it
+    # then has to notice and remove.
+    return error_json(404, "image not cached")
+
+
