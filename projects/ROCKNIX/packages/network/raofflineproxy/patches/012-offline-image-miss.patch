+        # tracker says unreachable -- a HEAD to retroachievements.org whose
+        # name lookup its five-second timeout does not bound -- and an image
+        # request is answered below without asking the link anything, so its
+        # log line reads the state as last probed rather than probing again.
+        if is_static_asset_request(self.path):
+            online = is_retroachievements_reachable()
+        else:
+            online = self.server.is_online()
         LOGGER.info(
             "Request: %s %s body=%s online=%s",
             self.command,
             redact_query_tokens(self.path),
             redact_form_tokens(body),
-            self.server.is_online(),
+            online,
         )
 
         response = self.server.process_proxy_request(
@@ -374,6 +403,17 @@ class ProxyRuntimeServer(ThreadingTCPServer):
                 cached_asset = resolve_cached_static_asset(path)
                 if cached_asset is not None:
                     return raw_response_bytes(200, cached_asset.read_bytes(), guess_content_type(cached_asset), "OK")
+                # ROCKNIX (fork #199): an image the store does not hold is a
+                # 404 at once -- no probe, no upstream attempt -- when the
+                # client asked for the store only, or when this process's own
+                # state is offline: the tracker as the monitor last left it,
+                # the same state online_state.json carries. is_online() is not
+                # asked on that path: while the tracker says unreachable it
+                # probes on every call, and the fetch behind a yes is ten
+                # seconds more on a link that is up and leads nowhere. A miss
+                # while the state is online fetches and caches as before.
+                if store_only_requested(headers) or not is_retroachievements_reachable():
+                    return image_not_cached()
                 if self.is_online():
                     return self._forward_static_asset(path, headers)
             return raw_response_bytes(204, b"", "application/octet-stream", "No Content")
@@ -438,8 +478,7 @@ class ProxyRuntimeServer(ThreadingTCPServer):
         # online (the monitor probes every fifteen seconds), every request
