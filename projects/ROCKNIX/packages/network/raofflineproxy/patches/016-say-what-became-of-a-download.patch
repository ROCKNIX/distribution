+# What became of a download (ROCKNIX, audit #307 PL-060's follow-up). A
+# server that does not have an image says so, and saying so is permanent in
+# a way a timeout is not: a caller that fetches a whole store's images needs
+# to tell the two apart, or one badge the server never had fails its every
+# pass. So download_static_image returns one of these, and logs the class,
+# the URL and the HTTP status of any image it did not cache.
+IMAGE_CACHED = "cached"        # there already, or fetched whole
+IMAGE_ABSENT = "absent"        # the server answered 404 or 410: it does not have it
+IMAGE_TRANSIENT = "transient"  # anything else: a timeout, a 5xx, a refused
+                               # connection, a short or damaged body -- try again
+ABSENT_HTTP_STATUSES = (404, 410)
+
