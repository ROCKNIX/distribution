+    def test_resolve_host_bounded_gives_up_on_a_lookup_that_hangs(self) -> None:
+        # ROCKNIX (fork #242): a resolver with a route and no answer takes
+        # about twenty seconds; the probe must not.
+        import time as _time
+        original = network.socket.getaddrinfo
+        network.socket.getaddrinfo = lambda *_args, **_kwargs: _time.sleep(5)
+        try:
+            started = _time.monotonic()
+            ok, reason = network.resolve_host_bounded("retroachievements.org", seconds=0.2)
+            elapsed = _time.monotonic() - started
+        finally:
+            network.socket.getaddrinfo = original
+        self.assertFalse(ok)
+        self.assertIn("took longer than", reason)
+        self.assertLess(elapsed, 2.0)
+
+    def test_resolve_host_bounded_reports_a_failed_lookup(self) -> None:
+        original = network.socket.getaddrinfo
+
+        def failing(*_args, **_kwargs):
+            raise OSError("Temporary failure in name resolution")
+
+        network.socket.getaddrinfo = failing
+        try:
+            ok, reason = network.resolve_host_bounded("retroachievements.org", seconds=1.0)
+        finally:
+            network.socket.getaddrinfo = original
+        self.assertFalse(ok)
+        self.assertIn("Temporary failure in name resolution", reason)
+
+    def test_head_upstream_does_not_connect_when_the_lookup_fails(self) -> None:
+        original_lookup = network.socket.getaddrinfo
+        original_urlopen = network.urllib.request.urlopen
+        calls = []
+
+        def failing(*_args, **_kwargs):
+            raise OSError("Temporary failure in name resolution")
+
+        network.socket.getaddrinfo = failing
+        network.urllib.request.urlopen = lambda *args, **kwargs: calls.append(args) or (_ for _ in ()).throw(AssertionError("urlopen must not be called"))
+        try:
+            reachable, reason = network._head_upstream("https://retroachievements.org/", None)
+        finally:
+            network.socket.getaddrinfo = original_lookup
+            network.urllib.request.urlopen = original_urlopen
+        self.assertFalse(reachable)
+        self.assertIn("name lookup", reason)
+        self.assertEqual(calls, [])
+
