From: sunshineinabox <aqemail@gmail.com>
Date: Fri, 20 Nov 2026 18:00:00 -0800
Subject: [PATCH] xwayland/glamor/gbm: fall back to the primary node

--- a/hw/xwayland/xwayland-glamor-gbm.c
+++ b/hw/xwayland/xwayland-glamor-gbm.c
@@ -1680,12 +1680,15 @@
         return FALSE;
     }
 
-    if (!(main_dev->available_nodes & (1 << DRM_NODE_RENDER))) {
+    if (main_dev->available_nodes & (1 << DRM_NODE_RENDER)) {
+        xwl_gbm->device_name = strdup(main_dev->nodes[DRM_NODE_RENDER]);
+    } else if (main_dev->available_nodes & (1 << DRM_NODE_PRIMARY)) {
+        xwl_gbm->device_name = strdup(main_dev->nodes[DRM_NODE_PRIMARY]);
+    } else {
         ErrorF("Main linux-dmabuf device has no render node\n");
         return FALSE;
     }
 
-    xwl_gbm->device_name = strdup(main_dev->nodes[DRM_NODE_RENDER]);
     if (!xwl_gbm->device_name) {
         return FALSE;
     }
