From: sunshineinabox <aqemail@gmail.com>
Date: Mon, 28 Sep 2026 21:15:00 -0700
Subject: [PATCH] display modes: list and set them through the output helpers

wlr-randr and /etc/profile.d/010-wlr-randr only exist under sway.

--- a/es-app/src/ApiSystem.cpp
+++ b/es-app/src/ApiSystem.cpp
@@ -914,16 +914,11 @@
 
 std::vector<std::string> ApiSystem::getAvailableDisplayModes()
 {
-    // Check if wlr-randr is available
-    if (!Utils::FileSystem::exists("/usr/bin/wlr-randr")) {
-        LOG(LogWarning) << "wlr-randr not found, display mode configuration unavailable";
-        return {};
-    }
-
-    auto result = executeEnumerationScript("/usr/bin/sh -lc \"/usr/bin/wlr-randr | awk '/Modes/{flag=1;next}/Position/{flag=0}flag'\"");
+    // Listed by the running compositor (sway or KWin) in wlr-randr's format
+    auto result = executeEnumerationScript("/usr/bin/sh -lc output_modes");
 
     if (result.empty()) {
-        LOG(LogWarning) << "No display modes found from wlr-randr";
+        LOG(LogWarning) << "No display modes found";
     }
 
     return result;
--- a/es-app/src/guis/GuiMenu.cpp
+++ b/es-app/src/guis/GuiMenu.cpp
@@ -2050,7 +2050,7 @@
             {
                 SystemConf::getInstance()->set("system.display_mode", optionsDisplayModes->getSelected());
                 SystemConf::getInstance()->saveSystemConf();
-                Utils::Platform::runSystemCommand("/usr/bin/sh -lc \". /etc/profile.d/010-wlr-randr; set_refresh_rate "+ optionsDisplayModes->getSelected() + "\"", "", nullptr);
+                Utils::Platform::runSystemCommand("/usr/bin/sh -lc \"set_refresh_rate "+ optionsDisplayModes->getSelected() + "\"", "", nullptr);
             }
         });
     }
