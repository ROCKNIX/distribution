From d9c39ac5fdb2626133de0cfcc07450bc9d697def Mon Sep 17 00:00:00 2001
From: Philippe Simons <simons.philippe@gmail.com>
Date: Sat, 29 Nov 2025 21:13:59 +0100
Subject: [PATCH] wifictl refactoring

enable wifi then connect to network
---
 es-app/src/ApiSystem.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/es-app/src/ApiSystem.cpp b/es-app/src/ApiSystem.cpp
index 22f105372..ae89c501a 100644
--- a/es-app/src/ApiSystem.cpp
+++ b/es-app/src/ApiSystem.cpp
@@ -431,7 +431,13 @@ bool ApiSystem::launchFileManager(Window *window)
 #if !WIN32
 bool ApiSystem::enableWifi(std::string ssid, std::string key, std::string country) 
 {
-	return executeScript("wifictl enable \"" + ssid + "\" \"" + key + "\" \"" + country + "\"");
+	bool ret;
+
+	ret = executeScript("wifictl enable");
+	if (!ret)
+		return ret;
+	
+	return executeScript("wifictl connect \"" + ssid + "\" \"" + key + "\" \"" + country + "\"");
 }
 #else
 bool ApiSystem::enableWifi(std::string ssid, std::string key) 
