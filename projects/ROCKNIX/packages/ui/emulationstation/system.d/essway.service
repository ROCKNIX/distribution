[Unit]
Description=EmulationStation
# This path never exist on rk3566
#ConditionPathExists=/run/rocknix/start.games
Requires=kwin.service
After=kwin.service

[Service]
Type=simple
Environment=HOME=/storage
EnvironmentFile=/etc/profile
ExecStartPre=-/usr/bin/timeout 30 /bin/sh -c "until [ -e /run/rocknix/kwin-ready ]; do sleep 0.1; done"
ExecStart=/usr/bin/start_es.sh
WorkingDirectory=/storage
Restart=always
RestartSec=2

[Install]
WantedBy=rocknix.target