+/// cheats3ds.zip, unpacked), the marks kept by name, and RetroArch gets the same list as the
+/// game's cheat file, which it reads right after retro_load_game (Quick Menu > Cheats).
+namespace LibRetro::SharedCheats {
+
+/// Points Azahar's cheats folder at the shared one; again after every FileUtil::SetUserPath.
+void UseSharedDir();
+
+/// Rebuilds the title's list and hands it to RetroArch. Called from retro_load_game.
+void Prepare(u64 title_id, const std::string& content_path);
+
+/// retro_cheat_reset and retro_cheat_set: RetroArch applies its list as a reset and then one set
+/// per enabled cheat, numbered among the enabled ones only, so a cheat is found by its code.
+void Reset();
+void Set(unsigned index, bool enabled, const char* code);
+
+/// Saves the marks RetroArch changed into <TID>.txt (nothing to do when none changed).
+void Flush();
+
+} // namespace LibRetro::SharedCheats
