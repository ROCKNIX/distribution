 }
@@ -702,6 +804,9 @@ static void DropSavestate() {
 static bool MakeSavestate() {
     if (savestate.has_value())
         return true;
+    // None while the shader cache loads (RetroArch's undo copy before an entry state).
+    if (DiskLoad::InProgress())
+        return false;
     auto& system = Core::System::GetInstance();
     if (!system.IsPoweredOn())
         return false;
@@ -734,6 +839,16 @@ bool retro_serialize(void* data, size_t size) {
 
 bool retro_unserialize(const void* data, size_t size) {
     DropSavestate();
+    std::vector<u8> buffer(static_cast<const u8*>(data), static_cast<const u8*>(data) + size);
+    if (DiskLoad::InProgress()) {
+        DiskLoad::deferred_state = std::move(buffer);
+        DiskLoad::has_deferred_state = true;
+        return true;
+    }
+    return LoadStateNow(std::move(buffer));
+}
+
+static bool LoadStateNow(std::vector<u8> buffer) {
     auto& system = Core::System::GetInstance();
     if (!system.IsPoweredOn())
         return false;
@@ -742,7 +857,6 @@ bool retro_unserialize(const void* data, size_t size) {
         return false;
     }
 
-    std::vector<u8> buffer(static_cast<const u8*>(data), static_cast<const u8*>(data) + size);
     try {
