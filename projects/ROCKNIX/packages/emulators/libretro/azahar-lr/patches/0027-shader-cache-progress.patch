+#include <atomic>
+#include <chrono>
 #include <list>
+#include <thread>
 #include <numeric>
 #include <vector>
 #include <math.h>
@@ -214,6 +217,97 @@ static void UpdateSettings() {
 
 static void DropSavestate();
 
+// dArkOS: the disk shader cache is loaded on a thread of its own from the first retro_run, not in
+// context_reset: a game whose cache another build made compiles every pipeline again (626 of
+// them in Castlevania, a minute here), and inside context_reset RetroArch presents nothing, so the
+// screen stayed black as if the core had hung. While the thread works, retro_run presents the
+// last frame again with RetroArch's progress bar (after a second, so a quick load shows none).
+static bool LoadStateNow(std::vector<u8> buffer);
+
+namespace DiskLoad {
+static std::thread thread;
+static std::atomic_bool pending{false};
+static std::atomic_bool running{false};
+static std::atomic_bool stop{false};
+static std::atomic<int> stage{0};
+static std::atomic<std::size_t> value{0};
+static std::atomic<std::size_t> total{0};
+static std::chrono::steady_clock::time_point started;
+static bool shown = false;
+// A savestate RetroArch loads while the cache loads (an entry state, -e, or one loaded at
+// once from the menu): kept and loaded when the cache is done, not under it.
+static std::vector<u8> deferred_state;
+static bool has_deferred_state = false;
+
+/// True while a load is in progress (started and not yet joined).
+static bool InProgress() {
+    return thread.joinable();
+}
+
+/// Ends a load in progress early (unload, reset).
+static void Stop() {
+    pending = false;
+    stop = true;
+    if (thread.joinable()) {
+        thread.join();
+    }
+    has_deferred_state = false;
+    deferred_state.clear();
+}
+
+static void Start() {
+    stop = false;
+    stage = 0;
+    value = 0;
+    total = 0;
+    started = std::chrono::steady_clock::now();
+    shown = false;
+    running = true;
+    thread = std::thread([] {
+        Core::System::GetInstance().GPU().Renderer().Rasterizer()->LoadDefaultDiskResources(
+            stop, [](VideoCore::LoadCallbackStage s, std::size_t v, std::size_t t,
+                     const std::string&) {
+                stage = static_cast<int>(s);
+                value = v;
+                total = t;
+            });
+        running = false;
+    });
+}
+
+/// True while the load runs: retro_run then presents the progress instead of a frame.
+static bool Busy() {
+    if (pending.exchange(false)) {
+        Start();
+    }
+    if (!thread.joinable()) {
+        return false;
+    }
+    if (!running) {
+        thread.join();
+        if (shown) {
+            LibRetro::DisplayProgress("Shaders ready", 100, 500);
+        }
+        if (has_deferred_state) {
+            has_deferred_state = false;
+            LoadStateNow(std::move(deferred_state));
+            deferred_state.clear();
+        }
+        return false;
+    }
+    if (std::chrono::steady_clock::now() - started > std::chrono::seconds(1)) {
+        const std::size_t v = value, t = total;
+        const bool build = stage == static_cast<int>(VideoCore::LoadCallbackStage::Build);
+        char text[96];
+        std::snprintf(text, sizeof(text), "%s: %zu / %zu",
+                      build ? "Compiling shaders" : "Loading shader cache", v, t);
+        LibRetro::DisplayProgress(text, t ? static_cast<int>(v * 100 / t) : -1, 1000);
+        shown = true;
+    }
+    return true;
+}
+} // namespace DiskLoad
+
 /**
  * libretro callback; Called every game tick.
  */
@@ -227,6 +321,12 @@ void retro_run() {
         return;
     }
 
+    if (DiskLoad::Busy()) {
+        LibRetro::PollInput();
+        LibRetro::UploadVideoFrame(nullptr, 0, 0, 0);
+        return;
+    }
+
