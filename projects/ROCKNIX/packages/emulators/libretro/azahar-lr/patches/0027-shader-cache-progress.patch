+    DiskLoad::Stop();
     Core::System::GetInstance().Shutdown();
     emu_instance->game_loaded = do_load_game();
     emu_instance->first_run_loop = true;
@@ -634,6 +735,7 @@ bool retro_load_game(const struct retro_game_info* info) {
 void retro_unload_game() {
     DropSavestate();
