+bool DisplayProgress(const char* text, int progress, unsigned duration_ms) {
+    retro_message_ext msg{};
+    msg.msg = text;
+    msg.duration = duration_ms;
+    msg.priority = 1;
+    msg.level = RETRO_LOG_INFO;
+    msg.target = RETRO_MESSAGE_TARGET_OSD;
+    msg.type = RETRO_MESSAGE_TYPE_PROGRESS;
+    msg.progress = static_cast<int8_t>(progress);
+    return environ_cb(RETRO_ENVIRONMENT_SET_MESSAGE_EXT, &msg);
+}
