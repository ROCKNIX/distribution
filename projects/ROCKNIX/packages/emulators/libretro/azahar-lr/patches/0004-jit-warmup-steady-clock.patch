From: dArkOS RG52 Mini port
Subject: The JIT warm-up deadline in steady_clock time with libstdc++ too

The frame limiter's Clock is high_resolution_clock: steady_clock in
Android's libc++, system_clock in libstdc++, so handing its time point to
GammaJitWarmStep (a steady_clock one) does not compile here. Pass the same
deadline as steady_clock::now() plus the time left.

diff --git a/src/core/perf_stats.cpp b/src/core/perf_stats.cpp
index 4b381c8..82c43be 100644
--- a/src/core/perf_stats.cpp
+++ b/src/core/perf_stats.cpp
@@ -284,7 +284,9 @@ void FrameLimiter::PaceBeforePresent(microseconds current_system_time_us) {
         // GammaOS JIT warm-up: use the idle wait, leaving 2 ms of slack.
         const auto warm_until = next_deadline - std::chrono::milliseconds(2);
         if (warm_until > now) {
-            Core::System::GetInstance().GammaJitWarmStep(warm_until);
+            Core::System::GetInstance().GammaJitWarmStep(
+                std::chrono::steady_clock::now() +
+                std::chrono::duration_cast<std::chrono::steady_clock::duration>(warm_until - now));
         }
         const auto sleep_start = Clock::now();
         std::this_thread::sleep_until(next_deadline);
