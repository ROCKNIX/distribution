+/// dArkOS: GammaOS switches (environment variables named like their Android properties) that some
+/// games need, set for those games unless the environment sets them already; the core reads each
+/// once, at the game's first GPU work. Castlevania: Lords of Shadow - Mirror of Fate draws the two
+/// eyes object by object, a render pass for each draw on the Mali GPU: stereo_skip leaves the right
+/// eye out (with 3D off it is never shown), and async_gpu_flush_lag lets the GPU worker stay up to
+/// 24 jobs behind at the cache flush the game makes before each command list instead of draining
+/// it there. Its intro on an RG52 Mini: 9.2 fps, 11.1 with the first, 14.4 with both (no flush
+/// wait at all gave the same).
+static void SetTitleSwitches(u64 program_id) {
+    struct TitleSwitch {
+        u64 program_id;
+        const char* name;
+        const char* value;
+    };
+    static constexpr std::array<TitleSwitch, 2> switches{{
+        {0x000400000009E500, "persist_gammaos_azahar_nano_stereo_skip", "1"},
+        {0x000400000009E500, "persist_gammaos_azahar_nano_async_gpu_flush_lag", "24"},
+    }};
+    for (const auto& s : switches) {
+        if (s.program_id == program_id && setenv(s.name, s.value, 0) == 0) {
+            LOG_INFO(Frontend, "title {:016X}: {}={}", program_id, s.name, getenv(s.name));
+        }
+    }
+}
