+// GammaOS: a draw into memory that no recent display transfer to either screen reads from. That is
+// an offscreen pass, typically run once: Pokemon Sun layers a Pokemon's skin into its texture when
+// the scene loads and never touches it again, so with a cold cache the skipped draws left the
+// texture plain red until the game rebuilt it. Such a draw waits for its (software path) pipeline.
+// A target a screen reads from, even partly (Kirby's shared 3D scene target), keeps the fallback,
+// and so does everything before the first screen image, where the sources are not known yet.
+bool RasterizerVulkan::DrawIsOffscreen() const {
+    bool any = false;
+    for (const auto* sources : {&top_sources, &bottom_sources}) {
+        for (const auto& src : *sources) {
+            any |= src.end != 0 && frame_index - src.frame < 600;
+        }
+    }
+    if (!any) {
+        return false;
+    }
+    PAddr first = 0, last = 0;
+    if (!DrawInterval(first, last)) {
+        return false;
+    }
+    for (const auto* sources : {&top_sources, &bottom_sources}) {
+        for (const auto& src : *sources) {
+            if (src.end != 0 && frame_index - src.frame < 600 && first < src.end &&
+                last > src.start) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
