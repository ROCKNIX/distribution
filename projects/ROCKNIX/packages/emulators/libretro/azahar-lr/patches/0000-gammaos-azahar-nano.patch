diff -ruN -x .git -x .github -x android -x 'Android.bp*' -x 'Android.mk*' -x '*.disabled' a/src/video_core/renderer_vulkan/vk_gammaos_game_prop.h b/src/video_core/renderer_vulkan/vk_gammaos_game_prop.h
