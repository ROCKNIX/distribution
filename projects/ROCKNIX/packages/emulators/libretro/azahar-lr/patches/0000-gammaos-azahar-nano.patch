+            t.executed_ticks != l.executed_ticks || t.slice_length != lead_executed ||
+            t.downcount != 0 || t.idled_cycles != static_cast<u64>(lead_executed) ||
+            t.cpu_clock_scale != l.cpu_clock_scale) {
