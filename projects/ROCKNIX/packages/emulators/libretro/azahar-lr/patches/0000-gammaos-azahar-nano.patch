+        if (gptr() < egptr()) {
+            return traits_type::to_int_type(*gptr());
+        }
+        while (!failed) {
+            if (in_pos == in_size && !eof) {
+                in_size = file.ReadBytes(in.data(), in.size());
+                in_pos = 0;
+                eof = in_size == 0;
+            }
+            if (in_pos == in_size && eof) {
+                break;
+            }
+            ZSTD_inBuffer src{in.data(), in_size, in_pos};
+            ZSTD_outBuffer dst{out.data(), out.size(), 0};
