+            auto it = std::find_if(s_wait_sites.begin(), s_wait_sites.end(),
+                                   [site](const WaitSite& w) { return w.site == site; });
+            if (it == s_wait_sites.end()) {
+                s_wait_sites.push_back({site, 1, ms});
+            } else {
+                it->count++;
+                it->ms += ms;
