+    // GammaOS stereo twins: remember fills until something else writes the region.
+    fresh_fills.push_back({fill_surface.addr, fill_surface.end, config.value_32bit,
+                           config.fill_32bit ? 32u : (config.fill_24bit ? 24u : 16u)});
