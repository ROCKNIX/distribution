+void GPU::RegisterVBlank() {
+    impl->vblank_event = impl->Timing().RegisterEvent(
+        "GPU::VBlankCallback",
+        [this](uintptr_t user_data, s64 cycles_late) { VBlankCallback(user_data, cycles_late); });
