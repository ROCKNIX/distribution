+/// dArkOS: GammaOS switches some games need, on for them with the options at Auto. Castlevania:
+/// Lords of Shadow - Mirror of Fate draws the two eyes object by object, a render pass for each
+/// draw on the Mali GPU (stereo_skip leaves the right eye out; with 3D off it is never shown),
+/// and flushes the CPU cache before each command list, where the GPU worker was drained
+/// (async_gpu_flush_lag lets it stay up to 24 jobs behind). Its intro on an RG52 Mini: 9.2 fps,
+/// 11.1 with the first, 14.4 with both, 20.1 with patch 013 on top.
+struct TitleSwitches {
+    u64 program_id;
+    int stereo_skip;
+    int gpu_flush_lag;
+};
+static constexpr std::array<TitleSwitches, 1> title_switches{{
+    {0x000400000009E500, 1, 24}, // Castlevania: Lords of Shadow - Mirror of Fate
+}};
+
+/// What an option at Auto leaves: the title's value, unless the switch's environment variable
+/// (the property, patch 002) is set; that then decides, as before there were options.
+static int AutoSwitch(const char* env, int TitleSwitches::*value) {
+    if (std::getenv(env) != nullptr) {
+        return -1;
+    }
+    for (const auto& t : title_switches) {
+        if (t.program_id == settings.program_id) {
+            return t.*value;
+        }
+    }
+    return -1;
+}
+
+static void ParseStereoSwitches() {
+    const std::string skip = LibRetro::FetchVariable(config::graphics::stereo_skip, "auto");
+    Settings::values.gammaos_stereo_skip =
+        skip == config::enabled    ? 1
+        : skip == config::disabled ? 0
+                                   : AutoSwitch("persist_gammaos_azahar_nano_stereo_skip",
+                                                &TitleSwitches::stereo_skip);
+    const std::string lag = LibRetro::FetchVariable(config::graphics::gpu_flush_lag, "auto");
+    Settings::values.gammaos_async_gpu_flush_lag =
+        lag == "auto" ? AutoSwitch("persist_gammaos_azahar_nano_async_gpu_flush_lag",
+                                   &TitleSwitches::gpu_flush_lag)
+                      : std::atoi(lag.c_str());
+}
+
+void SetTitle(u64 program_id) {
+    settings.program_id = program_id;
+    ParseStereoSwitches();
+    LOG_INFO(Frontend, "title {:016X}: stereo_skip {}, async_gpu_flush_lag {} (-1: property)",
+             program_id, Settings::values.gammaos_stereo_skip.load(),
+             Settings::values.gammaos_async_gpu_flush_lag.load());
+}
+
 static void ParseGraphicsOptions(void) {
     Settings::values.graphics_api =
         GetGraphicsAPI(LibRetro::FetchVariable(config::graphics::graphics_api, "auto"));
@@ -1013,6 +1110,8 @@
