+/// dArkOS: an output stream buffer that compresses what the archive writes as it comes,
+/// onto the end of `out` as one zstd frame; with workers, the compression runs beside the
+/// serialization, and the serialized state is never held whole.
+class ZstdOutBuf final : public std::streambuf {
+public:
+    ZstdOutBuf(std::vector<u8>& out_, int level, int workers)
+        : out{out_}, cctx{ZSTD_createCCtx()} {
+        if (cctx) {
+            ZSTD_CCtx_setParameter(cctx, ZSTD_c_compressionLevel, level);
+            if (ZSTD_isError(ZSTD_CCtx_setParameter(cctx, ZSTD_c_nbWorkers, workers))) {
+                LOG_WARNING(Core, "save state: zstd without threads");
+            }
+        }
+        buf.resize(1 << 20);
+        tmp.resize(ZSTD_CStreamOutSize());
+        setp(buf.data(), buf.data() + buf.size());
+    }
+    ~ZstdOutBuf() override {
+        ZSTD_freeCCtx(cctx);
+    }
+    /// Ends the frame; call once the archive is done.
+    bool Finish() {
+        return Push(ZSTD_e_end) && !failed;
+    }
+    std::size_t In() const {
+        return total;
+    }
+
+protected:
+    int_type overflow(int_type ch) override {
+        if (!Push(ZSTD_e_continue)) {
+            return traits_type::eof();
+        }
+        if (!traits_type::eq_int_type(ch, traits_type::eof())) {
+            *pptr() = traits_type::to_char_type(ch);
+            pbump(1);
+        }
+        return traits_type::not_eof(ch);
+    }
+    std::streamsize xsputn(const char* data, std::streamsize count) override {
+        // big blocks (the memories) go to zstd as they are, without a copy into buf
+        if (count >= static_cast<std::streamsize>(buf.size())) {
+            if (!Push(ZSTD_e_continue) ||
+                !Feed(data, static_cast<std::size_t>(count), ZSTD_e_continue)) {
+                return 0;
+            }
+            return count;
+        }
+        return std::streambuf::xsputn(data, count);
+    }
+
+private:
+    bool Push(ZSTD_EndDirective mode) {
+        const bool ok = Feed(pbase(), static_cast<std::size_t>(pptr() - pbase()), mode);
+        setp(buf.data(), buf.data() + buf.size());
+        return ok;
+    }
+    bool Feed(const char* data, std::size_t n, ZSTD_EndDirective mode) {
+        if (failed || !cctx) {
+            failed = true;
+            return false;
+        }
+        total += n;
+        ZSTD_inBuffer src{data, n, 0};
+        for (;;) {
+            ZSTD_outBuffer dst{tmp.data(), tmp.size(), 0};
+            const std::size_t remaining = ZSTD_compressStream2(cctx, &dst, &src, mode);
+            if (ZSTD_isError(remaining)) {
+                LOG_ERROR(Core, "save state: compression failed: {}",
+                          ZSTD_getErrorName(remaining));
+                failed = true;
+                return false;
+            }
+            out.insert(out.end(), tmp.data(), tmp.data() + dst.pos);
+            if (mode == ZSTD_e_end ? remaining == 0 : src.pos == src.size) {
+                return true;
+            }
+        }
+    }
+
+    std::vector<u8>& out;
+    ZSTD_CCtx* cctx;
+    std::vector<char> buf;
+    std::vector<u8> tmp;
+    std::size_t total = 0;
+    bool failed = false;
+};
+
+/// dArkOS: a zstd stream held in memory, decompressed as the archive reads it; the whole
+/// decompressed state is never held.
+class ZstdMemInBuf final : public std::streambuf {
+public:
+    explicit ZstdMemInBuf(std::span<const u8> src_) : src{src_}, dctx{ZSTD_createDCtx()} {
+        out.resize(ZSTD_DStreamOutSize());
+        setg(out.data(), out.data(), out.data());
+    }
+    ~ZstdMemInBuf() override {
+        ZSTD_freeDCtx(dctx);
+    }
+    bool Failed() const {
+        return failed || !dctx;
+    }
+
+protected:
+    int_type underflow() override {
+        if (gptr() < egptr()) {
+            return traits_type::to_int_type(*gptr());
+        }
+        while (!failed && dctx) {
+            ZSTD_inBuffer in{src.data(), src.size(), pos};
+            ZSTD_outBuffer dst{out.data(), out.size(), 0};
+            const std::size_t ret = ZSTD_decompressStream(dctx, &dst, &in);
+            pos = in.pos;
+            if (ZSTD_isError(ret)) {
+                LOG_ERROR(Core, "save state: decompression failed: {}", ZSTD_getErrorName(ret));
+                failed = true;
+                break;
+            }
+            if (dst.pos > 0) {
+                setg(out.data(), out.data(), out.data() + dst.pos);
+                return traits_type::to_int_type(*gptr());
+            }
+            if (pos == src.size()) {
+                break;
+            }
+        }
+        return traits_type::eof();
+    }
+
+private:
+    std::span<const u8> src;
+    std::size_t pos = 0;
+    ZSTD_DCtx* dctx;
+    std::vector<char> out;
+    bool failed = false;
+};
+
