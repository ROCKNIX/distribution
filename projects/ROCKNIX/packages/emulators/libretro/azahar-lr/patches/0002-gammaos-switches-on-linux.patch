diff --git a/darkos/linux/sys/system_properties.h b/darkos/linux/sys/system_properties.h
new file mode 100755
index 0000000..b40ebe1
--- /dev/null
+++ b/darkos/linux/sys/system_properties.h
@@ -0,0 +1,44 @@
+// Copyright 2026 dArkOS RG52 Mini port
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// Linux stand-in for Android's <sys/system_properties.h>. The GammaOS changes read their
+// switches from Android properties (persist.gammaos.azahar_nano.<name>, sys.gammaos...);
+// here a property is the environment variable named like it with dots as underscores,
+// e.g. persist_gammaos_azahar_nano_fastmem=0. Unset reads as an empty value, as an unset
+// property does, so every switch keeps its default.
+
+#pragma once
+
+#include <stdlib.h>
+#include <string.h>
+
+#define PROP_NAME_MAX 32
+#define PROP_VALUE_MAX 92
+
+static inline void darkos_property_env_name(const char* name, char* env, size_t size) {
+    size_t i = 0;
+    for (; name[i] != '\0' && i + 1 < size; i++) {
+        env[i] = name[i] == '.' ? '_' : name[i];
+    }
+    env[i] = '\0';
+}
+
+static inline int __system_property_get(const char* name, char* value) {
+    char env[128];
+    darkos_property_env_name(name, env, sizeof(env));
+    const char* v = getenv(env);
+    if (v == NULL) {
+        value[0] = '\0';
+        return 0;
+    }
+    strncpy(value, v, PROP_VALUE_MAX - 1);
+    value[PROP_VALUE_MAX - 1] = '\0';
+    return (int)strlen(value);
+}
+
+static inline int __system_property_set(const char* name, const char* value) {
+    char env[128];
+    darkos_property_env_name(name, env, sizeof(env));
+    return setenv(env, value, 1);
+}
