From: dArkOS RG52 Mini port
Subject: Realtime audio as a core option

Azahar's enable_realtime_audio makes the HLE DSP's audio tick follow the
frame time (clamped to 0.25-4 by GammaOS), so a game running below full
speed still produces about a frame's worth of sound per frame of real time:
the sound plays at its pace instead of breaking up, and can run ahead of the
picture. GammaOS's frontend turns it on by default since 0e442662ca4. Under
RetroArch, which paces the audio itself, it is an option (Audio > Realtime
Audio), on by default: the owner listened to Castlevania's intro (21 fps)
both ways, and with it the sound is much better.

--- a/src/citra_libretro/core_settings.cpp
+++ b/src/citra_libretro/core_settings.cpp
@@ -53,6 +53,7 @@
 namespace audio {
 static constexpr const char* audio_emulation = citra_setting(BaseKeys::audio_emulation);
 static constexpr const char* input_type = citra_setting(BaseKeys::input_type);
+static constexpr const char* enable_realtime_audio = citra_setting(BaseKeys::enable_realtime_audio);
 } // namespace audio
 
 namespace graphics {
@@ -283,6 +284,22 @@
         },
         "auto"
     },
+    {
+        config::audio::enable_realtime_audio,
+        "Realtime Audio",
+        "Realtime Audio",
+        "When the game runs slower than full speed, play its sound at real time instead of "
+        "slowing it down with the game: the sound does not break up, but it can run ahead of "
+        "the picture. HLE audio only.",
+        nullptr,
+        config::category::audio,
+        {
+            { config::enabled, "Enabled" },
+            { config::disabled, "Disabled" },
+            { nullptr, nullptr }
+        },
+        config::enabled
+    },
 
     // Graphics Category
     {
@@ -978,6 +995,12 @@
     } else {
         Settings::values.input_type = AudioCore::InputType::Auto;
     }
+
+    // dArkOS: the DSP's audio tick follows the frame time (hle.cpp), so a game below full speed
+    // still hands RetroArch about a frame's worth of sound per frame of real time.
+    Settings::values.enable_realtime_audio =
+        LibRetro::FetchVariable(config::audio::enable_realtime_audio, config::enabled) ==
+        config::enabled;
 }
 
