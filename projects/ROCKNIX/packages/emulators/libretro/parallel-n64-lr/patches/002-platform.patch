diff --git a/Makefile b/Makefile
index bca3454e..a00977d7 100644
--- a/Makefile
+++ b/Makefile
@@ -60,6 +60,8 @@ else ifneq (,$(findstring rpi,$(platform)))
    override platform += unix
 else ifneq (,$(findstring odroid,$(platform)))
    override platform += unix
+else ifneq (,$(findstring @DEVICE@,$(platform)))
+   override platform += unix
 endif
 
 # system platform
@@ -171,6 +173,20 @@ ifneq (,$(findstring unix,$(platform)))
 
    endif
    
+   #@DEVICE@
+   ifneq (,$(findstring @DEVICE@,$(platform)))
+     ifeq (,$(findstring AMD64,$(platform)))
+       TARGET := $(TARGET_NAME)_libretro.so
+       CPUFLAGS += -DARM_FIX -DCLASSIC -DARM64
+       WITH_DYNAREC = aarch64
+     endif
+   endif
+   #AMD64
+   ifneq (,$(findstring AMD64,$(platform)))
+     TARGET := $(TARGET_NAME)_libretro.so
+     WITH_DYNAREC = x86
+   endif
+
    # ODROIDs
    ifneq (,$(findstring odroid,$(platform)))
       BOARD ?= $(shell cat /proc/cpuinfo | grep -i odroid | awk '{print $$3}')
