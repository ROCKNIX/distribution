From 53638e182bd21fceb3ac362d00e6afb1c075dbb5 Mon Sep 17 00:00:00 2001
From: Zhenyu Qi <qzydustin@hotmail.com>
Date: Fri, 9 Oct 2026 03:25:19 -0700
Subject: [PATCH 15/15] menu: the video filter rows set video up for what it is
 then given

Choosing a CPU video filter while content runs sets the video driver up
again, as removing one does: the driver was set up for the core's frame,
not the filter's scale and pixel format, so gl showed the last
unfiltered frame and ntsc_crt came out garbled on gl, glcore and vulkan.

Video Filter Enable in the menu now does what the toggle hotkey does:
the driver is set up again when the loaded filter outputs another pixel
format than the core's (ntsc_crt), and the toggle stays instant when it
does not.

(cherry picked from commit ce362265c6d79a01bf179d17140f5c1b86aaba0e,
menu part only: the filter path row is set up in menu_setting.c in this
version, and the test harness is left out)
---
 menu/menu_setting.c | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/menu/menu_setting.c b/menu/menu_setting.c
index 886c2bc627..ff70c9a98b 100644
--- a/menu/menu_setting.c
+++ b/menu/menu_setting.c
@@ -8777,6 +8777,15 @@ static void general_write_handler(rarch_setting_t *setting)
             }
          }
          break;
+#endif
+#ifdef HAVE_VIDEO_FILTER
+      case MENU_ENUM_LABEL_VIDEO_FILTER_ENABLE:
+         /* As the toggle hotkey: instant while the filter keeps the
+          * core's pixel format, the driver set up again for one that
+          * changes it (ntsc_crt) */
+         if (video_driver_filter_changes_format())
+            rarch_cmd = CMD_EVENT_REINIT;
+         break;
 #endif
       case MENU_ENUM_LABEL_VIDEO_SCALE:
          settings->flags                  |= SETTINGS_FLG_MODIFIED;
@@ -14881,7 +14890,7 @@ static bool setting_append_list(
                &setting_get_string_representation_video_filter;
             MENU_SETTINGS_LIST_CURRENT_ADD_VALUES(list, list_info, "filt");
             MENU_SETTINGS_LIST_CURRENT_ADD_CMD(list, list_info,
-                  CMD_EVENT_VIDEO_FILTER_INIT);
+                  CMD_EVENT_REINIT);
             SETTINGS_DATA_LIST_CURRENT_ADD_FLAGS(list, list_info, SD_FLAG_LAKKA_ADVANCED);
 
             END_SUB_GROUP(list, list_info, parent_group);
