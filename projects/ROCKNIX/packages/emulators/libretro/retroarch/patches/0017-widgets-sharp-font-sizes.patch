+
+   RARCH_LOG("[Widgets] font %s: %s, computed %.2f px, floor %.0f, %s%s, drawn %u px\n",
+         (font_data == &p_dispwidget->gfx_widget_fonts.msg_queue) ? "msg_queue"
+         : (font_data == &p_dispwidget->gfx_widget_fonts.bold)    ? "bold" : "regular",
+         font_path ? font_path : "",
+         computed_size, min_size,
+         face  ? "sharp-size table " : (sharp ? "no sharp-size table for this face" : "no sharp-size step"),
+         face  ? face->name : "",
+         (unsigned)scaled_size);
+
    /* Free existing font */
    if (font_data->font)
    {
@@ -986,11 +1101,11 @@ static void gfx_widgets_layout(
       /* Create regular font */
       gfx_widgets_font_init(p_disp, p_dispwidget,
             &p_dispwidget->gfx_widget_fonts.regular,
-            is_threaded, p_dispwidget->ozone_regular_font_path, BASE_FONT_SIZE, 9.0f);
+            is_threaded, p_dispwidget->ozone_regular_font_path, BASE_FONT_SIZE, 9.0f, true);
       /* Create bold font */
       gfx_widgets_font_init(p_disp, p_dispwidget,
             &p_dispwidget->gfx_widget_fonts.bold,
-            is_threaded, p_dispwidget->ozone_bold_font_path, BASE_FONT_SIZE, 9.0f);
+            is_threaded, p_dispwidget->ozone_bold_font_path, BASE_FONT_SIZE, 9.0f, true);
 
