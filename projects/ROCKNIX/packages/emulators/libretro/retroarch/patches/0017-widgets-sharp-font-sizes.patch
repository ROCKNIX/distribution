@@ -1010,22 +1125,28 @@ static void gfx_widgets_layout(
             strlcpy(font_file, p_dispwidget->ozone_regular_font_path, sizeof(font_file));
             break;
       }
+      /* ROCKNIX: the message queue takes no sharp step, in either branch:
