         final_path = system_path.string().substr(0, system_path.string().find_last_of('/'));
         break;
     }
+    case VitaIoDevice::savedata0:
+    case VitaIoDevice::savedata1: {
+        // Save data is stored on a case insensitive filesystem on hardware.
