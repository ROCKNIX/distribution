# Map hotkey + left shoulder (L1) to quickload (Alt+L)
l1_hk = l
l1_hk = add_alt

# Map hotkey + right shoulder (R1) to quicksave (Alt+S)
r1_hk = s
r1_hk = add_alt

# Map hotkey + left trigger (L2) to swap screens (F9)
l2_hk = f9

# Map hotkey + right trigger (R2) to turbo mode (Ctrl+T)
r2_hk = t
r2_hk = add_ctrl

# No Enter/Esc on hotkey + face buttons (Esc leaves fullscreen)
a_hk = \\
