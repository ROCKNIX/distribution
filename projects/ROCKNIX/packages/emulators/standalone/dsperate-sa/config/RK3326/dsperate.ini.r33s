# Game Console R33S: no sticks. Hold L2 to move the pen with the d-pad, R2 touches.

[user]
nickname = ROCKNIX              # up to 10 characters
message =                       # up to 26 characters
birthday_month = 1
birthday_day = 1
colour = 2                      # 0 grey, 1 brown, 2 red, 3 pink, 4 orange, 5 yellow, 6 lime,
                                # 7 green, 8 dark green, 9 turquoise, 10 blue, 11 dark blue,
                                # 12 purple, 13 violet, 14 magenta, 15 dark pink

[paths]
bios9 = /storage/roms/bios/bios9.bin
bios7 = /storage/roms/bios/bios7.bin
firmware = /storage/roms/bios/firmware.bin
bios9i = /storage/roms/bios/dsi_bios9.bin
bios7i = /storage/roms/bios/dsi_bios7.bin
dsi_firmware = /storage/roms/bios/dsi_firmware.bin
dsi_nand = /storage/roms/bios/dsi_nand.bin
games = /storage/roms/nds
dsi_shortcuts = /storage/roms/ndsiware
saves = /storage/roms/nds
screenshots = /storage/roms/screenshots
states = /storage/roms/savestates/nds
cache = /storage/.cache/dsperate

[loader]

[video]
fullscreen = true
layout = horizontal
vsync = true

[audio]

[cart]

[emu]

[keys]

[pad]
a = a
b = b
x = x
y = y
stick_dpad = none
stylus_axis = none
stylus_dpad = +lefttrigger
stylus_button = +righttrigger

[hotkeys]

[padhotkeys]
modifier = back
quit = mod+start
pause = mod+x
fast_forward = mod+b
fast_forward_toggle = mod++righttrigger
save_state = mod+rightshoulder
load_state = mod+leftshoulder
slot_next = mod+dpright
slot_prev = mod+dpleft
layout_next = mod+dpup
layout_prev = mod+dpdown
screen_swap = mod++lefttrigger
mic = none
fps = mod+y

[cheevos]
enabled = false
