@@ -198,6 +198,11 @@ static WindowSystemInfo GetWindowSystemInfo(QWindow* window)
   wsi.render_surface = wsi.render_window;
 #endif
   wsi.render_surface_scale = window ? static_cast<float>(window->devicePixelRatio()) : 1.0f;
+  if (window)
+  {
+    wsi.render_surface_width = static_cast<int>(window->width() * window->devicePixelRatio());
+    wsi.render_surface_height = static_cast<int>(window->height() * window->devicePixelRatio());
