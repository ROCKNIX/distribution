+#include <poll.h>
 #include <unistd.h>
 
 #include "DolphinNoGUI/Platform.h"
@@ -354,6 +355,16 @@
 
 void PlatformWayland::ProcessEvents()
 {
+  // wl_display_dispatch_pending() alone never reads the socket, so configure events sent
+  // after startup (e.g. the tiled size once EmulationStation hides) were never seen.
+  while (wl_display_prepare_read(m_display) != 0)
+    wl_display_dispatch_pending(m_display);
+  wl_display_flush(m_display);
+  pollfd pfd = {wl_display_get_fd(m_display), POLLIN, 0};
+  if (poll(&pfd, 1, 0) > 0)
+    wl_display_read_events(m_display);
+  else
+    wl_display_cancel_read(m_display);
   wl_display_dispatch_pending(m_display);
 }
 }  // namespace
