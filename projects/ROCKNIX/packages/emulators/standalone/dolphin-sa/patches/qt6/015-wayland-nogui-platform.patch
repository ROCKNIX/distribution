diff --git a/Source/Core/DolphinNoGUI/CMakeLists.txt b/Source/Core/DolphinNoGUI/CMakeLists.txt
index 9dad1b5f86..1b8e16ce45 100644
--- a/Source/Core/DolphinNoGUI/CMakeLists.txt
+++ b/Source/Core/DolphinNoGUI/CMakeLists.txt
@@ -10,6 +10,32 @@ if(X11_FOUND)
   target_link_libraries(dolphin-nogui PRIVATE PkgConfig::XRANDR PkgConfig::X11)
 endif()
 
+if(ENABLE_WAYLAND AND WAYLAND_FOUND)
+  # Generate the xdg-shell and xdg-decoration client protocols at build time.
+  set(WAYLAND_PROTOCOL_SRCS "")
+  function(dolphin_add_wayland_protocol xml basename)
+    set(header "${CMAKE_CURRENT_BINARY_DIR}/wayland-${basename}-client-protocol.h")
+    set(code "${CMAKE_CURRENT_BINARY_DIR}/wayland-${basename}-protocol.c")
+    add_custom_command(OUTPUT "${header}"
+      COMMAND "${WAYLAND_SCANNER_EXECUTABLE}" client-header "${xml}" "${header}"
+      DEPENDS "${xml}" VERBATIM)
+    add_custom_command(OUTPUT "${code}"
+      COMMAND "${WAYLAND_SCANNER_EXECUTABLE}" private-code "${xml}" "${code}"
+      DEPENDS "${xml}" VERBATIM)
+    set(WAYLAND_PROTOCOL_SRCS ${WAYLAND_PROTOCOL_SRCS} "${header}" "${code}" PARENT_SCOPE)
+  endfunction()
+
+  dolphin_add_wayland_protocol(
+    "${WAYLAND_PROTOCOLS_DIR}/stable/xdg-shell/xdg-shell.xml" xdg-shell)
+  dolphin_add_wayland_protocol(
+    "${WAYLAND_PROTOCOLS_DIR}/unstable/xdg-decoration/xdg-decoration-unstable-v1.xml"
+    xdg-decoration)
+
+  target_sources(dolphin-nogui PRIVATE PlatformWayland.cpp ${WAYLAND_PROTOCOL_SRCS})
+  target_include_directories(dolphin-nogui PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
+  target_link_libraries(dolphin-nogui PRIVATE PkgConfig::WAYLAND)
+endif()
+
 if(WIN32)
   target_sources(dolphin-nogui PRIVATE PlatformWin32.cpp)
 endif()
