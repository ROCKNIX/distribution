From: sunshineinabox <aqemail@gmail.com>
Date: Sun, 20 Sep 2026 13:06:18 -0700
Subject: [PATCH] DolphinQt: size the render surface with the widget's device pixel ratio

On Wayland the screen's device pixel ratio is the output scale rounded
up. When the compositor shrinks the output and hints the render surface
a fractional scale of 1, the backbuffer came out twice the window size
or more. Use the widget's ratio instead, which follows the fractional
scale.

--- a/Source/Core/DolphinQt/RenderWidget.cpp
+++ b/Source/Core/DolphinQt/RenderWidget.cpp
@@ -52,7 +52,7 @@ RenderWidget::RenderWidget(QWidget* parent) : QWidget(parent)
     if (!Config::Get(Config::MAIN_RENDER_WINDOW_AUTOSIZE) || isFullScreen() || isMaximized())
       return;
 
-    const auto dpr = window()->windowHandle()->screen()->devicePixelRatio();
+    const auto dpr = devicePixelRatioF();
 
     resize(w / dpr, h / dpr);
   });
@@ -208,9 +208,8 @@ void RenderWidget::showFullScreen()
 {
   QWidget::showFullScreen();
 
-  QScreen* screen = window()->windowHandle()->screen();
-
-  const auto dpr = screen->devicePixelRatio();
+  // on Wayland the screen's ratio is the output scale rounded up
+  const auto dpr = devicePixelRatioF();
 
   emit SizeChanged(width() * dpr, height() * dpr);
 }
@@ -477,9 +476,7 @@ bool RenderWidget::event(QEvent* event)
     const QResizeEvent* se = static_cast<QResizeEvent*>(event);
     QSize new_size = se->size();
 
-    QScreen* screen = window()->windowHandle()->screen();
-
-    const float dpr = screen->devicePixelRatio();
+    const float dpr = devicePixelRatioF();
     const int width = new_size.width() * dpr;
     const int height = new_size.height() * dpr;
 
