From: ROCKNIX <maintainers@rocknix.org>
Subject: [PATCH] ThunkLibs: keep foreign-arch sysroot out of interface parses

Extend the REMOVE_ITEM guard to the sysrooted include path so the x86 guest parses never read the host arch's glibc.

diff --git a/ThunkLibs/HostLibs/CMakeLists.txt b/ThunkLibs/HostLibs/CMakeLists.txt
--- a/ThunkLibs/HostLibs/CMakeLists.txt
+++ b/ThunkLibs/HostLibs/CMakeLists.txt
@@ -13,6 +13,13 @@
   pkg_check_modules(PKG QUIET ${pkg})
   if (PKG_FOUND)
     list(REMOVE_ITEM PKG_INCLUDE_DIRS /usr/include)
+    # the guest parse must take its standard headers from its own --sysroot
+    if (CMAKE_SYSROOT)
+      list(REMOVE_ITEM PKG_INCLUDE_DIRS ${CMAKE_SYSROOT}/usr/include)
+    endif()
+    if (DEFINED ENV{PKG_CONFIG_SYSROOT_DIR})
+      list(REMOVE_ITEM PKG_INCLUDE_DIRS "$ENV{PKG_CONFIG_SYSROOT_DIR}/usr/include")
+    endif()
     target_include_directories(${target} INTERFACE ${PKG_INCLUDE_DIRS})
   elseif (ARGN)
     target_include_directories(${target} INTERFACE ${ARGN})
@@ -137,6 +145,12 @@
 
   generate(libdrm ${CMAKE_CURRENT_SOURCE_DIR}/../libdrm/libdrm_interface.cpp ${GUEST_BITNESS})
   target_include_directories_from_pkgconfig(libdrm-${GUEST_BITNESS}-deps libdrm /usr/include/drm /usr/include/libdrm)
+  if (CMAKE_SYSROOT)
+    target_include_directories(libdrm-${GUEST_BITNESS}-deps INTERFACE
+      ${CMAKE_SYSROOT}/usr/include/drm
+      ${CMAKE_SYSROOT}/usr/include/libdrm
+    )
+  endif()
   add_host_lib(drm ${GUEST_BITNESS})
 endforeach()
 
@@ -155,6 +169,9 @@
   generate(libwayland-client ${CMAKE_CURRENT_SOURCE_DIR}/../libwayland-client/libwayland-client_interface.cpp ${GUEST_BITNESS})
   add_host_lib(wayland-client ${GUEST_BITNESS})
   target_include_directories_from_pkgconfig(libwayland-client-${GUEST_BITNESS}-deps wayland-client /usr/include/wayland)
+  if (CMAKE_SYSROOT)
+    target_include_directories(libwayland-client-${GUEST_BITNESS}-deps INTERFACE ${CMAKE_SYSROOT}/usr/include/wayland)
+  endif()
 
   generate(libEGL ${CMAKE_CURRENT_SOURCE_DIR}/../libEGL/libEGL_interface.cpp ${GUEST_BITNESS})
   target_include_directories_from_pkgconfig(libEGL-${GUEST_BITNESS}-deps egl)
diff --git a/ThunkLibs/GuestLibs/CMakeLists.txt b/ThunkLibs/GuestLibs/CMakeLists.txt
--- a/ThunkLibs/GuestLibs/CMakeLists.txt
+++ b/ThunkLibs/GuestLibs/CMakeLists.txt
@@ -12,6 +12,13 @@
   pkg_check_modules(PKG QUIET ${pkg})
   if (PKG_FOUND)
     list(REMOVE_ITEM PKG_INCLUDE_DIRS /usr/include)
+    # the guest parse must take its standard headers from its own --sysroot
+    if (CMAKE_SYSROOT)
+      list(REMOVE_ITEM PKG_INCLUDE_DIRS ${CMAKE_SYSROOT}/usr/include)
+    endif()
+    if (DEFINED ENV{PKG_CONFIG_SYSROOT_DIR})
+      list(REMOVE_ITEM PKG_INCLUDE_DIRS "$ENV{PKG_CONFIG_SYSROOT_DIR}/usr/include")
+    endif()
     target_include_directories(${target} INTERFACE ${PKG_INCLUDE_DIRS})
   elseif (ARGN)
     target_include_directories(${target} INTERFACE ${ARGN})
