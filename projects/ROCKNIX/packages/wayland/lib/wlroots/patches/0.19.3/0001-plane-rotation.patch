+				set_plane_in_fence_fd(atom, crtc->primary, state->primary_in_fence_fd);
+			}
 		}
-		if (state->primary_in_fence_fd >= 0) {
-			set_plane_in_fence_fd(atom, crtc->primary, state->primary_in_fence_fd);
-		}
