diff -ruN pristine/types/output/output.c stepA/types/output/output.c
--- a/types/output/output.c	2026-03-19 12:13:09
+++ b/types/output/output.c	2026-09-22 23:01:47
@@ -8,6 +8,7 @@
 #include <wlr/types/wlr_compositor.h>
 #include <wlr/types/wlr_output_layer.h>
 #include <wlr/util/log.h>
+#include <wlr/util/transform.h>
 #include "types/wlr_output.h"
 #include "util/env.h"
 #include "util/global.h"
@@ -474,6 +475,39 @@
 	return wl_container_of(output->modes.next, mode, link);
 }
 
+bool output_offload_transform(struct wlr_output *output) {
+	// captures read the committed buffer and expect it in output orientation
+	return output->transform != WL_OUTPUT_TRANSFORM_NORMAL &&
+		!output->offload_transform_failed &&
+		output->attach_render_locks == 0 &&
+		getenv("WLR_OUTPUT_ROTATE_PLANE") != NULL;
+}
+
+void output_offload_transform_failed(struct wlr_output *output) {
+	if (output->offload_transform_failed) {
+		return;
+	}
+	wlr_log(WLR_ERROR, "Output '%s': plane rejected the offloaded transform, "
+		"compositing the rotation instead", output->name);
+	output->offload_transform_failed = true;
+	output_offload_transform_changed(output);
+}
+
+void output_offload_transform_changed(struct wlr_output *output) {
+	// the render buffer changes orientation, redraw everything
+	int width, height;
+	wlr_output_transformed_resolution(output, &width, &height);
+	pixman_region32_t damage;
+	pixman_region32_init_rect(&damage, 0, 0, width, height);
+	struct wlr_output_event_damage event = {
+		.output = output,
+		.damage = &damage,
+	};
+	wl_signal_emit_mutable(&output->events.damage, &event);
+	pixman_region32_fini(&damage);
+	wlr_output_schedule_frame(output);
+}
+
 void output_pending_resolution(struct wlr_output *output,
 		const struct wlr_output_state *state, int *width, int *height) {
 	if (state->committed & WLR_OUTPUT_STATE_MODE) {
@@ -481,16 +515,21 @@
 		case WLR_OUTPUT_STATE_MODE_FIXED:
 			*width = state->mode->width;
 			*height = state->mode->height;
-			return;
+			break;
 		case WLR_OUTPUT_STATE_MODE_CUSTOM:
 			*width = state->custom_mode.width;
 			*height = state->custom_mode.height;
-			return;
+			break;
+		default:
+			abort();
 		}
-		abort();
 	} else {
 		*width = output->width;
 		*height = output->height;
+	}
+
+	if (output_offload_transform(output)) {
+		wlr_output_transform_coords(output->transform, width, height);
 	}
 }
 
diff -ruN pristine/types/output/render.c stepA/types/output/render.c
--- a/types/output/render.c	2026-03-19 12:13:09
+++ b/types/output/render.c	2026-09-22 23:01:47
@@ -133,11 +133,15 @@
 }
 
 void wlr_output_lock_attach_render(struct wlr_output *output, bool lock) {
+	bool offload = output_offload_transform(output);
 	if (lock) {
 		++output->attach_render_locks;
 	} else {
 		assert(output->attach_render_locks > 0);
 		--output->attach_render_locks;
+	}
+	if (output_offload_transform(output) != offload) {
+		output_offload_transform_changed(output);
 	}
 	wlr_log(WLR_DEBUG, "%s direct scan-out on output '%s' (locks: %d)",
 		lock ? "Disabling" : "Enabling", output->name,
