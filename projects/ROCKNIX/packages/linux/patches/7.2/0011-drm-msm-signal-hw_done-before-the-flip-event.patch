From: sunshineinabox <aqemail@gmail.com>
Date: Thu, 17 Sep 2026 11:08:57 -0700
Subject: [PATCH] drm/msm: signal hw_done before sending the page-flip event

--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -755,6 +755,10 @@ void dpu_crtc_complete_commit(struct drm_crtc *crtc)
 {
 	trace_dpu_crtc_complete_commit(DRMID(crtc));
 	dpu_core_perf_crtc_update(crtc, 0);
+}
+
+void dpu_crtc_complete_flip(struct drm_crtc *crtc)
+{
 	_dpu_crtc_complete_flip(crtc);
 }
 
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.h
@@ -250,6 +250,8 @@ void dpu_crtc_commit_kickoff(struct drm_crtc *crtc);
 
 void dpu_crtc_complete_commit(struct drm_crtc *crtc);
 
+void dpu_crtc_complete_flip(struct drm_crtc *crtc);
+
 struct drm_crtc *dpu_crtc_init(struct drm_device *dev, struct drm_plane *plane,
 			       struct drm_plane *cursor);
 
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -489,6 +489,15 @@ static void dpu_kms_complete_commit(struct msm_kms *kms, unsigned crtc_mask)
 	DPU_ATRACE_END("kms_complete_commit");
 }
 
+static void dpu_kms_complete_flip(struct msm_kms *kms, unsigned crtc_mask)
+{
+	struct dpu_kms *dpu_kms = to_dpu_kms(kms);
+	struct drm_crtc *crtc;
+
+	for_each_crtc_mask(dpu_kms->dev, crtc, crtc_mask)
+		dpu_crtc_complete_flip(crtc);
+}
+
 static void dpu_kms_wait_for_commit_done(struct msm_kms *kms,
 		struct drm_crtc *crtc)
 {
@@ -1078,6 +1087,7 @@ static const struct msm_kms_funcs kms_funcs = {
 	.flush_commit    = dpu_kms_flush_commit,
 	.wait_flush      = dpu_kms_wait_flush,
 	.complete_commit = dpu_kms_complete_commit,
+	.complete_flip   = dpu_kms_complete_flip,
 	.enable_vblank   = dpu_kms_enable_vblank,
 	.disable_vblank  = dpu_kms_disable_vblank,
 	.destroy         = dpu_kms_destroy,
--- a/drivers/gpu/drm/msm/msm_atomic.c
+++ b/drivers/gpu/drm/msm/msm_atomic.c
@@ -94,6 +94,8 @@ static void msm_atomic_async_commit(struct msm_kms *kms, int crtc_idx)
 	vblank_put(kms, crtc_mask);
 
 	kms->funcs->complete_commit(kms, crtc_mask);
+	if (kms->funcs->complete_flip)
+		kms->funcs->complete_flip(kms, crtc_mask);
 	unlock_crtcs(kms, crtc_mask);
 	kms->funcs->disable_commit(kms);
 
@@ -315,9 +317,17 @@ fallback:
 	lock_crtcs(kms, crtc_mask);
 	kms->funcs->complete_commit(kms, crtc_mask);
 	unlock_crtcs(kms, crtc_mask);
-	kms->funcs->disable_commit(kms);
 
+
 	drm_atomic_helper_commit_hw_done(state);
+
+	if (kms->funcs->complete_flip) {
+		lock_crtcs(kms, crtc_mask);
+		kms->funcs->complete_flip(kms, crtc_mask);
+		unlock_crtcs(kms, crtc_mask);
+	}
+	kms->funcs->disable_commit(kms);
+
 	drm_atomic_helper_cleanup_planes(dev, state);
 
 	trace_msm_atomic_commit_tail_finish(async, crtc_mask);
--- a/drivers/gpu/drm/msm/msm_kms.h
+++ b/drivers/gpu/drm/msm/msm_kms.h
@@ -97,6 +97,8 @@ struct msm_kms_funcs {
 	 */
 	void (*complete_commit)(struct msm_kms *kms, unsigned crtc_mask);
 
+	void (*complete_flip)(struct msm_kms *kms, unsigned crtc_mask);
+
 	/*
 	 * Format handling:
 	 */
