From: tiopex <tiopxyz@gmail.com>
Subject: [PATCH] clk: qcom: blank DSI panels before dispcc parks boot clocks

The bootloader leaves splash on. PLL configure drops PLL_OUTCTRL and
clk_rcg2_shared_ops parks the MDP RCG to XO; both glitch any panel
that is still emitting.

Hold every qcom,mdss-dsi-ctrl child reset GPIO (DT polarity) and wait
one frame before those calls, then release after clock registration
so the panel driver can take them. Shared helper;

---
 drivers/clk/qcom/common.c        |  62 ++++++++++++++++++++++++++++++++++++++++
 drivers/clk/qcom/common.h        |  11 +++++++++++
 drivers/clk/qcom/dispcc-sm8250.c |   8 ++++++++
 drivers/clk/qcom/dispcc-sm8550.c |   6 ++++++
 drivers/clk/qcom/dispcc-sm8750.c |   6 ++++++
 5 files changed, 93 insertions(+)

diff --git a/drivers/clk/qcom/common.c b/drivers/clk/qcom/common.c
--- a/drivers/clk/qcom/common.c
+++ b/drivers/clk/qcom/common.c
@@ -12,6 +12,8 @@
 #include <linux/pm_runtime.h>
 #include <linux/reset-controller.h>
 #include <linux/of.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
 
 #include "common.h"
 #include "clk-alpha-pll.h"
@@ -464,5 +466,65 @@
 }
 EXPORT_SYMBOL_GPL(qcom_cc_probe_by_index);
 
+
+#define QCOM_CC_SPLASH_OFF_MS		50
+
+void qcom_cc_release_dsi_panels(struct qcom_cc_panel_resets *resets)
+{
+	int i;
+
+	if (!resets)
+		return;
+
+	for (i = 0; i < resets->n; i++)
+		gpiod_put(resets->desc[i]);
+	resets->n = 0;
+}
+EXPORT_SYMBOL_GPL(qcom_cc_release_dsi_panels);
+
+int qcom_cc_blank_dsi_panels(struct qcom_cc_panel_resets *resets)
+{
+	struct device_node *dsi, *panel;
+	struct gpio_desc *desc;
+	int ret;
+
+	if (!resets)
+		return 0;
+
+	resets->n = 0;
+	for_each_compatible_node(dsi, NULL, "qcom,mdss-dsi-ctrl") {
+		for_each_available_child_of_node(dsi, panel) {
+			if (!of_property_present(panel, "reset-gpios"))
+				continue;
+			if (resets->n >= QCOM_CC_MAX_PANEL_RESETS) {
+				of_node_put(panel);
+				of_node_put(dsi);
+				goto held;
+			}
+			desc = fwnode_gpiod_get_index(of_fwnode_handle(panel),
+						      "reset", 0, GPIOD_OUT_HIGH,
+						      "dispcc-splash-off");
+			if (IS_ERR(desc)) {
+				ret = PTR_ERR(desc);
+				if (ret == -EPROBE_DEFER) {
+					of_node_put(panel);
+					of_node_put(dsi);
+					qcom_cc_release_dsi_panels(resets);
+					return ret;
+				}
+				continue;
+			}
+			resets->desc[resets->n++] = desc;
+		}
+	}
+
+held:
+	if (resets->n)
+		msleep(QCOM_CC_SPLASH_OFF_MS);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(qcom_cc_blank_dsi_panels);
+
 MODULE_LICENSE("GPL v2");
 MODULE_DESCRIPTION("QTI Common Clock module");
diff --git a/drivers/clk/qcom/common.h b/drivers/clk/qcom/common.h
--- a/drivers/clk/qcom/common.h
+++ b/drivers/clk/qcom/common.h
@@ -11,6 +11,7 @@
 struct regmap;
 struct freq_tbl;
 struct clk_hw;
+struct gpio_desc;
 
 #define PLL_LOCK_COUNT_SHIFT	8
 #define PLL_LOCK_COUNT_MASK	0x3f
@@ -89,4 +90,14 @@
 extern int qcom_cc_probe_by_index(struct platform_device *pdev, int index,
 				  const struct qcom_cc_desc *desc);
 
+#define QCOM_CC_MAX_PANEL_RESETS	4
+
+struct qcom_cc_panel_resets {
+	struct gpio_desc *desc[QCOM_CC_MAX_PANEL_RESETS];
+	int n;
+};
+
+int qcom_cc_blank_dsi_panels(struct qcom_cc_panel_resets *resets);
+void qcom_cc_release_dsi_panels(struct qcom_cc_panel_resets *resets);
+
 #endif
diff --git a/drivers/clk/qcom/dispcc-sm8250.c b/drivers/clk/qcom/dispcc-sm8250.c
--- a/drivers/clk/qcom/dispcc-sm8250.c
+++ b/drivers/clk/qcom/dispcc-sm8250.c
@@ -1253,6 +1253,7 @@
 
 static int disp_cc_sm8250_probe(struct platform_device *pdev)
 {
+	struct qcom_cc_panel_resets panels = { };
 	struct regmap *regmap;
 	int ret;
 
@@ -1359,6 +1360,12 @@
 		disp_cc_sm8250_clocks[DISP_CC_MDSS_EDP_GTC_CLK_SRC] = NULL;
 	}
 
+	ret = qcom_cc_blank_dsi_panels(&panels);
+	if (ret) {
+		pm_runtime_put(&pdev->dev);
+		return ret;
+	}
+
 	if (of_device_is_compatible(pdev->dev.of_node, "qcom,sm8350-dispcc")) {
 		clk_lucid_5lpe_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
 		clk_lucid_5lpe_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
@@ -1374,6 +1381,7 @@
 	qcom_branch_set_clk_en(regmap, 0x605c); /* DISP_CC_XO_CLK */
 
 	ret = qcom_cc_really_probe(&pdev->dev, &disp_cc_sm8250_desc, regmap);
+	qcom_cc_release_dsi_panels(&panels);
 
 	pm_runtime_put(&pdev->dev);
 
diff --git a/drivers/clk/qcom/dispcc-sm8550.c b/drivers/clk/qcom/dispcc-sm8550.c
--- a/drivers/clk/qcom/dispcc-sm8550.c
+++ b/drivers/clk/qcom/dispcc-sm8550.c
@@ -1764,6 +1764,7 @@
 
 static int disp_cc_sm8550_probe(struct platform_device *pdev)
 {
+	struct qcom_cc_panel_resets panels = { };
 	struct regmap *regmap;
 	int ret;
 
@@ -1794,6 +1795,10 @@
 		disp_cc_mdss_mdp_clk_src.freq_tbl = ftbl_disp_cc_mdss_mdp_clk_src_sar2130p;
 	}
 
+	ret = qcom_cc_blank_dsi_panels(&panels);
+	if (ret)
+		goto err_put_rpm;
+
 	clk_lucid_ole_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
 	clk_lucid_ole_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
 
@@ -1804,6 +1809,7 @@
 	qcom_branch_set_clk_en(regmap, 0xe054); /* DISP_CC_XO_CLK */
 
 	ret = qcom_cc_really_probe(&pdev->dev, &disp_cc_sm8550_desc, regmap);
+	qcom_cc_release_dsi_panels(&panels);
 	if (ret)
 		goto err_put_rpm;
 
diff --git a/drivers/clk/qcom/dispcc-sm8750.c b/drivers/clk/qcom/dispcc-sm8750.c
--- a/drivers/clk/qcom/dispcc-sm8750.c
+++ b/drivers/clk/qcom/dispcc-sm8750.c
@@ -1902,6 +1902,7 @@
 
 static int disp_cc_sm8750_probe(struct platform_device *pdev)
 {
+	struct qcom_cc_panel_resets panels = { };
 	struct regmap *regmap;
 	int ret;
 
@@ -1919,6 +1920,10 @@
 		goto err_put_rpm;
 	}
 
+	ret = qcom_cc_blank_dsi_panels(&panels);
+	if (ret)
+		goto err_put_rpm;
+
 	clk_taycan_elu_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
 	clk_taycan_elu_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
 	clk_pongo_elu_pll_configure(&disp_cc_pll2, regmap, &disp_cc_pll2_config);
@@ -1933,6 +1938,7 @@
 	qcom_branch_set_clk_en(regmap, 0xc008); /* DISP_CC_MDSS_RSCC_VSYNC_CLK */
 
 	ret = qcom_cc_really_probe(&pdev->dev, &disp_cc_sm8750_desc, regmap);
+	qcom_cc_release_dsi_panels(&panels);
 	if (ret)
 		goto err_put_rpm;
 
