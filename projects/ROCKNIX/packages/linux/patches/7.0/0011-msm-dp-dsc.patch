 	ret = msm_dp_ctrl_wait4video_ready(ctrl);
@@ -2557,6 +2835,10 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, bool force_link_train
 	drm_dbg_dp(ctrl->drm_dev,
