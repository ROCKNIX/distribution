-static int _tu_param_compare(s64 a, s64 b)
-{
-	u32 a_sign;
-	u32 b_sign;
-	s64 a_temp, b_temp, minus_1;
-
-	if (a == b)
-		return 0;
-
-	minus_1 = drm_fixp_from_fraction(-1, 1);
-
-	a_sign = (a >> 32) & 0x80000000 ? 1 : 0;
-
