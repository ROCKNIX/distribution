hwdec_drmprime: build the libplacebo dmabuf interop without vaapi

The interop is pure vulkan/libplacebo code, so gate it on vaapi or vulkan.

diff -ruN a/meson.build b/meson.build
--- a/meson.build	2026-08-15 09:53:48
+++ b/meson.build	2026-08-15 09:53:48
@@ -1470,8 +1470,11 @@
     dependencies += libva
     sources += files('video/filter/vf_vavpp.c',
                      'video/vaapi.c',
-                     'video/out/hwdec/hwdec_vaapi.c',
-                     'video/out/hwdec/dmabuf_interop_pl.c')
+                     'video/out/hwdec/hwdec_vaapi.c')
+endif
+
+if features['vaapi'] or features['vulkan']
+    sources += files('video/out/hwdec/dmabuf_interop_pl.c')
 endif
 
 features += {'dmabuf-interop-gl': features['egl'] and drm.found()}
diff -ruN a/video/out/hwdec/hwdec_drmprime.c b/video/out/hwdec/hwdec_drmprime.c
--- a/video/out/hwdec/hwdec_drmprime.c	2026-08-15 09:53:48
+++ b/video/out/hwdec/hwdec_drmprime.c	2026-08-15 09:53:48
@@ -56,7 +56,7 @@
 #if HAVE_DMABUF_INTEROP_GL
     dmabuf_interop_gl_init,
 #endif
-#if HAVE_VAAPI
+#if HAVE_VAAPI || HAVE_VULKAN
     dmabuf_interop_pl_init,
 #endif
 #if HAVE_DMABUF_WAYLAND
