From: ROCKNIX <maintainers@rocknix.org>
Subject: [PATCH] vect: pass the SLP node when costing emulated vector ops

A NULL node reaches aarch64_force_single_cycle and crashes the kernel build, same fix as upstream 3bc63918cec9.

--- a/gcc/tree-vect-stmts.cc
+++ b/gcc/tree-vect-stmts.cc
@@ -6872,9 +6872,9 @@
 	  if (n != 0)
 	    {
 	      /* We also need to materialize two large constants.  */
-	      record_stmt_cost (cost_vec, 2, scalar_stmt, stmt_info,
+	      record_stmt_cost (cost_vec, 2, scalar_stmt, slp_node,
 				0, vect_prologue);
-	      record_stmt_cost (cost_vec, n, scalar_stmt, stmt_info,
+	      record_stmt_cost (cost_vec, n, scalar_stmt, slp_node,
 				0, vect_body);
 	    }
 	}
