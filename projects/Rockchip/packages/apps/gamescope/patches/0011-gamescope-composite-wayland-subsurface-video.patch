-			if ( vulkan_rxnix_rga_direct_enabled() && !bNeedsFullComposite && pFrameInfo->layerCount >= 1 )
+			if ( vulkan_rxnix_rga_direct_enabled() && !bNeedsFullComposite && pFrameInfo->layerCount == 1 )
